a71comet.duckdns.org {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000

	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
		resolvers 1.1.1.1
	}
}

# Comet na porta 7443: é a que o roteador encaminha da internet (4G) para o A71
# (a 443 externa é de outro PC da casa). Em casa o AdGuard reescreve
# a71comet.duckdns.org -> 192.168.3.44, então o mesmo link funciona dentro e fora.
a71comet.duckdns.org:7443 {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000

	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
		resolvers 1.1.1.1
	}
}

# StremThru (addon Store: biblioteca do Real-Debrid no Stremio)
a71comet.duckdns.org:8443 {
	reverse_proxy 127.0.0.1:8080

	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
		resolvers 1.1.1.1
	}
}
