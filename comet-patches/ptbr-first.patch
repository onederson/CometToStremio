@@ -0,0 +1,131 @@
+from fastapi import APIRouter, HTTPException, Response
+
+from comet.services.artwork import (
+    ArtworkNotFound,
+    render_animation,
+    render_landscape,
+    render_poster,
+    render_top10,
+)
+
+router = APIRouter(tags=["Stremio"])
+
+
+@router.get(
+    "/art/top10/{rank}/{poster_file:path}",
+    summary="Top 10 Artwork",
+    description="Returns composite top 10 artwork with rank number.",
+)
+async def get_art_top10(rank: int, poster_file: str, p: int | None = None):
+    try:
+        data = await render_top10(rank, poster_file, provider_id=p)
+        return Response(
+            content=data,
+            media_type="image/jpeg",
+            headers={"Cache-Control": "public, max-age=2592000, immutable"},
+        )
+    except (ArtworkNotFound, ValueError):
+        raise HTTPException(status_code=404, detail="Artwork not found")
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Artwork not found")
+
+
+@router.get(
+    "/art/poster/{poster_file:path}",
+    summary="Poster Artwork with Badge",
+    description="Returns portrait poster artwork with optional badge.",
+)
+async def get_art_poster(
+    poster_file: str, b: str | None = None, p: int | None = None
+):
+    if b and b not in ("new_ep", "new", "dub", "top10"):
+        raise HTTPException(status_code=404, detail="Invalid badge")
+    try:
+        data = await render_poster(poster_file, badge=b, provider_id=p)
+        return Response(
+            content=data,
+            media_type="image/jpeg",
+            headers={"Cache-Control": "public, max-age=2592000, immutable"},
+        )
+    except (ArtworkNotFound, ValueError):
+        raise HTTPException(status_code=404, detail="Artwork not found")
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Artwork not found")
+
+
+@router.get(
+    "/art/land/{backdrop_file}",
+    summary="Landscape Artwork without Logo",
+    description="Returns landscape artwork with dark gradients.",
+)
+async def get_art_land_no_logo(
+    backdrop_file: str, b: str | None = None, p: int | None = None
+):
+    if b and b not in ("new_ep", "new", "dub", "top10"):
+        raise HTTPException(status_code=404, detail="Invalid badge")
+    try:
+        data = await render_landscape(backdrop_file, None, badge=b, provider_id=p)
+        return Response(
+            content=data,
+            media_type="image/jpeg",
+            headers={"Cache-Control": "public, max-age=2592000, immutable"},
+        )
+    except (ArtworkNotFound, ValueError):
+        raise HTTPException(status_code=404, detail="Artwork not found")
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Artwork not found")
+
+
+@router.get(
+    "/art/land/{backdrop_file}/{logo_file:path}",
+    summary="Landscape Artwork with Logo",
+    description="Returns landscape artwork with logo and dark gradients.",
+)
+async def get_art_land_with_logo(
+    backdrop_file: str, logo_file: str, b: str | None = None, p: int | None = None
+):
+    if b and b not in ("new_ep", "new", "dub", "top10"):
+        raise HTTPException(status_code=404, detail="Invalid badge")
+    try:
+        data = await render_landscape(backdrop_file, logo_file, badge=b, provider_id=p)
+        return Response(
+            content=data,
+            media_type="image/jpeg",
+            headers={"Cache-Control": "public, max-age=2592000, immutable"},
+        )
+    except (ArtworkNotFound, ValueError):
+        raise HTTPException(status_code=404, detail="Artwork not found")
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Artwork not found")
+
+
+@router.get(
+    "/art/anim/{media_type}/{filename:path}",
+    summary="Animated Artwork",
+    description="Returns animated backdrop or poster in WebP or GIF format.",
+)
+async def get_art_anim(media_type: str, filename: str, kind: str | None = None):
+    try:
+        parts = filename.strip("/").split("/")
+        if len(parts) == 2 and media_type in ("poster", "backdrop"):
+            actual_kind = media_type
+            actual_type = parts[0]
+            actual_file = parts[1]
+        else:
+            actual_kind = kind or "backdrop"
+            actual_type = media_type
+            actual_file = parts[-1]
+
+        if "." not in actual_file:
+            raise HTTPException(status_code=404, detail="Invalid filename")
+        tmdb_id, ext = actual_file.rsplit(".", 1)
+        data, mime = await render_animation(actual_type, tmdb_id, ext, kind=actual_kind)
+        return Response(
+            content=data,
+            media_type=mime,
+            headers={"Cache-Control": "public, max-age=2592000, immutable"},
+        )
+    except (ArtworkNotFound, ValueError):
+        raise HTTPException(status_code=404, detail="Artwork not found")
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Artwork not found")
