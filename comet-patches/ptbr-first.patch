+def _format_resolution(raw_res: str | None) -> str:
+    r = str(raw_res or "").lower().strip()
+    if r in ("2160p", "4k"):
+        return "4K"
+    elif r == "1080p":
+        return "1080p"
+    elif r == "720p":
+        return "720p"
+    return "SD"
+
+
+def _format_size_gb(size_bytes: int | float | None) -> str | None:
+    if size_bytes is None or size_bytes <= 0:
+        return None
+    gb = size_bytes / (1024 ** 3)
+    return f"{gb:.1f} GB".replace(".", ",")
+
+
+def _extract_short_audio(rtn_data) -> str | None:
+    if not rtn_data:
+        return None
+    audios = getattr(rtn_data, "audio", None) or []
+    if isinstance(audios, str):
+        audios = [audios]
+    channels = getattr(rtn_data, "channels", None) or []
+    if isinstance(channels, str):
+        channels = [channels]
+
+    audios_lower = [str(a).lower() for a in audios]
+    has_atmos = any("atmos" in a for a in audios_lower)
+    ch = str(channels[0]).strip() if channels else None
+
+    if has_atmos and ch:
+        return f"{ch} Atmos"
+    if has_atmos:
+        return "Atmos"
+    if ch:
+        return ch
+    for a in audios:
+        al = str(a).lower()
+        if "dts" in al:
+            return "DTS"
+        if "aac" in al:
+            return "AAC"
+        if "ddp" in al or "plus" in al:
+            return "DD+"
+        if "truehd" in al:
+            return "TrueHD"
+        if "dolby" in al:
+            return "Dolby"
+        return str(a)
+    return None
+
+
+def _extract_quality(rtn_data) -> str | None:
+    if not rtn_data:
+        return None
+    q = getattr(rtn_data, "quality", None)
+    if not q:
+        return None
+    if isinstance(q, list):
+        return str(q[0]) if q else None
+    return str(q)
+
+
+def _extract_group(rtn_data) -> str | None:
+    if not rtn_data:
+        return None
+    g = getattr(rtn_data, "group", None)
+    if not g:
+        return None
+    if isinstance(g, list):
+        return str(g[0]) if g else None
+    return str(g)
+
+
+def _get_dub_kind(title: str, is_pt: bool) -> str | None:
+    if not is_pt:
+        return None
+    if re.search(r"(?i)\bdual\b", title):
+        return "dual"
+    if re.search(r"(?i)\b(dublado|nacional|dub)\b", title):
+        return "dublado"
+    return "pt"
+
