+++ b/comet/services/sub_translate.py
@@ -0,0 +1,307 @@
+import asyncio
+import hashlib
+import os
+import re
+import time
+import urllib.parse
+from curl_cffi.requests import AsyncSession
+
+from comet.core.logger import logger, record_source_error, record_source_success
+from comet.core.models import settings
+
+_TRANSLATE_LOCKS: dict[str, asyncio.Lock] = {}
+_LOCKS_MUTEX = asyncio.Lock()
+
+
+def parse_srt_cues(srt_text: str) -> list[dict]:
+    lines = srt_text.replace("\r\n", "\n").replace("\r", "\n").splitlines()
+    cues = []
+    i = 0
+    n = len(lines)
+    auto_idx = 1
+    while i < n:
+        line = lines[i].strip()
+        if not line:
+            i += 1
+            continue
+        if "-->" in line:
+            idx_str = str(auto_idx)
+            time_str = lines[i].strip()
+            i += 1
+        elif i + 1 < n and "-->" in lines[i + 1]:
+            idx_str = line
+            time_str = lines[i + 1].strip()
+            i += 2
+        else:
+            i += 1
+            continue
+        text_lines = []
+        while i < n:
+            cur = lines[i]
+            cur_strip = cur.strip()
+            if not cur_strip:
+                i += 1
+                break
+            if cur_strip.isdigit() and i + 1 < n and "-->" in lines[i + 1]:
+                break
+            if "-->" in cur:
+                break
+            text_lines.append(cur_strip)
+            i += 1
+        cues.append({
+            "index": idx_str,
+            "time": time_str,
+            "text": "\n".join(text_lines),
+        })
+        auto_idx += 1
+    return cues
+
+
+def clean_cue_text(text: str) -> str:
+    t = re.sub(r"<[^>]+>", "", text)
+    t = re.sub(r"\{[^}]*\}", "", t)
+    t = t.replace("\r\n", " ").replace("\r", " ").replace("\n", " ")
+    t = re.sub(r"[ \t]+", " ", t).strip()
+    return t
+
+
+def wrap_line_42(text: str) -> str:
+    t = text.strip()
+    if len(t) <= 42:
+        return t
+    mid = len(t) / 2
+    spaces = [i for i, c in enumerate(t) if c == " "]
+    if not spaces:
+        return t
+    best_space = min(spaces, key=lambda i: abs(i - mid))
+    line1 = t[:best_space].strip()
+    line2 = t[best_space + 1:].strip()
+    return f"{line1}\n{line2}"
+
+
+async def fetch_gtx(
+    text_query: str,
+    sl: str = "en",
+    tl: str = "pt",
+    session: AsyncSession | None = None,
+) -> str | None:
+    if not text_query:
+        return ""
+    url = (
+        f"https://translate.googleapis.com/translate_a/single?client=gtx&sl={sl}&tl={tl}&dt=t&q="
+        + urllib.parse.quote(text_query)
+    )
+    should_close = False
+    if session is None:
+        session = AsyncSession(impersonate="chrome")
+        should_close = True
+    try:
+        for attempt in range(2):
+            try:
+                r = await session.get(url, timeout=10.0)
+                if r.status_code == 200:
+                    data = r.json()
+                    if data and isinstance(data, list) and data[0]:
+                        return "".join(
+                            seg[0] for seg in data[0] if seg and seg[0]
+                        )
+                    return ""
+                elif r.status_code == 429:
+                    if attempt == 0:
+                        await asyncio.sleep(2.0)
+                        continue
+                    logger.warning("Tradutor: HTTP 429 ratelimit")
+                    return None
+                else:
+                    if attempt == 0:
+                        await asyncio.sleep(2.0)
+                        continue
+                    logger.warning(f"Tradutor: HTTP {r.status_code}")
+                    return None
+            except Exception as e:
+                if attempt == 0:
+                    await asyncio.sleep(2.0)
+                    continue
+                logger.warning(f"Tradutor: erro ({type(e).__name__}): {e}")
+                return None
+        return None
+    finally:
+        if should_close:
+            await session.close()
+
+
+async def translate_srt(srt_text: str) -> str | None:
+    if not srt_text or not srt_text.strip():
+        return None
+
+    if len(srt_text) > settings.AUTO_TRANSLATE_MAX_CHARS:
+        logger.warning(
+            f"Tradutor: SRT ({len(srt_text)} chars) excede AUTO_TRANSLATE_MAX_CHARS ({settings.AUTO_TRANSLATE_MAX_CHARS})"
+        )
+        record_source_error("Tradutor", "SRT muito grande")
+        return None
+
+    cues = parse_srt_cues(srt_text)
+    if not cues:
+        return None
+
+    t0 = time.time()
+    cleaned_texts = [clean_cue_text(c["text"]) for c in cues]
+
+    batches: list[list[int]] = []
+    curr_batch: list[int] = []
+    curr_len = 0
+    for idx, text in enumerate(cleaned_texts):
+        line_len = len(text) + 1
+        if curr_batch and (curr_len + line_len > 4500):
+            batches.append(curr_batch)
+            curr_batch = [idx]
+            curr_len = line_len
+        else:
+            curr_batch.append(idx)
+            curr_len += line_len
+    if curr_batch:
+        batches.append(curr_batch)
+
+    batch_sem = asyncio.Semaphore(3)
+
+    async with AsyncSession(impersonate="chrome") as session:
+        async def _fetch_gtx(text_query: str) -> str | None:
+            return await fetch_gtx(text_query, sl="en", tl="pt", session=session)
+
+        async def process_batch(b_indices: list[int]) -> list[str] | None:
+            b_lines = [cleaned_texts[i] for i in b_indices]
+            if not any(b_lines):
+                return [""] * len(b_lines)
+
+            payload = "\n".join(b_lines)
+            async with batch_sem:
+                raw_res = await _fetch_gtx(payload)
+
+            if raw_res is None:
+                return None
+
+            lines = raw_res.split("\n")
+            if len(lines) == len(b_lines) + 1 and lines[-1] == "":
+                lines = lines[:-1]
+
+            if len(lines) == len(b_lines):
+                return lines
+
+            cue_sem = asyncio.Semaphore(4)
+
+            async def translate_single(cue_line: str) -> str | None:
+                if not cue_line.strip():
+                    return ""
+                async with cue_sem:
+                    single_res = await _fetch_gtx(cue_line)
+                if single_res is None:
+                    return None
+                return single_res.replace("\n", " ").strip()
+
+            tasks = [translate_single(line) for line in b_lines]
+            results = await asyncio.gather(*tasks)
+            if any(r is None for r in results):
+                return None
+            return list(results)
+
+        batch_tasks = [process_batch(b) for b in batches]
+        batch_results = await asyncio.gather(*batch_tasks)
+
+        if any(res is None for res in batch_results):
+            record_source_error("Tradutor", "Falha na tradução")
+            return None
+
+        translated_lines: list[str] = []
+        for b_res in batch_results:
+            translated_lines.extend(b_res)
+
+    if len(translated_lines) != len(cues):
+        record_source_error("Tradutor", "Contagem de falas divergente")
+        logger.warning(
+            f"Tradutor: contagem divergente ({len(translated_lines)} != {len(cues)})"
+        )
+        return None
+
+    out_blocks = []
+    for c, tl in zip(cues, translated_lines):
+        wrapped = wrap_line_42(tl)
+        out_blocks.append(f"{c['index']}\n{c['time']}\n{wrapped}")
+
+    final_srt = "\n\n".join(out_blocks) + "\n"
+    elapsed = time.time() - t0
+    logger.info(f"🤖 Legenda traduzida: {len(cues)} falas em {elapsed:.1f}s")
+    record_source_success("Tradutor")
+    return final_srt
+
+
+async def _get_translate_lock(key: str) -> asyncio.Lock:
+    async with _LOCKS_MUTEX:
+        if key not in _TRANSLATE_LOCKS:
+            _TRANSLATE_LOCKS[key] = asyncio.Lock()
+        return _TRANSLATE_LOCKS[key]
+
+
+async def ensure_auto_translated(
+    provider: str,
+    sub_id: str,
+    season: int,
+    episode: int,
+) -> bytes | None:
+    from comet.services.subtitles import (
+        DISK_CACHE_TTL,
+        SUBS_CACHE_DIR,
+        fetch_subtitle,
+    )
+
+    os.makedirs(SUBS_CACHE_DIR, exist_ok=True)
+    cache_key_str = f"{provider}:{sub_id}:{season}:{episode}"
+    cache_hash = hashlib.sha1(cache_key_str.encode("utf-8")).hexdigest()
+    cache_file = os.path.join(SUBS_CACHE_DIR, f"auto-{cache_hash}.srt")
+
+    if os.path.exists(cache_file):
+        try:
+            mtime = os.path.getmtime(cache_file)
+            if (time.time() - mtime) < DISK_CACHE_TTL:
+                with open(cache_file, "rb") as f:
+                    return f.read()
+        except Exception:
+            pass
+
+    lock = await _get_translate_lock(cache_key_str)
+    async with lock:
+        if os.path.exists(cache_file):
+            try:
+                mtime = os.path.getmtime(cache_file)
+                if (time.time() - mtime) < DISK_CACHE_TTL:
+                    with open(cache_file, "rb") as f:
+                        return f.read()
+            except Exception:
+                pass
+
+        sub_bytes = await fetch_subtitle(
+            provider=provider,
+            sub_id=sub_id,
+            season=season,
+            episode=episode,
+        )
+        if not sub_bytes:
+            return None
+
+        try:
+            srt_text = sub_bytes.decode("utf-8", errors="replace")
+        except Exception:
+            return None
+
+        translated_srt = await translate_srt(srt_text)
+        if not translated_srt:
+            return None
+
+        out_bytes = translated_srt.encode("utf-8")
+        try:
+            with open(cache_file, "wb") as f:
+                f.write(out_bytes)
+        except Exception as e:
+            logger.warning(f"Erro ao gravar cache de legenda traduzida: {e}")
+
+        return out_bytes
