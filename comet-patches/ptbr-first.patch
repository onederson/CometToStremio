+                  AND (episode_norm = :episode OR episode_norm = -1)
+                ORDER BY updated_at DESC
+                """,
+                {"media_id": media_id, "season": season, "episode": ep_val},
+            )
+        else:
+            candidates_data = await database.fetch_all(
+                """
+                SELECT info_hash, title, file_index, sources_json, parsed_json, seeders, updated_at
+                FROM torrents
+                WHERE media_id = :media_id
+                  AND season_norm = -1
+                  AND episode_norm = -1
+                ORDER BY updated_at DESC
+                """,
+                {"media_id": media_id},
+            )
+    except Exception as exc:
+        logger.warning(f"Fallback 451: erro ao consultar torrents no banco: {exc}")
+        return None
+
+    if not candidates_data:
+        return None
+
+    bucket1 = []
+    bucket2 = []
+    bucket3 = []
+    seen = set()
+
+    for row in candidates_data:
+        chash = str(row["info_hash"]).lower()
+        if chash in blocked_hashes or chash in seen:
+            continue
+        seen.add(chash)
+
+        c_res = ""
+        c_langs = ()
+        if row["parsed_json"]:
+            try:
+                pj = orjson.loads(row["parsed_json"])
+                c_res = str(pj.get("resolution") or "").lower()
+                c_langs = pj.get("languages") or ()
+            except Exception:
+                pass
+        if not c_res:
+            try:
+                parsed_c = parse(row["title"])
+                c_res = str(getattr(parsed_c, "resolution", "") or "").lower()
+                c_langs = getattr(parsed_c, "languages", ()) or ()
+            except Exception:
+                pass
+
+        is_pt = "pt" in c_langs
+        seeders = row["seeders"] or 0
+        c_res_rank = _RES_PRIORITY.get(c_res, 99)
+
+        if orig_res and c_res == orig_res and is_pt:
+            bucket1.append((row, -seeders))
+        elif is_pt:
+            bucket2.append((row, c_res_rank, -seeders))
+        elif orig_res and c_res == orig_res:
+            bucket3.append((row, -seeders))
+
+    bucket1.sort(key=lambda x: x[1])
+    bucket2.sort(key=lambda x: (x[1], x[2]))
+    bucket3.sort(key=lambda x: x[1])
+
+    ordered_candidates = [x[0] for x in bucket1] + [x[0] for x in bucket2] + [x[0] for x in bucket3]
+
+    for candidate in ordered_candidates[:3]:
+        cand_hash = str(candidate["info_hash"]).lower()
+        cand_title = candidate["title"]
+        cand_index = (
+            str(candidate["file_index"])
+            if candidate["file_index"] is not None
+            else "n"
+        )
+        cand_sources = _decode_sources(candidate["sources_json"])
+
+        try:
+            cand_url = await debrid.generate_download_link(
+                cand_hash,
+                cand_index,
+                name,
+                cand_title,
+                season,
+                episode,
+                cand_sources,
+                aliases,
+            )
+            valid_cand_url = _valid_download_url(cand_url)
+            if valid_cand_url:
+                logger.log(
+                    "PLAYBACK",
+                    f"🔁 451 em {original_hash.lower()} → tocando {cand_hash} {cand_title}",
+                )
+                await _cache_download_link_safely(
+                    debrid_service=debrid_service,
+                    account_key_hash=account_key_hash,
+                    info_hash=cand_hash,
+                    season=season,
+                    episode=episode,
+                    download_url=valid_cand_url,
+                )
+                return valid_cand_url
+        except DebridLinkGenerationError as cand_err:
+            if (
+                cand_err.payload.get("status_code") == 451
+                or cand_err.error_code == "UNAVAILABLE_FOR_LEGAL_REASONS"
+                or cand_err.upstream_error_code == "infringing_file"
+            ):
+                blocked_hashes.add(cand_hash)
+            continue
+        except Exception as cand_exc:
+            logger.warning(f"Fallback 451 falhou para candidato {cand_hash}: {cand_exc}")
+            continue
+
+    return None
