+
+    is_br_tracker = bool(tracker and _PTBR_TRACKER_RE.search(tracker))
+    has_dual = bool(_PTBR_DUAL_RE.search(torrent_title))
+    has_br_season = bool(_PTBR_SEASON_RE.search(torrent_title))
+
+    is_pt = has_explicit_pt or is_br_tracker
+    if not is_pt and has_br_season and has_dual:
+        is_pt = True
+    if not is_pt and (has_dual or has_br_season):
+        if has_dual and tracker and any(t in tracker.lower() for t in ("betor", "brsites")):
+            is_pt = True
+        else:
+            groups_re = _get_ptbr_groups_re(settings.PTBR_RELEASE_GROUPS or "")
+            if groups_re is not None and groups_re.search(por_text):
+                is_pt = True
+
+    if is_pt and not already_pt:
+        _log_exclusion(f"🏷️ Added Language (PT-BR) | {torrent_title} | pt")
+        parsed.languages.append("pt")
+
+    if is_pt and has_br_season and not has_real_es and "es" in parsed.languages:
+        parsed.languages.remove("es")
+
+
+LOW_QUALITY_SOURCES = {"CAM", "TeleSync", "TeleCine", "SCR"}
+
+
+def is_cam_release(parsed) -> bool:
+    if parsed is None:
+        return False
+    if isinstance(parsed, dict):
+        q = parsed.get("quality")
+    else:
+        q = getattr(parsed, "quality", "")
+    return str(q or "") in LOW_QUALITY_SOURCES
+
 
