+async def validate_pluto_channels():
+    try:
+        channels = await get_pluto_channels()
+        session = await get_pluto_v4_session()
+        stitcher = (session.get("stitcher") or "").rstrip("/") if session else ""
+        sp = (session.get("stitcherParams") or "").lstrip("?&") if session else ""
+        jwt = session.get("sessionToken") if session else ""
+
+        alive = []
+        for ch in channels:
+            cid = ch.get("_id")
+            if not cid:
+                continue
+
+            v4_ok = False
+            if stitcher and jwt:
+                u_v4 = f"{stitcher}/v2/stitch/hls/channel/{cid}/master.m3u8?{sp}&jwt={jwt}&masterJWTPassthrough=true"
+                v4_ok, _ = await asyncio.to_thread(check_channel_chain, u_v4, 6.0)
+
+            jmp2_ok = False
+            if not v4_ok:
+                u_jmp2 = f"https://jmp2.uk/plu-{cid}.m3u8"
+                jmp2_ok, _ = await asyncio.to_thread(check_channel_chain, u_jmp2, 6.0)
+
+            if v4_ok or jmp2_ok:
+                alive.append(cid)
+
+            await asyncio.sleep(1.0)
+
+        save_pluto_alive_to_file(alive)
+        logger.info(f"📺 Pluto TV: {len(alive)}/{len(channels)} canais vivos validados")
+    except Exception as e:
+        logger.warning(f"Erro validando canais Pluto: {e}")
+
