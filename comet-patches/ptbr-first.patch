+def _render_top10_pillow(
+    rank: int, poster_bytes: bytes, provider_logo_bytes: bytes | None = None
+) -> bytes:
+    """Tile 500x500 estilo Netflix: numero grande contornado a esquerda, poster a direita
+    sobrepondo um pouco o numero."""
+    from PIL import Image, ImageDraw, ImageFilter, ImageFont
+
+    W = H = 500
+    canvas = Image.new("RGB", (W, H), "#141414")
+    poster = Image.open(io.BytesIO(poster_bytes)).convert("RGB")
+    ph = 440
+    pw = round(poster.width * ph / poster.height)
+    poster = poster.resize((pw, ph), Image.LANCZOS)
+    px, py = W - pw, H - ph
+
+    text = str(rank)
+    font_path = (
+        "/usr/share/fonts/truetype/liberation/LiberationSansNarrow-Bold.ttf"
+        if rank == 10
+        else "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf"
+    )
+    overlap = 50 if rank == 10 else 40
+    max_w = px + overlap - 6
+    max_h = 400
+    stroke = 7
+    size = 560
+    draw = ImageDraw.Draw(canvas)
+    while size > 60:
+        font = ImageFont.truetype(font_path, size)
+        l, t, r, b = draw.textbbox((0, 0), text, font=font, stroke_width=stroke)
+        if r - l <= max_w and b - t <= max_h:
+            break
+        size -= 10
+    l, t, r, b = draw.textbbox((0, 0), text, font=font, stroke_width=stroke)
+    x = (px + overlap) - r
+    y = (H - 8) - b
+    draw.text((x, y), text, font=font, fill="#141414", stroke_width=stroke, stroke_fill="#9a9a9a")
+
+    # sombra do poster sobre o numero
+    shadow = Image.new("L", (W, H), 0)
+    ImageDraw.Draw(shadow).rectangle((px - 4, py, W, H), fill=200)
+    shadow = shadow.filter(ImageFilter.GaussianBlur(10))
+    canvas = Image.composite(Image.new("RGB", (W, H), "#000000"), canvas, shadow)
+    canvas.paste(poster, (px, py))
+
+    if provider_logo_bytes:
+        _draw_provider_logo(canvas, provider_logo_bytes, is_poster=False)
+
+    out = io.BytesIO()
+    canvas.save(out, "JPEG", quality=85, optimize=True)
+    return out.getvalue()
+
