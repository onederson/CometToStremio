+        if url2:
+            tasks.append(tmdb._get_json(url2, f"catalog {catalog_id} p{page2}"))
+        gather_res = await asyncio.gather(*tasks, return_exceptions=True)
+
+        raw_items = []
+        for res in gather_res:
+            if isinstance(res, dict) and isinstance(res.get("results"), list):
+                raw_items.extend(res["results"])
+
+        unique_raw_items = []
+        seen_tmdb_ids = set()
+        today_str = datetime.date.today().isoformat()
+        is_lancamentos = (
+            genre in ("Lançamentos", "Lancamentos") or catalog_id == "comet_new"
+        )
+
+        for item in raw_items:
+            if not isinstance(item, dict):
+                continue
+            if catalog_id == "comet_kids_tv" and item.get("original_language") == "ja":
+                continue
