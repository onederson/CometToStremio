+async def _check_kids_movie_allowed(tmdb: TMDBApi, tid: int, genre_ids: list[int]) -> bool:
+    try:
+        rd = await tmdb._get_json(f"movie/{tid}/release_dates", f"rd {tid}")
+        results = rd.get("results", []) if isinstance(rd, dict) else []
+        br_cert = None
+        for r in results:
+            if r.get("iso_3166_1") == "BR":
+                for d in r.get("release_dates", []):
+                    c = (d.get("certification") or "").strip()
+                    if c:
+                        br_cert = c
+                        break
+                if br_cert:
+                    break
+        if br_cert:
+            c_up = br_cert.upper()
+            if c_up in ("L", "LIVRE"):
+                return True
+            try:
+                return int(c_up) <= 12
+            except ValueError:
+                pass
+        return bool(any(g in (16, 10751) for g in (genre_ids or [])))
+    except Exception:
+        return bool(any(g in (16, 10751) for g in (genre_ids or [])))
+
