+def is_portuguese_track(track: dict) -> bool:
+    lang = (track.get("lang") or "").lower().strip()
+    bcp47 = (track.get("bcp47") or "").lower().strip()
+    name = (track.get("name") or "").lower()
+    if lang in ("por", "pt", "pob", "pt-br") or lang.startswith("pt"):
+        return True
+    if bcp47 in ("por", "pt", "pob", "pt-br") or bcp47.startswith("pt"):
+        return True
+    if any(k in name for k in ("portugu", "dublad", "pt-br", "brasil")):
+        return True
+    return False
