+async def _get_top10_imdb_ids(media_type: str, session: aiohttp.ClientSession, tmdb: TMDBApi) -> set[str]:
+    now = time.time()
+    cached = _TOP10_IDS_CACHE.get(media_type)
+    if cached is not None and (now - cached[0]) < 1800:
+        return cached[1]
+
+    tmdb_type = "movie" if media_type == "movie" else "tv"
+    try:
+        data = await tmdb._get_json(f"trending/{tmdb_type}/day?language=pt-BR", f"top10 {media_type}")
+        top_ids = set()
+        if isinstance(data, dict) and isinstance(data.get("results"), list):
+            count = 0
+            for item in data["results"]:
+                if not isinstance(item, dict):
+                    continue
+                tid = item.get("id")
+                if not tid:
+                    continue
+                cache_key = f"{tmdb_type}:{tid}"
+                imdb_id = _IMDB_MAP.get(cache_key)
+                if not imdb_id:
+                    try:
+                        ext = await tmdb._get_json(f"{tmdb_type}/{tid}/external_ids", f"ext {tid}")
+                        if isinstance(ext, dict) and ext.get("imdb_id"):
+                            imdb_id = ext["imdb_id"]
+                            _IMDB_MAP[cache_key] = imdb_id
+                    except Exception:
+                        pass
+                if imdb_id and imdb_id.startswith("tt"):
+                    top_ids.add(imdb_id)
+                    count += 1
+                    if count >= 10:
+                        break
+        _TOP10_IDS_CACHE[media_type] = (now, top_ids)
+        return top_ids
+    except Exception as e:
+        logger.warning(f"Error getting top 10 imdb ids: {e}")
+        return set()
+
+
+def _is_relevant_series(it: dict) -> bool:
+    tid = it.get("id")
+    if not tid:
+        return False
+    if tid in _TV_LAST_EP_CACHE:
+        return True
+    fad = it.get("first_air_date") or ""
+    pop = float(it.get("popularity") or 0.0)
+    if fad and fad >= "2023-01-01":
+        return True
+    if pop >= 12.0:
+        return True
+    return False
+
+
+async def _get_ready_tt_list(media_type: str) -> list[str]:
+    now = time.time()
+    cached_ready = _READY_CACHE.get(media_type)
+    if cached_ready is not None and (now - cached_ready[0]) < 1800:
+        return cached_ready[1]
+
+    cutoff = now - 30 * 86400
+    if media_type == "movie":
+        query = """
+            SELECT t.info_hash, t.media_id, t.season, t.title, t.tracker, d.max_updated_at
+            FROM (
+                SELECT info_hash, max(updated_at) AS max_updated_at
+                FROM debrid_availability
+                WHERE (
+                    (debrid_service = 'realdebrid' AND info_hash NOT IN (
+                        SELECT info_hash FROM debrid_blocked_hashes WHERE debrid_service = 'realdebrid'
+                    ))
+                    OR debrid_service = 'torbox'
+                )
+                AND updated_at >= :cutoff
+                GROUP BY info_hash
+            ) d
+            JOIN torrents t ON d.info_hash = t.info_hash
+            WHERE t.media_id LIKE :prefix AND t.season IS NULL
+            GROUP BY t.info_hash, t.title
+            ORDER BY d.max_updated_at DESC
+        """
+    else:
+        query = """
+            SELECT t.info_hash, t.media_id, t.season, t.title, t.tracker, d.max_updated_at
+            FROM (
+                SELECT info_hash, max(updated_at) AS max_updated_at
+                FROM debrid_availability
+                WHERE (
+                    (debrid_service = 'realdebrid' AND info_hash NOT IN (
+                        SELECT info_hash FROM debrid_blocked_hashes WHERE debrid_service = 'realdebrid'
+                    ))
+                    OR debrid_service = 'torbox'
+                )
+                AND updated_at >= :cutoff
+                GROUP BY info_hash
+            ) d
+            JOIN torrents t ON d.info_hash = t.info_hash
+            WHERE t.media_id LIKE :prefix AND t.season IS NOT NULL
+            GROUP BY t.info_hash, t.title
+            ORDER BY d.max_updated_at DESC
+        """
+    try:
+        rows = await database.fetch_all(
+            query,
+            {"cutoff": cutoff, "prefix": "tt%"},
+        )
+
+        def _filter_rows(rows_data):
+            seen = {}
+            for r in rows_data:
+                media_id = r["media_id"]
+                title = r["title"]
+                tracker = r["tracker"]
+                up_at = r["max_updated_at"]
+                parsed = RTN.parse(title)
+                apply_ptbr_detection(parsed, title, tracker)
+                if "pt" in (getattr(parsed, "languages", None) or ()) and not is_cam_release(parsed):
+                    base_tt = media_id.split(":")[0]
+                    if base_tt not in seen:
+                        seen[base_tt] = up_at
+            return sorted(seen.keys(), key=lambda k: seen[k], reverse=True)
+
+        sorted_tt = await asyncio.to_thread(_filter_rows, rows)
+    except Exception as e:
+        logger.warning(f"Error fetching ready items for {media_type}: {e}")
+        sorted_tt = []
+
+    _READY_CACHE[media_type] = (now, sorted_tt)
+    return sorted_tt
+
+
+async def _fetch_catalog_items(
