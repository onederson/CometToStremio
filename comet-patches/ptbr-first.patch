+async def _fetch_saga_items(genre: str | None, skip: int) -> list[dict]:
+    _ensure_imdb_map_loaded()
+    now = time.time()
+
+    timeout = aiohttp.ClientTimeout(total=8.0)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        tmdb = TMDBApi(session)
+
+        if genre:
+            cid = SAGA_MAP.get(genre)
+            if not cid:
+                return []
+            _, parts = await _get_collection_data(tmdb, cid)
+            selected_parts = parts[skip : skip + 40]
+
+            sem = asyncio.Semaphore(10)
+            cache_updated = False
+
+            async def resolve_imdb(tmdb_id: int) -> str | None:
+                nonlocal cache_updated
+                cache_key = f"movie:{tmdb_id}"
+                if cache_key in _IMDB_MAP:
+                    return _IMDB_MAP[cache_key]
+                async with sem:
+                    data = await tmdb._get_json(
+                        f"movie/{tmdb_id}/external_ids", f"movie external_ids {tmdb_id}"
+                    )
+                    if isinstance(data, dict):
