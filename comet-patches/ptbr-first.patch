+
+class ArtworkNotFound(Exception):
+    pass
+
+
+def _get_font(size: int) -> ImageFont.FreeTypeFont:
+    for path in FONT_PATHS:
+        if os.path.exists(path):
+            try:
+                return ImageFont.truetype(path, size)
+            except Exception:
+                continue
+    return ImageFont.load_default()
+
+
+def _get_gradient_overlay() -> Image.Image:
+    global _GRADIENT_OVERLAY
+    if _GRADIENT_OVERLAY is not None:
+        return _GRADIENT_OVERLAY
+
+    W, H = 780, 439
+    half_y = H / 2.0
+    third_x = W / 3.0
+    raw = bytearray(W * H * 4)
+    idx = 0
+    for y in range(H):
+        if y >= half_y:
+            a_bot = 0.85 * ((y - half_y) / (H - 1 - half_y))
+        else:
+            a_bot = 0.0
+        for x in range(W):
+            if x <= third_x:
+                a_left = 0.60 * ((third_x - x) / third_x)
+            else:
+                a_left = 0.0
+            a_comb = 1.0 - (1.0 - a_bot) * (1.0 - a_left)
+            raw[idx + 3] = int(round(a_comb * 255))
+            idx += 4
+
+    _GRADIENT_OVERLAY = Image.frombytes("RGBA", (W, H), bytes(raw))
+    return _GRADIENT_OVERLAY
+
+
+def _cleanup_cache_if_needed():
+    global _last_cleanup_time
+    now = time.time()
+    if now - _last_cleanup_time < 3600.0:
+        return
+    _last_cleanup_time = now
+    try:
+        if not os.path.isdir(CACHE_DIR):
+            return
+        total_size = 0
+        files = []
+        for entry in os.scandir(CACHE_DIR):
+            if entry.is_file():
+                try:
+                    st = entry.stat()
+                    total_size += st.st_size
+                    files.append((entry.path, st.st_mtime))
+                except OSError:
+                    pass
+        if total_size > 300 * 1024 * 1024:
+            cutoff = now - (30 * 86400)
+            for path, mtime in files:
+                if mtime < cutoff:
+                    try:
+                        os.unlink(path)
+                    except OSError:
+                        pass
