+
+            # Item 5: Título - escrita não latina -> en-US ou descarte
+            async def resolve_latin_title(it: dict) -> dict | None:
+                name = (
+                    it.get("title") or it.get("original_title") or ""
+                    if media_type == "movie"
+                    else it.get("name") or it.get("original_name") or ""
+                )
+                if not is_all_non_latin(name):
