+async def get_provider_logo_bytes(provider_id: int) -> bytes | None:
+    if not provider_id:
+        return None
+    if provider_id in _PROVIDER_LOGO_BYTES_CACHE:
+        return _PROVIDER_LOGO_BYTES_CACHE[provider_id]
+
+    logo_path = _PROVIDER_LOGO_PATH_CACHE.get(provider_id)
+    if not logo_path and provider_id in KNOWN_PROVIDER_LOGOS:
+        logo_path = KNOWN_PROVIDER_LOGOS[provider_id]
+
+    if not logo_path:
+        await ensure_watch_provider_table()
+        try:
+            row = await database.fetch_one(
+                "SELECT logo_path FROM watch_provider WHERE provider_id = :pid AND logo_path IS NOT NULL AND logo_path != '' LIMIT 1",
+                {"pid": provider_id},
+            )
+            if row and row["logo_path"]:
+                logo_path = row["logo_path"]
+        except Exception:
+            pass
+
+    if not logo_path:
+        return None
+
+    _PROVIDER_LOGO_PATH_CACHE[provider_id] = logo_path
+    clean_logo = logo_path.lstrip("/")
+
+    cache_path = os.path.join(CACHE_DIR, f"prov_{clean_logo}")
+    if os.path.exists(cache_path):
+        try:
+            with open(cache_path, "rb") as f:
+                data = f.read()
+                if len(data) > 0:
+                    _PROVIDER_LOGO_BYTES_CACHE[provider_id] = data
+                    return data
+        except Exception:
+            pass
+
+    try:
+        data = await _fetch_tmdb_image("w92", clean_logo)
+        _save_atomic(cache_path, data)
+        _PROVIDER_LOGO_BYTES_CACHE[provider_id] = data
+        return data
+    except Exception as e:
+        logger.warning(f"Could not fetch TMDB provider logo for {provider_id} ({clean_logo}): {e}")
+        return None
