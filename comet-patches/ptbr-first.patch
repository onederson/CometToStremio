+async def validate_iptv_channels():
+    global _iptv_validation_running
+    if _iptv_validation_running:
+        return
+    _iptv_validation_running = True
+    try:
+        if _get_mem_available_mb() < 600:
+            logger.warning("MemAvailable < 600 MB: pulando validacao do iptv-org")
+            return
+
+        async with httpx.AsyncClient(timeout=15.0) as client:
+            resp = await client.get(IPTV_ORG_BR_URL)
+            if resp.status_code != 200:
+                logger.warning(f"iptv-org M3U retornou {resp.status_code}")
+                return
+            content = resp.text
+
+        pattern = re.compile(r'#EXTINF:-1\s*(.*?),(.*)')
+        logo_pat = re.compile(r'tvg-logo="([^"]+)"')
+        cur_info = None
+        entries = []
+        for raw_line in content.splitlines():
+            line = raw_line.strip()
+            if line.startswith("#EXTINF:"):
+                cur_info = line
+            elif line and not line.startswith("#") and cur_info:
+                has_ctrl = any(ord(c) < 32 or ord(c) == 127 for c in line)
+                is_http = line.startswith("http://") or line.startswith("https://")
+                parsed_u = urllib.parse.urlparse(line)
+                if not has_ctrl and is_http and bool(parsed_u.netloc):
+                    m = pattern.match(cur_info)
+                    attrs = m.group(1) if m else ""
+                    name = m.group(2).strip() if m else cur_info
+                    lm = logo_pat.search(attrs)
+                    logo = lm.group(1) if lm else ""
+                    entries.append({"name": name, "logo": logo, "url": line})
+                cur_info = None
+
+        if not entries:
+            logger.warning("Nenhum canal encontrado no M3U do iptv-org")
+            return
+
+        alive = []
+        sem = asyncio.Semaphore(15)
+
+        async def _check(item):
+            if _get_mem_available_mb() < 600:
+                return None
+            u = item["url"]
+            parsed = urllib.parse.urlparse(u)
+            host = parsed.hostname
+            if not host:
+                return None
+            try:
+                if await _is_host_blocked_by_house_dns(host, "iptv"):
+                    return None
+            except Exception:
+                pass
+            async with sem:
+                ok, motivo = await asyncio.to_thread(check_channel_chain, u, 5.0)
+                if ok:
+                    h = hashlib.sha1(u.encode()).hexdigest()[:10]
+                    return {
+                        "id": f"cometlive:iptv:{h}",
+                        "name": item["name"],
+                        "url": u,
+                        "logo": item["logo"],
+                        "category": "Canais abertos",
+                    }
+            return None
+
+        tasks = [_check(e) for e in entries]
+        results = await asyncio.gather(*tasks, return_exceptions=True)
+        for res in results:
+            if isinstance(res, dict) and res:
+                alive.append(res)
+
+        alive.sort(key=lambda x: x["name"].lower())
+        now_str = datetime.datetime.now().astimezone(BR_TZ).strftime("%Y-%m-%d %H:%M:%S")
+        save_iptv_alive_to_file(alive, now_str)
+        logger.info(f"📺 IPTV-org: {len(alive)} canais vivos validados")
+    except Exception as e:
+        logger.warning(f"Erro ao validar iptv-org: {e}")
+    finally:
+        _iptv_validation_running = False
+
