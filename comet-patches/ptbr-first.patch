+# Database & Cache Operations
+async def _ensure_initialized() -> None:
+    global _INITIALIZED
+    if _INITIALIZED:
+        return
+    async with _INIT_LOCK:
+        if _INITIALIZED:
+            return
+        try:
+            now = int(time.time())
+            cutoff = now - (60 * 86400)
+            await database.execute(
+                "DELETE FROM audio_probe WHERE probed_at < :cutoff",
+                {"cutoff": cutoff},
+            )
+            row = await database.fetch_one(
+                "SELECT COUNT(*) as total, "
+                "SUM(CASE WHEN has_pt = 1 THEN 1 ELSE 0 END) as pt, "
+                "SUM(CASE WHEN has_pt = 0 THEN 1 ELSE 0 END) as no_pt "
+                "FROM audio_probe"
+            )
+            if row:
+                _AUDIO_STATS["probed"] = row["total"] or 0
+                _AUDIO_STATS["has_pt"] = row["pt"] or 0
+                _AUDIO_STATS["false_pt"] = row["no_pt"] or 0
+        except Exception as exc:
+            logger.debug(f"audio_probe init error: {exc}")
+        _INITIALIZED = True
+
+
+async def get_probe_result(info_hash: str, file_key: str) -> dict | None:
+    await _ensure_initialized()
+    if not info_hash:
+        return None
+    try:
+        row = await database.fetch_one(
+            "SELECT info_hash, file_key, langs, has_pt, probed_at "
+            "FROM audio_probe "
+            "WHERE info_hash = :info_hash AND file_key = :file_key",
+            {"info_hash": info_hash.lower(), "file_key": str(file_key)},
+        )
+        if row:
+            langs = []
+            try:
+                langs = json.loads(row["langs"])
+            except Exception:
+                langs = [{"lang": x.strip()} for x in (row["langs"] or "").split(",") if x.strip()]
+            return {
+                "info_hash": row["info_hash"],
+                "file_key": row["file_key"],
+                "langs": langs,
+                "has_pt": int(row["has_pt"]),
+                "probed_at": int(row["probed_at"]),
+            }
+    except Exception as exc:
+        logger.debug(f"get_probe_result error: {exc}")
+    return None
+
+
+async def get_probe_results_batch(keys: list[tuple[str, str]]) -> dict[tuple[str, str], dict]:
+    await _ensure_initialized()
+    if not keys:
+        return {}
+    res_map = {}
+    hashes = list({k[0].lower() for k in keys if k[0]})
+    if not hashes:
+        return {}
+    try:
+        placeholders = ", ".join(f":h{i}" for i in range(len(hashes)))
+        params = {f"h{i}": h for i, h in enumerate(hashes)}
+        rows = await database.fetch_all(
+            f"SELECT info_hash, file_key, langs, has_pt, probed_at "
+            f"FROM audio_probe "
+            f"WHERE info_hash IN ({placeholders})",
+            params,
+        )
+        for r in rows:
+            h = r["info_hash"].lower()
+            fk = r["file_key"]
+            langs = []
+            try:
+                langs = json.loads(r["langs"])
+            except Exception:
+                langs = [{"lang": x.strip()} for x in (r["langs"] or "").split(",") if x.strip()]
+            entry = {
+                "info_hash": h,
+                "file_key": fk,
+                "langs": langs,
+                "has_pt": int(r["has_pt"]),
+                "probed_at": int(r["probed_at"]),
+            }
+            res_map[(h, fk)] = entry
+    except Exception as exc:
+        logger.debug(f"get_probe_results_batch error: {exc}")
+    return res_map
+
+
+async def save_probe_result(
+    info_hash: str,
+    file_key: str,
+    tracks: list[dict],
+    claimed_pt: bool = False,
+) -> None:
+    await _ensure_initialized()
+    if not info_hash:
+        return
+    now = int(time.time())
+    is_pt = has_portuguese(tracks)
+    has_pt_val = 1 if is_pt else 0
+    langs_json = json.dumps(tracks)
+
+    try:
+        await database.execute(
+            """
+            INSERT INTO audio_probe (info_hash, file_key, langs, has_pt, probed_at)
+            VALUES (:info_hash, :file_key, :langs, :has_pt, :probed_at)
+            ON CONFLICT (info_hash, file_key) DO UPDATE SET
+                langs = EXCLUDED.langs,
+                has_pt = EXCLUDED.has_pt,
+                probed_at = EXCLUDED.probed_at
+            """,
+            {
+                "info_hash": info_hash.lower(),
+                "file_key": str(file_key),
+                "langs": langs_json,
+                "has_pt": has_pt_val,
+                "probed_at": now,
+            },
+        )
+        _AUDIO_STATS["probed"] += 1
+        if has_pt_val == 1:
+            _AUDIO_STATS["has_pt"] += 1
+        elif claimed_pt:
+            _AUDIO_STATS["false_pt"] += 1
+    except Exception as exc:
+        logger.debug(f"save_probe_result error: {exc}")
+
+
+def record_probe_failure() -> None:
+    _AUDIO_STATS["failures"] += 1
+    _AUDIO_STATS["probed"] += 1
+
+
+async def get_audio_probe_stats() -> dict[str, int]:
+    await _ensure_initialized()
+    try:
+        row = await database.fetch_one(
+            "SELECT COUNT(*) as total, "
+            "SUM(CASE WHEN has_pt = 1 THEN 1 ELSE 0 END) as pt, "
+            "SUM(CASE WHEN has_pt = 0 THEN 1 ELSE 0 END) as no_pt "
+            "FROM audio_probe"
+        )
+        total_db = row["total"] or 0
+        pt_db = row["pt"] or 0
+        no_pt_db = row["no_pt"] or 0
+    except Exception:
+        total_db = pt_db = no_pt_db = 0
+
+    return {
+        "probed": max(total_db + _AUDIO_STATS["failures"], _AUDIO_STATS["probed"]),
+        "has_pt": max(pt_db, _AUDIO_STATS["has_pt"]),
+        "false_pt": max(no_pt_db, _AUDIO_STATS["false_pt"]),
+        "failures": _AUDIO_STATS["failures"],
+    }
