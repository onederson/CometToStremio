+                    unique_raw_items = [
+                        it for it, ok in zip(unique_raw_items, checks)
+                        if ok is True
+                    ]
+                else:
+                    unique_raw_items = [
+                        it for it in unique_raw_items
+                        if any(g in (10762, 10751, 16) for g in (it.get("genre_ids") or []))
+                    ]
+
+            sem = asyncio.Semaphore(10)
+            cache_updated = False
+
+            async def resolve_imdb(tmdb_id: int) -> str | None:
+                nonlocal cache_updated
+                cache_key = f"{tmdb_type}:{tmdb_id}"
+                if cache_key in _IMDB_MAP:
+                    return _IMDB_MAP[cache_key]
+
+                async with sem:
+                    data = await tmdb._get_json(
+                        f"{tmdb_type}/{tmdb_id}/external_ids",
+                        f"{tmdb_type} external_ids {tmdb_id}",
+                    )
+                    if isinstance(data, dict):
+                        imdb_id = data.get("imdb_id")
+                        if isinstance(imdb_id, str) and imdb_id.startswith("tt"):
+                            _IMDB_MAP[cache_key] = imdb_id
+                            cache_updated = True
+                            return imdb_id
+                return None
+
+            imdb_ids = await asyncio.gather(
+                *[resolve_imdb(it["id"]) for it in unique_raw_items],
+                return_exceptions=True,
+            )
+
+            if cache_updated:
+                await asyncio.to_thread(_save_imdb_map)
+
+            for it, imdb_id in zip(unique_raw_items, imdb_ids):
+                if (
+                    not isinstance(imdb_id, str)
+                    or not imdb_id.startswith("tt")
+                    or imdb_id in seen_imdb
+                ):
+                    continue
+                seen_imdb.add(imdb_id)
+                poster_path = it.get("poster_path")
+                backdrop_path = it.get("backdrop_path")
+                name = (
+                    it.get("title") or it.get("original_title") or ""
+                    if media_type == "movie"
+                    else it.get("name") or it.get("original_name") or ""
+                )
+                date_str = (
+                    it.get("release_date")
+                    if media_type == "movie"
+                    else it.get("first_air_date")
+                )
+                year = date_str[:4] if date_str and len(date_str) >= 4 else ""
+                vote_avg = it.get("vote_average")
+                rating_str = (
+                    f"{float(vote_avg):.1f}" if vote_avg is not None else ""
+                )
+
+                meta = {
+                    "id": imdb_id,
+                    "type": media_type,
+                    "name": name,
+                    "poster": (
+                        f"https://image.tmdb.org/t/p/w500{poster_path}"
+                        if poster_path
+                        else None
+                    ),
+                    "background": (
+                        f"https://image.tmdb.org/t/p/w1280{backdrop_path}"
+                        if backdrop_path
+                        else None
+                    ),
+                    "description": it.get("overview") or "",
+                    "releaseInfo": year,
+                    "imdbRating": rating_str,
+                    "_vote_count": it.get("vote_count", 0),
+                }
+                results.append(meta)
+
+        if not kids and isinstance(cinemeta_metas, list):
+            for cm_item in cinemeta_metas:
+                if not isinstance(cm_item, dict):
+                    continue
+                cid = cm_item.get("id")
+                if cid and cid not in seen_imdb:
+                    seen_imdb.add(cid)
+                    results.append(cm_item)
+
+        return results
+
+
+_TRANSLATE_CACHE: dict[str, tuple[str, float]] = {}
+TRANSLATE_TTL = 7 * 86400
+
+async def _translate_pt_en(text: str) -> str:
+    key = text.strip().lower()
+    if key in _TRANSLATE_CACHE:
+        val, ts = _TRANSLATE_CACHE[key]
+        if time.time() - ts < TRANSLATE_TTL:
+            return val
+    try:
+        from comet.services.sub_translate import fetch_gtx
+        res = await fetch_gtx(text, sl="pt", tl="en")
+        trans = res.strip().lower() if res else text.strip().lower()
+    except Exception as e:
+        logger.warning(f"Erro na tradução PT->EN: {e}")
+        trans = text.strip().lower()
+    _TRANSLATE_CACHE[key] = (trans, time.time())
+    return trans
+
+_KEYWORD_CACHE: dict[str, int | None] = {}
+_KEYWORD_CANDIDATES_CACHE: dict[str, list[int]] = {}
+_EN_TITLE_CACHE: dict[str, str | None] = {}
+
+
+def to_singular(word: str) -> str:
+    w = word.strip().lower()
+    if w.endswith("ies") and len(w) > 4:
+        return w[:-3] + "y"
+    if w.endswith("es") and len(w) > 4 and w[-3] in ("s", "x", "z", "c", "h"):
+        return w[:-2]
+    if w.endswith("s") and not w.endswith("ss") and len(w) > 3:
+        return w[:-1]
+    return w
+
+
+def is_all_non_latin(text: str) -> bool:
+    if not text:
+        return False
+    has_letter = False
+    for ch in text:
+        try:
+            name = unicodedata.name(ch, "")
+        except Exception:
+            continue
+        if "LETTER" in name or "IDEOGRAPH" in name:
+            has_letter = True
+            if "LATIN" in name:
+                return False
+    return has_letter
+
+
+async def _get_keyword_id(tmdb: TMDBApi, query: str) -> int | None:
+    q_norm = query.strip().lower()
+    if q_norm in _KEYWORD_CACHE:
+        return _KEYWORD_CACHE[q_norm]
+    k_enc = urllib.parse.quote(q_norm)
+    data = await tmdb._get_json(f"search/keyword?query={k_enc}", f"kw {q_norm}")
+    kid = None
+    if isinstance(data, dict) and data.get("results"):
+        for r in data["results"]:
+            r_name = r.get("name", "").lower()
+            if r_name == q_norm or q_norm in r_name:
+                kid = r["id"]
+                break
+        if kid is None and data["results"]:
+            kid = data["results"][0].get("id")
+    _KEYWORD_CACHE[q_norm] = kid
+    return kid
+
+
+async def _get_keyword_candidates(tmdb: TMDBApi, term: str) -> list[int]:
+    t_norm = term.strip().lower()
+    if not t_norm:
+        return []
+    if t_norm in _KEYWORD_CANDIDATES_CACHE:
+        return _KEYWORD_CANDIDATES_CACHE[t_norm]
+
+    candidates = []
+    t_enc = urllib.parse.quote(t_norm)
+    data = await tmdb._get_json(f"search/keyword?query={t_enc}", f"kw cand {t_norm}")
+    if isinstance(data, dict) and data.get("results"):
+        for r in data["results"]:
+            r_name = r.get("name", "").lower()
+            if t_norm in r_name:
+                rid = r.get("id")
+                if rid and rid not in candidates:
+                    candidates.append(rid)
+                    if len(candidates) >= 3:
+                        break
+
+    sing = to_singular(t_norm)
+    if sing != t_norm and len(candidates) < 3:
+        s_enc = urllib.parse.quote(sing)
+        s_data = await tmdb._get_json(f"search/keyword?query={s_enc}", f"kw cand sing {sing}")
+        if isinstance(s_data, dict) and s_data.get("results"):
+            for r in s_data["results"]:
+                r_name = r.get("name", "").lower()
+                if sing in r_name:
+                    rid = r.get("id")
+                    if rid and rid not in candidates:
+                        candidates.append(rid)
+                        if len(candidates) >= 3:
+                            break
+
+    _KEYWORD_CANDIDATES_CACHE[t_norm] = candidates
+    return candidates
+
+
+FIXED_SYNONYMS = {
+    "doctor": ["doctor", "hospital", "medical drama"],
+    "doctors": ["doctor", "hospital", "medical drama"],
+    "medical": ["doctor", "hospital", "medical drama"],
+    "medic": ["doctor", "hospital", "medical drama"],
+    "medics": ["doctor", "hospital", "medical drama"],
