@@ -0,0 +1,415 @@
+import asyncio
+import hashlib
+import io
+import os
+import re
+import time
+
+import aiohttp
+from PIL import Image, ImageDraw, ImageFont
+
+from comet.core.logger import logger
+
+FILENAME_REGEX = re.compile(r"^[A-Za-z0-9_-]+\.(jpg|png)$")
+CACHE_DIR = "/opt/comet/data/img_cache"
+TMDB_IMAGE_BASE = "https://image.tmdb.org/t/p"
+
+_SEMAPHORE = asyncio.Semaphore(2)
+_last_cleanup_time = 0.0
+_GRADIENT_OVERLAY: Image.Image | None = None
+
+FONT_PATHS = [
+    "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
+    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
+]
+
+VALID_BADGES = {"new_ep", "new", "dub", "top10"}
+
+
+class ArtworkNotFound(Exception):
+    pass
+
+
+def _get_font(size: int) -> ImageFont.FreeTypeFont:
+    for path in FONT_PATHS:
+        if os.path.exists(path):
+            try:
+                return ImageFont.truetype(path, size)
+            except Exception:
+                continue
+    return ImageFont.load_default()
+
+
+def _get_gradient_overlay() -> Image.Image:
+    global _GRADIENT_OVERLAY
+    if _GRADIENT_OVERLAY is not None:
+        return _GRADIENT_OVERLAY
+
+    W, H = 780, 439
+    half_y = H / 2.0
+    third_x = W / 3.0
+    raw = bytearray(W * H * 4)
+    idx = 0
+    for y in range(H):
+        if y >= half_y:
+            a_bot = 0.85 * ((y - half_y) / (H - 1 - half_y))
+        else:
+            a_bot = 0.0
+        for x in range(W):
+            if x <= third_x:
+                a_left = 0.60 * ((third_x - x) / third_x)
+            else:
+                a_left = 0.0
+            a_comb = 1.0 - (1.0 - a_bot) * (1.0 - a_left)
+            raw[idx + 3] = int(round(a_comb * 255))
+            idx += 4
+
+    _GRADIENT_OVERLAY = Image.frombytes("RGBA", (W, H), bytes(raw))
+    return _GRADIENT_OVERLAY
+
+
+def _cleanup_cache_if_needed():
+    global _last_cleanup_time
+    now = time.time()
+    if now - _last_cleanup_time < 3600.0:
+        return
+    _last_cleanup_time = now
+    try:
+        if not os.path.isdir(CACHE_DIR):
+            return
+        total_size = 0
+        files = []
+        for entry in os.scandir(CACHE_DIR):
+            if entry.is_file():
+                try:
+                    st = entry.stat()
+                    total_size += st.st_size
+                    files.append((entry.path, st.st_mtime))
+                except OSError:
+                    pass
+        if total_size > 300 * 1024 * 1024:
+            cutoff = now - (30 * 86400)
+            for path, mtime in files:
+                if mtime < cutoff:
+                    try:
+                        os.unlink(path)
+                    except OSError:
+                        pass
+    except Exception as e:
+        logger.warning(f"Error during img_cache cleanup: {e}")
+
+
+def _save_atomic(cache_path: str, data: bytes):
+    try:
+        os.makedirs(CACHE_DIR, exist_ok=True)
+        tmp_path = f"{cache_path}.tmp.{os.getpid()}.{time.time()}"
+        with open(tmp_path, "wb") as f:
+            f.write(data)
+        os.replace(tmp_path, cache_path)
+    except Exception as e:
+        logger.warning(f"Failed to cache artwork atomically: {e}")
+
+
+async def _fetch_tmdb_image(size: str, filename: str) -> bytes:
+    clean = filename.lstrip("/")
+    if not FILENAME_REGEX.match(clean):
+        raise ArtworkNotFound(f"Invalid filename: {filename}")
+
+    url = f"{TMDB_IMAGE_BASE}/{size}/{clean}"
+    try:
+        timeout = aiohttp.ClientTimeout(total=10.0)
+        async with aiohttp.ClientSession(timeout=timeout) as session:
+            async with session.get(url) as resp:
+                if resp.status != 200:
+                    raise ArtworkNotFound(f"TMDB image fetch returned status {resp.status} for {url}")
+                return await resp.read()
+    except ArtworkNotFound:
+        raise
+    except Exception as e:
+        logger.warning(f"Error downloading {url}: {e}")
+        raise ArtworkNotFound(f"Download failed for {url}: {e}")
+
+
+def _draw_badge(canvas: Image.Image, badge: str | None, is_poster: bool = False):
+    if not badge or badge not in VALID_BADGES:
+        return
+    W, H = canvas.size
+    draw = ImageDraw.Draw(canvas)
+    if badge == "top10":
+        S = 48 if is_poster else 46
+        x0 = W - 14 - S
+        y0 = 14
+        x1 = x0 + S
+        y1 = y0 + S
+        draw.rounded_rectangle([x0, y0, x1, y1], radius=4, fill="#E50914")
+        font_top = _get_font(11)
+        font_10 = _get_font(20 if is_poster else 19)
+        bb_top = draw.textbbox((0, 0), "TOP", font=font_top)
+        w_top = bb_top[2] - bb_top[0]
+        h_top = bb_top[3] - bb_top[1]
+        bb_10 = draw.textbbox((0, 0), "10", font=font_10)
+        w_10 = bb_10[2] - bb_10[0]
+        h_10 = bb_10[3] - bb_10[1]
+        gap = 1
+        total_h = h_top + gap + h_10
+        start_y = y0 + (S - total_h) / 2
+        tx_top = x0 + (S - w_top) / 2 - bb_top[0]
+        ty_top = start_y - bb_top[1]
+        tx_10 = x0 + (S - w_10) / 2 - bb_10[0]
+        ty_10 = start_y + h_top + gap - bb_10[1]
+        draw.text((tx_top, ty_top), "TOP", font=font_top, fill="#FFFFFF")
+        draw.text((tx_10, ty_10), "10", font=font_10, fill="#FFFFFF")
+    else:
+        text_map = {
+            "new_ep": ("NOVO EPISÓDIO", "#E50914"),
+            "new": ("NOVIDADE", "#E50914"),
+            "dub": ("DUBLADO", "#1565C0"),
+        }
+        text, bg = text_map[badge]
+        font = _get_font(15 if is_poster else 13)
+        bb = draw.textbbox((0, 0), text, font=font)
+        tw = bb[2] - bb[0]
+        th = bb[3] - bb[1]
+        pad_x = 12 if is_poster else 9
+        pad_y = 6 if is_poster else 5
+        bw = tw + 2 * pad_x
+        bh = th + 2 * pad_y
+        if is_poster:
+            x0 = (W - bw) // 2
+            y1 = H - 14
+            y0 = y1 - bh
+            x1 = x0 + bw
+        else:
+            x0 = 14
+            y0 = 14
+            x1 = x0 + bw
+            y1 = y0 + bh
+        draw.rounded_rectangle([x0, y0, x1, y1], radius=4, fill=bg)
+        tx = x0 + (bw - tw) / 2 - bb[0]
+        ty = y0 + (bh - th) / 2 - bb[1]
+        draw.text((tx, ty), text, font=font, fill="#FFFFFF")
+
+
+def _render_top10_pillow(rank: int, poster_bytes: bytes) -> bytes:
+    """Tile 500x500 estilo Netflix: numero grande contornado a esquerda, poster a direita
+    sobrepondo um pouco o numero."""
+    from PIL import Image, ImageDraw, ImageFilter, ImageFont
+
+    W = H = 500
+    canvas = Image.new("RGB", (W, H), "#141414")
+    poster = Image.open(io.BytesIO(poster_bytes)).convert("RGB")
+    ph = 440
+    pw = round(poster.width * ph / poster.height)
+    poster = poster.resize((pw, ph), Image.LANCZOS)
+    px, py = W - pw, H - ph
+
+    text = str(rank)
+    font_path = (
+        "/usr/share/fonts/truetype/liberation/LiberationSansNarrow-Bold.ttf"
+        if rank == 10
+        else "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf"
+    )
+    overlap = 50 if rank == 10 else 40
+    max_w = px + overlap - 6
+    max_h = 400
+    stroke = 7
+    size = 560
+    draw = ImageDraw.Draw(canvas)
+    while size > 60:
+        font = ImageFont.truetype(font_path, size)
+        l, t, r, b = draw.textbbox((0, 0), text, font=font, stroke_width=stroke)
+        if r - l <= max_w and b - t <= max_h:
+            break
+        size -= 10
+    l, t, r, b = draw.textbbox((0, 0), text, font=font, stroke_width=stroke)
+    x = (px + overlap) - r
+    y = (H - 8) - b
+    draw.text((x, y), text, font=font, fill="#141414", stroke_width=stroke, stroke_fill="#9a9a9a")
+
+    # sombra do poster sobre o numero
+    shadow = Image.new("L", (W, H), 0)
+    ImageDraw.Draw(shadow).rectangle((px - 4, py, W, H), fill=200)
+    shadow = shadow.filter(ImageFilter.GaussianBlur(10))
+    canvas = Image.composite(Image.new("RGB", (W, H), "#000000"), canvas, shadow)
+    canvas.paste(poster, (px, py))
+
+    out = io.BytesIO()
+    canvas.save(out, "JPEG", quality=85, optimize=True)
+    return out.getvalue()
+
+
+def _render_landscape_pillow(
+    backdrop_bytes: bytes, logo_bytes: bytes | None, badge: str | None = None
+) -> bytes:
+    W, H = 780, 439
+    bg = Image.open(io.BytesIO(backdrop_bytes)).convert("RGBA")
+    scale = max(W / bg.width, H / bg.height)
+    sw = int(round(bg.width * scale))
+    sh = int(round(bg.height * scale))
+    bg_resized = bg.resize((sw, sh), Image.Resampling.LANCZOS)
+    cx = (sw - W) // 2
+    cy = (sh - H) // 2
+    canvas = bg_resized.crop((cx, cy, cx + W, cy + H))
+
+    canvas.alpha_composite(_get_gradient_overlay())
+
+    if logo_bytes:
+        logo = Image.open(io.BytesIO(logo_bytes)).convert("RGBA")
+        max_lw = int(round(W * 0.45))
+        max_lh = int(round(H * 0.32))
+        lscale = min(max_lw / logo.width, max_lh / logo.height)
+        nlw = max(1, int(round(logo.width * lscale)))
+        nlh = max(1, int(round(logo.height * lscale)))
+        logo_resized = logo.resize((nlw, nlh), Image.Resampling.LANCZOS)
+        canvas.paste(logo_resized, (28, H - 28 - nlh), mask=logo_resized)
+
+    if badge:
+        _draw_badge(canvas, badge, is_poster=False)
+
+    out = io.BytesIO()
+    canvas.convert("RGB").save(out, format="JPEG", quality=85, optimize=True)
+    return out.getvalue()
+
+
+def _render_poster_pillow(poster_bytes: bytes, badge: str | None = None) -> bytes:
+    W, H = 500, 750
+    bg = Image.open(io.BytesIO(poster_bytes)).convert("RGBA")
+    scale = max(W / bg.width, H / bg.height)
+    sw = int(round(bg.width * scale))
+    sh = int(round(bg.height * scale))
+    bg_resized = bg.resize((sw, sh), Image.Resampling.LANCZOS)
+    cx = (sw - W) // 2
+    cy = (sh - H) // 2
+    canvas = bg_resized.crop((cx, cy, cx + W, cy + H))
+
+    if badge:
+        _draw_badge(canvas, badge, is_poster=True)
+
+    out = io.BytesIO()
+    canvas.convert("RGB").save(out, format="JPEG", quality=85, optimize=True)
+    return out.getvalue()
+
+
+async def render_top10(rank: int, poster_file: str) -> bytes:
+    if rank < 1 or rank > 10:
+        raise ArtworkNotFound(f"Invalid rank: {rank}")
+
+    clean_poster = poster_file.lstrip("/")
+    if not FILENAME_REGEX.match(clean_poster):
+        raise ArtworkNotFound(f"Invalid poster filename: {poster_file}")
+
+    cache_key = f"top10v2:{rank}:{clean_poster}"
+    cache_path = os.path.join(
+        CACHE_DIR, f"{hashlib.sha1(cache_key.encode('utf-8')).hexdigest()}.jpg"
+    )
+
+    if os.path.exists(cache_path):
+        try:
+            with open(cache_path, "rb") as f:
+                return f.read()
+        except Exception:
+            pass
+
+    async with _SEMAPHORE:
+        if os.path.exists(cache_path):
+            try:
+                with open(cache_path, "rb") as f:
+                    return f.read()
+            except Exception:
+                pass
+
+        poster_bytes = await _fetch_tmdb_image("w500", clean_poster)
+        jpeg_bytes = await asyncio.to_thread(_render_top10_pillow, rank, poster_bytes)
+        _save_atomic(cache_path, jpeg_bytes)
+        _cleanup_cache_if_needed()
+        return jpeg_bytes
+
+
+async def render_landscape(
+    backdrop_file: str, logo_file: str | None = None, badge: str | None = None
+) -> bytes:
+    clean_backdrop = backdrop_file.lstrip("/")
+    if not FILENAME_REGEX.match(clean_backdrop):
+        raise ArtworkNotFound(f"Invalid backdrop filename: {backdrop_file}")
+
+    clean_logo = logo_file.lstrip("/") if logo_file else None
+    if clean_logo and not FILENAME_REGEX.match(clean_logo):
+        raise ArtworkNotFound(f"Invalid logo filename: {logo_file}")
+
+    clean_badge = badge.strip() if badge else None
+    if clean_badge and clean_badge not in VALID_BADGES:
+        raise ArtworkNotFound(f"Invalid badge: {badge}")
+
+    cache_key = (
+        f"land:{clean_backdrop}:{clean_logo or ''}:{clean_badge}"
+        if clean_badge
+        else f"land:{clean_backdrop}:{clean_logo or ''}"
+    )
+    cache_path = os.path.join(
+        CACHE_DIR, f"{hashlib.sha1(cache_key.encode('utf-8')).hexdigest()}.jpg"
+    )
+
+    if os.path.exists(cache_path):
+        try:
+            with open(cache_path, "rb") as f:
+                return f.read()
+        except Exception:
+            pass
+
+    async with _SEMAPHORE:
+        if os.path.exists(cache_path):
+            try:
+                with open(cache_path, "rb") as f:
+                    return f.read()
+            except Exception:
+                pass
+
+        backdrop_bytes = await _fetch_tmdb_image("w780", clean_backdrop)
+        logo_bytes = None
+        if clean_logo:
+            logo_bytes = await _fetch_tmdb_image("w500", clean_logo)
+
+        jpeg_bytes = await asyncio.to_thread(
+            _render_landscape_pillow, backdrop_bytes, logo_bytes, clean_badge
+        )
+        _save_atomic(cache_path, jpeg_bytes)
+        _cleanup_cache_if_needed()
+        return jpeg_bytes
+
+
+async def render_poster(poster_file: str, badge: str | None = None) -> bytes:
+    clean_poster = poster_file.lstrip("/")
+    if not FILENAME_REGEX.match(clean_poster):
+        raise ArtworkNotFound(f"Invalid poster filename: {poster_file}")
+
+    clean_badge = badge.strip() if badge else None
+    if clean_badge and clean_badge not in VALID_BADGES:
+        raise ArtworkNotFound(f"Invalid badge: {badge}")
+
+    cache_key = f"poster:{clean_poster}:{clean_badge or ''}"
+    cache_path = os.path.join(
+        CACHE_DIR, f"{hashlib.sha1(cache_key.encode('utf-8')).hexdigest()}.jpg"
+    )
+
+    if os.path.exists(cache_path):
+        try:
+            with open(cache_path, "rb") as f:
+                return f.read()
+        except Exception:
+            pass
+
+    async with _SEMAPHORE:
+        if os.path.exists(cache_path):
+            try:
+                with open(cache_path, "rb") as f:
+                    return f.read()
+            except Exception:
+                pass
+
+        poster_bytes = await _fetch_tmdb_image("w500", clean_poster)
