+async def _get_ready_tt_list(media_type: str) -> list[str]:
+    now = time.time()
+    cached_ready = _READY_CACHE.get(media_type)
+    if cached_ready is not None and (now - cached_ready[0]) < 1800:
+        return cached_ready[1]
+
+    cutoff = now - 30 * 86400
+    if media_type == "movie":
+        query = """
+            SELECT t.info_hash, t.media_id, t.season, t.title, t.tracker, d.max_updated_at
+            FROM (
+                SELECT info_hash, max(updated_at) AS max_updated_at
+                FROM debrid_availability
+                WHERE debrid_service = :service AND updated_at >= :cutoff
+                GROUP BY info_hash
+            ) d
+            JOIN torrents t ON d.info_hash = t.info_hash
+            WHERE t.media_id LIKE :prefix AND t.season IS NULL
+            GROUP BY t.info_hash, t.title
+            ORDER BY d.max_updated_at DESC
+        """
+    else:
+        query = """
+            SELECT t.info_hash, t.media_id, t.season, t.title, t.tracker, d.max_updated_at
+            FROM (
+                SELECT info_hash, max(updated_at) AS max_updated_at
+                FROM debrid_availability
+                WHERE debrid_service = :service AND updated_at >= :cutoff
+                GROUP BY info_hash
+            ) d
+            JOIN torrents t ON d.info_hash = t.info_hash
+            WHERE t.media_id LIKE :prefix AND t.season IS NOT NULL
+            GROUP BY t.info_hash, t.title
+            ORDER BY d.max_updated_at DESC
+        """
+    try:
+        rows = await database.fetch_all(
+            query,
+            {"service": "realdebrid", "cutoff": cutoff, "prefix": "tt%"},
+        )
+
+        def _filter_rows(rows_data):
+            seen = {}
+            for r in rows_data:
+                media_id = r["media_id"]
+                title = r["title"]
+                tracker = r["tracker"]
+                up_at = r["max_updated_at"]
+                parsed = RTN.parse(title)
+                apply_ptbr_detection(parsed, title, tracker)
+                if "pt" in (getattr(parsed, "languages", None) or ()) and not is_cam_release(parsed):
+                    base_tt = media_id.split(":")[0]
+                    if base_tt not in seen:
+                        seen[base_tt] = up_at
+            return sorted(seen.keys(), key=lambda k: seen[k], reverse=True)
+
+        sorted_tt = await asyncio.to_thread(_filter_rows, rows)
+    except Exception as e:
+        logger.warning(f"Error fetching ready items for {media_type}: {e}")
+        sorted_tt = []
+
+    _READY_CACHE[media_type] = (now, sorted_tt)
+    return sorted_tt
+
