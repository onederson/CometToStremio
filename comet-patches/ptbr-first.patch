new file mode 100644
index 0000000..fd74bc2
--- /dev/null
+++ b/comet/services/anime_filler.py
@@ -0,0 +1,171 @@
+import asyncio
+import json
+import re
+import time
+import aiohttp
+from bs4 import BeautifulSoup
+
+from comet.core.database import database
+from comet.core.logger import logger
+
+_TABLE_INIT = False
+_TABLE_LOCK = asyncio.Lock()
+_CACHE: dict[str, tuple[float, dict[int, str]]] = {}
+_CACHE_TTL = 7 * 86400  # 7 days
+
+
+async def ensure_anime_filler_table() -> None:
+    global _TABLE_INIT
+    if _TABLE_INIT:
+        return
+    async with _TABLE_LOCK:
+        if not _TABLE_INIT:
+            await database.execute(
+                """
+                CREATE TABLE IF NOT EXISTS anime_filler (
+                    slug TEXT PRIMARY KEY,
+                    data TEXT,
+                    fetched_at INTEGER
+                )
+                """
+            )
+            _TABLE_INIT = True
+
+
+def to_slug(name: str) -> str:
+    cleaned = re.sub(r"[^a-zA-Z0-9\s-]", "", name).strip().lower()
+    return re.sub(r"[\s-]+", "-", cleaned)
+
+
+async def fetch_filler_data_from_slug(
+    slug: str, session: aiohttp.ClientSession
+) -> dict[int, str] | None:
+    if not slug:
+        return None
+
+    now = time.time()
+    if slug in _CACHE:
+        ts, data = _CACHE[slug]
+        if now - ts < _CACHE_TTL:
+            return data
+
+    await ensure_anime_filler_table()
+    row = await database.fetch_one(
+        "SELECT data, fetched_at FROM anime_filler WHERE slug = :slug",
+        {"slug": slug},
+    )
+    if row is not None:
+        fetched_at = row["fetched_at"] or 0
+        if now - fetched_at < _CACHE_TTL:
+            raw_data = row["data"]
+            if not raw_data:
+                _CACHE[slug] = (now, {})
+                return {}
+            try:
+                parsed = {int(k): v for k, v in json.loads(raw_data).items()}
+                _CACHE[slug] = (now, parsed)
+                return parsed
+            except Exception:
+                pass
+
+    url = f"https://www.animefillerlist.com/shows/{slug}"
+    headers = {
+        "User-Agent": (
+            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
+            "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
+        )
+    }
+
+    try:
+        timeout = aiohttp.ClientTimeout(total=10.0)
+        async with session.get(url, headers=headers, timeout=timeout) as resp:
+            if resp.status == 200:
+                html = await resp.text()
+                soup = BeautifulSoup(html, "html.parser")
+                table = soup.find("table", class_="EpisodeList")
+                if table:
+                    ep_dict = {}
+                    for row in table.find_all("tr"):
+                        tds = row.find_all("td")
+                        if len(tds) >= 3:
+                            ep_str = tds[0].get_text(strip=True)
+                            ep_type = tds[2].get_text(strip=True)
+                            if ep_str.isdigit():
+                                ep_dict[int(ep_str)] = ep_type
+                    await database.execute(
+                        """
+                        INSERT OR REPLACE INTO anime_filler (slug, data, fetched_at)
+                        VALUES (:slug, :data, :fetched_at)
+                        """,
+                        {
+                            "slug": slug,
+                            "data": json.dumps(ep_dict),
+                            "fetched_at": int(now),
+                        },
+                    )
+                    _CACHE[slug] = (now, ep_dict)
+                    return ep_dict
+            elif resp.status == 404:
+                await database.execute(
+                    """
+                    INSERT OR REPLACE INTO anime_filler (slug, data, fetched_at)
+                    VALUES (:slug, '', :fetched_at)
+                    """,
+                    {
+                        "slug": slug,
+                        "fetched_at": int(now),
+                    },
+                )
+                _CACHE[slug] = (now, {})
+                return None
+            else:
+                logger.warning(
+                    f"AnimeFillerList HTTP {resp.status} para slug '{slug}'"
+                )
+                return None
+    except Exception as e:
+        logger.warning(f"Erro ao buscar AnimeFillerList ({slug}): {e}")
+        return None
+
+    return None
+
+
+async def get_anime_filler_map(
+    series_id: str,
+    title: str,
+    aliases: dict | None,
+    session: aiohttp.ClientSession,
+) -> dict[int, str]:
+    slug_candidates = []
+    if title:
+        s0 = to_slug(title)
+        if s0:
+            slug_candidates.append(s0)
+
+    if aliases and isinstance(aliases, dict):
+        for k in ("original", "lang:en", "us", "br", "ez"):
+            for a in aliases.get(k, []):
+                if isinstance(a, str):
+                    sa = to_slug(a)
+                    if sa and sa not in slug_candidates:
+                        slug_candidates.append(sa)
+
+    for slug in slug_candidates:
+        res = await fetch_filler_data_from_slug(slug, session)
+        if res:
+            return res
+
+    # Se nenhum achou lista, salva vazio para o slug principal se houver
+    if slug_candidates:
+        primary = slug_candidates[0]
+        await ensure_anime_filler_table()
+        await database.execute(
+            """
+            INSERT OR REPLACE INTO anime_filler (slug, data, fetched_at)
+            VALUES (:slug, '', :fetched_at)
+            """,
+            {"slug": primary, "fetched_at": int(time.time())},
+        )
+        _CACHE[primary] = (time.time(), {})
+
+    return {}
