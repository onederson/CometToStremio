+                        _TV_LAST_EP_CACHE[tid] = (now, None)
+            if air_date:
+                try:
+                    ep_date = datetime.date.fromisoformat(air_date)
+                    diff = (datetime.date.today() - ep_date).days
+                    return -1 <= diff <= 10
+                except ValueError:
+                    pass
