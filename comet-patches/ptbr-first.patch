diff --git a/comet/services/subtitle_sync.py b/comet/services/subtitle_sync.py
new file mode 100644
index 0000000..114c872
--- /dev/null
+++ b/comet/services/subtitle_sync.py
@@ -0,0 +1,188 @@
+import re
+
+SPEED_RATIOS = (
+    1.0,
+    25 / 23.976,
+    23.976 / 25,
+    24 / 23.976,
+    23.976 / 24,
+    25 / 24,
+    24 / 25,
+)
+
+
+def _parse_time(t_str: str) -> int | None:
+    t_str = t_str.strip().replace(".", ",")
+    parts = t_str.split(":")
+    try:
+        if len(parts) == 3:
+            h = int(parts[0])
+            m = int(parts[1])
+            s, ms = parts[2].split(",")
+            return (h * 3600 + m * 60 + int(s)) * 1000 + int((ms + "000")[:3])
+        elif len(parts) == 2:
+            m = int(parts[0])
+            s, ms = parts[1].split(",")
+            return (m * 60 + int(s)) * 1000 + int((ms + "000")[:3])
+    except Exception:
+        return None
+    return None
+
+
+def _format_time(ms: int) -> str:
+    h = ms // 3600000
+    ms %= 3600000
+    m = ms // 60000
+    ms %= 60000
+    s = ms // 1000
+    ms %= 1000
+    return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"
+
+
+def parse_srt(srt_text: str) -> list[tuple[int, int, str]]:
+    lines = srt_text.replace("\r\n", "\n").replace("\r", "\n").splitlines()
+    blocks = []
+    i = 0
+    n = len(lines)
+    while i < n:
+        line = lines[i].strip()
+        if not line:
+            i += 1
+            continue
+        if "-->" in line:
+            time_line = line
+            i += 1
+        elif i + 1 < n and "-->" in lines[i + 1]:
+            time_line = lines[i + 1].strip()
+            i += 2
+        else:
+            i += 1
+            continue
+
+        parts = time_line.split("-->")
+        if len(parts) != 2:
+            continue
+        start_str = parts[0].strip().split()[0]
+        end_str = parts[1].strip().split()[0]
+        start_ms = _parse_time(start_str)
+        end_ms = _parse_time(end_str)
+        if start_ms is None or end_ms is None or start_ms >= end_ms:
+            continue
+
+        text_lines = []
+        while i < n and lines[i].strip() and "-->" not in lines[i]:
+            if i + 1 < n and "-->" in lines[i + 1] and lines[i].strip().isdigit():
+                break
+            text_lines.append(lines[i].strip())
+            i += 1
+        blocks.append((start_ms, end_ms, "\n".join(text_lines)))
+    return blocks
+
+
+def build_bitmask(intervals: list[tuple[int, int]], bin_ms: int) -> int:
+    mask = 0
+    for start_ms, end_ms in intervals:
+        start_bin = max(0, start_ms // bin_ms)
+        end_bin = max(start_bin, (end_ms + bin_ms - 1) // bin_ms)
+        span = end_bin - start_bin
+        if span > 0:
+            mask |= ((1 << span) - 1) << start_bin
+    return mask
+
+
+def align_srt_detail(
+    target_srt: str, reference_srt: str
+) -> tuple[str | None, dict]:
+    target_blocks = parse_srt(target_srt)
+    ref_blocks = parse_srt(reference_srt)
+    if not target_blocks or not ref_blocks:
+        return None, {"ratio": 1.0, "offset_ms": 0, "before": 0.0, "after": 0.0}
+
+    ref_intervals = [(s, e) for s, e, _ in ref_blocks]
+    ref_mask_100 = build_bitmask(ref_intervals, 100)
+
+    best_count = -1
+    best_ratio = 1.0
+    best_k_100 = 0
+
+    for ratio in SPEED_RATIOS:
+        scaled = [
+            (int(round(s * ratio)), int(round(e * ratio)))
+            for s, e, _ in target_blocks
+        ]
+        target_mask_100 = build_bitmask(scaled, 100)
+        for k in range(-1200, 1201):
+            shifted = (
+                (target_mask_100 << k)
+                if k >= 0
+                else (target_mask_100 >> (-k))
+            )
+            c = (ref_mask_100 & shifted).bit_count()
+            if c > best_count:
+                best_count = c
+                best_ratio = ratio
+                best_k_100 = k
+
+    ref_mask_20 = build_bitmask(ref_intervals, 20)
+    scaled_best = [
+        (int(round(s * best_ratio)), int(round(e * best_ratio)))
+        for s, e, _ in target_blocks
+    ]
+    target_mask_20 = build_bitmask(scaled_best, 20)
+
+    center_k_20 = best_k_100 * 5
+    best_count_20 = -1
+    best_k_20 = center_k_20
+    for k_20 in range(center_k_20 - 10, center_k_20 + 11):
+        shifted = (
+            (target_mask_20 << k_20)
+            if k_20 >= 0
+            else (target_mask_20 >> (-k_20))
+        )
+        c = (ref_mask_20 & shifted).bit_count()
+        if c > best_count_20:
+            best_count_20 = c
+            best_k_20 = k_20
+
+    best_offset_ms = best_k_20 * 20
+
+    ref_fala_20 = ref_mask_20.bit_count()
+    target_mask_20_r1 = build_bitmask([(s, e) for s, e, _ in target_blocks], 20)
+    denom_before = min(ref_fala_20, target_mask_20_r1.bit_count())
+    overlap_antes = (
+        ((ref_mask_20 & target_mask_20_r1).bit_count() / denom_before)
+        if denom_before > 0
+        else 0.0
+    )
+
+    denom_after = min(ref_fala_20, target_mask_20.bit_count())
+    overlap_depois = (best_count_20 / denom_after) if denom_after > 0 else 0.0
+
+    stats = {
+        "ratio": best_ratio,
+        "offset_ms": best_offset_ms,
+        "before": round(overlap_antes, 4),
+        "after": round(overlap_depois, 4),
+    }
+
+    if overlap_depois < 0.55 or overlap_depois < (overlap_antes + 0.05):
+        return None, stats
+
+    new_blocks = []
+    for idx, (s, e, text) in enumerate(target_blocks, 1):
+        ns = max(0, int(round(s * best_ratio + best_offset_ms)))
+        ne = max(0, int(round(e * best_ratio + best_offset_ms)))
+        if ne <= ns:
+            ne = ns + max(1, e - s)
+        new_blocks.append(
+            f"{idx}\n{_format_time(ns)} --> {_format_time(ne)}\n{text}\n"
+        )
+    new_srt = "\n".join(new_blocks) + "\n"
+    return new_srt, stats
+
+
+def align_srt(target_srt: str, reference_srt: str) -> tuple[str, dict] | None:
+    res_srt, stats = align_srt_detail(target_srt, reference_srt)
+    if res_srt is None:
+        return None
+    return res_srt, stats
