+            # Step 2: OU entre todos (se etapa vencedora tiver < 20, completa com seguintes até 40)
+            if len(collected_items) < 20 and concepts:
+                all_ids = list(dict.fromkeys(k for c in concepts for k in c))
+                or_kw = "|".join(str(k) for k in all_ids)
+                items2 = await run_query(or_kw, base_vote_count)
+                add_batch(items2, 1)
+
+            # Step 3: só o conceito com mais resultados
+            if len(collected_items) < 20 and len(concepts) > 1:
+                best_items = []
+                for c in concepts:
