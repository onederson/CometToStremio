+                account_key_hash=build_account_key_hash(token),
+                info_hash=info_hash,
+                season=season,
+                episode=episode,
+                download_url=valid_url,
+            )
+            logger.log("PLAYBACK", f"⚡ Assistir pré-resolvido em memória: {info_hash}")
+    except DebridLinkGenerationError as err:
+        if (
