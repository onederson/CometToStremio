+    "lawyers": ["lawyer", "courtroom"],
+    "attorney": ["lawyer", "courtroom"],
+    "attorneys": ["lawyer", "courtroom"],
+    "courtroom": ["lawyer", "courtroom"],
+    "police": ["police", "detective"],
+    "detective": ["police", "detective"],
+    "detectives": ["police", "detective"],
+    "school": ["high school"],
+    "schools": ["high school"],
+    "high school": ["high school"],
+    "superhero": ["superhero"],
+    "superheroes": ["superhero"],
+    "pirate": ["pirate"],
+    "pirates": ["pirate"],
+}
+
+async def _fetch_smart_search_items(
+    media_type: str,
+    query: str,
+    filters: dict,
+    kids: bool = False,
+) -> list[dict]:
+    _ensure_imdb_map_loaded()
+    tmdb_type = "movie" if media_type == "movie" else "tv"
+
+    async def _fetch_discover():
+        if filters.get("media_type_hint") and filters["media_type_hint"] != media_type:
+            return [], [], []
+
+        timeout = aiohttp.ClientTimeout(total=14.0)
+        async with aiohttp.ClientSession(timeout=timeout) as session:
+            tmdb = TMDBApi(session)
+
+            with_people = None
+            if filters.get("person"):
+                p_enc = urllib.parse.quote(filters["person"])
+                p_data = await tmdb._get_json(
+                    f"search/person?query={p_enc}&language=pt-BR",
+                    f"search person {filters['person']}",
+                )
+                if isinstance(p_data, dict) and p_data.get("results"):
+                    top_p = p_data["results"][0]
+                    pop = float(top_p.get("popularity", 0) or 0)
+                    dept = top_p.get("known_for_department")
+                    if pop >= 1.0 or dept in ("Acting", "Directing"):
+                        with_people = top_p.get("id")
+                if not with_people:
+                    p_toks = [w for w in strip_accents(filters["person"]).lower().split() if w not in STOPWORDS]
+                    if p_toks:
+                        extra_theme = " ".join(p_toks)
+                        curr_theme = filters.get("theme_query") or ""
+                        filters["theme_query"] = (curr_theme + " " + extra_theme).strip()
+            elif filters.get("person_candidate"):
+                cand = filters["person_candidate"]
+                p_enc = urllib.parse.quote(cand)
+                p_data = await tmdb._get_json(
+                    f"search/person?query={p_enc}&language=pt-BR",
+                    f"search person candidate {cand}",
+                )
+                matched_id = None
+                if isinstance(p_data, dict) and p_data.get("results"):
+                    cand_words = [w for w in strip_accents(cand).lower().split() if w]
+                    for pr in p_data["results"]:
+                        dept = pr.get("known_for_department")
+                        pop = float(pr.get("popularity", 0) or 0)
+                        if dept in ("Acting", "Directing") and pop >= 5.0:
+                            pr_name = strip_accents(pr.get("name", "")).lower()
+                            if cand_words and all(w in pr_name for w in cand_words):
+                                matched_id = pr.get("id")
+                                break
+                if matched_id:
+                    with_people = matched_id
+                else:
+                    c_tokens = [w for w in strip_accents(cand).lower().split() if w not in STOPWORDS]
+                    if c_tokens:
+                        extra_theme = " ".join(c_tokens)
+                        curr_theme = filters.get("theme_query") or ""
+                        filters["theme_query"] = (curr_theme + " " + extra_theme).strip()
+
+            concepts: list[list[int]] = []
+            concept_words: list[str] = []
+
+            # 1. Palavra-chave primária se informada
+            if filters.get("keyword"):
+                kw_raw = filters["keyword"].lower()
+                k_ids = await _get_keyword_candidates(tmdb, kw_raw)
+                if not k_ids:
+                    kid = await _get_keyword_id(tmdb, kw_raw)
+                    if kid:
+                        k_ids = [kid]
+                if k_ids:
+                    concepts.append(k_ids)
+                    concept_words.append(kw_raw)
+
+            # 2. Tradução contextual da frase inteira (Item 2)
+            raw_q = filters.get("raw_query") or query
+            trans_en = await _translate_pt_en(raw_q)
+
+            MEDIA_WORDS = {"movie", "movies", "film", "films", "series", "serie", "tv", "show", "shows", "anime", "animes", "cartoon", "cartoons", "animation"}
+            STOP_EN = {"a", "an", "the", "of", "in", "on", "at", "with", "about", "who", "which", "that", "always", "day", "from", "for", "to", "and", "by"}
+
+            GENERIC_WORDS = {"guy", "cara", "wakes", "acorda", "same", "mesmo", "day", "dia", "sempre", "always", "one", "two", "man", "woman", "person", "people", "thing", "things"}
+            COUNTRY_WORDS = {"brazilian", "brazil", "national", "japanese", "japan", "american", "korean", "british", "french", "spanish", "german", "italian", "chinese"}
+            GENRE_WORDS = {"comedy", "comedies", "romance", "romantic", "horror", "action", "adventure", "drama", "animation", "thriller", "fantasy", "crime", "war", "documentary", "musical", "mystery", "western", "sci-fi", "scifi"}
+
+            en_words = [
+                w for w in re.findall(r"[a-z0-9]+", trans_en.lower())
+                if w not in MEDIA_WORDS and w not in STOP_EN and not re.match(r"^\d{2,4}s?$", w)
+            ]
+
+            # Se pessoa foi identificada, não traduz o nome dela como tema
+            if with_people and filters.get("person"):
+                p_lower_words = [w.lower() for w in filters["person"].split()]
+                en_words = [w for w in en_words if w not in p_lower_words]
+            if filters.get("epoch"):
+                ep_label = filters["epoch"].get("label", "")
+                ep_words = [w.lower() for w in ep_label.split()]
+                en_words = [w for w in en_words if w not in ep_words and not w.isdigit() and not re.match(r"^\d{2,4}s?$", w)]
+            if filters.get("origin_country") or filters.get("original_language"):
+                en_words = [w for w in en_words if w not in COUNTRY_WORDS]
+            if filters.get("keyword"):
+                en_words = [w for w in en_words if w not in GENERIC_WORDS]
+            if filters.get("genres"):
+                en_words = [w for w in en_words if w not in GENRE_WORDS]
+
+            # 3. Item 1: Candidatos de keyword
+            # Tente bigramas primeiro (prefira o bigrama quando existir como keyword)
+            used_indices = set()
+            if len(en_words) >= 2:
+                for i in range(len(en_words) - 1):
+                    bg = f"{en_words[i]} {en_words[i+1]}"
+                    bg_ids = await _get_keyword_candidates(tmdb, bg)
+                    if not bg_ids:
+                        rev_bg = f"{en_words[i+1]} {en_words[i]}"
+                        bg_ids = await _get_keyword_candidates(tmdb, rev_bg)
+                        if bg_ids:
+                            bg = rev_bg
+                    if bg_ids:
+                        if bg_ids not in concepts:
+                            concepts.append(bg_ids)
+                            concept_words.append(bg)
+                            used_indices.add(i)
+                            used_indices.add(i + 1)
+
+            # Sinônimos de domínio para palavras não usadas em bigramas
+            norm_q = strip_accents(raw_q).lower()
+            domain_covered = set()
+            for pt_w, syns in DOMAIN_SYNONYMS.items():
+                if re.search(rf"\b{re.escape(pt_w)}\b", norm_q):
+                    matching_indices = [idx for idx, w in enumerate(en_words) if w in syns]
+                    if matching_indices and all(idx in used_indices for idx in matching_indices):
+                        continue
+                    syn_concept_ids: list[int] = []
+                    for syn in syns:
+                        s_ids = await _get_keyword_candidates(tmdb, syn)
+                        if s_ids:
+                            for sid in s_ids:
+                                if sid not in syn_concept_ids:
+                                    syn_concept_ids.append(sid)
+                            domain_covered.add(syn)
+                            for w in syn.split():
+                                domain_covered.add(w)
+                    if syn_concept_ids and syn_concept_ids not in concepts:
+                        concepts.append(syn_concept_ids)
+                        concept_words.append("/".join(syns))
+                        for idx in matching_indices:
+                            used_indices.add(idx)
