diff --git a/comet/services/meta_ptbr.py b/comet/services/meta_ptbr.py
new file mode 100644
index 0000000..10fda00
--- /dev/null
+++ b/comet/services/meta_ptbr.py
@@ -0,0 +1,435 @@
+import asyncio
+import copy
+import re
+import time
+import aiohttp
+
+from comet.core.logger import logger
+from comet.metadata.tmdb import TMDBApi
+from comet.services.catalogs import PROVIDERS
+
+_PROVIDER_SHORT_NAMES = {
+    info[1]: info[0] for info in PROVIDERS.values()
+}
+
+_GENERIC_EPISODE_RE = re.compile(
+    r"^(?:epis[oó]dio|episode|cap[ií]tulo)\s+\d+$", re.IGNORECASE
+)
+
+_META_CACHE: dict[tuple[str, str], tuple[float, dict]] = {}
+_META_CACHE_TTL = 12 * 3600.0  # 12 hours
+_META_CACHE_MAX = 500
+
+
+_RATING_ICON = {"10": "🔵", "12": "🟡", "14": "🟠", "16": "🔴", "18": "⚫"}
+
+def _is_generic_title(title: str) -> bool:
+    if not title:
+        return True
+    return bool(_GENERIC_EPISODE_RE.match(title.strip()))
+
+
+def _apply_tmdb_logo_and_trailer(base_meta: dict, tmdb_data: dict) -> None:
+    # 1. Logo do título: pt -> en -> null; maior vote_average; ignora .svg
+    images = tmdb_data.get("images")
+    if isinstance(images, dict):
+        logos = images.get("logos")
+        if isinstance(logos, list):
+            valid_logos = [
+                l
+                for l in logos
+                if isinstance(l, dict)
+                and l.get("file_path")
+                and not str(l["file_path"]).lower().endswith(".svg")
+            ]
+            chosen_logo = None
+            for target_lang in ("pt", "en", None):
+                candidates = [
+                    l
+                    for l in valid_logos
+                    if (
+                        l.get("iso_639_1") == target_lang
+                        or (
+                            target_lang is None
+                            and l.get("iso_639_1") in (None, "null", "")
+                        )
+                    )
+                ]
+                if candidates:
+                    chosen_logo = max(
+                        candidates,
+                        key=lambda x: (
+                            x.get("vote_average") or 0.0,
+                            x.get("vote_count") or 0,
+                        ),
+                    )
+                    break
+            if chosen_logo and chosen_logo.get("file_path"):
+                base_meta["logo"] = (
+                    f"https://image.tmdb.org/t/p/w500{chosen_logo['file_path']}"
+                )
+
+    # 2. Trailer em PT-BR: Trailer pt -> Teaser pt -> Trailer en -> Teaser en
+    videos_obj = tmdb_data.get("videos")
+    if isinstance(videos_obj, dict):
+        videos = videos_obj.get("results")
+        if isinstance(videos, list):
+            yt_videos = [
+                v
+                for v in videos
+                if isinstance(v, dict)
+                and v.get("site") == "YouTube"
+                and v.get("key")
+            ]
+            chosen_vid = None
+            for req_type, req_lang in (
+                ("Trailer", "pt"),
+                ("Teaser", "pt"),
+                ("Trailer", "en"),
+                ("Teaser", "en"),
+            ):
+                matches = [
+                    v
+                    for v in yt_videos
+                    if v.get("type") == req_type and v.get("iso_639_1") == req_lang
+                ]
+                if matches:
+                    chosen_vid = matches[0]
+                    break
+
+            if chosen_vid:
+                vid_name = chosen_vid.get("name") or "Trailer"
+                vid_key = chosen_vid["key"]
+                base_meta["trailerStreams"] = [{"title": vid_name, "ytId": vid_key}]
+                base_meta["trailers"] = [{"source": vid_key, "type": "Trailer"}]
+
+
+def _extract_movie_rating(tmdb_movie: dict) -> str | None:
+    release_dates = tmdb_movie.get("release_dates")
+    if not isinstance(release_dates, dict):
+        return None
+    results = release_dates.get("results")
+    if not isinstance(results, list):
+        return None
+    for r in results:
+        if isinstance(r, dict) and r.get("iso_3166_1") == "BR":
+            rds = r.get("release_dates")
+            if isinstance(rds, list):
+                for rd in rds:
+                    if isinstance(rd, dict):
+                        cert = rd.get("certification")
+                        if cert and str(cert).strip():
+                            c = str(cert).strip()
+                            if c.upper() in ("L", "LIVRE"):
+                                return "🟢 Livre"
+                            return f"{_RATING_ICON.get(str(c).strip(), '🔞')} {c}"
+    return None
+
+
+def _extract_series_rating(tmdb_tv: dict) -> str | None:
+    content_ratings = tmdb_tv.get("content_ratings")
+    if not isinstance(content_ratings, dict):
+        return None
+    results = content_ratings.get("results")
+    if not isinstance(results, list):
+        return None
+    for r in results:
+        if isinstance(r, dict) and r.get("iso_3166_1") == "BR":
+            rating = r.get("rating")
+            if rating and str(rating).strip():
+                c = str(rating).strip()
+                if c.upper() in ("L", "LIVRE"):
+                    return "🟢 Livre"
+                return f"{_RATING_ICON.get(str(c).strip(), '🔞')} {c}"
+    return None
+
+
+def _extract_watch_providers(tmdb_data: dict) -> str | None:
+    wp = tmdb_data.get("watch/providers")
+    if not isinstance(wp, dict):
+        return None
+    results = wp.get("results")
+    if not isinstance(results, dict):
+        return None
+    br = results.get("BR")
+    if not isinstance(br, dict):
+        return None
+    flatrate = br.get("flatrate")
+    if not isinstance(flatrate, list) or not flatrate:
+        return None
+
+    names = []
+    seen = set()
+    for item in flatrate:
+        if not isinstance(item, dict):
+            continue
+        pid = item.get("provider_id")
+        pname = _PROVIDER_SHORT_NAMES.get(pid) or item.get("provider_name")
+        if not pname or not str(pname).strip():
+            continue
+        pname_str = str(pname).strip()
+        if "with ads" in pname_str.lower():
+            continue
+        if pname_str not in seen:
+            seen.add(pname_str)
+            names.append(pname_str)
+        if len(names) == 3:
+            break
+
+    if names:
+        return f"📺 {', '.join(names)}"
+    return None
+
+
+def _build_rich_description(
+    rating_badge: str | None,
+    providers_badge: str | None,
+    overview: str | None,
+    base_description: str | None,
+) -> str:
+    parts = []
+    if rating_badge:
+        parts.append(rating_badge)
+    if providers_badge:
+        parts.append(providers_badge)
+
+    first_line = " · ".join(parts) if parts else ""
+    synopsis = (overview or "").strip() or (base_description or "").strip()
+
+    if first_line and synopsis:
+        return f"{first_line}\n\n{synopsis}"
+    elif first_line:
+        return first_line
+    return synopsis
+
+
+def _format_runtime(runtime_minutes: int | float | None) -> str | None:
+    if not runtime_minutes:
+        return None
+    try:
+        val = int(runtime_minutes)
+    except (ValueError, TypeError):
+        return None
+    if val <= 0:
+        return None
+    h = val // 60
+    m = val % 60
+    if h > 0 and m > 0:
+        return f"{h}h {m}min"
+    elif h > 0:
+        return f"{h}h"
+    else:
+        return f"{m}min"
+
+
+def _save_to_cache(cache_key: tuple[str, str], meta: dict) -> None:
+    while len(_META_CACHE) >= _META_CACHE_MAX:
+        oldest_key = min(_META_CACHE.keys(), key=lambda k: _META_CACHE[k][0])
+        _META_CACHE.pop(oldest_key, None)
+    _META_CACHE[cache_key] = (time.time(), copy.deepcopy(meta))
+
+
+async def get_meta_ptbr(media_type: str, media_id: str) -> dict | None:
+    if media_type not in ("movie", "series") or not media_id.startswith("tt"):
+        return None
+
+    cache_key = (media_type, media_id)
+    now = time.time()
+    if cache_key in _META_CACHE:
+        ts, cached = _META_CACHE[cache_key]
+        if now - ts < _META_CACHE_TTL:
+            return copy.deepcopy(cached)
+        _META_CACHE.pop(cache_key, None)
+
+    # 1. Fetch Cinemeta base
+    timeout = aiohttp.ClientTimeout(total=8.0)
+    cinemeta_url = f"https://v3-cinemeta.strem.io/meta/{media_type}/{media_id}.json"
+    try:
+        async with aiohttp.ClientSession(timeout=timeout) as session:
+            async with session.get(cinemeta_url) as resp:
+                if resp.status != 200:
+                    logger.warning(
+                        f"Cinemeta meta HTTP {resp.status} for {media_id}"
+                    )
+                    return None
+                data = await resp.json()
+                if not isinstance(data, dict) or not isinstance(data.get("meta"), dict):
+                    return None
+                base_meta = data["meta"]
+    except Exception as e:
+        logger.warning(f"Cinemeta fetch error for {media_id}: {e}")
+        return None
+
+    # 2. TMDB overlay
+    try:
+        async with aiohttp.ClientSession(timeout=timeout) as session:
+            tmdb = TMDBApi(session)
+            tmdb_id = await tmdb.get_tmdb_id_from_imdb(media_id, media_type)
+            if not tmdb_id:
+                logger.info(
+                    f"TMDB ID not found for {media_id}, returning Cinemeta meta"
+                )
+                _save_to_cache(cache_key, base_meta)
+                return copy.deepcopy(base_meta)
+
+            if media_type == "movie":
+                tmdb_movie = await tmdb._get_json(
+                    f"movie/{tmdb_id}?language=pt-BR&append_to_response=images,videos,watch/providers,release_dates&include_image_language=pt,en,null&include_video_language=pt,en",
+                    f"movie {tmdb_id}",
+                )
+                if isinstance(tmdb_movie, dict):
+                    tmdb_name = tmdb_movie.get("title") or tmdb_movie.get("name")
+                    if tmdb_name and tmdb_name.strip():
+                        base_meta["name"] = tmdb_name.strip()
+
+                    rating_badge = _extract_movie_rating(tmdb_movie)
+                    providers_badge = _extract_watch_providers(tmdb_movie)
+                    base_meta["description"] = _build_rich_description(
+                        rating_badge,
+                        providers_badge,
+                        tmdb_movie.get("overview"),
+                        base_meta.get("description"),
+                    )
+
+                    formatted_runtime = _format_runtime(tmdb_movie.get("runtime"))
+                    if formatted_runtime:
+                        base_meta["runtime"] = formatted_runtime
+
+                    backdrop_path = tmdb_movie.get("backdrop_path")
+                    if backdrop_path:
+                        bp = (
+                            backdrop_path
+                            if backdrop_path.startswith("/")
+                            else f"/{backdrop_path}"
+                        )
+                        base_meta["background"] = (
+                            f"https://image.tmdb.org/t/p/original{bp}"
+                        )
+
+                    poster_path = tmdb_movie.get("poster_path")
+                    if poster_path:
+                        base_meta["poster"] = (
+                            f"https://image.tmdb.org/t/p/w500{poster_path}"
+                        )
+                    genres = tmdb_movie.get("genres")
+                    if isinstance(genres, list) and genres:
+                        base_meta["genres"] = [
+                            g["name"]
+                            for g in genres
+                            if isinstance(g, dict) and g.get("name")
+                        ]
+                    _apply_tmdb_logo_and_trailer(base_meta, tmdb_movie)
+            elif media_type == "series":
+                tmdb_tv = await tmdb._get_json(
+                    f"tv/{tmdb_id}?language=pt-BR&append_to_response=images,videos,watch/providers,content_ratings&include_image_language=pt,en,null&include_video_language=pt,en",
+                    f"tv {tmdb_id}",
+                )
+                if isinstance(tmdb_tv, dict):
+                    tmdb_name = tmdb_tv.get("name") or tmdb_tv.get("title")
+                    if tmdb_name and tmdb_name.strip():
+                        base_meta["name"] = tmdb_name.strip()
+
+                    rating_badge = _extract_series_rating(tmdb_tv)
+                    providers_badge = _extract_watch_providers(tmdb_tv)
+                    base_meta["description"] = _build_rich_description(
+                        rating_badge,
+                        providers_badge,
+                        tmdb_tv.get("overview"),
+                        base_meta.get("description"),
+                    )
+
+                    backdrop_path = tmdb_tv.get("backdrop_path")
+                    if backdrop_path:
+                        bp = (
+                            backdrop_path
+                            if backdrop_path.startswith("/")
+                            else f"/{backdrop_path}"
+                        )
+                        base_meta["background"] = (
+                            f"https://image.tmdb.org/t/p/original{bp}"
+                        )
+
+                    poster_path = tmdb_tv.get("poster_path")
+                    if poster_path:
+                        base_meta["poster"] = (
+                            f"https://image.tmdb.org/t/p/w500{poster_path}"
+                        )
+                    genres = tmdb_tv.get("genres")
+                    if isinstance(genres, list) and genres:
+                        base_meta["genres"] = [
+                            g["name"]
+                            for g in genres
+                            if isinstance(g, dict) and g.get("name")
+                        ]
+                    _apply_tmdb_logo_and_trailer(base_meta, tmdb_tv)
+
+                # Series episodes overlay
+                cinemeta_videos = base_meta.get("videos")
+                if isinstance(cinemeta_videos, list) and cinemeta_videos:
+                    seasons_set = set()
+                    for v in cinemeta_videos:
+                        if isinstance(v, dict):
+                            s = v.get("season")
+                            try:
+                                s_int = int(s)
+                                if s_int >= 1:
+                                    seasons_set.add(s_int)
+                            except (TypeError, ValueError):
+                                pass
+
+                    sem = asyncio.Semaphore(5)
+
+                    async def fetch_and_overlay_season(season_num: int):
+                        async with sem:
+                            s_data = await tmdb._get_json(
+                                f"tv/{tmdb_id}/season/{season_num}?language=pt-BR",
+                                f"tv season {tmdb_id}:{season_num}",
+                            )
+                            if not isinstance(s_data, dict):
+                                return
+                            tmdb_episodes = s_data.get("episodes")
+                            if not isinstance(tmdb_episodes, list):
+                                return
+
+                            cm_season_videos = [
+                                v
+                                for v in cinemeta_videos
+                                if isinstance(v, dict) and v.get("season") == season_num
+                            ]
+                            if len(tmdb_episodes) != len(cm_season_videos):
+                                return
+
+                            tmdb_ep_map = {}
+                            for ep in tmdb_episodes:
+                                if isinstance(ep, dict):
+                                    ep_num = ep.get("episode_number")
+                                    if ep_num is not None:
+                                        tmdb_ep_map[ep_num] = ep
+
+                            for v in cm_season_videos:
+                                ep_num = v.get("episode")
+                                tmdb_ep = tmdb_ep_map.get(ep_num)
+                                if tmdb_ep:
+                                    ep_name = (tmdb_ep.get("name") or "").strip()
+                                    if ep_name and not _is_generic_title(ep_name):
+                                        v["name"] = ep_name
+                                        v["title"] = ep_name
+                                    ep_overview = (
+                                        tmdb_ep.get("overview") or ""
+                                    ).strip()
+                                    if ep_overview:
+                                        v["overview"] = ep_overview
+                                        if "description" in v:
+                                            v["description"] = ep_overview
+
+                    await asyncio.gather(
+                        *[fetch_and_overlay_season(s) for s in sorted(seasons_set)],
+                        return_exceptions=True,
+                    )
+    except Exception as e:
+        logger.warning(
+            f"TMDB overlay error for {media_id}, returning Cinemeta meta: {e}"
+        )
+
+    _save_to_cache(cache_key, base_meta)
+    return copy.deepcopy(base_meta)
