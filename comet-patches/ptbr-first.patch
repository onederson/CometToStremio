+import collections
+import asyncio
+import base64
+from datetime import datetime, timezone, timedelta
+import gzip
+import hashlib
+import io
+import math
+import os
+import re
+import time
+from typing import Any
+import zipfile
+from curl_cffi.requests import AsyncSession
+
+from comet.core.logger import logger
+from comet.core.models import settings
+
+SUBS_CACHE_DIR = "/opt/comet/data/subs_cache"
+RAW_CACHE_TTL = 6 * 3600
+DISK_CACHE_TTL = 30 * 86400
+
+_RAW_CACHE: dict[tuple, tuple] = {}
+_RAW_CACHE_LOCK = asyncio.Lock()
+
+_OS_TOKEN: str | None = None
+_OS_TOKEN_EXPIRES_AT: float = 0.0
+_OS_TOKEN_LOCK = asyncio.Lock()
+
+_OS_REMAINING: int | None = None
+_OS_RESET_AT: datetime | None = None
+
+
+def _parse_reset_time(val: Any) -> datetime | None:
+    if not val:
+        return None
+    if isinstance(val, (int, float)):
+        return datetime.fromtimestamp(val, tz=timezone.utc)
+    if isinstance(val, str):
+        val = val.strip()
+        for fmt in (
+            "%Y-%m-%d %H:%M:%S",
+            "%Y-%m-%dT%H:%M:%S",
+            "%Y-%m-%dT%H:%M:%SZ",
+            "%Y-%m-%dT%H:%M:%S.%fZ",
+        ):
+            try:
+                dt = datetime.strptime(val, fmt)
+                return dt.replace(tzinfo=timezone.utc)
+            except ValueError:
+                pass
+        try:
+            dt = datetime.fromisoformat(val.replace("Z", "+00:00"))
+            if dt.tzinfo is None:
+                dt = dt.replace(tzinfo=timezone.utc)
+            return dt.astimezone(timezone.utc)
+        except Exception:
+            pass
+    return None
+
+
+def _update_os_quota(status_code: int, data: dict):
+    global _OS_REMAINING, _OS_RESET_AT
+    remaining = data.get("remaining")
+    reset_val = data.get("reset_time_utc") or data.get("reset_time")
+    reset_dt = _parse_reset_time(reset_val)
+    if not reset_dt:
+        now = datetime.now(timezone.utc)
+        reset_dt = (now + timedelta(days=1)).replace(
+            hour=0, minute=0, second=0, microsecond=0
+        )
+
+    if status_code == 406 or (remaining is not None and int(remaining) <= 0):
+        _OS_REMAINING = 0
+        _OS_RESET_AT = reset_dt
+        logger.warning(
+            f"OpenSubtitles quota exhausted (status={status_code}, remaining={remaining}) until {_OS_RESET_AT.isoformat()}"
+        )
+    elif status_code == 200 and remaining is not None:
+        try:
+            _OS_REMAINING = int(remaining)
+        except (ValueError, TypeError):
+            pass
+        _OS_RESET_AT = reset_dt
+
+
+def _is_os_exhausted() -> bool:
+    if _OS_RESET_AT:
+        now = datetime.now(timezone.utc)
+        if now < _OS_RESET_AT and (_OS_REMAINING is not None and _OS_REMAINING <= 0):
+            return True
+    return False
+
+
+def get_os_remaining() -> int | None:
+    return _OS_REMAINING
+
+
+def _is_cached(provider: str, sub_id: str, season: int, episode: int) -> bool:
+    hash_key = hashlib.sha1(f"{sub_id}{season}{episode}".encode("utf-8")).hexdigest()
+    cache_file = os.path.join(SUBS_CACHE_DIR, f"{provider}-{hash_key}.srt")
+    if os.path.exists(cache_file):
+        try:
+            mtime = os.path.getmtime(cache_file)
+            if (time.time() - mtime) < DISK_CACHE_TTL:
+                return True
+        except Exception:
+            pass
+    return False
+
+
+def _ass_to_srt(ass_text: str) -> str:
+    lines = ass_text.replace("\r\n", "\n").replace("\r", "\n").splitlines()
+    dialogues = []
+    format_indices = {}
+    in_events = False
+
+    for line in lines:
+        line_clean = line.strip()
+        if line_clean.lower() == "[events]":
+            in_events = True
+            continue
+        if in_events:
+            if line_clean.lower().startswith("format:"):
+                headers = [h.strip().lower() for h in line_clean[7:].split(",")]
+                format_indices = {h: i for i, h in enumerate(headers)}
+            elif line_clean.lower().startswith("dialogue:"):
+                payload = line_clean[9:].strip()
+                num_fields = len(format_indices) if format_indices else 10
+                parts = payload.split(",", num_fields - 1)
+                start = None
+                end = None
+                text = ""
+                if (
+                    format_indices
+                    and "start" in format_indices
+                    and "end" in format_indices
+                    and "text" in format_indices
+                ):
+                    si = format_indices["start"]
+                    ei = format_indices["end"]
+                    ti = format_indices["text"]
+                    if len(parts) > max(si, ei, ti):
+                        start = parts[si].strip()
+                        end = parts[ei].strip()
+                        text = parts[ti].strip()
+                else:
+                    if len(parts) >= 10:
+                        start = parts[1].strip()
+                        end = parts[2].strip()
+                        text = parts[9].strip()
+                if start and end and text:
+                    dialogues.append((start, end, text))
+
+    def convert_time(t_str: str) -> str:
+        parts = t_str.split(":")
+        if len(parts) == 3:
+            h, m, rest = parts
+        elif len(parts) == 2:
+            h, m, rest = "0", parts[0], parts[1]
+        else:
+            return "00:00:00,000"
+        if "." in rest:
+            s, cs = rest.split(".", 1)
+            ms = (cs + "000")[:3]
+        else:
+            s, ms = rest, "000"
+        return f"{int(h):02d}:{int(m):02d}:{int(s):02d},{ms}"
+
+    srt_blocks = []
+    idx = 1
+    for start, end, text in dialogues:
+        clean_text = re.sub(r"\{[^}]*\}", "", text)
+        clean_text = (
+            clean_text.replace(r"\N", "\n")
+            .replace(r"\n", "\n")
+            .replace(r"\h", " ")
+            .strip()
+        )
+        if not clean_text:
+            continue
+        start_srt = convert_time(start)
+        end_srt = convert_time(end)
+        srt_blocks.append(f"{idx}\n{start_srt} --> {end_srt}\n{clean_text}\n")
+        idx += 1
+    return "\n".join(srt_blocks)
+
+
+def _vtt_to_srt(vtt_text: str) -> str:
+    lines = vtt_text.replace("\r\n", "\n").replace("\r", "\n").splitlines()
+    srt_blocks = []
+    idx = 1
+    i = 0
+    while i < len(lines):
+        line = lines[i].strip()
+        if "-->" in line:
+            parts = line.split("-->")
+            start = parts[0].strip().split()[0].replace(".", ",")
+            end = parts[1].strip().split()[0].replace(".", ",")
+            if start.count(":") == 1:
+                start = "00:" + start
+            if end.count(":") == 1:
+                end = "00:" + end
+            i += 1
+            text_lines = []
+            while i < len(lines) and lines[i].strip():
+                t = re.sub(r"<[^>]+>", "", lines[i].strip())
+                if t:
+                    text_lines.append(t)
+                i += 1
+            if text_lines:
+                srt_blocks.append(
+                    f"{idx}\n{start} --> {end}\n" + "\n".join(text_lines) + "\n"
+                )
+                idx += 1
+        i += 1
+    return "\n".join(srt_blocks)
+
+
+def _score_release(
+    rel: str,
+    fn: str | None,
+    is_series: bool,
+    season: int,
+    episode: int,
+    is_pack: bool,
+    downloads: int,
+    from_trusted: bool,
+    moviehash_match: bool,
+) -> tuple[float, bool] | None:
+    score = 0.0
+
+    if is_series:
+        ep_matches = re.findall(r"[sS](\d{1,2})[eE](\d{1,2})", rel)
+        if not ep_matches:
+            ep_matches = re.findall(r"\b(\d{1,2})x(\d{1,2})\b", rel)
+        if ep_matches:
+            if any(int(s) == season and int(e) == episode for s, e in ep_matches):
+                score += 50.0
+            else:
+                return None
+        else:
+            score -= 50.0
+
+    if from_trusted:
+        score += 20.0
+
+    score += math.log10(downloads + 1)
+
+    if not fn:
+        return score, False
+
+    if moviehash_match:
+        score += 1000.0
+
+    def _get_group(name: str) -> str | None:
+        base = re.sub(r"\.[a-zA-Z0-9]{2,4}$", "", name.strip())
+        if "-" in base:
+            grp = base.rsplit("-", 1)[1].strip()
+            grp = re.split(r"[\s\[\(\_\.]", grp)[0]
+            if grp:
+                return grp.lower()
+        return None
+
+    grp_fn = _get_group(fn)
+    grp_sub = _get_group(rel)
+    same_group = bool(grp_fn and grp_sub and grp_fn == grp_sub)
+    if same_group:
+        score += 300.0
+
+    def _detect_source(name: str) -> tuple[str | None, str | None]:
+        low = name.lower()
+        for s in ("amzn", "nf", "dsnp", "hmax", "max", "atvp", "pcok", "hulu"):
+            if re.search(rf"\b{s}\b", low):
+                srv = "max" if s == "hmax" else s
+                return srv, "WEB"
+        if re.search(r"\b(web-?dl|webrip|web)\b", low):
+            return None, "WEB"
+        if re.search(r"\b(bluray|bdrip|brrip|remux)\b", low):
+            return None, "BLURAY"
+        if re.search(r"\bhdtv\b", low):
+            return None, "HDTV"
+        return None, None
+
+    srv_fn, cat_fn = _detect_source(fn)
+    srv_sub, cat_sub = _detect_source(rel)
+    same_source = bool(
+        cat_fn is not None and cat_sub is not None and cat_fn == cat_sub
+    )
+    if cat_fn and cat_sub:
+        if srv_fn and srv_sub and srv_fn == srv_sub:
+            score += 150.0
+        elif cat_fn == cat_sub:
+            score += 100.0
+        else:
+            score -= 100.0
+
+    is_exact = bool(moviehash_match or (same_group and same_source))
+
+    def _detect_res(name: str) -> str | None:
+        low = name.lower()
+        for r in ("2160p", "4k", "1080p", "720p", "480p"):
+            if r in low:
+                return "2160p" if r == "4k" else r
+        return None
+
+    res_fn = _detect_res(fn)
+    res_sub = _detect_res(rel)
+    if res_fn and res_sub and res_fn == res_sub:
+        score += 30.0
+
+    title_m = re.split(r"[sS]\d{1,2}[eE]\d{1,2}|\b(19\d\d|20\d\d)\b", fn)
+    title_raw = title_m[0] if title_m else fn
+    title_toks = set(
+        t for t in re.split(r"[^a-zA-Z0-9]+", title_raw.lower()) if t
+    )
+
+    toks_fn = set(
+        t
+        for t in re.split(r"[^a-zA-Z0-9]+", fn.lower())
+        if len(t) > 1 and t not in title_toks
+    )
+    toks_sub = set(
+        t
+        for t in re.split(r"[^a-zA-Z0-9]+", rel.lower())
+        if len(t) > 1 and t not in title_toks
+    )
+    union = toks_fn | toks_sub
+    if union:
+        jaccard = len(toks_fn & toks_sub) / len(union)
+        score += 100.0 * jaccard
+
+    return score, is_exact
+
+
+def _score_item(
+    item: dict,
+    fn: str | None,
+    is_series: bool,
+    season: int,
+    episode: int,
+) -> tuple[float, str, bool] | None:
+    rel_list = item.get("releases") or [item.get("release", "")]
+    best_score = -999999.0
+    best_rel = None
+    best_exact = False
+
+    for rel_name in rel_list:
+        res = _score_release(
+            rel=rel_name,
+            fn=fn,
+            is_series=is_series,
+            season=season,
+            episode=episode,
+            is_pack=bool(item.get("is_pack")),
+            downloads=item.get("downloads", 0),
+            from_trusted=bool(item.get("from_trusted")),
+            moviehash_match=bool(item.get("moviehash_match")),
+        )
+        if res is not None:
+            s, exact = res
+            if s > best_score or (s == best_score and exact and not best_exact):
+                best_score = s
+                best_rel = rel_name
+                best_exact = exact
+
+    if best_rel is None:
+        return None
+
+    # OpenSubtitles disk cache bonus (+40)
+    if item.get("provider") == "opensubtitles":
+        s_code = season if is_series else 0
+        e_code = episode if is_series else 0
+        if _is_cached("opensubtitles", str(item.get("id")), s_code, e_code):
+            best_score += 40.0
+
+    return best_score, best_rel, best_exact
+
+
+async def _fetch_opensubtitles(
+    session: AsyncSession,
+    media_type: str,
+    imdb_id: str,
+    season: int,
+    episode: int,
+    video_hash: str | None,
+) -> list[dict]:
+    if not (
+        settings.OPENSUBTITLES_API_KEY
+        and settings.OPENSUBTITLES_USERNAME
+        and settings.OPENSUBTITLES_PASSWORD
+    ):
+        return []
+
+    headers = {
+        "Api-Key": settings.OPENSUBTITLES_API_KEY,
+        "User-Agent": "CometA71 v1.0",
+        "Content-Type": "application/json",
+        "Accept": "application/json",
+    }
+    clean_id = imdb_id.lower().replace("tt", "").lstrip("0")
+    if not clean_id:
+        return []
+
+    params = {"languages": "pt-br"}
+    if media_type == "series":
+        params["parent_imdb_id"] = clean_id
+        params["season_number"] = season
+        params["episode_number"] = episode
+    else:
+        params["imdb_id"] = clean_id
+
+    if video_hash:
+        params["moviehash"] = video_hash
+
+    try:
+        r = await session.get(
+            "https://api.opensubtitles.com/api/v1/subtitles",
+            headers=headers,
+            params=params,
+            timeout=10.0,
+        )
+        if r.status_code != 200:
+            logger.warning(f"OpenSubtitles search returned status {r.status_code}")
+            return []
+        data = r.json().get("data", [])
+        items = []
+        for entry in data:
+            attr = entry.get("attributes", {})
+            if attr.get("ai_translated") or attr.get("machine_translated"):
+                continue
+            files = attr.get("files", [])
+            if not files or not files[0].get("file_id"):
+                continue
+            file_id = str(files[0]["file_id"])
+            release = attr.get("release") or ""
+            items.append(
+                {
+                    "provider": "opensubtitles",
+                    "id": file_id,
+                    "release": release,
+                    "downloads": int(attr.get("download_count") or 0),
+                    "from_trusted": bool(attr.get("from_trusted")),
+                    "moviehash_match": bool(attr.get("moviehash_match")),
+                    "season": season,
+                    "episode": episode,
+                }
+            )
+        return items
+    except Exception as e:
+        logger.warning(f"OpenSubtitles search failed: {type(e).__name__}")
+        return []
+
+
+async def _fetch_subsource(
+    session: AsyncSession,
+    media_type: str,
+    imdb_id: str,
+    season: int,
+    episode: int,
+    language: str = "brazilian_portuguese",
+) -> list[dict]:
+    if not settings.SUBSOURCE_API_KEY:
+        return []
+
+    headers = {"X-API-Key": settings.SUBSOURCE_API_KEY}
+    search_url = f"https://api.subsource.net/api/v1/movies/search?searchType=imdb&imdb={imdb_id}"
+    if media_type == "series":
+        search_url += f"&season={season}"
+
+    try:
+        r = await session.get(search_url, headers=headers, timeout=10.0)
+        if r.status_code != 200:
+            logger.warning(f"SubSource movie search returned status {r.status_code}")
+            return []
+        movie_data = r.json().get("data", [])
+        movie_id = None
+        if media_type == "series":
+            for m in movie_data:
+                if str(m.get("season")) == str(season):
+                    movie_id = m.get("movieId")
+                    break
+        else:
+            if movie_data:
+                movie_id = movie_data[0].get("movieId")
+
+        if not movie_id:
+            return []
+
+        subs_url = f"https://api.subsource.net/api/v1/subtitles?movieId={movie_id}&language={language}"
+        r_subs = await session.get(subs_url, headers=headers, timeout=10.0)
+        if r_subs.status_code != 200:
+            logger.warning(f"SubSource subtitles search returned status {r_subs.status_code}")
+            return []
+
+        res_json = r_subs.json()
+        raw_subs = res_json.get("data", [])
+        pages = int(res_json.get("pagination", {}).get("pages") or 1)
+        for page in range(2, min(pages + 1, 4)):
+            try:
+                r_p = await session.get(
+                    f"{subs_url}&page={page}",
+                    headers=headers,
+                    timeout=10.0,
+                )
+                if r_p.status_code == 200:
+                    raw_subs.extend(r_p.json().get("data", []))
+            except Exception:
+                break
+
+        items = []
+        for entry in raw_subs:
+            sub_id = entry.get("subtitleId")
+            if not sub_id:
+                continue
+            rel_info = entry.get("releaseInfo", [])
+            if isinstance(rel_info, str):
+                rel_info = [rel_info]
+            elif not isinstance(rel_info, list):
+                rel_info = []
+
+            if media_type == "series":
+                has_target = False
+                has_other = False
+                for r_name in rel_info:
+                    matches = re.findall(r"[sS](\d{1,2})[eE](\d{1,2})", r_name)
+                    if not matches:
+                        matches = re.findall(r"\b(\d{1,2})x(\d{1,2})\b", r_name)
+                    for s_str, e_str in matches:
+                        if int(s_str) == season and int(e_str) == episode:
+                            has_target = True
+                        else:
+                            has_other = True
+                if has_target:
+                    is_pack = False
+                elif not has_target and not has_other:
+                    is_pack = True
+                else:
+                    continue
+            else:
+                is_pack = False
+
+            first_rel = rel_info[0] if rel_info else ""
+            items.append(
+                {
+                    "provider": "subsource",
+                    "id": str(sub_id),
+                    "release": first_rel,
+                    "releases": rel_info,
+                    "downloads": int(entry.get("downloads") or 0),
+                    "from_trusted": False,
+                    "moviehash_match": False,
+                    "season": season,
+                    "episode": episode,
+                    "is_pack": is_pack,
+                }
+            )
+        return items
+    except Exception as e:
+        logger.warning(f"SubSource search failed: {type(e).__name__}")
+        return []
+
+
+async def _fetch_subdl(
+    session: AsyncSession,
+    media_type: str,
+    imdb_id: str,
+    season: int,
+    episode: int,
+    languages: str = "BR_PT",
+) -> list[dict]:
+    if not settings.SUBDL_API_KEY:
+        return []
+
+    params = {
+        "api_key": settings.SUBDL_API_KEY,
+        "imdb_id": imdb_id,
+        "type": "tv" if media_type == "series" else "movie",
+        "languages": languages,
+        "subs_per_page": 30,
+    }
+    if media_type == "series":
+        params["season_number"] = season
+        params["episode_number"] = episode
+
+    try:
+        r = await session.get(
+            "https://api.subdl.com/api/v1/subtitles",
+            params=params,
+            timeout=10.0,
+        )
+        if r.status_code != 200:
+            logger.warning(f"SubDL search returned status {r.status_code}")
+            return []
+        subdl_data = r.json().get("subtitles", [])
+        items = []
+        for entry in subdl_data:
+            url_val = entry.get("url") or ""
+            if not url_val:
+                continue
+            clean_path = url_val.split("?")[0]
+            sub_id = (
+                base64.urlsafe_b64encode(clean_path.encode("utf-8"))
+                .decode("utf-8")
+                .rstrip("=")
+            )
+            items.append(
+                {
+                    "provider": "subdl",
+                    "id": sub_id,
+                    "release": entry.get("release_name") or "",
+                    "downloads": 0,
+                    "from_trusted": False,
+                    "moviehash_match": False,
+                    "season": season,
+                    "episode": episode,
+                    "is_pack": bool(entry.get("full_season")),
+                }
+            )
+        return items
+    except Exception as e:
+        logger.warning(f"SubDL search failed: {type(e).__name__}")
+        return []
