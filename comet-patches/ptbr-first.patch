+                        candidates.append({
+                            "type": "series",
+                            "imdb": imdb_id,
+                            "season": ns,
+                            "episode": ne,
+                            "media_id": ep_media_id,
+                            "name": series_name,
+                            "aired": next_aired,
+                            "is_history": True,
+                        })
+
+                if latest_ep:
+                    ls, le, laired = latest_ep
+                    latest_media_id = f"{imdb_id}:{ls}:{le}"
+                    if (
+                        not next_ep or (ls, le) != next_ep
+                    ) and latest_media_id not in seen_media_ids:
+                        seen_media_ids.add(latest_media_id)
+                        candidates.append({
+                            "type": "series",
+                            "imdb": imdb_id,
+                            "season": ls,
+                            "episode": le,
+                            "media_id": latest_media_id,
+                            "name": series_name,
+                            "aired": laired,
+                            "is_history": True,
+                        })
+        except Exception as exc:
+            logger.warning(f"🌙 Erro ao carregar histórico Stremio: {exc}")
+
+    # b. Top 10 de hoje: os 10 filmes e o S1E1 das 5 primeiras séries
+    try:
+        top_mov = await get_catalog("movie", "comet_top10")
+        top_ser = await get_catalog("series", "comet_top10")
+
+        mov_added = 0
+        for item in top_mov:
+            mid = item.get("id")
+            if mid and isinstance(mid, str) and mid.startswith("tt"):
+                if mid not in seen_media_ids:
+                    seen_media_ids.add(mid)
+                    candidates.append({
+                        "type": "movie",
+                        "imdb": mid,
+                        "season": None,
+                        "episode": None,
+                        "media_id": mid,
+                        "name": item.get("name") or "",
+                        "aired": "",
+                        "is_history": False,
+                    })
+                    mov_added += 1
+                    if mov_added >= 10:
+                        break
+
+        ser_added = 0
+        for item in top_ser:
+            mid = item.get("id")
+            if mid and isinstance(mid, str) and mid.startswith("tt"):
+                ep_mid = f"{mid}:1:1"
+                if ep_mid not in seen_media_ids:
+                    seen_media_ids.add(ep_mid)
+                    candidates.append({
+                        "type": "series",
+                        "imdb": mid,
+                        "season": 1,
+                        "episode": 1,
+                        "media_id": ep_mid,
+                        "name": item.get("name") or "",
+                        "aired": "",
+                        "is_history": False,
+                    })
+                    ser_added += 1
+                    if ser_added >= 5:
+                        break
+    except Exception as exc:
+        logger.warning(f"🌙 Erro ao carregar Top 10: {exc}")
+
+    return candidates[:max_items]
+
+
+async def run_nightly_cycle() -> dict[str, Any]:
+    global _is_running
+    if _is_running:
+        return {"started": False, "status": "already running"}
+
+    async with _run_lock:
+        _is_running = True
+        t0 = time.time()
+        token = settings.PERSONAL_LINK_TOKEN
+        if not token:
+            logger.warning("🌙 Madrugada cancelada: PERSONAL_LINK_TOKEN não configurado")
+            _is_running = False
+            return {"started": False, "error": "no token"}
+
+        port = getattr(settings, "FASTAPI_PORT", 8000) or 8000
+        base_url = f"http://127.0.0.1:{port}"
+
+        timeout = aiohttp.ClientTimeout(total=90.0)
+        items_processed = 0
+        dub_ready_count = 0
+        notified_count = 0
+
+        try:
+            async with aiohttp.ClientSession(timeout=timeout) as session:
+                work_list = await _build_work_list(session)
+                total_items = len(work_list)
+                logger.info(f"🌙 Iniciando rodada da madrugada com {total_items} itens")
+
+                for idx, item in enumerate(work_list):
+                    mem_avail = _get_mem_available_mb()
+                    if mem_avail < 600.0:
+                        logger.warning(
+                            f"🌙 Memória baixa ({mem_avail:.1f} MB < 600 MB), aguardando 60s..."
+                        )
+                        await asyncio.sleep(60)
+                        mem_avail = _get_mem_available_mb()
+                        if mem_avail < 600.0:
+                            logger.warning(
+                                f"🌙 Memória continua baixa ({mem_avail:.1f} MB < 600 MB), interrompendo rodada"
+                            )
+                            break
+
+                    mtype = item["type"]
+                    mid = item["media_id"]
+                    if mtype == "series":
+                        url = f"{base_url}/{token}/stream/series/{mid}.json"
+                    else:
+                        url = f"{base_url}/{token}/stream/movie/{mid}.json"
+
+                    streams: list[dict] = []
+                    try:
+                        async with session.get(url) as resp:
+                            if resp.status == 200:
+                                data = await resp.json()
+                                if isinstance(data, dict):
+                                    streams = data.get("streams") or []
+                            else:
+                                logger.warning(f"🌙 Stream {mid} HTTP {resp.status}")
+                    except asyncio.CancelledError:
+                        raise
+                    except Exception as exc:
+                        logger.warning(
+                            f"🌙 Erro ao buscar stream {mid}: {type(exc).__name__}"
+                        )
+
+                    dub_ready = 1 if any(_is_stream_dub_ready(s) for s in streams) else 0
+                    if dub_ready:
+                        dub_ready_count += 1
+
+                    items_processed += 1
+
+                    if mtype == "series":
+                        try:
+                            row = await database.fetch_one(
+                                "SELECT dub_ready, first_ready_at, notified FROM dub_watch WHERE media_id = :mid",
+                                {"mid": mid},
+                            )
+                            old_dub = row["dub_ready"] if row else 0
+                            old_notified = row["notified"] if row else 0
+                            first_ready = row["first_ready_at"] if row else None
+                            now_ts = int(time.time())
+
+                            if dub_ready == 1 and not first_ready:
+                                first_ready = now_ts
+
+                            should_notify = False
+                            aired_str = item.get("aired") or ""
+                            is_recent = False
+                            if aired_str:
+                                try:
+                                    clean_date = str(aired_str).strip().split("T")[0]
+                                    aired_date = datetime.date.fromisoformat(clean_date)
+                                    diff = (datetime.date.today() - aired_date).days
+                                    if -1 <= diff <= 14:
+                                        is_recent = True
+                                except Exception:
+                                    pass
+
+                            if (
+                                item.get("is_history")
+                                and is_recent
+                                and (old_dub == 0 or row is None)
+                                and dub_ready == 1
+                                and old_notified == 0
+                            ):
+                                should_notify = True
+
+                            new_notified = old_notified
+                            if should_notify:
+                                notified_count += 1
+                                ntfy_topic = getattr(settings, "NTFY_TOPIC", None)
+                                body = f"{item['name']} T{item['season']}E{item['episode']}"
+                                if ntfy_topic:
+                                    try:
+                                        headers = {
+                                            "Title": "🇧🇷 Episódio dublado chegou",
+                                            "Click": f"stremio:///detail/series/{item['imdb']}/{mid}",
+                                        }
+                                        async with session.post(
+                                            f"https://ntfy.sh/{ntfy_topic}",
+                                            data=body.encode("utf-8"),
+                                            headers=headers,
+                                            timeout=aiohttp.ClientTimeout(total=10.0),
+                                        ) as ntfy_resp:
+                                            logger.info(
+                                                f"📢 Aviso dublado enviado (ntfy {ntfy_resp.status}): {body}"
+                                            )
+                                    except Exception as ntfy_err:
+                                        logger.warning(f"Erro ao enviar ntfy: {ntfy_err}")
+                                    new_notified = 1
+                                else:
+                                    logger.info(
+                                        f"📢 Aviso dublado: {body} (sem NTFY_TOPIC, notificação em log)"
+                                    )
+                                    new_notified = 1
+
+                            await database.execute(
+                                """
+                                INSERT INTO dub_watch (media_id, imdb, season, episode, name, dub_ready, aired, first_ready_at, notified)
+                                VALUES (:media_id, :imdb, :season, :episode, :name, :dub_ready, :aired, :first_ready_at, :notified)
+                                ON CONFLICT(media_id) DO UPDATE SET
+                                    dub_ready = :dub_ready,
+                                    name = :name,
+                                    aired = COALESCE(NULLIF(:aired, ''), dub_watch.aired),
+                                    first_ready_at = COALESCE(dub_watch.first_ready_at, :first_ready_at),
+                                    notified = :notified
+                                """,
+                                {
+                                    "media_id": mid,
+                                    "imdb": item["imdb"],
+                                    "season": item["season"],
+                                    "episode": item["episode"],
+                                    "name": item["name"],
+                                    "dub_ready": dub_ready,
+                                    "aired": aired_str,
+                                    "first_ready_at": first_ready,
+                                    "notified": new_notified,
+                                },
+                            )
+                        except Exception as db_exc:
+                            logger.warning(
+                                f"🌙 Erro ao salvar dub_watch para {mid}: {db_exc}"
+                            )
+
+                    if idx < total_items - 1:
+                        await asyncio.sleep(3)
+
+        finally:
+            elapsed = time.time() - t0
+            _is_running = False
+
+            try:
+                _CATALOG_CACHE.clear()
+            except Exception:
+                pass
+
+            logger.info(
+                f"🌙 madrugada: {items_processed} itens, {dub_ready_count} dublados prontos, {notified_count} avisos em {elapsed:.1f}s"
+            )
+
+            now_dt = datetime.datetime.now().astimezone()
+            last_record = {
+                "timestamp": time.time(),
+                "last_run": now_dt.strftime("%Y-%m-%d %H:%M:%S"),
+                "items": items_processed,
+                "dub_ready": dub_ready_count,
+                "notified": notified_count,
+                "duration_seconds": round(elapsed, 1),
+                "status": "OK",
+            }
+            try:
+                _NIGHTLY_LAST_FILE.parent.mkdir(parents=True, exist_ok=True)
+                _NIGHTLY_LAST_FILE.write_text(
+                    json.dumps(last_record, indent=2), encoding="utf-8"
+                )
+            except Exception as e:
+                logger.warning(f"🌙 Erro ao gravar nightly_last.json: {e}")
+
+            return {
+                "started": True,
+                "items": items_processed,
+                "dub_ready": dub_ready_count,
+                "notified": notified_count,
+                "duration": elapsed,
+            }
+
+
+async def _startup_catchup_check():
+    try:
+        delay_s = float(os.getenv("NIGHTLY_STARTUP_DELAY", "1200"))
+        if delay_s > 0:
+            await asyncio.sleep(delay_s)
+
+        last_ts = 0.0
+        if _NIGHTLY_LAST_FILE.is_file():
+            try:
+                data = json.loads(_NIGHTLY_LAST_FILE.read_text(encoding="utf-8"))
+                last_ts = float(data.get("timestamp", 0.0))
+            except Exception:
+                last_ts = 0.0
+
+        now = time.time()
+        if (now - last_ts) > 26 * 3600:
+            logger.info(
+                "🌙 Mais de 26h desde a última rodada da madrugada, executando agora..."
+            )
+            await run_nightly_cycle()
+    except asyncio.CancelledError:
+        pass
+    except Exception as exc:
+        logger.warning(f"🌙 Erro na checagem inicial da madrugada: {exc}")
+
+
+async def start_nightly_service():
+    try:
+        catchup_task = asyncio.create_task(_startup_catchup_check())
+        _tasks.add(catchup_task)
+        catchup_task.add_done_callback(_tasks.discard)
+
+        while True:
+            now = datetime.datetime.now().astimezone()
+            target_hour = getattr(settings, "NIGHTLY_WARM_HOUR", 4)
+            target = now.replace(
+                hour=target_hour, minute=0, second=0, microsecond=0
+            )
+            if target <= now:
+                target += datetime.timedelta(days=1)
+            sleep_secs = (target - now).total_seconds()
+
+            logger.info(
+                f"🌙 Próxima rodada da madrugada agendada para {target.strftime('%Y-%m-%d %H:%M:%S %Z')} (em {sleep_secs/3600:.1f}h)"
+            )
+            await asyncio.sleep(sleep_secs)
+
+            if not is_nightly_running():
+                await run_nightly_cycle()
+    except asyncio.CancelledError:
+        pass
+    except Exception as exc:
+        logger.warning(f"🌙 Serviço da madrugada finalizado com erro: {exc}")
+
+
+@router.get("/{token}/nightly/run")
+async def trigger_nightly_run(token: str):
+    if not settings.PERSONAL_LINK_TOKEN or token != settings.PERSONAL_LINK_TOKEN:
+        raise HTTPException(status_code=404, detail="Not Found")
+
+    if is_nightly_running():
+        return JSONResponse(
+            content={"started": False, "status": "already running"},
+            status_code=200,
+        )
+
+    task = asyncio.create_task(run_nightly_cycle())
+    _tasks.add(task)
+    task.add_done_callback(_tasks.discard)
+    return JSONResponse(content={"started": True}, status_code=200)
