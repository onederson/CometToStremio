+def _format_agora_depois(timelines: list[dict], now_utc: datetime.datetime) -> str:
+    tz = BR_TZ
+    agora = None
+    depois = None
+    for i, t in enumerate(timelines):
+        try:
+            start_dt = datetime.datetime.fromisoformat(t["start"].replace("Z", "+00:00"))
+            stop_dt = datetime.datetime.fromisoformat(t["stop"].replace("Z", "+00:00"))
+        except Exception:
+            continue
+        if start_dt <= now_utc < stop_dt:
+            title = t.get("title") or t.get("name") or "Programa"
+            stop_str = stop_dt.astimezone(tz).strftime("%H:%M")
+            agora = (title, stop_str)
+            if i + 1 < len(timelines):
+                next_t = timelines[i + 1]
+                try:
+                    next_start = datetime.datetime.fromisoformat(next_t["start"].replace("Z", "+00:00"))
+                    next_title = next_t.get("title") or next_t.get("name") or "Programa"
+                    next_start_str = next_start.astimezone(tz).strftime("%H:%M")
+                    depois = (next_title, next_start_str)
+                except Exception:
+                    pass
+            break
+    parts = []
+    if agora:
+        parts.append(f"▶ Agora: {agora[0]} (até {agora[1]})")
+    if depois:
+        parts.append(f"⏭ Depois: {depois[0]} ({depois[1]})")
+    if parts:
+        return "\n".join(parts)
+    return "▶ Transmissão ao vivo"
+
+
+def _format_meta_programming(timelines: list[dict], now_utc: datetime.datetime, summary: str = "") -> str:
+    tz = BR_TZ
+    lines = []
+    stop_window = now_utc + datetime.timedelta(hours=6)
+    for t in timelines:
+        try:
+            start_dt = datetime.datetime.fromisoformat(t["start"].replace("Z", "+00:00"))
+            stop_dt = datetime.datetime.fromisoformat(t["stop"].replace("Z", "+00:00"))
+        except Exception:
+            continue
+        if stop_dt > now_utc and start_dt < stop_window:
+            hhmm = start_dt.astimezone(tz).strftime("%H:%M")
+            title = t.get("title") or t.get("name") or ""
+            lines.append(f"{hhmm}  {title}")
+    if lines:
+        return "\n".join(lines)
+    return summary or "Transmissão ao vivo"
+
