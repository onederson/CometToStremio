+import asyncio
+import os
+import time
+
+import aiohttp
+
+from comet.core.logger import logger
+from comet.core.models import settings
+from comet.services.catalogs import get_catalog
+
+_WARMED_IDS: dict[str, float] = {}
+
+
+async def run_warmup_cycle():
+    token = settings.PERSONAL_LINK_TOKEN
+    config = settings.PERSONAL_LINK_CONFIG
+    if not token or not config:
+        return
+
+    port = getattr(settings, "FASTAPI_PORT", 8000) or 8000
+    base_url = f"http://127.0.0.1:{port}"
+
+    try:
+        top_mov = await get_catalog("movie", "comet_top10")
+        top_ser = await get_catalog("series", "comet_top10")
+        trend_mov = (await get_catalog("movie", "comet_trending"))[:20]
+        trend_ser = (await get_catalog("series", "comet_trending"))[:20]
+    except Exception as e:
+        logger.warning(f"Error fetching catalogs for warmup: {e}")
+        return
+
+    candidates: list[tuple[str, str]] = []
+    seen = set()
+
+    for item in top_mov + trend_mov:
+        mid = item.get("id")
+        if mid and isinstance(mid, str) and mid.startswith("tt") and ("movie", mid) not in seen:
+            seen.add(("movie", mid))
+            candidates.append(("movie", mid))
+
+    for item in top_ser + trend_ser:
+        mid = item.get("id")
+        if mid and isinstance(mid, str) and mid.startswith("tt") and ("series", mid) not in seen:
+            seen.add(("series", mid))
+            candidates.append(("series", mid))
+
+    total_n = len(candidates)
+    now = time.time()
+
+    new_candidates = [
+        (mtype, mid)
+        for (mtype, mid) in candidates
+        if (now - _WARMED_IDS.get(f"{mtype}:{mid}", 0)) >= 86400
+    ]
+    new_m = len(new_candidates)
+
+    logger.info(f"🔥 Pré-aquecimento: {total_n} títulos ({new_m} novos)")
+
+    if not new_candidates:
+        return
+
+    timeout = aiohttp.ClientTimeout(total=120.0)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        for mtype, mid in new_candidates:
+            if mtype == "movie":
+                url = f"{base_url}/{token}/stream/movie/{mid}.json"
+            else:
+                url = f"{base_url}/{token}/stream/series/{mid}:1:1.json"
+
+            try:
+                async with session.get(url) as resp:
+                    await resp.read()
+            except asyncio.CancelledError:
+                raise
+            except Exception as e:
+                logger.warning(f"Pré-aquecimento error on {mtype} {mid}: {type(e).__name__}")
+
+            _WARMED_IDS[f"{mtype}:{mid}"] = time.time()
+
+            try:
+                await asyncio.sleep(20)
+            except asyncio.CancelledError:
+                raise
+
+
+async def start_catalog_warmup():
+    try:
+        initial_delay_raw = os.getenv("WARMUP_INITIAL_DELAY", "300")
+        try:
+            initial_delay = float(initial_delay_raw)
+        except ValueError:
+            initial_delay = 300.0
+
+        if initial_delay > 0:
+            await asyncio.sleep(initial_delay)
+
+        while True:
+            await run_warmup_cycle()
+            await asyncio.sleep(12 * 3600)
+    except asyncio.CancelledError:
+        pass
+    except Exception as e:
+        logger.warning(f"Pré-aquecimento task encountered error: {e}")
