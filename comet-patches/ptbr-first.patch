+async def _get_collection_data(tmdb: TMDBApi, cid: int) -> tuple[dict, list[dict]]:
+    now = time.time()
+    today_str = datetime.date.today().isoformat()
+    cached = _SAGA_CACHE.get(cid)
+    if cached is not None and (now - cached[0]) < 86400 and len(cached) == 3:
+        return cached[1], cached[2]
+    try:
+        data = await tmdb._get_json(
+            f"collection/{cid}?language=pt-BR", f"coll {cid}"
+        )
+        if isinstance(data, dict) and isinstance(data.get("parts"), list):
+            released = [
+                p
+                for p in data["parts"]
+                if isinstance(p, dict)
+                and p.get("release_date")
+                and p.get("release_date") <= today_str
+            ]
+            released.sort(key=lambda x: x.get("release_date") or "")
+            _SAGA_CACHE[cid] = (now, data, released)
+            return data, released
+    except Exception as e:
+        logger.warning(f"Error fetching collection {cid}: {e}")
+    return {}, []
