diff --git a/comet/metadata/siblings.py b/comet/metadata/siblings.py
new file mode 100644
index 0000000..316c696
--- /dev/null
+++ b/comet/metadata/siblings.py
@@ -0,0 +1,163 @@
+import asyncio
+import time
+import urllib.parse
+
+from curl_cffi.requests import AsyncSession
+
+from comet.core.logger import logger
+from comet.metadata.manager import MetadataScraper
+from comet.services.anime import anime_mapper
+from comet.services.filtering import scrub
+from comet.utils.http_client import http_client_manager
+from comet.utils.languages import merge_aliases
+
+_CACHE_TTL = 86400.0  # 24 hours
+_cache: dict[tuple[str, str], tuple[float, frozenset[str]]] = {}
+_locks: dict[tuple[str, str], asyncio.Lock] = {}
+
+
+async def get_blocked_titles(
+    media_type: str, imdb_id: str, title: str
+) -> frozenset[str]:
+    if (
+        not imdb_id
+        or not isinstance(imdb_id, str)
+        or not imdb_id.startswith("tt")
+        or not title
+        or not isinstance(title, str)
+        or media_type not in ("series", "movie")
+    ):
+        return frozenset()
+
+    cache_key = (media_type, imdb_id)
+    now = time.time()
+    cached = _cache.get(cache_key)
+    if cached is not None and (now - cached[0]) < _CACHE_TTL:
+        return cached[1]
+
+    lock = _locks.get(cache_key)
+    if lock is None:
+        lock = asyncio.Lock()
+        _locks[cache_key] = lock
+
+    async with lock:
+        now = time.time()
+        cached = _cache.get(cache_key)
+        if cached is not None and (now - cached[0]) < _CACHE_TTL:
+            return cached[1]
+
+        base_scrub = scrub(title)
+        if not base_scrub:
+            empty = frozenset()
+            _cache[cache_key] = (now, empty)
+            return empty
+
+        prefix = base_scrub + " "
+        encoded_query = urllib.parse.quote_plus(title)
+        url = f"https://v3-cinemeta.strem.io/catalog/{media_type}/top/search={encoded_query}.json"
+
+        try:
+            async with AsyncSession(impersonate="chrome") as session:
+                resp = await session.get(url, timeout=6.0)
+                if resp.status_code != 200:
+                    logger.warning(
+                        f"Cinemeta search failed with HTTP {resp.status_code} for {imdb_id} ({title})"
+                    )
+                    empty = frozenset()
+                    _cache[cache_key] = (now, empty)
+                    return empty
+                payload = resp.json()
+        except Exception as exc:
+            logger.warning(
+                f"Cinemeta search failed for {imdb_id} ({title}): {exc}"
+            )
+            empty = frozenset()
+            _cache[cache_key] = (now, empty)
+            return empty
+
+        metas = payload.get("metas") if isinstance(payload, dict) else None
+        if not isinstance(metas, list) or not metas:
+            empty = frozenset()
+            _cache[cache_key] = (now, empty)
+            return empty
+
+        siblings: list[dict] = []
+        for meta in metas:
+            if not isinstance(meta, dict):
+                continue
+            meta_id = meta.get("id") or meta.get("imdb_id")
+            meta_name = meta.get("name") or ""
+            if not meta_id or meta_id == imdb_id:
+                continue
+            meta_type = meta.get("type")
+            if meta_type and meta_type != media_type:
+                continue
+            meta_scrub = scrub(meta_name)
+            if meta_scrub.startswith(prefix):
+                siblings.append(
+                    {"id": meta_id, "name": meta_name, "scrub": meta_scrub}
+                )
+                if len(siblings) == 6:
+                    break
+
+        if not siblings:
+            empty = frozenset()
+            _cache[cache_key] = (now, empty)
+            return empty
+
+        blocked: set[str] = set()
+        for sib in siblings:
+            blocked.add(sib["scrub"])
+
+        session = await http_client_manager.get_session()
+        scraper = MetadataScraper(session)
+
+        async def _fetch_sibling_aliases(sib_id: str) -> dict:
+            try:
+                _, aliases = await scraper.fetch_metadata_and_aliases(
+                    media_type, sib_id
+                )
+            except Exception as e:
+                logger.warning(
+                    f"Failed fetching aliases for sibling {sib_id}: {e}"
+                )
+                aliases = {}
+
+            if anime_mapper.is_loaded():
+                try:
+                    kids = anime_mapper.get_kitsu_ids_from_imdb(sib_id)
+                    for kid in kids:
+                        k_aliases = await anime_mapper.get_aliases(f"kitsu:{kid}")
+                        if k_aliases:
+                            aliases = merge_aliases(aliases, k_aliases)
+                except Exception:
+                    pass
+
+            return aliases if isinstance(aliases, dict) else {}
+
+        sibling_aliases_list = await asyncio.gather(
+            *(_fetch_sibling_aliases(s["id"]) for s in siblings),
+            return_exceptions=True,
+        )
+
+        for aliases in sibling_aliases_list:
+            if isinstance(aliases, dict):
+                for titles in aliases.values():
+                    if isinstance(titles, list):
+                        for t in titles:
+                            if isinstance(t, str):
+                                st = scrub(t)
+                                if st.startswith(prefix):
+                                    blocked.add(st)
+
+        result = frozenset(blocked)
+        _cache[cache_key] = (time.time(), result)
+
+        if result:
+            sibs_str = ", ".join(f"{s['id']} {s['name']}" for s in siblings)
+            logger.log(
+                "FILTER",
+                f"🧬 Irmãos de {imdb_id} ({title}): {sibs_str} → {len(result)} nomes bloqueados",
+            )
+
+        return result
diff --git a/comet/scrapers/addons.py b/comet/scrapers/addons.py
new file mode 100644
index 0000000..969ec80
--- /dev/null
+++ b/comet/scrapers/addons.py
@@ -0,0 +1,200 @@
+import re
+import unicodedata
+import urllib.parse
+from RTN import parse
+
+from comet.core.logger import log_scraper_error
+from comet.scrapers.base import BaseScraper
+from comet.scrapers.models import ScrapeRequest
+from comet.utils.formatting import size_to_bytes
+
+SIZE_PATTERN = re.compile(r"💾 ([\d.]+ [KMGT]B)")
+SEEDERS_PATTERN = re.compile(r"👤 (\d+)")
+
+
+def _strip_leading_icons(line: str) -> str:
+    while line:
+        ch = line[0]
+        cat = unicodedata.category(ch)
+        if cat in ("So", "Sk", "Sm", "Cn", "Mn", "Me") or ch.isspace():
+            line = line[1:]
+        else:
+            break
+    return line.strip()
+
+
+def _has_rtn_resolution(parsed) -> bool:
+    res = str(getattr(parsed, "resolution", "") or "").lower()
+    return bool(res and res not in ("", "unknown", "none"))
+
+
+def _has_rtn_quality(parsed) -> bool:
+    qual = str(getattr(parsed, "quality", "") or "").lower()
+    return bool(qual and qual not in ("", "unknown", "none"))
+
+
+def _get_short_host(url: str | None) -> str:
+    if not url:
+        return "Addons"
+    try:
+        host = urllib.parse.urlparse(url).netloc.split(":")[0].lower()
+    except Exception:
+        return "Addons"
+    if "stremio-betor" in host:
+        return "BeTor"
+    elif "bestcine" in host:
+        return "BestCine"
+    parts = host.split(".")
+    return parts[0] if parts and parts[0] else "Addons"
+
+
+class AddonsScraper(BaseScraper):
+    impersonate = "chrome"
+
+    def __init__(self, manager, session, url: str):
+        super().__init__(manager, session, url)
+
+    def _parse_stream(
+        self, stream: dict, request: ScrapeRequest | None = None
+    ) -> dict | None:
+        if not isinstance(stream, dict):
+            return None
+
+        info_hash = stream.get("infoHash")
+        if not isinstance(info_hash, str) or not info_hash.strip():
+            return None
+        info_hash = info_hash.strip().lower()
+
+        file_index = stream.get("fileIdx")
+        if not isinstance(file_index, int):
+            file_index = None
+
+        sources = stream.get("sources")
+        if not isinstance(sources, list):
+            sources = []
+
+        full_title = stream.get("title") or ""
+        full_desc = stream.get("description") or ""
+        name = stream.get("name") or ""
+        text_combined = f"{full_title}\n{full_desc}"
+        all_text = f"{name}\n{full_title}\n{full_desc}"
+
+        seeders_match = SEEDERS_PATTERN.search(text_combined)
+        seeders = int(seeders_match.group(1)) if seeders_match else None
+
+        size = None
+        size_match = SIZE_PATTERN.search(text_combined)
+        if size_match:
+            size = size_to_bytes(size_match.group(1))
+        if size is None:
+            behavior_hints = stream.get("behaviorHints")
+            if isinstance(behavior_hints, dict):
+                video_size = behavior_hints.get("videoSize")
+                if isinstance(video_size, (int, float)):
+                    size = int(video_size)
+
+        raw_text = full_title if full_title else full_desc
+        first_line = raw_text.split("\n")[0].strip() if raw_text else ""
+        cleaned_line = _strip_leading_icons(first_line)
+
+        parsed_line = parse(cleaned_line)
+        if not _has_rtn_resolution(parsed_line) and not _has_rtn_quality(parsed_line):
+            behavior_hints = stream.get("behaviorHints")
+            filename = (
+                behavior_hints.get("filename")
+                if isinstance(behavior_hints, dict)
+                else None
+            )
+            if (
+                isinstance(filename, str)
+                and filename.strip()
+                and _has_rtn_resolution(parse(filename.strip()))
+            ):
+                final_title = filename.strip()
+            else:
+                ep_tag = ""
+                if not parsed_line.episodes:
+                    m_ep = re.search(
+                        r"\b[ST](\d+)[·.xE](\d+)\b", text_combined, re.IGNORECASE
+                    )
+                    if m_ep:
+                        ep_tag = f"S{int(m_ep.group(1)):02d}E{int(m_ep.group(2)):02d}"
+                    elif (
+                        request
+                        and request.media_type == "series"
+                        and request.season is not None
+                        and request.episode is not None
+                    ):
+                        ep_tag = f"S{request.season:02d}E{request.episode:02d}"
+
+                name_lines = name.split("\n")[1:]
+                name_rest = " ".join(name_lines)
+                res = ""
+                if re.search(r"\b(?:4k|2160p)\b", name_rest, re.IGNORECASE):
+                    res = "2160p"
+                elif re.search(r"\b1080p\b", name_rest, re.IGNORECASE):
+                    res = "1080p"
+                elif re.search(r"\b720p\b", name_rest, re.IGNORECASE):
+                    res = "720p"
+                elif re.search(r"\b480p\b", name_rest, re.IGNORECASE):
+                    res = "480p"
+
+                # Rotulos de idioma do addon (Dual/Dublado) nao entram no titulo: o BestCine
+                # marca como Dual releases YTS/FLUX em ingles, o que contaminava a deteccao PT-BR.
+
+                # Titulo sintetico com o nome original da midia: o titulo traduzido do addon
+                # ("Transformers: O Inicio") fazia a deteccao de idioma marcar PT-BR em
+                # releases em ingles, e a marca contaminava o mesmo hash nas outras fontes.
+                base_title = request.title if request and request.title else cleaned_line
+                if request and request.media_type == "movie" and request.year:
+                    base_title = f"{base_title} {request.year}"
+                parts = [base_title]
+                if ep_tag:
+                    parts.append(ep_tag)
+                if res:
+                    parts.append(res)
+                final_title = " ".join(parts).strip()
+        else:
+            final_title = cleaned_line
+
+        if not final_title:
+            return None
+
+        short_host = _get_short_host(self.url)
+        # O rotulo entre colchetes do addon (ex.: BeTor "[bludv]") nao e confiavel:
+        # aparece ate em releases YTS em ingles. Nao entra no tracker para nao
+        # disparar a deteccao PT-BR por tracker BR.
+        tracker = f"Addons|{short_host}"
+
+        return {
+            "title": final_title,
+            "infoHash": info_hash,
+            "fileIndex": file_index,
+            "seeders": seeders,
+            "size": size,
+            "tracker": tracker,
+            "sources": sources,
+        }
+
+    async def scrape(self, request: ScrapeRequest):
+        torrents = []
+        try:
+            url = f"{self.url}/stream/{request.media_type}/{request.media_id}.json"
+            async with self.session.get(url) as response:
+                if response.status != 200:
+                    return []
+                results = await response.json()
+
+            if not isinstance(results, dict) or not isinstance(
+                results.get("streams"), list
+            ):
+                return []
+
+            for stream in results["streams"]:
+                parsed = self._parse_stream(stream, request)
+                if parsed is not None:
+                    torrents.append(parsed)
+        except Exception as e:
+            log_scraper_error("Addons", self.url, request.media_id, e)
+
+        return torrents
diff --git a/comet/scrapers/brsites.py b/comet/scrapers/brsites.py
new file mode 100644
index 0000000..c6c18de
--- /dev/null
+++ b/comet/scrapers/brsites.py
@@ -0,0 +1,333 @@
+import asyncio
+import base64
+import re
+import unicodedata
+import urllib.parse
+from bs4 import BeautifulSoup
+
+from comet.core.logger import log_scraper_error
+from comet.scrapers.base import BaseScraper
+from comet.scrapers.models import ScrapeRequest
+
+SITES = [
+    {
+        "name": "FilmesTorrent",
+        "domain": "filmestorrent.tv",
+        "search_url": "https://filmestorrent.tv/?s={query}",
+        "tracker": "BRSites|FilmesTorrent",
+    },
+    {
+        "name": "ApacheTorrent",
+        "domain": "apachetorrents.com",
+        "search_url": "https://apachetorrents.com/index.php?busca={query}",
+        "tracker": "BRSites|ApacheTorrent",
+    },
+]
+
+RE_ACESSE = re.compile(r"^\s*\[?ACESSE [^\]]*\]\s*", re.IGNORECASE)
+RE_DOMAIN = re.compile(
+    r"^(?:[A-Za-z0-9-]+\.(?:org|com|net|tv|to|biz))\.*\s*", re.IGNORECASE
+)
+RE_AUDIO_TAGS = re.compile(
+    r"[-_.]*(DUBLADO|DUAL[-_.]?AUDIO|DUAL|LEGENDADO)[-_.]*", re.IGNORECASE
+)
+RE_DUAL_AUDIO = re.compile(r"DUAL[-_.]AUDIO", re.IGNORECASE)
+RE_YEAR = re.compile(r"\b(?:19|20)\d{2}\b")
+RE_NON_WORD = re.compile(r"[^\w\s]", re.UNICODE)
+RE_NON_POST = re.compile(
+    r"/(?:category|categoria|tag|page|pagina|genero|qualidade|pesquisa|lancamentos|filmes|series|desenhos)(?:/|$)|index\.php|\?s=",
+    re.IGNORECASE,
+)
+
+
+def normalize_text(text: str) -> str:
+    return (
+        unicodedata.normalize("NFKD", text)
+        .encode("ASCII", "ignore")
+        .decode("utf-8")
+        .lower()
+    )
+
+
+def get_significant_words(text: str) -> list[str]:
+    norm = normalize_text(text)
+    words = re.findall(r"[a-z0-9]+", norm)
+    sig = [w for w in words if len(w) >= 3]
+    return sig if sig else words
+
+
+def clean_query_title(title: str) -> str:
+    no_year = RE_YEAR.sub(" ", title)
+    no_punct = RE_NON_WORD.sub(" ", no_year)
+    return " ".join(no_punct.split())
+
+
+def clean_magnet_title(title: str, fallback_title: str) -> str:
+    t = title.strip() if title else ""
+    if not t:
+        t = fallback_title.strip()
+    while True:
+        prev = t
+        t = RE_ACESSE.sub("", t)
+        t = RE_DOMAIN.sub("", t)
+        t = t.lstrip(" .-_/")
+        if t == prev:
+            break
+    t = RE_AUDIO_TAGS.sub(r" \1 ", t)
+    t = RE_DUAL_AUDIO.sub("DUAL AUDIO", t)
+    t = re.sub(r"\s+", " ", t).strip()
+    return t
+
+
+def parse_info_hash(raw_hash: str) -> str | None:
+    raw = raw_hash.strip().lower()
+    if raw.startswith("urn:btih:"):
+        raw = raw[9:]
+    raw = raw.split("&")[0].strip()
+    if len(raw) == 40 and all(c in "0123456789abcdef" for c in raw):
+        return raw
+    if len(raw) == 32:
+        try:
+            decoded = base64.b32decode(raw.upper())
+            return decoded.hex().lower()
+        except Exception:
+            return None
+    return None
+
+
+def parse_magnet(
+    magnet_str: str, fallback_title: str, tracker: str
+) -> dict | None:
+    if not magnet_str.startswith("magnet:?"):
+        return None
+    query_str = magnet_str[8:]
+    params = urllib.parse.parse_qs(query_str)
+
+    xt_list = params.get("xt", [])
+    info_hash = None
+    for xt in xt_list:
+        parsed_hash = parse_info_hash(xt)
+        if parsed_hash:
+            info_hash = parsed_hash
+            break
+    if not info_hash:
+        return None
+
+    raw_dn = params.get("dn", [""])[0]
+    decoded_dn = urllib.parse.unquote_plus(raw_dn) if raw_dn else ""
+    title = clean_magnet_title(decoded_dn, fallback_title)
+    if not title:
+        title = fallback_title
+
+    tr_list = params.get("tr", [])
+    sources = []
+    for tr in tr_list:
+        tr_decoded = urllib.parse.unquote_plus(tr).strip()
+        if tr_decoded:
+            sources.append(f"tracker:{tr_decoded}")
+
+    return {
+        "title": title,
+        "infoHash": info_hash,
+        "fileIndex": None,
+        "seeders": None,
+        "size": None,
+        "tracker": tracker,
+        "sources": sources,
+    }
+
+
+class BrSitesScraper(BaseScraper):
+    impersonate = "chrome"
+
+    async def _scrape_site(
+        self, site: dict, request: ScrapeRequest
+    ) -> list[dict]:
+        results: list[dict] = []
+        seen_hashes: set[str] = set()
+        collected_posts: list[str] = []
+
+        # 1. Build queries
+        queries = list(
+            dict.fromkeys(
+                q
+                for q in (clean_query_title(t) for t in request.query_titles[:2])
+                if q
+            )
+        )
+        target_sigs = [
+            get_significant_words(q) for q in queries if get_significant_words(q)
+        ]
+        first_sig_words = {sig[0].lower() for sig in target_sigs if sig}
+
+        allowed_years = (
+            {request.year - 1, request.year, request.year + 1}
+            if (request.media_type == "movie" and request.year)
+            else None
+        )
+
+        # 2. Search pages
+        for q in queries:
+            search_url = site["search_url"].format(
+                query=urllib.parse.quote_plus(q)
+            )
+            try:
+                async with self.session.get(search_url, timeout=8) as response:
+                    if response.status != 200:
+                        continue
+                    html = await response.text()
+            except Exception as e:
+                log_scraper_error("BRSites", search_url, request.media_id, e)
+                continue
+
+            soup = BeautifulSoup(html, "html.parser")
+            for a in soup.find_all("a", href=True):
+                href = a["href"].strip()
+                if not href or href.startswith(("#", "javascript:")):
+                    continue
+                full_url = urllib.parse.urljoin(search_url, href)
+                parsed = urllib.parse.urlparse(full_url)
+                if parsed.netloc.lower() != site["domain"]:
+                    continue
+                path = parsed.path.strip("/")
+                if not path or RE_NON_POST.search(parsed.path):
+                    continue
+
+                slug = path.split("/")[-1]
+                slug_words = set(re.findall(r"[a-z0-9]+", normalize_text(slug)))
+
+                if not any(
+                    all(w in slug_words for w in sig)
+                    for sig in target_sigs
+                    if sig
+                ):
+                    continue
+
+                link_text = a.get_text(strip=True)
+                if allowed_years is not None:
+                    found_years = [
+                        int(y) for y in RE_YEAR.findall(f"{slug} {link_text}")
+                    ]
+                    if any(y not in allowed_years for y in found_years):
+                        continue
+
+                if full_url not in collected_posts:
+                    collected_posts.append(full_url)
+
+        # Em serie, posts da temporada pedida vem primeiro (os sites tem um post por temporada)
+        if request.media_type == "series" and request.season is not None:
+            season_re = re.compile(
+                rf"(?:^|-)(?:{request.season}a?-temporada|temporada-{request.season}|s0?{request.season})(?:-|$)"
+            )
+            episode_re = (
+                re.compile(rf"(?:^|-)s0?{request.season}e0?{request.episode}(?:-|$)")
+                if request.episode is not None
+                else None
+            )
+
+            def post_priority(url: str) -> int:
+                slug = urllib.parse.urlparse(url).path.strip("/").split("/")[-1]
+                slug = normalize_text(slug)
+                if episode_re and episode_re.search(slug):
+                    return 0
+                if season_re.search(slug):
+                    return 1
+                if re.search(r"(?:^|-)s\d+e\d+(?:-|$)", slug):
+                    return 3
+                if "completa" in slug or "temporada" not in slug:
+                    return 2
+                return 3
+
+            collected_posts.sort(key=post_priority)
+
+        # 3. Fetch each post
+        for post_url in collected_posts[:4]:
+            try:
+                async with self.session.get(post_url, timeout=8) as response:
+                    if response.status != 200:
+                        continue
+                    post_html = await response.text()
+            except Exception as e:
+                log_scraper_error("BRSites", post_url, request.media_id, e)
+                continue
+
+            clean_post_html = post_html.replace("&amp;", "&")
+            soup = BeautifulSoup(clean_post_html, "html.parser")
+            h1 = soup.find("h1")
+            post_title = (
+                h1.get_text(strip=True)
+                if h1
+                else (soup.title.get_text(strip=True) if soup.title else "")
+            )
+
+            if allowed_years is not None:
+                slug = (
+                    urllib.parse.urlparse(post_url)
+                    .path.strip("/")
+                    .split("/")[-1]
+                )
+                post_years = [
+                    int(y) for y in RE_YEAR.findall(f"{slug} {post_title}")
+                ]
+                if any(y not in allowed_years for y in post_years):
+                    continue
+
+            magnet_links: list[str] = []
+            for a in soup.find_all("a", href=True):
+                href = a["href"].strip()
+                if href.startswith("magnet:?"):
+                    magnet_links.append(href)
+            for m in re.findall(r"magnet:\?[^\s\"'<>]+", clean_post_html):
+                if m not in magnet_links:
+                    magnet_links.append(m)
+
+            for m in magnet_links:
+                parsed_torrent = parse_magnet(m, post_title, site["tracker"])
+                if not parsed_torrent:
+                    continue
+                info_hash = parsed_torrent["infoHash"]
+                if info_hash in seen_hashes:
+                    continue
+
+                if request.media_type == "series" and first_sig_words:
+                    clean_norm = normalize_text(parsed_torrent["title"])
+                    magnet_words = set(re.findall(r"[a-z0-9]+", clean_norm))
+                    if not any(fw in magnet_words for fw in first_sig_words):
+                        continue
+
+                seen_hashes.add(info_hash)
+                results.append(parsed_torrent)
+
+        return results
+
+    async def scrape(self, request: ScrapeRequest) -> list[dict]:
+        if not request.media_only_id.startswith("tt"):
+            return []
+
+        all_results: list[dict] = []
+        seen_hashes: set[str] = set()
+        lock = asyncio.Lock()
+
+        async def _run_site(site_info: dict):
+            try:
+                site_torrents = await self._scrape_site(site_info, request)
+                async with lock:
+                    for t in site_torrents:
+                        h = t["infoHash"]
+                        if h not in seen_hashes:
+                            seen_hashes.add(h)
+                            all_results.append(t)
+            except Exception as e:
+                log_scraper_error(
+                    "BRSites", site_info["search_url"], request.media_id, e
+                )
+
+        site_tasks = [asyncio.create_task(_run_site(s)) for s in SITES]
+        try:
+            await asyncio.wait_for(asyncio.gather(*site_tasks), timeout=12.0)
+        except TimeoutError:
+            for task in site_tasks:
+                if not task.done():
+                    task.cancel()
+
+        return all_results
