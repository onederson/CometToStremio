+async def _fetch_ready_items(media_type: str, skip: int, base_url: str = "") -> list[dict]:
+    _ensure_find_map_loaded()
+    sorted_tt = await _get_ready_tt_list(media_type)
+
+    page_tt = sorted_tt[skip : skip + 40]
+    if not page_tt:
+        return []
+
+    is_landscape = getattr(settings, "CATALOG_LANDSCAPE", True)
+    if is_landscape:
+        _ensure_landscape_map_loaded()
+
+    timeout = aiohttp.ClientTimeout(total=8.0)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        tmdb = TMDBApi(session)
+        tasks = [_resolve_find_imdb(tmdb, tt, media_type) for tt in page_tt]
+        resolved = await asyncio.gather(*tasks, return_exceptions=True)
+        raw_metas = [dict(r) for r in resolved if isinstance(r, dict)]
+
+        if not is_landscape:
+            for m in raw_metas:
+                m.pop("_tmdb_id", None)
+                m.pop("_backdrop_path", None)
+                m.pop("_poster_path", None)
+                m.pop("_release_date", None)
+            return raw_metas
+
+        top10_set = await _get_top10_imdb_ids(media_type, session, tmdb)
+        sem = asyncio.Semaphore(10)
+        today_date = datetime.date.today()
+        landscape_cache_updated = False
+
+        tmdb_type = "movie" if media_type == "movie" else "tv"
+        async def resolve_landscape(tmdb_id: int, fallback_backdrop: str | None = None) -> dict | None:
+            nonlocal landscape_cache_updated
+            cache_key = f"{tmdb_type}:{tmdb_id}"
+            if cache_key in _LANDSCAPE_MAP:
+                val = _LANDSCAPE_MAP[cache_key]
+                if isinstance(val, dict) and "backdrop" in val:
+                    return val
+
+            async with sem:
+                data = await tmdb._get_json(
+                    f"{tmdb_type}/{tmdb_id}/images?include_image_language=pt,en,null",
+                    f"{tmdb_type} images {tmdb_id}",
+                )
+                chosen_backdrop = None
+                chosen_logo = None
+                if isinstance(data, dict):
+                    backdrops = data.get("backdrops")
+                    if isinstance(backdrops, list) and backdrops:
+                        null_bds = [
+                            b.get("file_path")
+                            for b in backdrops
+                            if isinstance(b, dict)
+                            and (b.get("iso_639_1") is None or b.get("iso_639_1") == "null")
+                            and b.get("file_path")
+                        ]
+                        if null_bds:
+                            chosen_backdrop = null_bds[0]
+                        else:
+                            any_bds = [
+                                b.get("file_path")
+                                for b in backdrops
+                                if isinstance(b, dict) and b.get("file_path")
+                            ]
+                            if any_bds:
+                                chosen_backdrop = any_bds[0]
+
+                    logos = data.get("logos")
+                    if isinstance(logos, list) and logos:
+                        valid_logos = [
+                            l for l in logos
+                            if isinstance(l, dict)
+                            and l.get("file_path")
+                            and l.get("file_path", "").lower().endswith(".png")
+                        ]
+                        pt_logos = [
+                            l for l in valid_logos
+                            if l.get("iso_639_1") == "pt"
+                        ]
+                        if pt_logos:
+                            pt_logos.sort(key=lambda x: float(x.get("vote_average") or 0.0), reverse=True)
+                            chosen_logo = pt_logos[0].get("file_path")
+                        else:
+                            en_logos = [
+                                l for l in valid_logos
+                                if l.get("iso_639_1") == "en"
+                            ]
+                            if en_logos:
+                                en_logos.sort(key=lambda x: float(x.get("vote_average") or 0.0), reverse=True)
+                                chosen_logo = en_logos[0].get("file_path")
+
+                if not chosen_backdrop and fallback_backdrop:
+                    chosen_backdrop = fallback_backdrop
+
+                res = {
+                    "backdrop": chosen_backdrop.lstrip("/") if chosen_backdrop else None,
+                    "logo": chosen_logo.lstrip("/") if chosen_logo else None,
+                }
+                _LANDSCAPE_MAP[cache_key] = res
+                landscape_cache_updated = True
+                return res
+
+        async def check_new_ep(tid: int) -> bool:
+            now = time.time()
+            cached = _TV_LAST_EP_CACHE.get(tid)
+            if cached is not None and (now - cached[0]) < 12 * 3600:
+                air_date = cached[1]
+            else:
+                air_date = None
+                async with sem:
+                    try:
+                        tv_data = await tmdb._get_json(f"tv/{tid}?language=pt-BR", f"tv {tid}")
+                        if isinstance(tv_data, dict):
+                            last_ep = tv_data.get("last_episode_to_air")
+                            if isinstance(last_ep, dict) and last_ep.get("air_date"):
+                                air_date = str(last_ep["air_date"])
+                        _TV_LAST_EP_CACHE[tid] = (now, air_date)
+                    except Exception:
+                        _TV_LAST_EP_CACHE[tid] = (now, None)
+            if air_date:
+                try:
+                    ep_date = datetime.date.fromisoformat(air_date)
+                    diff = (today_date - ep_date).days
+                    return -1 <= diff <= 10
+                except ValueError:
+                    pass
+            return False
+
+        async def process_ready_item(m: dict) -> dict:
+            meta = dict(m)
+            tid = meta.get("_tmdb_id")
+            if not tid:
+                return meta
+            ls_data = await resolve_landscape(tid, meta.get("_backdrop_path"))
+            badge = None
+            imdb_id = meta.get("id")
+            if imdb_id and imdb_id in top10_set:
+                badge = "top10"
+            elif media_type == "series":
+                if await check_new_ep(tid):
+                    badge = "new_ep"
+            elif media_type == "movie":
+                rel_d_str = meta.get("_release_date")
+                if rel_d_str:
+                    try:
+                        rel_d = datetime.date.fromisoformat(rel_d_str)
+                        if -1 <= (today_date - rel_d).days <= 30:
+                            badge = "new"
+                    except ValueError:
+                        pass
+
+            backdrop_file = None
+            logo_file = None
+            if ls_data and ls_data.get("backdrop"):
+                backdrop_file = ls_data["backdrop"]
+                logo_file = ls_data.get("logo")
+            elif meta.get("_backdrop_path"):
+                backdrop_file = meta["_backdrop_path"]
+
+            if backdrop_file:
+                b_clean = backdrop_file.lstrip("/")
+                l_clean = logo_file.lstrip("/") if logo_file else None
+                b_param = f"?b={badge}" if badge else ""
+                if l_clean:
+                    meta["poster"] = f"{base_url}/art/land/{b_clean}/{l_clean}{b_param}"
+                else:
+                    meta["poster"] = f"{base_url}/art/land/{b_clean}{b_param}"
+                meta["posterShape"] = "landscape"
+            return meta
+
+        processed_metas = await asyncio.gather(*[process_ready_item(m) for m in raw_metas], return_exceptions=True)
+        if landscape_cache_updated:
+            await asyncio.to_thread(_save_landscape_map)
+
+        final_metas = []
+        for m in processed_metas:
+            if isinstance(m, dict):
+                m.pop("_tmdb_id", None)
+                m.pop("_backdrop_path", None)
+                m.pop("_poster_path", None)
+                m.pop("_release_date", None)
+                final_metas.append(m)
+        return final_metas
+
+
+async def _fetch_saga_items(genre: str | None, skip: int) -> list[dict]:
+    _ensure_imdb_map_loaded()
+    today_str = datetime.date.today().isoformat()
+    now = time.time()
+
+    timeout = aiohttp.ClientTimeout(total=8.0)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        tmdb = TMDBApi(session)
+
+        async def get_collection_parts(cid: int) -> list[dict]:
+            cached = _SAGA_CACHE.get(cid)
+            if cached is not None and (now - cached[0]) < 86400:
+                return cached[1]
+            try:
+                data = await tmdb._get_json(
+                    f"collection/{cid}?language=pt-BR", f"coll {cid}"
+                )
+                if isinstance(data, dict) and isinstance(data.get("parts"), list):
+                    released = [
+                        p
+                        for p in data["parts"]
+                        if isinstance(p, dict)
+                        and p.get("release_date")
+                        and p.get("release_date") <= today_str
+                    ]
+                    released.sort(key=lambda x: x.get("release_date") or "")
+                    _SAGA_CACHE[cid] = (now, released)
+                    return released
+            except Exception as e:
+                logger.warning(f"Error fetching collection {cid}: {e}")
+            return []
+
+        if genre:
+            cid = SAGA_MAP.get(genre)
+            if not cid:
+                return []
+            parts = await get_collection_parts(cid)
+            selected_parts = parts[skip : skip + 40]
+        else:
+            tasks = [get_collection_parts(cid) for _, cid in SAGAS]
+            collections_parts = await asyncio.gather(*tasks, return_exceptions=True)
+            first_parts = []
+            for res in collections_parts:
+                if isinstance(res, list) and res:
+                    first_parts.append(res[0])
+            selected_parts = first_parts[skip : skip + 40]
+
+        sem = asyncio.Semaphore(10)
+        cache_updated = False
+
+        async def resolve_imdb(tmdb_id: int) -> str | None:
+            nonlocal cache_updated
+            cache_key = f"movie:{tmdb_id}"
+            if cache_key in _IMDB_MAP:
+                return _IMDB_MAP[cache_key]
+            async with sem:
+                data = await tmdb._get_json(
+                    f"movie/{tmdb_id}/external_ids", f"movie external_ids {tmdb_id}"
+                )
+                if isinstance(data, dict):
+                    imdb_id = data.get("imdb_id")
+                    if isinstance(imdb_id, str) and imdb_id.startswith("tt"):
+                        _IMDB_MAP[cache_key] = imdb_id
+                        cache_updated = True
+                        return imdb_id
+            return None
+
+        imdb_ids = await asyncio.gather(
+            *[resolve_imdb(it["id"]) for it in selected_parts],
+            return_exceptions=True,
+        )
+
+        if cache_updated:
+            await asyncio.to_thread(_save_imdb_map)
+
+        metas = []
+        for it, imdb_id in zip(selected_parts, imdb_ids):
+            if not isinstance(imdb_id, str) or not imdb_id.startswith("tt"):
+                continue
+            poster_path = it.get("poster_path")
+            backdrop_path = it.get("backdrop_path")
+            name = it.get("title") or it.get("original_title") or ""
+            date_str = it.get("release_date") or ""
+            year = date_str[:4] if len(date_str) >= 4 else ""
+            vote_avg = it.get("vote_average")
+            rating_str = f"{float(vote_avg):.1f}" if vote_avg is not None else ""
+
+            metas.append({
+                "id": imdb_id,
+                "type": "movie",
+                "name": name,
+                "poster": f"https://image.tmdb.org/t/p/w500{poster_path}" if poster_path else None,
+                "background": f"https://image.tmdb.org/t/p/w1280{backdrop_path}" if backdrop_path else None,
+                "description": it.get("overview") or "",
+                "releaseInfo": year,
+                "imdbRating": rating_str,
+            })
+        return metas
+
+
+def _strip_accents(s: str) -> str:
+    return "".join(
+        c for c in unicodedata.normalize("NFD", s)
+        if unicodedata.category(c) != "Mn"
+    ).lower()
+
+
+async def _fetch_person_items(media_type: str, query: str, kids: bool = False) -> list[dict]:
+    _ensure_imdb_map_loaded()
+    q_encoded = urllib.parse.quote(query)
+    tmdb_type = "movie" if media_type == "movie" else "tv"
+
+    timeout = aiohttp.ClientTimeout(total=8.0)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        tmdb = TMDBApi(session)
+        person_data = await tmdb._get_json(
+            f"search/person?query={q_encoded}&language=pt-BR",
+            f"search person {query}",
+        )
+        if not isinstance(person_data, dict) or not isinstance(person_data.get("results"), list):
+            return []
+
+        words = _strip_accents(query).split()
+        matches = [
+            p
+            for p in person_data["results"]
+            if isinstance(p, dict) and all(w in _strip_accents(p.get("name", "")) for w in words)
+        ]
+        if not matches:
+            return []
+
+        matches.sort(key=lambda x: x.get("popularity", 0), reverse=True)
+        best_person = matches[0]
+        person_id = best_person.get("id")
+        if not person_id:
+            return []
+
+        if media_type == "movie":
+            credits_data = await tmdb._get_json(
+                f"person/{person_id}/movie_credits?language=pt-BR",
+                f"person movie credits {person_id}",
+            )
+            cast = credits_data.get("cast", []) if isinstance(credits_data, dict) else []
+            crew = [
+                c
+                for c in credits_data.get("crew", [])
+                if isinstance(c, dict) and c.get("job") == "Director"
+            ] if isinstance(credits_data, dict) else []
+            raw_candidates = cast + crew
+        else:
+            credits_data = await tmdb._get_json(
+                f"person/{person_id}/tv_credits?language=pt-BR",
+                f"person tv credits {person_id}",
+            )
+            raw_candidates = (
+                credits_data.get("cast", [])
+                if isinstance(credits_data, dict)
+                else []
+            )
+
+        unique_items = {}
+        for it in raw_candidates:
+            if not isinstance(it, dict):
+                continue
+            cid = it.get("id")
+            if media_type != "movie":
+                # sem talk show/jornal/reality, sem "Himself/Self" e sem participacao de 1-2 episodios
+                if set(it.get("genre_ids") or []) & {10767, 10763, 10764}:
+                    continue
+                if "self" in str(it.get("character") or "").lower():
+                    continue
+                if (it.get("episode_count") or 0) < 3:
+                    continue
+            if cid and cid not in unique_items and it.get("poster_path"):
+                unique_items[cid] = it
+
+        sorted_items = sorted(
+            unique_items.values(),
+            key=lambda x: x.get("popularity", 0),
+            reverse=True,
+        )
+
+        if kids:
+            if media_type == "movie":
+                checks = await asyncio.gather(
+                    *[_check_kids_movie_allowed(tmdb, it["id"], it.get("genre_ids", [])) for it in sorted_items[:50]],
+                    return_exceptions=True,
+                )
+                filtered = [
+                    it for it, ok in zip(sorted_items[:50], checks)
+                    if ok is True
+                ]
+                sorted_items = filtered
+            else:
+                sorted_items = [
+                    it for it in sorted_items
+                    if any(g in (10762, 10751, 16) for g in (it.get("genre_ids") or []))
+                ]
+
+        items_slice = sorted_items[:40]
+
+        sem = asyncio.Semaphore(10)
+        cache_updated = False
+
+        async def resolve_imdb(tmdb_id: int) -> str | None:
+            nonlocal cache_updated
+            cache_key = f"{tmdb_type}:{tmdb_id}"
+            if cache_key in _IMDB_MAP:
+                return _IMDB_MAP[cache_key]
+            async with sem:
+                data = await tmdb._get_json(
+                    f"{tmdb_type}/{tmdb_id}/external_ids",
+                    f"{tmdb_type} external_ids {tmdb_id}",
+                )
+                if isinstance(data, dict):
+                    imdb_id = data.get("imdb_id")
+                    if isinstance(imdb_id, str) and imdb_id.startswith("tt"):
+                        _IMDB_MAP[cache_key] = imdb_id
+                        cache_updated = True
+                        return imdb_id
+            return None
+
+        imdb_ids = await asyncio.gather(
+            *[resolve_imdb(it["id"]) for it in items_slice],
+            return_exceptions=True,
+        )
+
+        if cache_updated:
+            await asyncio.to_thread(_save_imdb_map)
+
+        metas = []
+        for it, imdb_id in zip(items_slice, imdb_ids):
+            if not isinstance(imdb_id, str) or not imdb_id.startswith("tt"):
+                continue
+            poster_path = it.get("poster_path")
+            backdrop_path = it.get("backdrop_path")
+            name = (
+                it.get("title") or it.get("original_title") or ""
+                if media_type == "movie"
+                else it.get("name") or it.get("original_name") or ""
+            )
+            date_str = (
+                it.get("release_date")
+                if media_type == "movie"
+                else it.get("first_air_date")
+            ) or ""
+            year = date_str[:4] if len(date_str) >= 4 else ""
+            vote_avg = it.get("vote_average")
+            rating_str = f"{float(vote_avg):.1f}" if vote_avg is not None else ""
+
+            metas.append({
+                "id": imdb_id,
+                "type": media_type,
+                "name": name,
+                "poster": f"https://image.tmdb.org/t/p/w500{poster_path}" if poster_path else None,
+                "background": f"https://image.tmdb.org/t/p/w1280{backdrop_path}" if backdrop_path else None,
+                "description": it.get("overview") or "",
+                "releaseInfo": year,
+                "imdbRating": rating_str,
+            })
+
+        return metas
+
+
+async def get_catalog(
+    media_type: str,
+    catalog_id: str,
+    extra: dict | None = None,
+    base_url: str = "",
+    kids: bool = False,
+) -> list[dict]:
+    if not base_url:
+        # chamadas internas (warmup) nao tem request: sem isso o cache guarda posters relativos
+        base_url = (getattr(settings, "PUBLIC_BASE_URL", None) or "").rstrip("/")
+    if catalog_id in ("comet_mylist", "comet_newep", "comet_foryou"):
+        if kids or not getattr(settings, "STREMIO_AUTH_KEY", None):
+            return []
+        from comet.services.stremio_library import get_stremio_catalog
+        return await get_stremio_catalog(
+            media_type=media_type,
+            catalog_id=catalog_id,
+            extra=extra,
+            base_url=base_url,
+        )
+
+    if catalog_id == "comet_search":
+        extra = extra or {}
+        search_query = extra.get("search")
+        if not search_query or not str(search_query).strip():
+            return []
+        q = str(search_query).strip()
+        search_cache_key = (media_type, "comet_search", q.lower(), kids)
+        cached_search = _get_cached_search(search_cache_key)
+        if cached_search is not None:
+            return cached_search
+        try:
+            async with asyncio.timeout(10.0):
+                metas = await _fetch_search_items(media_type, q, kids=kids)
+                if metas:
+                    _set_cached_search(search_cache_key, metas)
+                return metas
+        except TimeoutError:
+            logger.warning(f"Search catalog timeout for {media_type}/{q}")
+            return []
+        except Exception as e:
+            logger.warning(
+                f"Search catalog error for {media_type}/{q}: {type(e).__name__}"
+            )
+            return []
+
+    if catalog_id == "comet_person":
+        extra = extra or {}
+        search_query = extra.get("search")
+        if not search_query or not str(search_query).strip():
+            return []
+        q = str(search_query).strip()
+        search_cache_key = (media_type, "comet_person", q.lower(), kids)
+        cached_search = _get_cached_search(search_cache_key)
+        if cached_search is not None:
+            return cached_search
+        try:
+            async with asyncio.timeout(10.0):
+                metas = await _fetch_person_items(media_type, q, kids=kids)
+                if metas:
+                    _set_cached_search(search_cache_key, metas)
+                return metas
+        except TimeoutError:
+            logger.warning(f"Person search timeout for {media_type}/{q}")
+            return []
+        except Exception as e:
+            logger.warning(
+                f"Person search error for {media_type}/{q}: {type(e).__name__}"
+            )
+            return []
+
+    if catalog_id == "comet_ready":
+        extra = extra or {}
+        skip_raw = extra.get("skip", 0)
+        try:
+            skip = int(skip_raw)
+        except (ValueError, TypeError):
+            skip = 0
+        cache_key = (media_type, "comet_ready", skip)
+        cached = _get_cached_catalog(cache_key)
+        if cached is not None:
+            return cached
+        try:
+            async with asyncio.timeout(15.0):
+                metas = await _fetch_ready_items(media_type, skip, base_url=base_url)
+                if metas:
+                    _set_cached_catalog(cache_key, metas)
+                return metas
+        except TimeoutError:
+            logger.warning(f"Ready catalog timeout for {media_type}")
+            return []
+        except Exception as e:
+            logger.warning(
+                f"Ready catalog error for {media_type}: {type(e).__name__}"
+            )
+            return []
+
+    if catalog_id == "comet_saga":
+        if media_type != "movie":
+            return []
+        extra = extra or {}
+        genre = extra.get("genre")
+        skip_raw = extra.get("skip", 0)
+        try:
+            skip = int(skip_raw)
+        except (ValueError, TypeError):
+            skip = 0
+        cache_key = (media_type, "comet_saga", genre, skip)
+        cached = _get_cached_catalog(cache_key)
+        if cached is not None:
+            return cached
+        try:
+            async with asyncio.timeout(10.0):
+                metas = await _fetch_saga_items(genre, skip)
+                if metas:
+                    _set_cached_catalog(cache_key, metas)
+                return metas
+        except TimeoutError:
+            logger.warning("Saga catalog timeout")
+            return []
+        except Exception as e:
+            logger.warning(
+                f"Saga catalog error: {type(e).__name__}"
+            )
+            return []
+
+    extra = extra or {}
+    genre = extra.get("genre")
+    skip_raw = extra.get("skip", 0)
+    try:
+        skip = int(skip_raw)
+    except (ValueError, TypeError):
+        skip = 0
+
+    cache_key = (media_type, catalog_id, genre, skip, kids)
+    cached = _get_cached_catalog(cache_key)
+    if cached is not None:
+        return cached
+
+    try:
+        async with asyncio.timeout(10.0):
+            metas = await _fetch_catalog_items(
+                media_type, catalog_id, genre, skip, base_url=base_url, kids=kids
+            )
+            if metas:
+                _set_cached_catalog(cache_key, metas)
+            return metas
+    except TimeoutError:
+        logger.warning(f"Catalog timeout for {media_type}/{catalog_id}")
+        return []
+    except Exception as e:
+        logger.warning(
+            f"Catalog error for {media_type}/{catalog_id}: {type(e).__name__}"
+        )
+        return []
