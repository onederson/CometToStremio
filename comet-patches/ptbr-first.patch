+                    else item.get("first_air_date")
+                )
+                if rel_date and rel_date > today_str:
+                    continue
+            seen_tmdb_ids.add(tid)
+            unique_raw_items.append(item)
+            if catalog_id == "comet_top10" and len(unique_raw_items) >= 15:
+                break
+
+        tmdb_type = "movie" if media_type == "movie" else "tv"
+        sem = asyncio.Semaphore(10)
+        cache_updated = False
+        landscape_cache_updated = False
+
+        is_landscape = (
+            getattr(settings, "CATALOG_LANDSCAPE", True)
+            and not kids
+            and catalog_id != "comet_top10"
