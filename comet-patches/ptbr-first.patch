+async def _resolve_landscape_data(
+    tmdb: TMDBApi,
+    media_type: str,
+    tmdb_id: int,
+    fallback_backdrop: str | None = None,
+    sem: asyncio.Semaphore | None = None,
+) -> dict | None:
+    _ensure_landscape_map_loaded()
+    tmdb_type = "movie" if media_type == "movie" else "tv"
+    cache_key = f"{tmdb_type}:{tmdb_id}"
+    if cache_key in _LANDSCAPE_MAP:
+        val = _LANDSCAPE_MAP[cache_key]
+        if isinstance(val, dict) and "backdrop" in val:
+            return val
+
+    async def _fetch():
+        data = await tmdb._get_json(
+            f"{tmdb_type}/{tmdb_id}/images?include_image_language=pt,en,null",
+            f"{tmdb_type} images {tmdb_id}",
+        )
+        chosen_backdrop = None
+        chosen_logo = None
+        if isinstance(data, dict):
+            backdrops = data.get("backdrops")
+            if isinstance(backdrops, list) and backdrops:
+                null_bds = [
+                    b.get("file_path")
+                    for b in backdrops
+                    if isinstance(b, dict)
+                    and (b.get("iso_639_1") is None or b.get("iso_639_1") == "null")
+                    and b.get("file_path")
+                ]
+                if null_bds:
+                    chosen_backdrop = null_bds[0]
+                else:
+                    any_bds = [
+                        b.get("file_path")
+                        for b in backdrops
+                        if isinstance(b, dict) and b.get("file_path")
+                    ]
+                    if any_bds:
+                        chosen_backdrop = any_bds[0]
+
+            logos = data.get("logos")
+            if isinstance(logos, list) and logos:
+                valid_logos = [
+                    l
+                    for l in logos
+                    if isinstance(l, dict)
+                    and l.get("file_path")
+                    and l.get("file_path", "").lower().endswith(".png")
+                ]
+                pt_logos = [l for l in valid_logos if l.get("iso_639_1") == "pt"]
+                if pt_logos:
+                    pt_logos.sort(key=lambda x: float(x.get("vote_average") or 0.0), reverse=True)
+                    chosen_logo = pt_logos[0].get("file_path")
+                else:
+                    en_logos = [l for l in valid_logos if l.get("iso_639_1") == "en"]
+                    if en_logos:
+                        en_logos.sort(key=lambda x: float(x.get("vote_average") or 0.0), reverse=True)
+                        chosen_logo = en_logos[0].get("file_path")
+
+        if not chosen_backdrop and fallback_backdrop:
+            chosen_backdrop = fallback_backdrop
+
+        res = {
+            "backdrop": chosen_backdrop.lstrip("/") if chosen_backdrop else None,
+            "logo": chosen_logo.lstrip("/") if chosen_logo else None,
+        }
+        _LANDSCAPE_MAP[cache_key] = res
+        return res
+
+    if sem:
+        async with sem:
+            res = await _fetch()
+    else:
+        res = await _fetch()
+
+    await asyncio.to_thread(_save_landscape_map)
+    return res
+
