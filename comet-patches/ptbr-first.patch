+            or err.error_code == "UNAVAILABLE_FOR_LEGAL_REASONS"
+            or err.upstream_error_code == "infringing_file"
+        ):
+            await _record_debrid_blocked_hash("realdebrid", info_hash, "infringing_file")
+            logger.log("PLAYBACK", f"🚫 RD bloqueou (451) no pré-resolve do Assistir: {info_hash}")
+    except Exception as e:
