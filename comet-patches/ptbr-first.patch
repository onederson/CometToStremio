+async def ensure_watch_provider_table():
+    global _WP_TABLE_INIT
+    if _WP_TABLE_INIT:
+        return
+    async with _WP_TABLE_LOCK:
+        if not _WP_TABLE_INIT:
+            try:
+                await database.execute(
+                    """
+                    CREATE TABLE IF NOT EXISTS watch_provider (
+                        media_key TEXT PRIMARY KEY,
+                        provider_id INT,
+                        logo_path TEXT,
+                        fetched_at INT
+                    )
+                    """
+                )
+                _WP_TABLE_INIT = True
+            except Exception as e:
+                logger.warning(f"Error ensuring watch_provider table: {e}")
+
+
+def pick_best_provider(flatrate_list: list[dict]) -> tuple[int | None, str | None]:
+    if not flatrate_list:
+        return None, None
+    valid = [p for p in flatrate_list if isinstance(p, dict) and p.get("provider_id")]
+    if not valid:
+        return None, None
+
+    def _sort_key(p):
+        pid = p.get("provider_id")
+        disp = p.get("display_priority")
+        if disp is None:
+            disp = 999
+        if pid in PREFERRED_ORDER:
+            return (0, PREFERRED_ORDER[pid], disp)
+        return (1, disp, 0)
+
+    best = min(valid, key=_sort_key)
+    pid = best.get("provider_id")
+    logo = best.get("logo_path")
+    return pid, logo
+
+
+async def preload_watch_providers(media_keys: list[str]):
+    if not media_keys:
+        return
+    await ensure_watch_provider_table()
+    now = time.time()
+    needed = [k for k in media_keys if k not in _WP_MEM_CACHE or (now - _WP_MEM_CACHE[k][0] >= _WP_TTL)]
+    if not needed:
+        return
+    try:
+        placeholders = ",".join(f":k{i}" for i in range(len(needed)))
+        params = {f"k{i}": k for i, k in enumerate(needed)}
+        rows = await database.fetch_all(
+            f"SELECT media_key, provider_id, logo_path, fetched_at FROM watch_provider WHERE media_key IN ({placeholders})",
+            params,
+        )
+        for r in rows:
+            mk = r["media_key"]
+            pid = r["provider_id"]
+            lp = r["logo_path"]
+            fa = float(r["fetched_at"] or 0)
+            if now - fa < _WP_TTL:
+                _WP_MEM_CACHE[mk] = (fa, pid, lp)
+                if pid and lp:
+                    _PROVIDER_LOGO_PATH_CACHE[pid] = lp
+    except Exception as e:
+        logger.warning(f"Error preloading watch_providers: {e}")
+
+
+async def resolve_single_watch_provider(
+    tmdb_type: str,
+    tmdb_id: int,
+    session: aiohttp.ClientSession,
+    tmdb,
+) -> int | None:
+    media_key = f"{tmdb_type}:{tmdb_id}"
+    now = time.time()
+    if media_key in _WP_MEM_CACHE:
+        fa, pid, lp = _WP_MEM_CACHE[media_key]
+        if now - fa < _WP_TTL:
+            return pid
+
+    async with _WP_SEMAPHORE:
+        if media_key in _WP_MEM_CACHE:
+            fa, pid, lp = _WP_MEM_CACHE[media_key]
+            if now - fa < _WP_TTL:
+                return pid
+
+        pid = None
+        lp = None
+        try:
+            data = await tmdb._get_json(
+                f"{tmdb_type}/{tmdb_id}/watch/providers",
+                f"watch providers {tmdb_type} {tmdb_id}",
+            )
+            flatrate = []
+            if isinstance(data, dict):
+                flatrate = data.get("results", {}).get("BR", {}).get("flatrate", [])
+            pid, lp = pick_best_provider(flatrate)
+        except Exception as e:
+            logger.warning(f"Failed to fetch watch providers for {media_key}: {e}")
+
+        _WP_MEM_CACHE[media_key] = (now, pid, lp)
+        if pid and lp:
+            _PROVIDER_LOGO_PATH_CACHE[pid] = lp
+
+        try:
+            await database.execute(
+                """
+                INSERT OR REPLACE INTO watch_provider (media_key, provider_id, logo_path, fetched_at)
+                VALUES (:mk, :pid, :lp, :fa)
+                """,
+                {"mk": media_key, "pid": pid, "lp": lp, "fa": int(now)},
+            )
+        except Exception as e:
+            logger.warning(f"Failed to save watch_provider for {media_key}: {e}")
+
+        return pid
+
+
+async def resolve_watch_providers(
+    media_type: str,
+    items: list[dict],
+    session: aiohttp.ClientSession,
+    tmdb,
+) -> dict[int, int | None]:
+    if not items:
+        return {}
+    tmdb_type = "movie" if media_type == "movie" else "tv"
+    valid_items = [it for it in items if isinstance(it, dict) and it.get("id")]
+    if not valid_items:
+        return {}
+
+    media_keys = [f"{tmdb_type}:{it['id']}" for it in valid_items]
+    await preload_watch_providers(media_keys)
+
+    tasks = [
+        resolve_single_watch_provider(tmdb_type, it["id"], session, tmdb)
+        for it in valid_items
+    ]
+    results = await asyncio.gather(*tasks, return_exceptions=True)
+
+    out = {}
+    for it, res in zip(valid_items, results):
+        tid = it["id"]
+        out[tid] = res if isinstance(res, int) else None
+    return out
+
