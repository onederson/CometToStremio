+def _get_providers_list() -> list[str]:
+    raw = getattr(settings, "CATALOG_PROVIDERS", list(PROVIDERS.keys()))
+    if isinstance(raw, str):
+        s = raw.strip()
+        if s.startswith("[") and s.endswith("]"):
+            try:
+                parsed = json.loads(s)
+                if isinstance(parsed, list):
+                    return [str(p).strip().lower() for p in parsed if str(p).strip()]
+            except Exception:
+                pass
+        return [p.strip().lower() for p in s.split(",") if p.strip()]
+    elif isinstance(raw, list):
+        return [str(p).strip().lower() for p in raw if str(p).strip()]
+    return list(PROVIDERS.keys())
+
+
+def build_manifest_catalogs() -> list[dict]:
+    catalogs = [
+        {
+            "type": "movie",
+            "id": "comet_trending",
+            "name": "Em alta",
+            "extra": [
+                {"name": "skip", "isRequired": False},
+            ],
+        },
+        {
+            "type": "series",
+            "id": "comet_trending",
+            "name": "Em alta",
+            "extra": [
+                {"name": "skip", "isRequired": False},
+            ],
+        },
+    ]
+
+    for p in _get_providers_list():
+        if p not in PROVIDERS:
+            continue
+        name, _ = PROVIDERS[p]
+        # Serie primeiro, depois filme
+        catalogs.append(
+            {
+                "type": "series",
+                "id": f"comet_{p}",
+                "name": name,
+                "extra": [
+                    {"name": "genre", "options": TV_GENRE_OPTIONS, "isRequired": False},
+                    {"name": "skip", "isRequired": False},
+                ],
+            }
+        )
+        catalogs.append(
+            {
+                "type": "movie",
+                "id": f"comet_{p}",
+                "name": name,
+                "extra": [
+                    {"name": "genre", "options": MOVIE_GENRE_OPTIONS, "isRequired": False},
+                    {"name": "skip", "isRequired": False},
+                ],
+            }
+        )
+
+    catalogs.append(
+        {
+            "type": "series",
+            "id": "comet_anime",
+            "name": "Animes",
+            "extra": [
+                {"name": "genre", "options": TV_GENRE_OPTIONS, "isRequired": False},
+                {"name": "skip", "isRequired": False},
+            ],
+        }
+    )
+
+    catalogs.append(
+        {
+            "type": "movie",
+            "id": "comet_search",
+            "name": "Busca",
+            "extra": [
+                {"name": "search", "isRequired": True},
+            ],
+        }
+    )
+    catalogs.append(
+        {
+            "type": "series",
+            "id": "comet_search",
+            "name": "Busca",
+            "extra": [
+                {"name": "search", "isRequired": True},
+            ],
+        }
+    )
+
+    return catalogs
