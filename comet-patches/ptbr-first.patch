+                t_is_pt = "pt" in (getattr(parsed, "languages", None) or ())
+                if not t_is_pt:
+                    continue
+                rd_cached = (service_cache_status.get(h, {}) or {}).get("realdebrid", False)
+                if rd_cached:
+                    continue
+                if h.lower() in blocked_by_service.get("realdebrid", ()):
+                    continue
+                precheck_candidates.append(
+                    {
+                        "info_hash": h,
+                        "title": t.get("title", ""),
+                        "sources": t.get("sources"),
+                    }
+                )
+                if len(precheck_candidates) >= 3:
+                    break
+
+            if precheck_candidates:
+                background_tasks.add_task(
+                    run_debrid_precheck,
+                    rd_tokens[0],
+                    get_client_ip(request),
+                    precheck_candidates,
+                )
 
     has_results = len(final_streams) > 0
 
