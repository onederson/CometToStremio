+    619: "/bPqd9nypuR4iA3o2a93K5lK4Fh8.png",   # Star Plus
+}
+
+PREFERRED_PROVIDERS = [8, 119, 337, 1899, 384, 350, 531, 307, 283, 619]
+PREFERRED_ORDER = {pid: i for i, pid in enumerate(PREFERRED_PROVIDERS)}
+PREFERRED_ORDER[384] = PREFERRED_ORDER[1899]
