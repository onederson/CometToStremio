+        for t in titles:
+            if t in release_norm:
+                matches.append((len(t), season))
+
+    if not matches:
+        return False
+
+    max_len = max(m[0] for m in matches)
+    for length, season in matches:
+        if length == max_len and season == requested_season:
+            return False
+
+    return True
