+def _apply_clean_layout(
+    final_streams: list[dict],
+    notice_count: int,
+    blocked_hashes: set[str] | None = None,
+) -> tuple[list[dict], dict | None, list[dict]]:
+    for s in final_streams:
+        info = s.get("_info")
+        if not info:
+            continue
+        kind = info.get("kind", "rd")
+        cached = bool(info.get("cached"))
+        is_cam = bool(info.get("is_cam"))
+        is_pt = bool(info.get("is_pt"))
+        dub_kind = info.get("dub_kind")
+
+        if kind == "p2p":
+            status = "⚠️"
+        elif cached:
+            status = "⚡"
+        else:
+            status = "⬇️"
+
+        res = _format_resolution(info.get("resolution"))
+
+        has_pt = info.get("has_pt")
+        audio_langs_str = info.get("_audio_langs_str")
+        claimed_pt_false = info.get("claimed_pt_false")
+
+        if not is_pt:
+            idioma = "🌐 Original"
+        elif dub_kind == "dublado":
+            idioma = "🇧🇷 Dublado"
+        elif dub_kind == "dual":
+            idioma = "🇧🇷 Dual áudio"
+        elif dub_kind == "pt":
+            idioma = "🇧🇷 PT-BR"
+        else:
+            idioma = "🌐 Original"
+
+        if has_pt == 1:
+            idioma = idioma.replace("🇧🇷", "🇧🇷✔")
+
+        if is_cam:
+            s["name"] = f"{status} {res}\n🎦 CAM"
+        else:
+            s["name"] = f"{status} {res}\n{idioma}"
+
+        quality = info.get("quality")
+        audio = info.get("audio")
+        tamanho = _format_size_gb(info.get("size"))
+        line1_parts = [p for p in [quality, audio, tamanho] if p]
+        line1 = " · ".join(line1_parts) if line1_parts else None
+
+        audio_line = None
+        if has_pt == 1 and audio_langs_str:
+            audio_line = f"🔊 {audio_langs_str}"
+        elif has_pt == 0 and claimed_pt_false:
+            if audio_langs_str:
+                audio_line = f"🔊 {audio_langs_str} (sem português)"
+            else:
+                audio_line = "🔊 (sem português)"
+
+        deb_svc = str(info.get("debrid_service") or info.get("service") or "").lower()
+        svc_name = "TorBox" if ("torbox" in deb_svc or deb_svc == "tb") else "Real-Debrid"
+
+        if is_cam:
+            line2 = "🎦 Gravação de cinema"
+        elif kind == "p2p":
+            line2 = "⚠️ Direto do torrent (P2P)"
+        elif cached:
+            line2 = f"⚡ Pronto no {svc_name}"
+        else:
+            line2 = f"⬇️ O {svc_name} baixa antes de tocar"
+
+        raw_title = info.get("raw_title") or ""
+        if kind == "p2p":
+            line3 = f"📄 {raw_title[:70]}" if raw_title else None
+        else:
+            line3 = f"{svc_name} · 📄 {raw_title[:70]}" if raw_title else svc_name
+
+        desc_lines = [l for l in [line1, audio_line, line2, line3] if l]
+        s["description"] = "\n".join(desc_lines)
+
+        service = "p2p" if kind == "p2p" else str(info.get("service") or "RD")
+        lang_tag = "pt" if is_pt else "xx"
+        group = (info.get("group") or "").lower()
+        if "behaviorHints" not in s or not isinstance(s["behaviorHints"], dict):
+            s["behaviorHints"] = {}
+        s["behaviorHints"]["bingeGroup"] = f"comet|{service}|{res}|{lang_tag}|{group}"
+
+    best_stream = None
+    best_meta = None
+    candidates = final_streams[notice_count:]
+    blocked_set = {h.lower() for h in (blocked_hashes or ())}
+
+    def _dub_label(info):
+        has_pt_val = info.get("has_pt")
+        flag = "🇧🇷✔" if has_pt_val == 1 else "🇧🇷"
+        dk = info.get("dub_kind")
+        if dk == "dublado":
+            return f"{flag} Dublado"
+        if dk == "dual":
+            return f"{flag} Dual áudio"
+        return f"{flag} PT-BR"
+
+    def _res_pref(info):
+        # 1080p primeiro (leve e bonito na TV), depois 4K, 720p e o resto
+        r = str(info.get("resolution") or "").lower()
+        return {"1080p": 0, "2160p": 1, "4k": 1, "1440p": 1, "720p": 2}.get(r, 3)
+
+    def _pick(pred):
+        best_key = None
+        chosen = None
+        for idx, cand in enumerate(candidates):
+            info = cand.get("_info")
+            if not info or not pred(info):
+                continue
+            if info.get("kind") == "p2p":
+                continue
+            if not info.get("cached"):
+                continue
+            deb_svc = str(info.get("debrid_service") or info.get("service") or "").lower()
+            chash = str(info.get("info_hash") or "").lower()
+            if not ("torbox" in deb_svc or deb_svc == "tb"):
+                if chash and chash in blocked_set:
+                    continue
+            too_big = (info.get("size") or 0) > 30 * 1024**3
+            key = (too_big, _res_pref(info), idx)
+            if best_key is None or key < best_key:
+                best_key, chosen = key, cand
+        return chosen
+
+    # 1) dublado/dual pronto no RD (prefere 1080p e arquivos ate 30 GB)
+    # Prefer has_pt == 1; NEVER choose has_pt == 0 as dublado.
+    chosen = _pick(
+        lambda i: i.get("cached")
+        and i.get("is_pt")
+        and not i.get("is_cam")
+        and i.get("has_pt") == 1
+    )
+    if not chosen:
+        chosen = _pick(
+            lambda i: i.get("cached")
+            and i.get("is_pt")
+            and not i.get("is_cam")
+            and i.get("has_pt") != 0
+        )
+    if chosen:
+        info = chosen["_info"]
+        best_stream = chosen
+        best_meta = (_dub_label(info), _format_resolution(info.get("resolution")), _format_size_gb(info.get("size")))
+
+    # 2) link direto em PT-BR (validado)
+    if not best_stream:
+        for cand in candidates:
+            if (cand.get("_is_direct") or cand.get("_is_direct_pt")) and cand.get("_is_pt"):
+                best_stream = cand
+                best_meta = ("🇧🇷 PT-BR", cand.get("_res") or "HD", None)
+                break
+
+    # 3) qualquer um pronto no RD (audio original) cujo hash nao esta em 451
+    if not best_stream:
+        chosen = _pick(lambda i: i.get("cached") and not i.get("is_cam"))
+        if chosen:
+            info = chosen["_info"]
+            best_stream = chosen
+            best_meta = ("🌐 Original", _format_resolution(info.get("resolution")), _format_size_gb(info.get("size")))
+
+    # 4) link direto validado (original)
+    if not best_stream:
+        for cand in candidates:
+            if cand.get("_is_direct") or cand.get("_is_direct_pt"):
+                best_stream = cand
+                best_meta = ("🌐 Original", cand.get("_res") or "HD", None)
+                break
+
+    if best_stream and best_meta:
+        idioma, res, tamanho = best_meta
+        copy_stream = dict(best_stream)
+        if "behaviorHints" in best_stream and isinstance(best_stream["behaviorHints"], dict):
+            copy_stream["behaviorHints"] = dict(best_stream["behaviorHints"])
+        else:
+            copy_stream["behaviorHints"] = {}
+        copy_stream["name"] = f"▶ Assistir\n{res}"
+        desc_parts = [p for p in [idioma, res, tamanho] if p]
+        desc_line1 = ' · '.join(desc_parts)
+        b_info = best_stream.get("_info") or {}
+        b_langs = b_info.get("_audio_langs_str")
+        if b_info.get("has_pt") == 1 and b_langs:
+            copy_stream["description"] = f"{desc_line1}\n🔊 {b_langs}\nMelhor opção escolhida pelo Comet"
+        else:
+            copy_stream["description"] = f"{desc_line1}\nMelhor opção escolhida pelo Comet"
+
+        is_best_dublado = (
+            bool(b_info.get("is_pt"))
+            or bool(best_stream.get("_is_pt"))
+            or bool(best_stream.get("_is_direct_pt"))
+            or ("🇧🇷" in str(idioma))
+        )
+        if is_best_dublado:
+            best_lang_tag = "pt"
+        else:
+            langs = b_info.get("languages") or best_stream.get("_languages")
+            if langs and isinstance(langs, list) and langs[0]:
+                best_lang_tag = str(langs[0]).lower()
+            elif b_info.get("_audio_langs_str"):
+                best_lang_tag = b_info["_audio_langs_str"].split(",")[0].strip().lower()
+            else:
+                best_lang_tag = "xx"
+
+        copy_stream["behaviorHints"]["bingeGroup"] = f"comet|best|{best_lang_tag}"
+
+        final_streams.insert(notice_count, copy_stream)
+
+    pt_cand_list = [
+        cand
+        for idx, cand in enumerate(candidates)
+        if (
+            cand.get("_info")
+            and cand["_info"].get("cached")
+            and cand["_info"].get("is_pt")
+            and not cand["_info"].get("is_cam")
+            and cand["_info"].get("kind") != "p2p"
+            and not (
+                (cand["_info"].get("info_hash") or "").lower() in blocked_set
+                and "torbox" not in str(cand["_info"].get("debrid_service") or cand["_info"].get("service") or "").lower()
+            )
+            and cand["_info"].get("has_pt") != 0
+        )
+    ]
+    pt_cand_list.sort(key=lambda c: (
+        (c["_info"].get("size") or 0) > 30 * 1024**3,
+        _res_pref(c["_info"]),
+        candidates.index(c)
+    ))
+    next_pt_candidates = [
+        c["_info"] for c in pt_cand_list if c is not best_stream
+    ][:2]
+
+    return final_streams, best_stream, next_pt_candidates
+
