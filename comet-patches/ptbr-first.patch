+                frac_part = re.split(r"[+-]", frac)[0]
+                tz_part = clean[len(base) + 1 + len(frac_part) :]
+                clean = f"{base}.{frac_part[:6]}{tz_part}"
+            dt = datetime.datetime.fromisoformat(clean)
+            if dt.tzinfo is None:
