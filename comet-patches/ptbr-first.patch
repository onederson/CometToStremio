+def _build_animation_frames(
+    scenes: list[Image.Image],
+    W: int,
+    H: int,
+    fps: int,
+    still_sec: float,
+    trans_sec: float,
+) -> list[Image.Image]:
+    W_max, H_max = round(W * 1.03), round(H * 1.03)
+    still_count = max(1, round(still_sec * fps))
+    trans_count = max(1, round(trans_sec * fps))
+
+    cropped_scenes = []
+    for im in scenes:
+        scale = max(W_max / im.width, H_max / im.height)
+        nw, nh = round(im.width * scale), round(im.height * scale)
+        res = im.resize((nw, nh), Image.Resampling.BILINEAR)
+        x0 = (nw - W_max) // 2
+        y0 = (nh - H_max) // 2
+        cropped_scenes.append(res.crop((x0, y0, x0 + W_max, y0 + H_max)))
+
+    scene_frames = []
+    for idx, sc in enumerate(cropped_scenes):
+        frs = []
+        zoom_in = (idx % 2 == 0)
+        for f in range(still_count):
+            p = f / (still_count - 1) if still_count > 1 else 0.0
+            if not zoom_in:
+                p = 1.0 - p
+            cw = round(W_max - p * (W_max - W))
+            ch = round(H_max - p * (H_max - H))
+            x0 = (W_max - cw) // 2
+            y0 = (H_max - ch) // 2
+            fr = sc.crop((x0, y0, x0 + cw, y0 + ch)).resize((W, H), Image.Resampling.BILINEAR)
+            frs.append(fr)
+        scene_frames.append(frs)
+
+    all_frames = []
+    n = len(scene_frames)
+    for i in range(n):
+        all_frames.extend(scene_frames[i])
+        next_i = (i + 1) % n
+        last_cur = scene_frames[i][-1]
+        first_next = scene_frames[next_i][0]
+        for t in range(1, trans_count + 1):
+            alpha = t / (trans_count + 1)
+            all_frames.append(Image.blend(last_cur, first_next, alpha))
+
+    return all_frames
+
+
+def _encode_webp(all_frames: list[Image.Image], duration_ms: int, quality: int = 70) -> bytes:
+    buf = io.BytesIO()
+    all_frames[0].save(
+        buf,
+        format="WEBP",
+        save_all=True,
+        append_images=all_frames[1:],
+        duration=duration_ms,
+        loop=0,
+        quality=quality,
+        method=4,
+    )
+    return buf.getvalue()
+
+
+def _encode_gif(all_frames: list[Image.Image], duration_ms: int, colors: int = 64) -> bytes:
+    palette_img = all_frames[0].quantize(colors=colors, method=Image.Quantize.MEDIANCUT)
+    p_frames = [f.quantize(palette=palette_img) for f in all_frames]
+    buf = io.BytesIO()
+    p_frames[0].save(
+        buf,
+        format="GIF",
+        save_all=True,
+        append_images=p_frames[1:],
+        duration=duration_ms,
+        loop=0,
+        optimize=True,
+    )
+    return buf.getvalue()
+
