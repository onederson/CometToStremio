+import asyncio
+import hashlib
+import os
+import time
+import urllib.parse
+from fastapi import APIRouter, HTTPException, Request, Response
+from fastapi.responses import JSONResponse
+
+from RTN import parse
+
+from comet.services.subtitles import is_known_pt_filename
+from comet.services.filtering import apply_ptbr_detection
+from comet.core.config_validation import config_check
+from comet.core.logger import logger
+from comet.core.models import settings
+from comet.services.subtitle_sync import align_srt_detail
+from comet.services.sub_translate import ensure_auto_translated
+from comet.services.subtitles import (
+    DISK_CACHE_TTL,
+    SUBS_CACHE_DIR,
+    fetch_subtitle,
+    search_subtitles,
+)
+
+router = APIRouter()
+
+
+@router.get(
+    "/subtitles/{media_type}/{media_id}.json",
+    tags=["Stremio"],
+    summary="Subtitles Provider",
+    description="Returns a list of subtitles for the specified media.",
+)
+@router.get(
+    "/subtitles/{media_type}/{media_id}/{extra}.json",
+    tags=["Stremio"],
+    summary="Subtitles Provider",
+    description="Returns a list of subtitles for the specified media with extra parameters.",
+)
+@router.get(
+    "/{b64config}/subtitles/{media_type}/{media_id}.json",
+    tags=["Stremio"],
+    summary="Subtitles Provider",
+    description="Returns a list of subtitles with configuration.",
+)
+@router.get(
+    "/{b64config}/subtitles/{media_type}/{media_id}/{extra}.json",
+    tags=["Stremio"],
+    summary="Subtitles Provider",
+    description="Returns a list of subtitles with configuration and extra parameters.",
+)
+async def get_subtitles(
+    request: Request,
+    media_type: str,
+    media_id: str,
+    extra: str | None = None,
+    b64config: str | None = None,
+):
+    clean_id = media_id.removesuffix(".json")
+    if media_type == "series" and clean_id.startswith("tt") and ":" not in clean_id:
+        media_type = "movie"
+        media_id = clean_id
+
+    if not settings.SUBTITLES_ENABLED:
+        return JSONResponse(
+            content={"subtitles": []},
+            headers={"Cache-Control": "max-age=3600"},
+        )
+
+    try:
+        if b64config:
+            config = config_check(b64config)
+            if not config:
+                return JSONResponse(
+                    content={"subtitles": []},
+                    headers={"Cache-Control": "max-age=3600"},
+                )
+
+        filename = None
+        video_hash = None
+        if extra:
+            parsed = urllib.parse.parse_qs(extra)
+            if "filename" in parsed and parsed["filename"]:
+                filename = parsed["filename"][0]
+            if "videoHash" in parsed and parsed["videoHash"]:
+                video_hash = parsed["videoHash"][0]
+
+        if not filename and "filename" in request.query_params:
+            filename = request.query_params.get("filename")
+        if not video_hash and "videoHash" in request.query_params:
+            video_hash = request.query_params.get("videoHash")
+
+        if filename:
+            is_pt = ".direct.PTBR" in filename or is_known_pt_filename(filename)
+            if not is_pt:
+                try:
+                    rtn_data = parse(filename)
+                    try:
+                        apply_ptbr_detection(rtn_data, filename)
+                    except Exception:
+                        pass
+                    is_pt = "pt" in (getattr(rtn_data, "languages", None) or ())
+                except Exception:
+                    is_pt = False
+            if is_pt:
+                logger.info(f"🗒️ Legendas puladas (áudio PT): {filename[:80]}")
+                return JSONResponse(
+                    content={"subtitles": []},
+                    headers={"Cache-Control": "max-age=3600"},
+                )
+
+        base_url = (
+            settings.PUBLIC_BASE_URL
+            if settings.PUBLIC_BASE_URL
+            else f"{request.url.scheme}://{request.url.netloc}"
+        )
+
+        subtitles = await search_subtitles(
+            media_type=media_type,
+            media_id=media_id,
+            filename=filename,
+            video_hash=video_hash,
+            base_url=base_url,
+        )
+        return JSONResponse(
+            content={"subtitles": subtitles},
+            headers={"Cache-Control": "max-age=3600"},
+        )
+    except Exception as e:
+        logger.warning(f"Error handling subtitles request: {type(e).__name__}")
+        return JSONResponse(
+            content={"subtitles": []},
+            headers={"Cache-Control": "max-age=3600"},
+        )
+
+
+@router.get(
+    "/subs/{provider}/{sub_id}/{season}/{episode}.srt",
+    tags=["Stremio"],
+    summary="Subtitle Download",
+    description="Downloads the subtitle file in SRT format.",
+)
+@router.get(
+    "/{b64config}/subs/{provider}/{sub_id}/{season}/{episode}.srt",
+    tags=["Stremio"],
+    summary="Subtitle Download",
+    description="Downloads the subtitle file in SRT format with configuration.",
+)
+async def get_subtitle_file(
+    provider: str,
+    sub_id: str,
+    season: int,
+    episode: int,
+    b64config: str | None = None,
+):
+    sub_bytes = await fetch_subtitle(
+        provider=provider,
+        sub_id=sub_id,
+        season=season,
+        episode=episode,
+    )
+    if not sub_bytes:
+        raise HTTPException(status_code=404, detail="Subtitle not found")
+
+    return Response(
+        content=sub_bytes,
+        media_type="application/x-subrip; charset=utf-8",
+        headers={
+            "Access-Control-Allow-Origin": "*",
+            "Cache-Control": "max-age=86400",
+        },
+    )
+
+
+@router.get(
+    "/subs/auto/{provider}/{sub_id}/{season}/{episode}.srt",
+    tags=["Stremio"],
+    summary="Auto-translated Subtitle Download",
+    description="Downloads an auto-translated subtitle file in SRT format.",
+)
+@router.get(
+    "/{b64config}/subs/auto/{provider}/{sub_id}/{season}/{episode}.srt",
+    tags=["Stremio"],
+    summary="Auto-translated Subtitle Download",
+    description="Downloads an auto-translated subtitle file in SRT format with configuration.",
+)
+async def get_auto_subtitle_file(
+    provider: str,
+    sub_id: str,
+    season: int,
+    episode: int,
+    b64config: str | None = None,
+):
+    sub_bytes = await ensure_auto_translated(
+        provider=provider,
+        sub_id=sub_id,
+        season=season,
+        episode=episode,
+    )
+    if not sub_bytes:
+        raise HTTPException(status_code=404, detail="Subtitle not found")
+
+    return Response(
+        content=sub_bytes,
+        media_type="application/x-subrip; charset=utf-8",
+        headers={
+            "Access-Control-Allow-Origin": "*",
+            "Cache-Control": "max-age=86400",
+        },
+    )
+
+
+@router.get(
+    "/subs/sync/{provider}/{sub_id}/{season}/{episode}/{ref_provider}/{ref_id}.srt",
+    tags=["Stremio"],
+    summary="Synchronized Subtitle Download",
+    description="Downloads a synchronized subtitle file in SRT format.",
+)
+@router.get(
+    "/{b64config}/subs/sync/{provider}/{sub_id}/{season}/{episode}/{ref_provider}/{ref_id}.srt",
+    tags=["Stremio"],
+    summary="Synchronized Subtitle Download",
+    description="Downloads a synchronized subtitle file in SRT format with configuration.",
+)
+async def get_sync_subtitle_file(
+    provider: str,
+    sub_id: str,
+    season: int,
+    episode: int,
+    ref_provider: str,
+    ref_id: str,
+    b64config: str | None = None,
+):
+    os.makedirs(SUBS_CACHE_DIR, exist_ok=True)
+    cache_key_str = (
+        f"{provider}:{sub_id}:{season}:{episode}:{ref_provider}:{ref_id}"
+    )
+    cache_hash = hashlib.sha1(cache_key_str.encode("utf-8")).hexdigest()
+    sync_cache_file = os.path.join(SUBS_CACHE_DIR, f"sync-{cache_hash}.srt")
+
+    if os.path.exists(sync_cache_file):
+        try:
+            mtime = os.path.getmtime(sync_cache_file)
+            if (time.time() - mtime) < DISK_CACHE_TTL:
+                with open(sync_cache_file, "rb") as f:
+                    cached_bytes = f.read()
+                return Response(
+                    content=cached_bytes,
+                    media_type="application/x-subrip; charset=utf-8",
+                    headers={
+                        "Access-Control-Allow-Origin": "*",
+                        "Cache-Control": "max-age=86400",
+                    },
+                )
+        except Exception:
+            pass
+
+    target_bytes, ref_bytes = await asyncio.gather(
+        fetch_subtitle(
+            provider=provider,
+            sub_id=sub_id,
+            season=season,
+            episode=episode,
+        ),
+        fetch_subtitle(
+            provider=ref_provider,
+            sub_id=ref_id,
+            season=season,
+            episode=episode,
+        ),
+    )
+
+    if not target_bytes:
+        raise HTTPException(status_code=404, detail="Subtitle not found")
+
+    if not ref_bytes:
+        logger.info(
+            f"🗒️ Sync {provider}-{sub_id} com ref {ref_provider}-{ref_id}: não aplicado (ref não encontrada)"
+        )
+        return Response(
+            content=target_bytes,
+            media_type="application/x-subrip; charset=utf-8",
+            headers={
+                "Access-Control-Allow-Origin": "*",
+                "Cache-Control": "max-age=86400",
+            },
+        )
+
+    try:
+        target_srt = target_bytes.decode("utf-8", errors="replace")
+        ref_srt = ref_bytes.decode("utf-8", errors="replace")
+        aligned_srt, stats = await asyncio.to_thread(
+            align_srt_detail, target_srt, ref_srt
+        )
+        if aligned_srt is not None:
+            logger.info(
+                f"🗒️ Sync {provider}-{sub_id} com ref {ref_provider}-{ref_id}: "
+                f"razão {round(stats['ratio'], 4)}, desloc {stats['offset_ms']} ms, "
+                f"encaixe {stats['before']:.2f}→{stats['after']:.2f}"
+            )
+            out_bytes = aligned_srt.encode("utf-8")
+            try:
+                with open(sync_cache_file, "wb") as f:
+                    f.write(out_bytes)
+            except Exception:
+                pass
+            return Response(
+                content=out_bytes,
+                media_type="application/x-subrip; charset=utf-8",
+                headers={
+                    "Access-Control-Allow-Origin": "*",
+                    "Cache-Control": "max-age=86400",
+                },
+            )
+        else:
+            logger.info(
+                f"🗒️ Sync {provider}-{sub_id} com ref {ref_provider}-{ref_id}: "
+                f"não aplicado ({stats['before']:.2f}→{stats['after']:.2f})"
+            )
+            return Response(
+                content=target_bytes,
+                media_type="application/x-subrip; charset=utf-8",
+                headers={
+                    "Access-Control-Allow-Origin": "*",
+                    "Cache-Control": "max-age=86400",
+                },
+            )
+    except Exception as e:
+        logger.warning(
+            f"🗒️ Sync {provider}-{sub_id} com ref {ref_provider}-{ref_id}: "
+            f"erro ({type(e).__name__}), servindo original"
+        )
+        return Response(
+            content=target_bytes,
+            media_type="application/x-subrip; charset=utf-8",
+            headers={
+                "Access-Control-Allow-Origin": "*",
+                "Cache-Control": "max-age=86400",
+            },
+        )
+
+
+@router.get(
+    "/subs/dual/{provider}/{sub_id}/{season}/{episode}.srt",
+    tags=["Stremio"],
+    summary="Dual Language Subtitle Download",
+    description="Downloads a dual language (PT + EN) subtitle file in SRT format.",
+)
+@router.get(
+    "/{b64config}/subs/dual/{provider}/{sub_id}/{season}/{episode}.srt",
+    tags=["Stremio"],
+    summary="Dual Language Subtitle Download",
+    description="Downloads a dual language (PT + EN) subtitle file in SRT format with configuration.",
+)
+async def get_dual_subtitle_file(
+    provider: str,
+    sub_id: str,
+    season: int,
+    episode: int,
+    b64config: str | None = None,
+):
+    os.makedirs(SUBS_CACHE_DIR, exist_ok=True)
+    cache_key_str = f"dual:{provider}:{sub_id}:{season}:{episode}"
+    cache_hash = hashlib.sha1(cache_key_str.encode("utf-8")).hexdigest()
+    dual_cache_file = os.path.join(SUBS_CACHE_DIR, f"dual-{cache_hash}.srt")
+
+    if os.path.exists(dual_cache_file):
+        try:
+            mtime = os.path.getmtime(dual_cache_file)
+            if (time.time() - mtime) < DISK_CACHE_TTL:
+                with open(dual_cache_file, "rb") as f:
+                    cached_bytes = f.read()
+                return Response(
+                    content=cached_bytes,
+                    media_type="application/x-subrip; charset=utf-8",
+                    headers={
+                        "Access-Control-Allow-Origin": "*",
+                        "Cache-Control": "max-age=86400",
+                    },
+                )
+        except Exception:
+            pass
+
+    en_bytes = await fetch_subtitle(
+        provider=provider,
+        sub_id=sub_id,
+        season=season,
+        episode=episode,
+    )
+    if not en_bytes:
+        raise HTTPException(status_code=404, detail="English subtitle not found")
+
+    pt_bytes = await ensure_auto_translated(
+        provider=provider,
+        sub_id=sub_id,
+        season=season,
+        episode=episode,
+    )
+    if not pt_bytes:
+        raise HTTPException(status_code=502, detail="Failed to translate subtitle")
+
+    try:
+        en_srt = en_bytes.decode("utf-8", errors="replace")
+        pt_srt = pt_bytes.decode("utf-8", errors="replace")
+
+        from comet.services.sub_translate import clean_cue_text, parse_srt_cues
+
+        en_cues = parse_srt_cues(en_srt)
+        pt_cues = parse_srt_cues(pt_srt)
+
+        blocks = []
+        for idx, en_cue in enumerate(en_cues):
+            time_str = en_cue["time"]
+            pt_text = clean_cue_text(pt_cues[idx]["text"]) if idx < len(pt_cues) else ""
+            en_text = clean_cue_text(en_cue["text"])
+            blocks.append(f"{idx + 1}\n{time_str}\n{pt_text}\n<i>{en_text}</i>")
+
+        dual_srt = "\n\n".join(blocks) + "\n"
+        out_bytes = dual_srt.encode("utf-8")
+
+        try:
+            with open(dual_cache_file, "wb") as f:
+                f.write(out_bytes)
+        except Exception as e:
+            logger.warning(f"Erro ao salvar cache dual-srt: {e}")
+
+        return Response(
+            content=out_bytes,
+            media_type="application/x-subrip; charset=utf-8",
+            headers={
+                "Access-Control-Allow-Origin": "*",
+                "Cache-Control": "max-age=86400",
+            },
+        )
+    except HTTPException:
+        raise
+    except Exception as e:
+        logger.warning(f"Erro ao montar legenda dual ({type(e).__name__}): {e}")
+        return Response(
+            content=en_bytes,
+            media_type="application/x-subrip; charset=utf-8",
+            headers={
+                "Access-Control-Allow-Origin": "*",
+                "Cache-Control": "max-age=86400",
+            },
+        )
diff --git a/comet/core/breaker.py b/comet/core/breaker.py
new file mode 100644
index 0000000..eea7d2f
--- /dev/null
+++ b/comet/core/breaker.py
@@ -0,0 +1,193 @@
+import re
+import threading
+import time
+from datetime import datetime
+
+from comet.core.logger import logger
+from comet.core.models import settings
+
+EXCLUDED_SOURCES = {
+    "realdebrid",
+    "real-debrid",
+    "torbox",
+    "stremthru",
+    "tmdb",
+    "cinemeta",
+}
+
+_lock = threading.RLock()
+
+
+def _is_excluded(name: str) -> bool:
+    clean = name.strip().lower().replace(" ", "").replace("_", "").replace("-", "")
+    for exc in EXCLUDED_SOURCES:
+        exc_clean = exc.lower().replace("-", "")
+        if clean == exc_clean or clean.startswith(exc_clean):
+            return True
+    return False
+
+
+def _clean_name(name: str) -> str:
+    return name.split(" #")[0].removesuffix("Scraper").strip()
+
+
+def _format_min(seconds: float) -> str:
+    m = seconds / 60.0
+    if m.is_integer():
+        return str(int(m))
+    return f"{m:.1f}"
+
+
+class SourceState:
+    def __init__(self, name: str, default_pause: float = 600.0):
+        self.name: str = name
+        self.fails_streak: int = 0
+        self.pause_duration: float = default_pause
+        self.paused_until: float = 0.0
+        self.state: str = "closed"  # "closed" | "open" | "half_open"
+        self.in_flight: bool = False
+        self.trial_at: float = 0.0
+
+
+_sources: dict[str, SourceState] = {}
+
+
+def reset():
+    """Resets all breaker states (useful for tests)."""
+    with _lock:
+        _sources.clear()
+
+
+def is_open(name: str, now: float | None = None) -> bool:
+    clean = _clean_name(name)
+    if _is_excluded(clean):
+        return False
+    if not getattr(settings, "SOURCE_BREAKER", True):
+        return False
+
+    if now is None:
+        now = time.time()
+
+    with _lock:
+        st = _sources.get(clean)
+        if st is None or st.state == "closed":
+            return False
+
+        if st.state == "open":
+            if now < st.paused_until:
+                return True
+            else:
+                # Pause has expired -> let 1 trial request pass
+                st.state = "half_open"
+                st.in_flight = True
+                st.trial_at = now
+                return False
+
+        if st.state == "half_open":
+            if st.in_flight and (now - st.trial_at) < 120:
+                return True
+            st.in_flight = True
+            st.trial_at = now
+            return False
+
+        return False
+
+
+def record(name: str, ok: bool, now: float | None = None):
+    clean = _clean_name(name)
+    if _is_excluded(clean):
+        return
+    if not getattr(settings, "SOURCE_BREAKER", True):
+        return
+
+    if now is None:
+        now = time.time()
+
+    default_pause = float(getattr(settings, "SOURCE_BREAKER_PAUSE", 600))
+    fail_threshold = int(getattr(settings, "SOURCE_BREAKER_FAILS", 3))
+
+    with _lock:
+        st = _sources.get(clean)
+        if st is None:
+            st = SourceState(clean, default_pause=default_pause)
+            _sources[clean] = st
+
+        if ok:
+            was_open_or_half = (st.state in ("open", "half_open"))
+            st.fails_streak = 0
+            st.pause_duration = default_pause
+            st.paused_until = 0.0
+            st.state = "closed"
+            st.in_flight = False
+            if was_open_or_half:
+                logger.info(f"▶️ {clean} voltou")
+        else:
+            if st.state == "half_open":
+                st.fails_streak += 1
+                st.pause_duration = min(3600.0, st.pause_duration * 2.0)
+                st.paused_until = now + st.pause_duration
+                st.state = "open"
+                st.in_flight = False
+                min_str = _format_min(st.pause_duration)
+                logger.warning(
+                    f"⏸️ {clean} pausada {min_str} min ({st.fails_streak} falhas seguidas)"
+                )
+            elif st.state == "open":
+                st.fails_streak += 1
+            else:  # closed
+                st.fails_streak += 1
+                if st.fails_streak >= fail_threshold:
+                    st.state = "open"
+                    st.in_flight = False
+                    st.pause_duration = default_pause
+                    st.paused_until = now + st.pause_duration
+                    min_str = _format_min(st.pause_duration)
+                    logger.warning(
+                        f"⏸️ {clean} pausada {min_str} min ({st.fails_streak} falhas seguidas)"
+                    )
+
+
+def get_state(name: str, now: float | None = None) -> str:
+    clean = _clean_name(name)
+    if _is_excluded(clean) or not getattr(settings, "SOURCE_BREAKER", True):
+        return "ok"
+
+    if now is None:
+        now = time.time()
+
+    with _lock:
+        st = _sources.get(clean)
+        if st is None or st.state == "closed":
+            return "ok"
+
+        if st.state == "half_open":
+            return "testando"
+
+        if st.state == "open":
+            if now < st.paused_until:
+                hh_mm = datetime.fromtimestamp(st.paused_until).strftime("%H:%M")
+                return f"pausada até {hh_mm}"
+            else:
+                return "testando"
+
+        return "ok"
+
+
+def snapshot(now: float | None = None) -> list[dict]:
+    if now is None:
+        now = time.time()
+
+    with _lock:
+        res = []
+        for name, st in sorted(_sources.items()):
+            state_str = get_state(name, now=now)
+            res.append(
+                {
+                    "name": name,
+                    "state": state_str,
+                    "fails": st.fails_streak,
+                    "pause_duration": st.pause_duration,
+                    "paused_until": st.paused_until,
+                }
+            )
+        return res
diff --git a/comet/core/config_validation.py b/comet/core/config_validation.py
index 44bf701..6524e2f 100644
--- a/comet/core/config_validation.py
+++ b/comet/core/config_validation.py
@@ -112,12 +112,62 @@ def _parse_and_validate_config(b64config: str):
         return None
 
 
+def is_kids_request(b64config: str | None) -> bool:
+    if not b64config or not settings.KIDS_LINK_TOKEN:
+        return False
+    return b64config == settings.KIDS_LINK_TOKEN
+
+
