+                if not isinstance(d1, dict) or not d1.get("results"):
+                    return []
+                items = list(d1.get("results", []))
+                if d1.get("total_pages", 1) >= 2 and len(items) < 30:
+                    qs2 = urllib.parse.urlencode({**q_params, "page": 2})
+                    d2 = await tmdb._get_json(
+                        f"discover/{tmdb_type}?{qs2}",
+                        f"discover {tmdb_type} {query} p2",
+                    )
+                    if isinstance(d2, dict) and d2.get("results"):
+                        items.extend(d2.get("results", []))
