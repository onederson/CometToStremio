+        return []
+
+    _ensure_imdb_map_loaded()
+    page1 = (skip // 40) * 2 + 1
+    page2 = page1 + 1
+
+    query1 = _build_tmdb_path_and_params(media_type, catalog_id, genre, page1, kids=kids)
+    if not query1:
+        return []
+
+    query2 = (
+        None
+        if catalog_id == "comet_top10"
+        else _build_tmdb_path_and_params(media_type, catalog_id, genre, page2, kids=kids)
+    )
+
+    path1, params1 = query1
+    url1 = f"{path1}?{urllib.parse.urlencode(params1)}"
+    url2 = (
+        f"{query2[0]}?{urllib.parse.urlencode(query2[1])}" if query2 else None
+    )
+
+    timeout = aiohttp.ClientTimeout(total=8.0)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
