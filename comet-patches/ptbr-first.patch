+def _raw_build_tmdb_path_and_params(
+    media_type: str, catalog_id: str, genre: str | None, page: int
+) -> tuple[str, dict] | None:
+    region = getattr(settings, "CATALOG_REGION", "BR")
+    language = getattr(settings, "CATALOG_LANGUAGE", "pt-BR")
+    tmdb_type = "movie" if media_type == "movie" else "tv"
+    today = datetime.date.today()
+    today_str = today.isoformat()
+
+    if catalog_id == "comet_kids_anim":
+        if media_type != "movie":
+            return None
+        return "discover/movie", {
+            "with_genres": 16,
+            "language": language,
+            "page": page,
+            "sort_by": "popularity.desc",
+            "vote_count.gte": 20,
+        }
+
+    if catalog_id == "comet_kids_tv":
+        if media_type != "series":
+            return None
+        return "discover/tv", {
+            "with_genres": "10762",
+            "without_genres": "10767,10763,10764",
+            "language": language,
+            "page": page,
+            "sort_by": "popularity.desc",
+            "vote_count.gte": 20,
+        }
+
+    if catalog_id == "comet_anime_season":
+        if media_type != "series":
+            return None
+        q_month = ((today.month - 1) // 3) * 3 + 1
+        start_date = datetime.date(today.year, q_month, 1).isoformat()
+        end_date = (today + datetime.timedelta(days=7)).isoformat()
+        return "discover/tv", {
+            "with_genres": 16,
+            "with_original_language": "ja",
+            "air_date.gte": start_date,
+            "air_date.lte": end_date,
+            "sort_by": "popularity.desc",
+            "vote_count.gte": 5,
+            "language": language,
+            "page": page,
+        }
+
+    if catalog_id == "comet_top10":
+        path = f"trending/{tmdb_type}/day"
+        params = {
+            "language": language,
+            "page": page,
+        }
+        return path, params
+
+    if catalog_id in (
+        "comet_br",
+        "comet_action",
+        "comet_comedy",
+        "comet_horror",
+        "comet_crime",
+        "comet_kdrama",
+        "comet_family",
+        "comet_docs",
+    ):
+        all_providers = "|".join(
+            str(PROVIDERS[p][1]) for p in _get_providers_list() if p in PROVIDERS
+        )
+        base_params = {
+            "watch_region": region,
+            "with_watch_providers": all_providers,
+            "language": language,
+            "page": page,
+            "sort_by": "popularity.desc",
+            "vote_count.gte": 200,
+        }
+
+        if catalog_id == "comet_br":
+            base_params["with_origin_country"] = "BR"
+            base_params["vote_count.gte"] = 20
+            return f"discover/{tmdb_type}", base_params
+
+        if catalog_id == "comet_action":
+            base_params["without_genres"] = "16,10751"
+            if media_type != "movie":
+                return None
+            base_params["with_genres"] = "28|12"
+            return "discover/movie", base_params
+
+        if catalog_id == "comet_comedy":
+            base_params["without_genres"] = "16,10751"
+            if media_type != "movie":
+                return None
+            base_params["with_genres"] = 35
+            return "discover/movie", base_params
+
+        if catalog_id == "comet_horror":
+            base_params["without_genres"] = "16,10751"
+            if media_type != "movie":
+                return None
+            base_params["with_genres"] = 27
+            return "discover/movie", base_params
+
+        if catalog_id == "comet_crime":
+            if media_type != "series":
+                return None
+            base_params["with_genres"] = "80|9648"
+            base_params["without_genres"] = "10763,10764,10766,10767"
