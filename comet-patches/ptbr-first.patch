+def check_channel_chain(url: str, timeout: float = 8.0) -> tuple[bool, str]:
+    headers = {"User-Agent": "ExoPlayerLib/2.19.1"}
+    try:
+        if any(ord(c) < 32 or ord(c) == 127 for c in url):
+            return False, "control characters in url"
+        with httpx.Client(headers=headers, follow_redirects=True, timeout=timeout) as client:
+            r = client.get(url)
+            if r.status_code != 200:
+                return False, f"master status {r.status_code}"
+            txt = r.text
+            if not txt.startswith("#EXTM3U") and "#EXTM3U" not in txt[:100]:
+                return False, "master sem EXTM3U"
+
+            lines = [l.strip() for l in txt.splitlines() if l.strip() and not l.strip().startswith("#")]
+            if not lines:
+                return False, "master sem variantes"
+
+            var_url = urllib.parse.urljoin(str(r.url), lines[0])
+            r_var = client.get(var_url)
+            if r_var.status_code != 200:
+                return False, f"variante status {r_var.status_code}"
+            var_txt = r_var.text
+            if not var_txt.startswith("#EXTM3U") and "#EXTM3U" not in var_txt[:100]:
+                return False, "variante sem EXTM3U"
+
+            segs = [l.strip() for l in var_txt.splitlines() if l.strip() and not l.strip().startswith("#")]
+            if not segs:
+                return False, "variante sem segmentos"
+
+            for s in segs:
+                s_lower = s.lower()
+                if "takedownslate" in s_lower or "slate" in s_lower:
+                    return False, "slate"
+
+            seg_idx = min(2, len(segs) - 1)
+            seg_target = segs[seg_idx]
+            if any(ord(c) < 32 or ord(c) == 127 for c in seg_target):
+                return False, "control characters in segment"
+
+            seg_url = urllib.parse.urljoin(str(r_var.url), seg_target)
+            if "takedownslate" in seg_url.lower() or "slate" in seg_url.lower():
+                return False, "slate"
+
+            with client.stream("GET", seg_url) as s_resp:
+                if s_resp.status_code != 200:
+                    return False, f"segmento status {s_resp.status_code}"
+                chunk = next(s_resp.iter_bytes(4096), b"")
+                if len(chunk) < 100:
+                    return False, f"segmento vazio ({len(chunk)}B)"
+                return True, "ok"
+    except Exception as e:
+        return False, f"erro {type(e).__name__}: {str(e)[:60]}"
+
