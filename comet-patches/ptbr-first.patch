+    "/{b64config}/subtitles/{media_type}/{media_id}.json",
+    tags=["Stremio"],
+    summary="Subtitles Provider",
+    description="Returns a list of subtitles with configuration.",
+)
+@router.get(
+    "/{b64config}/subtitles/{media_type}/{media_id}/{extra}.json",
+    tags=["Stremio"],
+    summary="Subtitles Provider",
+    description="Returns a list of subtitles with configuration and extra parameters.",
+)
+async def get_subtitles(
+    request: Request,
+    media_type: str,
+    media_id: str,
+    extra: str | None = None,
+    b64config: str | None = None,
+):
+    if not settings.SUBTITLES_ENABLED:
+        return JSONResponse(
+            content={"subtitles": []},
+            headers={"Cache-Control": "max-age=3600"},
+        )
+
+    try:
+        if b64config:
+            config = config_check(b64config)
+            if not config:
+                return JSONResponse(
+                    content={"subtitles": []},
+                    headers={"Cache-Control": "max-age=3600"},
+                )
+
+        filename = None
+        video_hash = None
+        if extra:
+            parsed = urllib.parse.parse_qs(extra)
+            if "filename" in parsed and parsed["filename"]:
+                filename = parsed["filename"][0]
+            if "videoHash" in parsed and parsed["videoHash"]:
+                video_hash = parsed["videoHash"][0]
+
+        if not filename and "filename" in request.query_params:
+            filename = request.query_params.get("filename")
+        if not video_hash and "videoHash" in request.query_params:
+            video_hash = request.query_params.get("videoHash")
+
+        if filename:
+            is_pt = ".direct.PTBR" in filename or is_known_pt_filename(filename)
+            if not is_pt:
+                try:
+                    rtn_data = parse(filename)
+                    try:
+                        apply_ptbr_detection(rtn_data, filename)
+                    except Exception:
+                        pass
+                    is_pt = "pt" in (getattr(rtn_data, "languages", None) or ())
+                except Exception:
+                    is_pt = False
+            if is_pt:
+                logger.info(f"🗒️ Legendas puladas (áudio PT): {filename[:80]}")
+                return JSONResponse(
+                    content={"subtitles": []},
+                    headers={"Cache-Control": "max-age=3600"},
+                )
+
+        base_url = (
+            settings.PUBLIC_BASE_URL
+            if settings.PUBLIC_BASE_URL
+            else f"{request.url.scheme}://{request.url.netloc}"
+        )
+
+        subtitles = await search_subtitles(
+            media_type=media_type,
+            media_id=media_id,
+            filename=filename,
+            video_hash=video_hash,
+            base_url=base_url,
+        )
+        return JSONResponse(
+            content={"subtitles": subtitles},
+            headers={"Cache-Control": "max-age=3600"},
+        )
+    except Exception as e:
+        logger.warning(f"Error handling subtitles request: {type(e).__name__}")
+        return JSONResponse(
+            content={"subtitles": []},
+            headers={"Cache-Control": "max-age=3600"},
+        )
+
+
+@router.get(
+    "/subs/{provider}/{sub_id}/{season}/{episode}.srt",
+    tags=["Stremio"],
+    summary="Subtitle Download",
+    description="Downloads the subtitle file in SRT format.",
+)
+@router.get(
+    "/{b64config}/subs/{provider}/{sub_id}/{season}/{episode}.srt",
+    tags=["Stremio"],
+    summary="Subtitle Download",
+    description="Downloads the subtitle file in SRT format with configuration.",
+)
+async def get_subtitle_file(
+    provider: str,
+    sub_id: str,
+    season: int,
+    episode: int,
+    b64config: str | None = None,
+):
+    sub_bytes = await fetch_subtitle(
+        provider=provider,
+        sub_id=sub_id,
+        season=season,
+        episode=episode,
+    )
+    if not sub_bytes:
+        raise HTTPException(status_code=404, detail="Subtitle not found")
+
+    return Response(
+        content=sub_bytes,
+        media_type="application/x-subrip; charset=utf-8",
+        headers={
+            "Access-Control-Allow-Origin": "*",
+            "Cache-Control": "max-age=86400",
+        },
+    )
+
+
+@router.get(
+    "/subs/sync/{provider}/{sub_id}/{season}/{episode}/{ref_provider}/{ref_id}.srt",
+    tags=["Stremio"],
+    summary="Synchronized Subtitle Download",
+    description="Downloads a synchronized subtitle file in SRT format.",
+)
+@router.get(
+    "/{b64config}/subs/sync/{provider}/{sub_id}/{season}/{episode}/{ref_provider}/{ref_id}.srt",
+    tags=["Stremio"],
+    summary="Synchronized Subtitle Download",
+    description="Downloads a synchronized subtitle file in SRT format with configuration.",
+)
+async def get_sync_subtitle_file(
+    provider: str,
+    sub_id: str,
+    season: int,
+    episode: int,
+    ref_provider: str,
+    ref_id: str,
+    b64config: str | None = None,
+):
+    os.makedirs(SUBS_CACHE_DIR, exist_ok=True)
+    cache_key_str = (
+        f"{provider}:{sub_id}:{season}:{episode}:{ref_provider}:{ref_id}"
+    )
+    cache_hash = hashlib.sha1(cache_key_str.encode("utf-8")).hexdigest()
+    sync_cache_file = os.path.join(SUBS_CACHE_DIR, f"sync-{cache_hash}.srt")
+
+    if os.path.exists(sync_cache_file):
+        try:
+            mtime = os.path.getmtime(sync_cache_file)
+            if (time.time() - mtime) < DISK_CACHE_TTL:
+                with open(sync_cache_file, "rb") as f:
+                    cached_bytes = f.read()
+                return Response(
+                    content=cached_bytes,
+                    media_type="application/x-subrip; charset=utf-8",
+                    headers={
+                        "Access-Control-Allow-Origin": "*",
+                        "Cache-Control": "max-age=86400",
+                    },
+                )
+        except Exception:
+            pass
+
+    target_bytes, ref_bytes = await asyncio.gather(
+        fetch_subtitle(
+            provider=provider,
+            sub_id=sub_id,
+            season=season,
+            episode=episode,
+        ),
+        fetch_subtitle(
+            provider=ref_provider,
+            sub_id=ref_id,
+            season=season,
+            episode=episode,
+        ),
+    )
+
+    if not target_bytes:
+        raise HTTPException(status_code=404, detail="Subtitle not found")
+
+    if not ref_bytes:
+        logger.info(
+            f"🗒️ Sync {provider}-{sub_id} com ref {ref_provider}-{ref_id}: não aplicado (ref não encontrada)"
+        )
+        return Response(
+            content=target_bytes,
+            media_type="application/x-subrip; charset=utf-8",
+            headers={
+                "Access-Control-Allow-Origin": "*",
+                "Cache-Control": "max-age=86400",
+            },
+        )
+
+    try:
+        target_srt = target_bytes.decode("utf-8", errors="replace")
+        ref_srt = ref_bytes.decode("utf-8", errors="replace")
+        aligned_srt, stats = await asyncio.to_thread(
+            align_srt_detail, target_srt, ref_srt
+        )
+        if aligned_srt is not None:
+            logger.info(
+                f"🗒️ Sync {provider}-{sub_id} com ref {ref_provider}-{ref_id}: "
+                f"razão {round(stats['ratio'], 4)}, desloc {stats['offset_ms']} ms, "
+                f"encaixe {stats['before']:.2f}→{stats['after']:.2f}"
+            )
+            out_bytes = aligned_srt.encode("utf-8")
+            try:
+                with open(sync_cache_file, "wb") as f:
+                    f.write(out_bytes)
+            except Exception:
+                pass
+            return Response(
+                content=out_bytes,
+                media_type="application/x-subrip; charset=utf-8",
+                headers={
+                    "Access-Control-Allow-Origin": "*",
+                    "Cache-Control": "max-age=86400",
+                },
+            )
+        else:
+            logger.info(
+                f"🗒️ Sync {provider}-{sub_id} com ref {ref_provider}-{ref_id}: "
+                f"não aplicado ({stats['before']:.2f}→{stats['after']:.2f})"
+            )
+            return Response(
+                content=target_bytes,
+                media_type="application/x-subrip; charset=utf-8",
+                headers={
+                    "Access-Control-Allow-Origin": "*",
+                    "Cache-Control": "max-age=86400",
+                },
+            )
+    except Exception as e:
+        logger.warning(
+            f"🗒️ Sync {provider}-{sub_id} com ref {ref_provider}-{ref_id}: "
+            f"erro ({type(e).__name__}), servindo original"
+        )
+        return Response(
+            content=target_bytes,
+            media_type="application/x-subrip; charset=utf-8",
+            headers={
+                "Access-Control-Allow-Origin": "*",
+                "Cache-Control": "max-age=86400",
+            },
+        )
