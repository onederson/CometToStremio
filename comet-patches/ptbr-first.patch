+"""
+Stremio library service for personal catalogs:
+- Minha lista (comet_mylist)
+- Novos episódios (comet_newep)
+- Recomendados para você (comet_foryou)
+"""
+from __future__ import annotations
+
+import asyncio
+import datetime
+import time
+from typing import Any
+
+import aiohttp
+
+from comet.core.logger import logger
+from comet.core.models import settings
+from comet.metadata.tmdb import TMDBApi
+from comet.services.catalogs import (
+    _TV_LAST_EP_CACHE,
+    _resolve_find_imdb,
+    _resolve_imdb_id,
+    _resolve_landscape_data,
+)
+
+STREMIO_DATASTORE_URL = "https://api.strem.io/api/datastoreGet"
+
+# In-memory library cache (10 minutes)
+_LIBRARY_CACHE: tuple[float, list[dict[str, Any]]] = (0.0, [])
+_LIBRARY_CACHE_KEY: str | None = None
+_LIBRARY_CACHE_TTL = 10 * 60  # 10 minutes
+
+# In-memory catalog results cache (15 minutes)
+_CATALOG_CACHE: dict[tuple, tuple[float, list[dict[str, Any]]]] = {}
+_CATALOG_CACHE_TTL = 15 * 60  # 15 minutes
+
+
+def _parse_timestamp(val: Any) -> str:
+    if val is None:
+        return ""
+    if isinstance(val, (int, float)):
+        try:
+            return datetime.datetime.fromtimestamp(
+                val / 1000 if val > 1e11 else val, datetime.timezone.utc
+            ).isoformat()
+        except Exception:
+            return str(val)
+    return str(val)
+
+
+async def get_stremio_library(auth_key: str | None = None) -> list[dict[str, Any]]:
+    global _LIBRARY_CACHE, _LIBRARY_CACHE_KEY
+    if auth_key is None:
+        auth_key = getattr(settings, "STREMIO_AUTH_KEY", None)
+    if not auth_key:
+        return []
+
+    now = time.time()
+    cached_time, cached_items = _LIBRARY_CACHE
+    if _LIBRARY_CACHE_KEY == auth_key and (now - cached_time) < _LIBRARY_CACHE_TTL:
+        return cached_items
+
+    timeout = aiohttp.ClientTimeout(total=10.0)
+    payload = {
+        "authKey": auth_key,
+        "collection": "libraryItem",
+        "ids": [],
+        "all": True,
+    }
+    try:
+        async with aiohttp.ClientSession(timeout=timeout) as session:
+            async with session.post(STREMIO_DATASTORE_URL, json=payload) as resp:
+                if resp.status != 200:
+                    logger.warning(f"Stremio library error: HTTP {resp.status}")
+                    return []
+                data = await resp.json()
+    except Exception as e:
+        logger.warning(f"Stremio library error: {type(e).__name__}")
+        return []
+
+    if not isinstance(data, dict):
+        logger.warning("Stremio library error: invalid response format")
+        return []
+
+    if "error" in data:
+        err = data["error"]
+        msg = err.get("message") if isinstance(err, dict) else str(err)
+        logger.warning(f"Stremio library error: {msg}")
+        return []
+
+    items = data.get("result")
+    if not isinstance(items, list):
+        logger.warning("Stremio library error: missing result list")
+        return []
+
+    _LIBRARY_CACHE = (now, items)
+    _LIBRARY_CACHE_KEY = auth_key
+    return items
+
+
+async def _build_landscape_meta(
+    tmdb: TMDBApi,
+    media_type: str,
+    imdb_id: str,
+    name: str,
+    poster_path: str | None,
+    backdrop_path: str | None,
+    overview: str,
+    year: str,
+    rating_str: str,
+    tmdb_id: int | None,
+    base_url: str = "",
+    badge: str | None = None,
+    sem: asyncio.Semaphore | None = None,
+) -> dict[str, Any]:
+    meta: dict[str, Any] = {
+        "id": imdb_id,
+        "type": media_type,
+        "name": name,
+        "poster": f"https://image.tmdb.org/t/p/w500{poster_path}" if poster_path else "",
+        "background": f"https://image.tmdb.org/t/p/w1280{backdrop_path}" if backdrop_path else None,
+        "description": overview or "",
+        "releaseInfo": year,
+        "imdbRating": rating_str,
+    }
+    is_landscape = getattr(settings, "CATALOG_LANDSCAPE", True)
+    if is_landscape and tmdb_id:
+        ls_data = await _resolve_landscape_data(
+            tmdb, media_type, tmdb_id, fallback_backdrop=backdrop_path, sem=sem
+        )
+        backdrop_file = (ls_data.get("backdrop") if ls_data else None) or backdrop_path
+        logo_file = ls_data.get("logo") if ls_data else None
+        if backdrop_file:
+            b_clean = backdrop_file.lstrip("/")
+            l_clean = logo_file.lstrip("/") if logo_file else None
+            b_param = f"?b={badge}" if badge else ""
+            if l_clean:
+                meta["poster"] = f"{base_url}/art/land/{b_clean}/{l_clean}{b_param}"
+            else:
+                meta["poster"] = f"{base_url}/art/land/{b_clean}{b_param}"
+            meta["posterShape"] = "landscape"
+    return meta
+
+
+async def get_my_list(
+    media_type: str,
+    library: list[dict[str, Any]],
+    skip: int = 0,
+    base_url: str = "",
+) -> list[dict[str, Any]]:
+    filtered = [
+        it for it in library
+        if it.get("type") == media_type
+        and isinstance(it.get("_id"), str)
+        and it["_id"].startswith("tt")
+        and not it.get("removed", False)
+        and not it.get("temp", False)
+    ]
+    filtered.sort(key=lambda x: _parse_timestamp(x.get("_mtime")), reverse=True)
+
+    page_items = filtered[skip : skip + 40]
+    if not page_items:
+        return []
+
+    timeout = aiohttp.ClientTimeout(total=10.0)
+    sem = asyncio.Semaphore(10)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        tmdb = TMDBApi(session)
+
+        async def process_item(item: dict[str, Any]) -> dict[str, Any] | None:
+            imdb_id = item["_id"]
+            find_meta = await _resolve_find_imdb(tmdb, imdb_id, media_type)
+            if not find_meta:
+                return None
+            return await _build_landscape_meta(
+                tmdb=tmdb,
+                media_type=media_type,
+                imdb_id=imdb_id,
+                name=find_meta.get("name") or item.get("name") or "",
+                poster_path=find_meta.get("_poster_path"),
+                backdrop_path=find_meta.get("_backdrop_path"),
+                overview=find_meta.get("description") or "",
+                year=find_meta.get("releaseInfo") or "",
+                rating_str=find_meta.get("imdbRating") or "",
+                tmdb_id=find_meta.get("_tmdb_id"),
+                base_url=base_url,
+                badge=None,
+                sem=sem,
+            )
+
+        tasks = [process_item(it) for it in page_items]
+        results = await asyncio.gather(*tasks, return_exceptions=True)
+        return [r for r in results if isinstance(r, dict)]
+
+
+async def get_new_episodes(
+    media_type: str,
+    library: list[dict[str, Any]],
+    skip: int = 0,
+    base_url: str = "",
+) -> list[dict[str, Any]]:
+    if media_type != "series":
+        return []
+
+    watched_series = [
+        it for it in library
+        if it.get("type") == "series"
+        and isinstance(it.get("_id"), str)
+        and it["_id"].startswith("tt")
+        and not it.get("removed", False)
+        and not it.get("temp", False)
+        and it.get("state", {}).get("lastWatched") is not None
+    ]
+    if not watched_series:
+        return []
+
+    timeout = aiohttp.ClientTimeout(total=10.0)
+    sem = asyncio.Semaphore(10)
+    today = datetime.date.today()
+
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        tmdb = TMDBApi(session)
+
+        async def check_series(it: dict[str, Any]) -> tuple[dict[str, Any], str] | None:
+            imdb_id = it["_id"]
+            find_meta = await _resolve_find_imdb(tmdb, imdb_id, "series")
+            if not find_meta or not find_meta.get("_tmdb_id"):
+                return None
+            tid = find_meta["_tmdb_id"]
+
+            now = time.time()
+            cached = _TV_LAST_EP_CACHE.get(tid)
+            if cached is not None and (now - cached[0]) < 12 * 3600:
+                air_date = cached[1]
+            else:
+                air_date = None
+                async with sem:
+                    try:
+                        tv_data = await tmdb._get_json(f"tv/{tid}?language=pt-BR", f"tv {tid}")
+                        if isinstance(tv_data, dict):
+                            last_ep = tv_data.get("last_episode_to_air")
+                            if isinstance(last_ep, dict) and last_ep.get("air_date"):
+                                air_date = str(last_ep["air_date"])
+                        _TV_LAST_EP_CACHE[tid] = (now, air_date)
+                    except Exception:
+                        _TV_LAST_EP_CACHE[tid] = (now, None)
+
+            if not air_date:
+                return None
+
+            try:
+                ep_date = datetime.date.fromisoformat(air_date)
+                diff = (today - ep_date).days
+                if -1 <= diff <= 14:
+                    return (find_meta, air_date)
+            except ValueError:
+                pass
+            return None
+
+        tasks = [check_series(it) for it in watched_series]
+        checked = await asyncio.gather(*tasks, return_exceptions=True)
+        matching: list[tuple[dict[str, Any], str]] = [
+            r for r in checked if isinstance(r, tuple)
+        ]
+
+        matching.sort(key=lambda x: x[1], reverse=True)
+
+        page_items = matching[skip : skip + 40]
+        if not page_items:
+            return []
+
+        async def build_meta(find_meta: dict[str, Any]) -> dict[str, Any]:
+            imdb_id = find_meta["id"]
+            return await _build_landscape_meta(
+                tmdb=tmdb,
+                media_type="series",
+                imdb_id=imdb_id,
+                name=find_meta.get("name") or "",
+                poster_path=find_meta.get("_poster_path"),
+                backdrop_path=find_meta.get("_backdrop_path"),
+                overview=find_meta.get("description") or "",
+                year=find_meta.get("releaseInfo") or "",
+                rating_str=find_meta.get("imdbRating") or "",
+                tmdb_id=find_meta.get("_tmdb_id"),
+                base_url=base_url,
+                badge="new_ep",
+                sem=sem,
+            )
+
+        meta_tasks = [build_meta(m[0]) for m in page_items]
+        meta_results = await asyncio.gather(*meta_tasks, return_exceptions=True)
+        return [r for r in meta_results if isinstance(r, dict)]
+
+
+async def get_recommendations(
+    media_type: str,
+    library: list[dict[str, Any]],
+    skip: int = 0,
+    base_url: str = "",
+) -> list[dict[str, Any]]:
+    all_library_imdb_ids = {
+        it["_id"] for it in library
+        if isinstance(it.get("_id"), str) and it["_id"].startswith("tt")
+    }
+
+    watched = [
+        it for it in library
+        if it.get("type") == media_type
+        and isinstance(it.get("_id"), str)
+        and it["_id"].startswith("tt")
+        and not it.get("removed", False)
+        and not it.get("temp", False)
+        and it.get("state", {}).get("lastWatched") is not None
+    ]
+    if not watched:
+        return []
+
+    watched.sort(
+        key=lambda x: _parse_timestamp(x.get("state", {}).get("lastWatched")),
+        reverse=True,
+    )
+    top_watched = watched[:5]
+
+    timeout = aiohttp.ClientTimeout(total=10.0)
+    sem = asyncio.Semaphore(10)
+    tmdb_type = "movie" if media_type == "movie" else "tv"
+
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        tmdb = TMDBApi(session)
+
+        find_tasks = [_resolve_find_imdb(tmdb, it["_id"], media_type) for it in top_watched]
+        find_metas = await asyncio.gather(*find_tasks, return_exceptions=True)
+        valid_tmdb_ids = [
+            m["_tmdb_id"] for m in find_metas
+            if isinstance(m, dict) and m.get("_tmdb_id")
+        ]
+        if not valid_tmdb_ids:
+            return []
+
+        async def fetch_recs(tid: int) -> list[dict[str, Any]]:
+            async with sem:
+                try:
+                    data = await tmdb._get_json(
+                        f"{tmdb_type}/{tid}/recommendations?language=pt-BR",
+                        f"rec {tid}",
+                    )
+                    if isinstance(data, dict):
+                        res = data.get("results")
+                        if isinstance(res, list):
+                            return res
+                except Exception:
+                    pass
+            return []
+
+        rec_tasks = [fetch_recs(tid) for tid in valid_tmdb_ids]
+        rec_lists = await asyncio.gather(*rec_tasks, return_exceptions=True)
+        valid_rec_lists = [
+            l for l in rec_lists if isinstance(l, list) and l
+        ]
+        if not valid_rec_lists:
+            return []
+
+        max_len = max((len(l) for l in valid_rec_lists), default=0)
+        interleaved_candidates: list[dict[str, Any]] = []
+        seen_cand_tmdb_ids: set[int] = set()
+
+        for idx in range(max_len):
+            for r_list in valid_rec_lists:
+                if idx < len(r_list):
+                    cand = r_list[idx]
+                    cid = cand.get("id")
+                    if cid and cid not in seen_cand_tmdb_ids:
+                        seen_cand_tmdb_ids.add(cid)
+                        interleaved_candidates.append(cand)
+
+        final_candidates: list[tuple[str, dict[str, Any]]] = []
+        seen_imdb_ids: set[str] = set()
+
+        for cand in interleaved_candidates:
+            cid = cand.get("id")
+            imdb_id = await _resolve_imdb_id(tmdb, media_type, cid, sem=sem)
+            if not imdb_id or not imdb_id.startswith("tt"):
+                continue
+            if imdb_id in all_library_imdb_ids:
+                continue
+            if imdb_id in seen_imdb_ids:
+                continue
+            seen_imdb_ids.add(imdb_id)
+            final_candidates.append((imdb_id, cand))
+            if len(final_candidates) >= 40:
+                break
+
+        page_items = final_candidates[skip : skip + 40]
+        if not page_items:
+            return []
+
+        async def build_rec_meta(imdb_id: str, cand: dict[str, Any]) -> dict[str, Any]:
+            name = (
+                cand.get("title") or cand.get("original_title") or ""
+                if media_type == "movie"
+                else cand.get("name") or cand.get("original_name") or ""
+            )
+            date_str = (
+                cand.get("release_date")
+                if media_type == "movie"
+                else cand.get("first_air_date")
+            ) or ""
+            year = date_str[:4] if len(date_str) >= 4 else ""
+            vote_avg = cand.get("vote_average")
+            rating_str = f"{float(vote_avg):.1f}" if vote_avg is not None else ""
+
+            return await _build_landscape_meta(
+                tmdb=tmdb,
+                media_type=media_type,
+                imdb_id=imdb_id,
+                name=name,
+                poster_path=cand.get("poster_path"),
+                backdrop_path=cand.get("backdrop_path"),
+                overview=cand.get("overview") or "",
+                year=year,
+                rating_str=rating_str,
+                tmdb_id=cand.get("id"),
+                base_url=base_url,
+                badge=None,
+                sem=sem,
+            )
+
+        meta_tasks = [build_rec_meta(imdb_id, cand) for imdb_id, cand in page_items]
+        meta_results = await asyncio.gather(*meta_tasks, return_exceptions=True)
+        return [r for r in meta_results if isinstance(r, dict)]
+
+
+async def get_stremio_catalog(
+    media_type: str,
+    catalog_id: str,
+    extra: dict[str, Any] | None = None,
+    base_url: str = "",
+    library: list[dict[str, Any]] | None = None,
+) -> list[dict[str, Any]]:
+    extra = extra or {}
+    skip_raw = extra.get("skip", 0)
+    try:
+        skip = int(skip_raw)
+    except (ValueError, TypeError):
+        skip = 0
+
+    if library is None:
+        auth_key = getattr(settings, "STREMIO_AUTH_KEY", None)
+        if not auth_key:
+            return []
+        cache_key = (media_type, catalog_id, skip, base_url)
+        now = time.time()
+        cached = _CATALOG_CACHE.get(cache_key)
+        if cached is not None and (now - cached[0]) < _CATALOG_CACHE_TTL:
+            return cached[1]
+
+        library = await get_stremio_library(auth_key)
+        if not library:
+            return []
+
+        if catalog_id == "comet_mylist":
+            metas = await get_my_list(media_type, library, skip, base_url)
+        elif catalog_id == "comet_newep":
+            metas = await get_new_episodes(media_type, library, skip, base_url)
+        elif catalog_id == "comet_foryou":
+            metas = await get_recommendations(media_type, library, skip, base_url)
+        else:
+            return []
+
+        _CATALOG_CACHE[cache_key] = (now, metas)
+        return metas
+
+    if catalog_id == "comet_mylist":
+        return await get_my_list(media_type, library, skip, base_url)
+    elif catalog_id == "comet_newep":
+        return await get_new_episodes(media_type, library, skip, base_url)
+    elif catalog_id == "comet_foryou":
+        return await get_recommendations(media_type, library, skip, base_url)
+    return []
