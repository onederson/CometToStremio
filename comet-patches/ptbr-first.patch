+            landscape_data = res[1] if isinstance(res[1], dict) else None
+            is_new_ep = res[2] if isinstance(res[2], bool) else False
+            return imdb_id, landscape_data, is_new_ep
+
+        resolved_pairs = await asyncio.gather(
+            *[resolve_item(it) for it in unique_raw_items],
