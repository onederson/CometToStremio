+
+    headers = {"X-API-Key": settings.SUBSOURCE_API_KEY}
+    search_url = f"https://api.subsource.net/api/v1/movies/search?searchType=imdb&imdb={imdb_id}"
+    if media_type == "series":
+        search_url += f"&season={season}"
+
+    try:
+        r = await session.get(search_url, headers=headers, timeout=10.0)
+        if r.status_code != 200:
+            logger.warning(f"SubSource movie search returned status {r.status_code}")
+            return []
+        movie_data = r.json().get("data", [])
+        movie_id = None
+        if media_type == "series":
+            for m in movie_data:
+                if str(m.get("season")) == str(season):
