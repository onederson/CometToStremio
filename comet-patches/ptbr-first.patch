+            "deviceVersion": "122.0.0",
+            "deviceModel": "web",
+            "deviceMake": "chrome",
+            "deviceType": "web",
+            "clientID": client_id,
+            "clientModelNumber": "1.0.0",
+            "serverSideAds": "false",
+        }
+        url = "https://boot.pluto.tv/v4/start?" + urllib.parse.urlencode(params)
+        try:
+            async with httpx.AsyncClient(timeout=15.0) as client:
+                resp = await client.get(url)
+                if resp.status_code == 200:
+                    data = resp.json()
+                    session_token = data.get("sessionToken")
+                    stitcher_params = (data.get("stitcherParams") or "").lstrip("?&")
+                    servers = data.get("servers") or {}
+                    stitcher = (servers.get("stitcher") or "").rstrip("/")
+                    refresh_in_sec = int(data.get("refreshInSec") or 28800)
+                    if session_token and stitcher:
+                        _pluto_v4_cache = {
+                            "sessionToken": session_token,
+                            "stitcherParams": stitcher_params,
+                            "stitcher": stitcher,
+                        }
+                        _pluto_v4_cache_expiry = now + max(60, refresh_in_sec - 300)
+                        return _pluto_v4_cache
+        except Exception as e:
+            logger.warning(f"Error fetching Pluto v4 session: {e}")
+
+        if _pluto_v4_cache:
+            return _pluto_v4_cache
