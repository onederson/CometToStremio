+def _build_tmdb_path_and_params(
+    media_type: str, catalog_id: str, genre: str | None, page: int, kids: bool = False
+) -> tuple[str, dict] | None:
+    res = _raw_build_tmdb_path_and_params(media_type, catalog_id, genre, page)
+    if not res:
+        return None
+    path, params = res
+    if kids and path.startswith("discover/"):
+        if media_type == "movie":
+            params["certification_country"] = "BR"
+            params["certification.lte"] = "12"
+        elif media_type == "series":
+            # So o genero "Kids" do TMDB: "Familia"/"Animacao" deixavam passar Simpsons e Family Guy
+            if "with_genres" in params and str(params["with_genres"]) != "10762":
+                params["with_genres"] = f"{params['with_genres']},10762"
+            else:
+                params["with_genres"] = "10762"
+    return path, params
