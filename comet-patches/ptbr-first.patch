+_CACHE_TTL = 600.0  # 10 min
+_CACHE_MAX_SIZE = 500
+
+_URL_VALID_CACHE: dict[str, tuple[float, bool]] = {}
+_URL_CACHE_TTL = 600.0  # 10 min
+
+_HOUSE_DNS_CACHE: dict[str, tuple[float, bool]] = {}  # host -> (timestamp, is_blocked)
+_HOUSE_DNS_CACHE_TTL = 1800.0  # 30 min
+_HOUSE_DNS_LOGGED: dict[str, float] = {}  # host -> timestamp
+
+_LAST_DIRECT_RATIO: str = "-"
+
+
+def get_last_direct_ratio() -> str:
+    return _LAST_DIRECT_RATIO
+
+
+def get_blocked_hosts() -> list[str]:
+    now = time.time()
+    return sorted([
+        host
+        for host, (ts, is_blocked) in _HOUSE_DNS_CACHE.items()
+        if is_blocked and (now - ts < _HOUSE_DNS_CACHE_TTL)
+    ])
+
+
+RES_RANKS = {
+    "4K": 0,
+    "1080p": 1,
+    "720p": 2,
+    "480p": 3,
+}
+
+PT_KEYWORDS = (
+    "dublado",
+    "dual",
