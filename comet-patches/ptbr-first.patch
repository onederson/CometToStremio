+++ b/comet/api/endpoints/meta.py
@@ -0,0 +1,57 @@
+from fastapi import APIRouter, Request
+from fastapi.responses import JSONResponse
+
+from comet.core.config_validation import config_check
+from comet.core.logger import logger
+from comet.services.meta_ptbr import get_meta_ptbr
+
+router = APIRouter()
+
+
+@router.get(
+    "/meta/{type}/{id}.json",
+    tags=["Stremio"],
+    summary="Meta Provider",
+    description="Returns metadata in PT-BR for the specified media.",
+)
+@router.get(
+    "/{b64config}/meta/{type}/{id}.json",
+    tags=["Stremio"],
+    summary="Meta Provider",
+    description="Returns metadata in PT-BR with configuration.",
+)
+async def get_meta_endpoint(
+    request: Request,
+    type: str,
+    id: str,
+    b64config: str | None = None,
+):
+    clean_id = id.removesuffix(".json")
+    if type not in ("movie", "series") or not clean_id.startswith("tt"):
+        return JSONResponse(
+            content={"meta": None},
+            headers={"Cache-Control": "public, max-age=21600"},
+        )
+
+    try:
+        if b64config:
+            config = config_check(b64config)
+            if not config:
+                return JSONResponse(
+                    content={"meta": None},
+                    headers={"Cache-Control": "public, max-age=21600"},
+                )
+
+        meta = await get_meta_ptbr(type, clean_id)
+        return JSONResponse(
+            content={"meta": meta},
+            headers={"Cache-Control": "public, max-age=21600"},
+        )
+    except Exception as e:
+        logger.warning(
+            f"Error handling meta request for {type}/{id}: {type(e).__name__}"
+        )
+        return JSONResponse(
+            content={"meta": None},
+            headers={"Cache-Control": "public, max-age=21600"},
+        )
