+async def _fetch_catalog_items(
+    media_type: str, catalog_id: str, genre: str | None, skip: int
+) -> list[dict]:
+    _ensure_imdb_map_loaded()
+    page1 = (skip // 40) * 2 + 1
+    page2 = page1 + 1
+
+    query1 = _build_tmdb_path_and_params(media_type, catalog_id, genre, page1)
+    query2 = _build_tmdb_path_and_params(media_type, catalog_id, genre, page2)
+    if not query1 or not query2:
+        return []
+
+    path1, params1 = query1
+    path2, params2 = query2
+    url1 = f"{path1}?{urllib.parse.urlencode(params1)}"
+    url2 = f"{path2}?{urllib.parse.urlencode(params2)}"
+
+    timeout = aiohttp.ClientTimeout(total=8.0)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        tmdb = TMDBApi(session)
+        res1, res2 = await asyncio.gather(
+            tmdb._get_json(url1, f"catalog {catalog_id} p{page1}"),
+            tmdb._get_json(url2, f"catalog {catalog_id} p{page2}"),
+            return_exceptions=True,
+        )
+
+        raw_items = []
+        if isinstance(res1, dict) and isinstance(res1.get("results"), list):
+            raw_items.extend(res1["results"])
+        if isinstance(res2, dict) and isinstance(res2.get("results"), list):
+            raw_items.extend(res2["results"])
+
+        unique_raw_items = []
+        seen_tmdb_ids = set()
+        today_str = datetime.date.today().isoformat()
+        is_lancamentos = genre in ("Lançamentos", "Lancamentos")
+
+        for item in raw_items:
+            if not isinstance(item, dict):
+                continue
+            tid = item.get("id")
+            poster = item.get("poster_path")
+            if not tid or not poster or tid in seen_tmdb_ids:
+                continue
+            # If Lancamentos, guarantee no future releases
+            if is_lancamentos:
+                rel_date = (
+                    item.get("release_date")
+                    if media_type == "movie"
+                    else item.get("first_air_date")
+                )
+                if rel_date and rel_date > today_str:
+                    continue
+            seen_tmdb_ids.add(tid)
+            unique_raw_items.append(item)
+
+        tmdb_type = "movie" if media_type == "movie" else "tv"
+        sem = asyncio.Semaphore(10)
+        cache_updated = False
+
+        async def resolve_imdb(tmdb_id: int) -> str | None:
+            nonlocal cache_updated
+            cache_key = f"{tmdb_type}:{tmdb_id}"
+            if cache_key in _IMDB_MAP:
+                return _IMDB_MAP[cache_key]
+
+            async with sem:
+                data = await tmdb._get_json(
+                    f"{tmdb_type}/{tmdb_id}/external_ids",
+                    f"{tmdb_type} external_ids {tmdb_id}",
+                )
+                if isinstance(data, dict):
+                    imdb_id = data.get("imdb_id")
+                    if isinstance(imdb_id, str) and imdb_id.startswith("tt"):
+                        _IMDB_MAP[cache_key] = imdb_id
+                        cache_updated = True
+                        return imdb_id
+            return None
+
+        imdb_ids = await asyncio.gather(
+            *[resolve_imdb(it["id"]) for it in unique_raw_items],
+            return_exceptions=True,
+        )
+
+        if cache_updated:
+            await asyncio.to_thread(_save_imdb_map)
+
+        metas = []
+        seen_imdb = set()
+        for it, imdb_id in zip(unique_raw_items, imdb_ids):
+            if (
+                not isinstance(imdb_id, str)
+                or not imdb_id.startswith("tt")
+                or imdb_id in seen_imdb
+            ):
+                continue
+            seen_imdb.add(imdb_id)
+            poster_path = it.get("poster_path")
+            backdrop_path = it.get("backdrop_path")
+            name = (
+                it.get("title") or it.get("original_title") or ""
+                if media_type == "movie"
+                else it.get("name") or it.get("original_name") or ""
+            )
+            date_str = (
+                it.get("release_date")
+                if media_type == "movie"
+                else it.get("first_air_date")
+            )
+            year = date_str[:4] if date_str and len(date_str) >= 4 else ""
+            vote_avg = it.get("vote_average")
+            rating_str = f"{float(vote_avg):.1f}" if vote_avg is not None else ""
+
+            meta = {
+                "id": imdb_id,
+                "type": media_type,
+                "name": name,
+                "poster": f"https://image.tmdb.org/t/p/w342{poster_path}",
+                "background": (
+                    f"https://image.tmdb.org/t/p/w1280{backdrop_path}"
+                    if backdrop_path
+                    else None
+                ),
+                "description": it.get("overview") or "",
+                "releaseInfo": year,
+                "imdbRating": rating_str,
+            }
+            metas.append(meta)
+
+        return metas
+
+
+_SEARCH_CACHE: dict[tuple, tuple[float, list[dict]]] = {}
+_SEARCH_CACHE_MAX = 300
+_SEARCH_CACHE_TTL = 3600.0  # 1 hour
+
+
+def _get_cached_search(key: tuple) -> list[dict] | None:
+    now = time.time()
+    if key in _SEARCH_CACHE:
+        ts, items = _SEARCH_CACHE[key]
+        if now - ts < _SEARCH_CACHE_TTL:
+            return items
+        _SEARCH_CACHE.pop(key, None)
+    return None
+
+
+def _set_cached_search(key: tuple, items: list[dict]) -> None:
+    while len(_SEARCH_CACHE) >= _SEARCH_CACHE_MAX:
+        oldest_key = min(_SEARCH_CACHE.keys(), key=lambda k: _SEARCH_CACHE[k][0])
+        _SEARCH_CACHE.pop(oldest_key, None)
+    _SEARCH_CACHE[key] = (time.time(), items)
+
+
+async def _fetch_search_items(media_type: str, query: str) -> list[dict]:
+    _ensure_imdb_map_loaded()
+    tmdb_type = "movie" if media_type == "movie" else "tv"
+    q_encoded = urllib.parse.quote(query)
+
+    timeout = aiohttp.ClientTimeout(total=8.0)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        tmdb = TMDBApi(session)
+
+        async def fetch_tmdb():
+            return await tmdb._get_json(
+                f"search/{tmdb_type}?query={q_encoded}&language=pt-BR&page=1",
+                f"search {tmdb_type} {query}",
+            )
+
+        async def fetch_cinemeta():
+            cm_url = f"https://v3-cinemeta.strem.io/catalog/{media_type}/top/search={q_encoded}.json"
+            try:
+                async with session.get(cm_url) as resp:
+                    if resp.status == 200:
+                        data = await resp.json()
+                        if isinstance(data, dict):
+                            return data.get("metas", [])
+            except Exception as e:
+                logger.warning(f"Cinemeta search failed for {query}: {e}")
+            return []
+
+        tmdb_data, cinemeta_metas = await asyncio.gather(
+            fetch_tmdb(), fetch_cinemeta(), return_exceptions=True
+        )
+
+        results = []
+        seen_imdb = set()
+
+        if isinstance(tmdb_data, dict) and isinstance(tmdb_data.get("results"), list):
+            unique_raw_items = []
+            seen_tmdb_ids = set()
+            for item in tmdb_data["results"]:
+                if not isinstance(item, dict):
+                    continue
+                tid = item.get("id")
+                if not tid or tid in seen_tmdb_ids:
+                    continue
+                seen_tmdb_ids.add(tid)
+                unique_raw_items.append(item)
+
+            sem = asyncio.Semaphore(10)
+            cache_updated = False
+
+            async def resolve_imdb(tmdb_id: int) -> str | None:
+                nonlocal cache_updated
+                cache_key = f"{tmdb_type}:{tmdb_id}"
+                if cache_key in _IMDB_MAP:
+                    return _IMDB_MAP[cache_key]
+
+                async with sem:
+                    data = await tmdb._get_json(
+                        f"{tmdb_type}/{tmdb_id}/external_ids",
+                        f"{tmdb_type} external_ids {tmdb_id}",
+                    )
+                    if isinstance(data, dict):
+                        imdb_id = data.get("imdb_id")
+                        if isinstance(imdb_id, str) and imdb_id.startswith("tt"):
+                            _IMDB_MAP[cache_key] = imdb_id
+                            cache_updated = True
+                            return imdb_id
+                return None
+
+            imdb_ids = await asyncio.gather(
+                *[resolve_imdb(it["id"]) for it in unique_raw_items],
+                return_exceptions=True,
+            )
+
+            if cache_updated:
+                await asyncio.to_thread(_save_imdb_map)
+
+            for it, imdb_id in zip(unique_raw_items, imdb_ids):
+                if (
+                    not isinstance(imdb_id, str)
+                    or not imdb_id.startswith("tt")
+                    or imdb_id in seen_imdb
+                ):
+                    continue
+                seen_imdb.add(imdb_id)
+                poster_path = it.get("poster_path")
+                backdrop_path = it.get("backdrop_path")
+                name = (
+                    it.get("title") or it.get("original_title") or ""
+                    if media_type == "movie"
+                    else it.get("name") or it.get("original_name") or ""
+                )
+                date_str = (
+                    it.get("release_date")
+                    if media_type == "movie"
+                    else it.get("first_air_date")
+                )
+                year = date_str[:4] if date_str and len(date_str) >= 4 else ""
+                vote_avg = it.get("vote_average")
+                rating_str = (
+                    f"{float(vote_avg):.1f}" if vote_avg is not None else ""
+                )
+
+                meta = {
+                    "id": imdb_id,
+                    "type": media_type,
+                    "name": name,
+                    "poster": (
+                        f"https://image.tmdb.org/t/p/w342{poster_path}"
+                        if poster_path
+                        else None
+                    ),
+                    "background": (
+                        f"https://image.tmdb.org/t/p/w1280{backdrop_path}"
+                        if backdrop_path
+                        else None
+                    ),
+                    "description": it.get("overview") or "",
+                    "releaseInfo": year,
+                    "imdbRating": rating_str,
+                }
+                results.append(meta)
+
+        if isinstance(cinemeta_metas, list):
+            for cm_item in cinemeta_metas:
+                if not isinstance(cm_item, dict):
+                    continue
+                cid = cm_item.get("id")
+                if cid and cid not in seen_imdb:
+                    seen_imdb.add(cid)
+                    results.append(cm_item)
+
+        return results
+
+
+async def get_catalog(
+    media_type: str, catalog_id: str, extra: dict | None = None
+) -> list[dict]:
+    if catalog_id == "comet_search":
+        extra = extra or {}
+        search_query = extra.get("search")
+        if not search_query or not str(search_query).strip():
+            return []
+        q = str(search_query).strip()
+        search_cache_key = (media_type, "comet_search", q.lower())
+        cached_search = _get_cached_search(search_cache_key)
+        if cached_search is not None:
+            return cached_search
+        try:
+            async with asyncio.timeout(10.0):
+                metas = await _fetch_search_items(media_type, q)
+                if metas:
+                    _set_cached_search(search_cache_key, metas)
+                return metas
+        except TimeoutError:
+            logger.warning(f"Search catalog timeout for {media_type}/{q}")
+            return []
+        except Exception as e:
+            logger.warning(
+                f"Search catalog error for {media_type}/{q}: {type(e).__name__}"
+            )
+            return []
+    extra = extra or {}
+    genre = extra.get("genre")
+    skip_raw = extra.get("skip", 0)
+    try:
+        skip = int(skip_raw)
+    except (ValueError, TypeError):
+        skip = 0
+
+    cache_key = (media_type, catalog_id, genre, skip)
+    cached = _get_cached_catalog(cache_key)
+    if cached is not None:
+        return cached
+
+    try:
+        async with asyncio.timeout(10.0):
+            metas = await _fetch_catalog_items(media_type, catalog_id, genre, skip)
+            if metas:
+                _set_cached_catalog(cache_key, metas)
+            return metas
+    except TimeoutError:
+        logger.warning(f"Catalog timeout for {media_type}/{catalog_id}")
+        return []
+    except Exception as e:
+        logger.warning(
+            f"Catalog error for {media_type}/{catalog_id}: {type(e).__name__}"
+        )
+        return []
