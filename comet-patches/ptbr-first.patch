+async def _fetch_search_items(media_type: str, query: str, kids: bool = False) -> list[dict]:
+    _ensure_imdb_map_loaded()
+    tmdb_type = "movie" if media_type == "movie" else "tv"
+    q_encoded = urllib.parse.quote(query)
+
+    timeout = aiohttp.ClientTimeout(total=8.0)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        tmdb = TMDBApi(session)
+
+        async def fetch_tmdb():
+            return await tmdb._get_json(
+                f"search/{tmdb_type}?query={q_encoded}&language=pt-BR&page=1",
+                f"search {tmdb_type} {query}",
+            )
+
+        async def fetch_cinemeta():
+            if kids:
+                return []
+            cm_url = f"https://v3-cinemeta.strem.io/catalog/{media_type}/top/search={q_encoded}.json"
+            try:
+                async with session.get(cm_url) as resp:
+                    if resp.status == 200:
+                        data = await resp.json()
+                        if isinstance(data, dict):
+                            return data.get("metas", [])
+            except Exception as e:
+                logger.warning(f"Cinemeta search failed for {query}: {e}")
+            return []
+
+        tmdb_data, cinemeta_metas = await asyncio.gather(
+            fetch_tmdb(), fetch_cinemeta(), return_exceptions=True
+        )
+
+        results = []
+        seen_imdb = set()
+
+        if isinstance(tmdb_data, dict) and isinstance(tmdb_data.get("results"), list):
+            unique_raw_items = []
+            seen_tmdb_ids = set()
+            for item in tmdb_data["results"]:
+                if not isinstance(item, dict):
+                    continue
+                tid = item.get("id")
+                if not tid or tid in seen_tmdb_ids:
+                    continue
+                seen_tmdb_ids.add(tid)
+                unique_raw_items.append(item)
+
+            if kids:
+                if media_type == "movie":
+                    checks = await asyncio.gather(
+                        *[_check_kids_movie_allowed(tmdb, it["id"], it.get("genre_ids", [])) for it in unique_raw_items],
+                        return_exceptions=True,
+                    )
+                    unique_raw_items = [
+                        it for it, ok in zip(unique_raw_items, checks)
+                        if ok is True
+                    ]
+                else:
+                    unique_raw_items = [
+                        it for it in unique_raw_items
+                        if any(g in (10762, 10751, 16) for g in (it.get("genre_ids") or []))
+                    ]
+
+            sem = asyncio.Semaphore(10)
+            cache_updated = False
+
+            async def resolve_imdb(tmdb_id: int) -> str | None:
+                nonlocal cache_updated
+                cache_key = f"{tmdb_type}:{tmdb_id}"
+                if cache_key in _IMDB_MAP:
+                    return _IMDB_MAP[cache_key]
+
+                async with sem:
+                    data = await tmdb._get_json(
+                        f"{tmdb_type}/{tmdb_id}/external_ids",
+                        f"{tmdb_type} external_ids {tmdb_id}",
+                    )
+                    if isinstance(data, dict):
+                        imdb_id = data.get("imdb_id")
+                        if isinstance(imdb_id, str) and imdb_id.startswith("tt"):
+                            _IMDB_MAP[cache_key] = imdb_id
+                            cache_updated = True
+                            return imdb_id
+                return None
+
+            imdb_ids = await asyncio.gather(
+                *[resolve_imdb(it["id"]) for it in unique_raw_items],
+                return_exceptions=True,
+            )
+
+            if cache_updated:
+                await asyncio.to_thread(_save_imdb_map)
+
+            for it, imdb_id in zip(unique_raw_items, imdb_ids):
+                if (
+                    not isinstance(imdb_id, str)
+                    or not imdb_id.startswith("tt")
+                    or imdb_id in seen_imdb
+                ):
+                    continue
+                seen_imdb.add(imdb_id)
+                poster_path = it.get("poster_path")
+                backdrop_path = it.get("backdrop_path")
+                name = (
+                    it.get("title") or it.get("original_title") or ""
+                    if media_type == "movie"
+                    else it.get("name") or it.get("original_name") or ""
+                )
+                date_str = (
+                    it.get("release_date")
+                    if media_type == "movie"
+                    else it.get("first_air_date")
+                )
+                year = date_str[:4] if date_str and len(date_str) >= 4 else ""
+                vote_avg = it.get("vote_average")
+                rating_str = (
+                    f"{float(vote_avg):.1f}" if vote_avg is not None else ""
+                )
+
+                meta = {
+                    "id": imdb_id,
+                    "type": media_type,
+                    "name": name,
+                    "poster": (
+                        f"https://image.tmdb.org/t/p/w500{poster_path}"
+                        if poster_path
+                        else None
+                    ),
+                    "background": (
+                        f"https://image.tmdb.org/t/p/w1280{backdrop_path}"
+                        if backdrop_path
+                        else None
+                    ),
+                    "description": it.get("overview") or "",
+                    "releaseInfo": year,
+                    "imdbRating": rating_str,
+                }
+                results.append(meta)
+
+        if not kids and isinstance(cinemeta_metas, list):
+            for cm_item in cinemeta_metas:
+                if not isinstance(cm_item, dict):
+                    continue
+                cid = cm_item.get("id")
+                if cid and cid not in seen_imdb:
+                    seen_imdb.add(cid)
+                    results.append(cm_item)
+
+        return results
+
