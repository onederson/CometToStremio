+def _render_landscape_pillow(
+    backdrop_bytes: bytes,
+    logo_bytes: bytes | None,
+    badge: str | None = None,
+    provider_logo_bytes: bytes | None = None,
+) -> bytes:
+    W, H = 780, 439
+    bg = Image.open(io.BytesIO(backdrop_bytes)).convert("RGBA")
+    scale = max(W / bg.width, H / bg.height)
+    sw = int(round(bg.width * scale))
+    sh = int(round(bg.height * scale))
+    bg_resized = bg.resize((sw, sh), Image.Resampling.LANCZOS)
+    cx = (sw - W) // 2
+    cy = (sh - H) // 2
+    canvas = bg_resized.crop((cx, cy, cx + W, cy + H))
+
+    canvas.alpha_composite(_get_gradient_overlay())
+
+    if logo_bytes:
+        logo = Image.open(io.BytesIO(logo_bytes)).convert("RGBA")
+        max_lw = int(round(W * 0.45))
+        max_lh = int(round(H * 0.32))
+        lscale = min(max_lw / logo.width, max_lh / logo.height)
+        nlw = max(1, int(round(logo.width * lscale)))
+        nlh = max(1, int(round(logo.height * lscale)))
+        logo_resized = logo.resize((nlw, nlh), Image.Resampling.LANCZOS)
