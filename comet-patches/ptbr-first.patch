+import asyncio
+import time
+from collections import deque
+from urllib.parse import quote
+
+from comet.core.database import database
+from comet.core.logger import logger
+from comet.core.models import settings
+from comet.debrid.exceptions import DebridLinkGenerationError
+from comet.debrid.stremthru import (
+    StremThru,
+    _record_debrid_blocked_hash,
+    _record_debrid_verified_hash,
+)
+from comet.services.trackers import trackers as generic_trackers
+from comet.utils.http_client import http_client_manager
+
+_precheck_lock = asyncio.Lock()
+_check_timestamps: deque = deque()
+_cooldown_until: float = 0.0
+
+
+async def is_hash_known_or_verified(debrid_service: str, info_hash: str) -> bool:
+    try:
+        norm_hash = info_hash.lower()
+        blocked = await database.fetch_one(
+            """
+            SELECT 1 FROM debrid_blocked_hashes
+            WHERE debrid_service = :debrid_service AND info_hash = :info_hash
+            LIMIT 1
+            """,
+            {"debrid_service": debrid_service, "info_hash": norm_hash},
+        )
+        if blocked:
+            return True
+
+        now = int(time.time())
+        verified = await database.fetch_one(
+            """
+            SELECT 1 FROM debrid_verified_hashes
+            WHERE debrid_service = :debrid_service AND info_hash = :info_hash AND expires_at > :now
+            LIMIT 1
+            """,
+            {"debrid_service": debrid_service, "info_hash": norm_hash, "now": now},
+        )
+        return bool(verified)
+    except Exception as exc:
+        logger.warning(
+            f"Erro ao consultar cache de verificação de {debrid_service}:{info_hash}: {exc}"
+        )
+        return False
+
+
+async def run_debrid_precheck(
+    token: str,
+    client_ip: str,
+    candidates: list[dict],
+) -> None:
+    global _cooldown_until
+
+    if not settings.DEBRID_PRECHECK:
+        return
+
+    now = time.time()
+    if now < _cooldown_until:
+        return
+
+    if _precheck_lock.locked():
+        return
+
+    if not candidates or not token:
+        return
+
+    async with _precheck_lock:
+        session = await http_client_manager.get_session()
+        checked_count = 0
+        for candidate in candidates:
+            if checked_count >= 3:
+                break
+
+            info_hash = candidate.get("info_hash")
+            title = candidate.get("title", "")
+            if not info_hash:
+                continue
+
+            info_hash = info_hash.lower()
+
+            now = time.time()
+            if now < _cooldown_until:
+                break
+
+            # Hourly rate limit (sliding 1 hour window)
+            while _check_timestamps and now - _check_timestamps[0] > 3600:
+                _check_timestamps.popleft()
+
+            max_per_hour = settings.DEBRID_PRECHECK_MAX_PER_HOUR or 20
+            if len(_check_timestamps) >= max_per_hour:
+                logger.log(
+                    "DEBRID",
+                    f"RD precheck: limite horário de {max_per_hour}/h atingido.",
+                )
+                break
+
+            if await is_hash_known_or_verified("realdebrid", info_hash):
+                continue
+
+            _check_timestamps.append(now)
+            checked_count += 1
+
+            magnet_uri = f"magnet:?xt=urn:btih:{info_hash}&dn={quote(title)}"
+            sources = candidate.get("sources") or generic_trackers[:20]
+            for s in sources:
+                magnet_uri += f"&tr={quote(s, safe='')}"
+
+            st = StremThru(
+                session,
+                "",
+                "",
+                f"realdebrid:{token}",
+                client_ip,
+            )
+
+            try:
+                magnet = await st._post_store_json(
+                    f"/magnets?client_ip={client_ip}",
+                    {"magnet": magnet_uri},
+                    "precheck torrent",
+                )
+                magnet_data = magnet.get("data", {}) if isinstance(magnet, dict) else {}
+                magnet_id = magnet_data.get("id")
+
+                await _record_debrid_verified_hash(
+                    "realdebrid", info_hash, status="ok", ttl_seconds=7 * 86400
+                )
+                logger.log(
+                    "DEBRID",
+                    f"✅ RD precheck aceitou {info_hash} {title}",
+                )
+
+                if magnet_id:
+                    deleted = await st.delete_magnet(str(magnet_id))
+                    if deleted:
+                        logger.log(
+                            "DEBRID",
+                            f"🗑️ RD precheck removeu {magnet_id} da conta",
+                        )
+            except DebridLinkGenerationError as err:
+                status_code = err.payload.get("status_code") if isinstance(err.payload, dict) else None
+                if (
+                    status_code == 451
+                    or err.error_code == "UNAVAILABLE_FOR_LEGAL_REASONS"
+                    or err.upstream_error_code == "infringing_file"
+                ):
+                    await _record_debrid_blocked_hash(
+                        "realdebrid", info_hash, "infringing_file"
+                    )
+                    logger.log(
+                        "DEBRID",
+                        f"🚫 RD precheck detectou bloqueio (451) em {info_hash} {title}",
+                    )
+                elif (
+                    status_code == 429
+                    or err.error_code in ("TOO_MANY_REQUESTS", "RATE_LIMIT_EXCEEDED")
+                ):
+                    logger.warning(
+                        f"RD precheck rate limit (429), pausando verificações por 30 min: {err}"
+                    )
+                    _cooldown_until = time.time() + 1800
+                    break
+                else:
+                    logger.warning(
+                        f"RD precheck erro na verificação de {info_hash}: {err}"
+                    )
+            except Exception as exc:
+                logger.warning(
+                    f"RD precheck falha de rede/exceção ({exc}), pausando verificações por 30 min"
+                )
+                _cooldown_until = time.time() + 1800
+                break
diff --git a/comet/services/direct_addons.py b/comet/services/direct_addons.py
new file mode 100644
index 0000000..167ea5e
--- /dev/null
+++ b/comet/services/direct_addons.py
@@ -0,0 +1,191 @@
+import asyncio
+import re
+import time
+from urllib.parse import urlparse
+
+from curl_cffi.requests import AsyncSession
+
+from comet.core.logger import logger
+from comet.core.models import settings
+
+_CACHE: dict[tuple[str, str], tuple[float, list[dict]]] = {}
+_CACHE_TTL = 600.0  # 10 min
+_CACHE_MAX_SIZE = 500
+
+RES_RANKS = {
+    "4K": 0,
+    "1080p": 1,
+    "720p": 2,
+    "480p": 3,
+}
+
+PT_KEYWORDS = (
+    "dublado",
+    "dual",
+    "pt-br",
+    "ptbr",
+    "português",
+    "portugues",
+    "nacional",
+    "🇧🇷",
+)
+
+
+def _get_short_name(base_url: str) -> str:
+    parsed = urlparse(base_url)
+    host = (parsed.hostname or "").lower()
+    if "fenixflix" in host:
+        return "FenixFlix"
+    if "froststream" in host:
+        return "FrostStream"
+    first_label = host.split(".")[0] if host else "Direct"
+    return first_label.capitalize()
+
+
+def _extract_res(texto: str) -> str:
+    m = re.search(r"(?i)\b(2160p|4k|1080p|720p|480p)\b", texto)
+    if not m:
+        return ""
+    val = m.group(1).lower()
+    if val in ("2160p", "4k"):
+        return "4K"
+    elif val == "1080p":
+        return "1080p"
+    elif val == "720p":
+        return "720p"
+    elif val == "480p":
+        return "480p"
+    return ""
+
+
+async def _fetch_addon(
+    session: AsyncSession, base_url: str, media_type: str, media_id: str
+) -> list[dict]:
+    url = f"{base_url}/stream/{media_type}/{media_id}.json"
+    try:
+        resp = await session.get(url, timeout=settings.DIRECT_ADDONS_TIMEOUT)
+        if resp.status_code == 200:
+            data = resp.json()
+            streams = data.get("streams", [])
+            if isinstance(streams, list):
+                return streams
+            return []
+        else:
+            logger.warning(
+                f"Direct addon {base_url} returned HTTP {resp.status_code}"
+            )
+    except Exception as e:
+        logger.warning(f"Direct addon {base_url} failed: {e}")
+    return []
+
+
+async def fetch_direct_streams(media_type: str, media_id: str) -> list[dict]:
+    try:
+        raw_urls = settings.DIRECT_ADDONS_URL
+        if isinstance(raw_urls, str):
+            urls = [raw_urls.rstrip("/")] if raw_urls else []
+        elif isinstance(raw_urls, list):
+            urls = [u.rstrip("/") for u in raw_urls if u]
+        else:
+            urls = []
+
+        if not urls:
+            return []
+
+        cache_key = (media_type, media_id)
+        now = time.time()
+        if cache_key in _CACHE:
+            cached_time, cached_items = _CACHE[cache_key]
+            if now - cached_time < _CACHE_TTL:
+                return cached_items
+            else:
+                _CACHE.pop(cache_key, None)
+
+        try:
+            async with AsyncSession(impersonate="chrome") as session:
+                tasks = [
+                    _fetch_addon(session, base, media_type, media_id)
+                    for base in urls
+                ]
+                responses = await asyncio.gather(*tasks, return_exceptions=True)
+        except Exception as e:
+            logger.warning(f"Direct addons session error: {e}")
+            return []
+
+        converted_items = []
+        order_idx = 0
+
+        for base, res_streams in zip(urls, responses):
+            if not isinstance(res_streams, list):
+                continue
+            curto = _get_short_name(base)
+            for s in res_streams:
+                if not isinstance(s, dict):
+                    continue
+                orig_url = s.get("url")
+                if (
+                    not orig_url
+                    or not isinstance(orig_url, str)
+                    or not orig_url.startswith("http")
+                ):
+                    continue
+
+                orig_name = str(s.get("name") or "")
+                orig_desc = str(s.get("title") or s.get("description") or "")
+                texto = f"{orig_name}\n{orig_desc}"
+
+                texto_lower = texto.lower()
+                is_pt = any(kw in texto_lower for kw in PT_KEYWORDS)
+
+                res = _extract_res(texto)
+                res_rank = RES_RANKS.get(res, 4)
+
+                new_name = (
+                    ("🇧🇷 PT-BR\n" if is_pt else "")
+                    + f"🌐 {curto}"
+                    + (f"\n{res}" if res else "")
+                )
+
+                desc_lines = orig_desc.strip().splitlines()[:6]
+                trimmed_desc = "\n".join(desc_lines)
+                if trimmed_desc:
+                    new_desc = (
+                        f"{trimmed_desc}\n🌐 Link direto ({curto}): "
+                        "não usa o Real-Debrid"
+                    )
+                else:
+                    new_desc = (
+                        f"🌐 Link direto ({curto}): não usa o Real-Debrid"
+                    )
+
+                orig_hints = s.get("behaviorHints")
+                behavior_hints = (
+                    dict(orig_hints) if isinstance(orig_hints, dict) else {}
+                )
+                behavior_hints["bingeGroup"] = f"comet|direct|{curto}|{res}"
+                if not behavior_hints.get("filename"):
+                    behavior_hints["filename"] = f"{curto}.direct.{'PTBR' if is_pt else 'XX'}"
+
+                clean_stream = {
+                    "name": new_name,
+                    "description": new_desc,
+                    "url": orig_url,
+                    "behaviorHints": behavior_hints,
+                    "_is_pt": is_pt,
+                }
+                converted_items.append((clean_stream, is_pt, res_rank, order_idx))
+                order_idx += 1
+
+        converted_items.sort(key=lambda x: (0 if x[1] else 1, x[2], x[3]))
+        results = [item[0] for item in converted_items]
+
+        if results:
+            while len(_CACHE) >= _CACHE_MAX_SIZE:
+                oldest_key = min(_CACHE.keys(), key=lambda k: _CACHE[k][0])
+                _CACHE.pop(oldest_key, None)
+            _CACHE[cache_key] = (now, results)
+
+        return results
+    except Exception as e:
+        logger.warning(f"fetch_direct_streams unexpected error: {e}")
+        return []
