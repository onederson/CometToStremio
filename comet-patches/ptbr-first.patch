+    )
+
+    path1, params1 = query1
+    url1 = f"{path1}?{urllib.parse.urlencode(params1)}"
+    url2 = (
+        f"{query2[0]}?{urllib.parse.urlencode(query2[1])}" if query2 else None
+    )
+
+    timeout = aiohttp.ClientTimeout(total=8.0)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        tmdb = TMDBApi(session)
