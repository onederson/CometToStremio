+                            _IMDB_MAP[cache_key] = imdb_id
+                            cache_updated = True
+                            return imdb_id
+                return None
+
+            imdb_ids = await asyncio.gather(
+                *[resolve_imdb(it["id"]) for it in unique_raw],
+                return_exceptions=True,
+            )
+            if cache_updated:
+                await asyncio.to_thread(_save_imdb_map)
+
+            disc_metas = []
+            seen_imdb = set()
+            for it, imdb_id in zip(unique_raw, imdb_ids):
+                if (
+                    not isinstance(imdb_id, str)
+                    or not imdb_id.startswith("tt")
+                    or imdb_id in seen_imdb
+                ):
+                    continue
+                seen_imdb.add(imdb_id)
+                poster_path = it.get("poster_path")
+                backdrop_path = it.get("backdrop_path")
+                name = (
+                    it.get("title") or it.get("original_title") or ""
+                    if media_type == "movie"
+                    else it.get("name") or it.get("original_name") or ""
+                )
+                date_str = (
+                    it.get("release_date")
+                    if media_type == "movie"
+                    else it.get("first_air_date")
+                )
+                year = date_str[:4] if date_str and len(date_str) >= 4 else ""
+                vote_avg = it.get("vote_average")
+                rating_str = (
+                    f"{float(vote_avg):.1f}" if vote_avg is not None else ""
+                )
+
+                disc_metas.append({
+                    "id": imdb_id,
+                    "type": media_type,
+                    "name": name,
+                    "poster": (
+                        f"https://image.tmdb.org/t/p/w500{poster_path}"
+                        if poster_path
+                        else None
+                    ),
+                    "background": (
+                        f"https://image.tmdb.org/t/p/w1280{backdrop_path}"
+                        if backdrop_path
+                        else None
+                    ),
+                    "description": it.get("overview") or "",
+                    "releaseInfo": year,
+                    "imdbRating": rating_str,
+                    "_vote_count": it.get("vote_count", 0),
+                })
+            return disc_metas, concepts, concept_words
+
+    discover_res, title_res = await asyncio.gather(
+        _fetch_discover(),
+        _fetch_search_items(media_type, query, kids=kids),
+        return_exceptions=True,
+    )
+    if isinstance(discover_res, tuple):
+        discover_metas, concepts, concept_words = discover_res
+    else:
+        if isinstance(discover_res, Exception):
+            logger.warning(f"Erro em _fetch_discover: {discover_res}")
+        discover_metas, concepts, concept_words = (discover_res if isinstance(discover_res, list) else []), [], []
+    title_metas = title_res if isinstance(title_res, list) else []
+
+    if filters.get("dublado"):
+        ready_tt = set(await _get_ready_tt_list(media_type))
+        discover_metas = sorted(discover_metas, key=lambda m: m.get("id") not in ready_tt)
+        title_metas = sorted(title_metas, key=lambda m: m.get("id") not in ready_tt)
+
+    has_theme = bool(concepts or filters.get("keyword") or filters.get("theme_query"))
+    if discover_metas and has_theme:
+        filtered_title_metas = [
+            m for m in title_metas
+            if m.get("_vote_count", 0) >= 20
+        ]
+    else:
+        filtered_title_metas = title_metas
+
+    final_metas = []
+    seen_ids = set()
+    for m in discover_metas:
+        mid = m.get("id")
+        if mid and mid not in seen_ids:
+            seen_ids.add(mid)
+            final_metas.append(m)
+            if len(final_metas) >= 60:
+                break
+
+    if len(final_metas) < 60:
+        for m in filtered_title_metas:
+            mid = m.get("id")
+            if mid and mid not in seen_ids:
+                seen_ids.add(mid)
+                final_metas.append(m)
+                if len(final_metas) >= 60:
+                    break
+
+    # 5. Log: 🔎 busca inteligente "<texto>" → tema [<palavras EN>] keywords [<ids>] ...: <n>
+    if concepts:
+        all_kw_ids = []
+        for c in concepts:
+            for kid in c:
+                if kid not in all_kw_ids:
+                    all_kw_ids.append(kid)
+        other_signals = [s for s in filters.get("signals", []) if not s.startswith("tema")]
+        other_str = f" {', '.join(other_signals)}" if other_signals else ""
+        logger.info(
+            f'🔎 busca inteligente "{query}" → tema {concept_words} keywords {all_kw_ids}{other_str}: {len(final_metas)}'
+        )
+    else:
+        summary = filters.get("summary") or ", ".join(filters.get("signals", []))
+        logger.info(f'🔎 busca inteligente "{query}" → {summary}: {len(final_metas)}')
+    return final_metas
+
