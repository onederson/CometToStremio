+    async def get_absolute_episode(
+        self,
+        series_id: str,
+        season: int | None,
+        episode: int | None,
+    ) -> int | None:
+        if season is None or episode is None:
+            return None
+        if season == 1:
+            return episode
+
+        if not isinstance(series_id, str) or not series_id.startswith("tt"):
+            return None
+
+        min_timestamp = time.time() - settings.METADATA_CACHE_TTL
+        if not await self._is_series_index_fresh(series_id, min_timestamp):
+            await self._refresh_from_cinemeta(series_id)
+
+        query = """
+            SELECT COUNT(*)
+            FROM series_episode_index
+            WHERE series_id = :series_id
+              AND season > 0
+              AND (
+                  season < CAST(:season AS INTEGER)
+                  OR (season = CAST(:season AS INTEGER) AND episode <= CAST(:episode AS INTEGER))
+              )
+        """
+        count = await database.fetch_val(
+            query,
+            {
+                "series_id": series_id,
+                "season": season,
+                "episode": episode,
+            },
+        )
+        if count and count > 0:
+            return int(count)
+
+        return None
