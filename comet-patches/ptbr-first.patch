+def generate_pluto_stream_url(stitched_url: str) -> str:
+    parsed = urllib.parse.urlparse(stitched_url)
+    qs = urllib.parse.parse_qs(parsed.query, keep_blank_values=True)
+    qs["deviceId"] = [_get_pluto_device_id()]
+    qs["sid"] = [str(uuid.uuid4())]
+    qs["appName"] = ["web"]
+    qs["deviceMake"] = ["Chrome"]
+    qs["deviceModel"] = ["web"]
+    qs["deviceType"] = ["web"]
+    qs["deviceVersion"] = ["unknown"]
+    now_utc = datetime.datetime.now(datetime.timezone.utc)
+    qs["clientTime"] = [now_utc.strftime("%Y-%m-%dT%H:%M:%SZ")]
+    flat_qs = {k: v[0] for k, v in qs.items()}
+    new_query = urllib.parse.urlencode(flat_qs)
+    return urllib.parse.urlunparse(parsed._replace(query=new_query))
