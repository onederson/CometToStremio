+async def _resolve_find_imdb(tmdb: TMDBApi, imdb_id: str, media_type: str) -> dict | None:
+    _ensure_find_map_loaded()
+    if imdb_id in _FIND_MAP:
+        cached_meta = _FIND_MAP[imdb_id]
+        if "_tmdb_id" in cached_meta:
+            return cached_meta
+
+    try:
+        data = await tmdb._get_json(
+            f"find/{imdb_id}?external_source=imdb_id&language=pt-BR",
+            f"find {imdb_id}",
+        )
+        if not isinstance(data, dict):
+            return None
+        res = (
+            data.get("movie_results", [])
+            if media_type == "movie"
+            else data.get("tv_results", [])
+        )
+        if not res:
+            return None
+        item = res[0]
+        poster_path = item.get("poster_path")
+        backdrop_path = item.get("backdrop_path")
+        name = (
+            item.get("title") or item.get("original_title") or ""
+            if media_type == "movie"
+            else item.get("name") or item.get("original_name") or ""
+        )
+        date_str = (
+            item.get("release_date")
+            if media_type == "movie"
+            else item.get("first_air_date")
+        ) or ""
+        year = date_str[:4] if len(date_str) >= 4 else ""
+        vote_avg = item.get("vote_average")
+        rating_str = f"{float(vote_avg):.1f}" if vote_avg is not None else ""
+
+        meta = {
+            "id": imdb_id,
+            "type": media_type,
+            "name": name,
+            "poster": f"https://image.tmdb.org/t/p/w500{poster_path}" if poster_path else None,
+            "background": f"https://image.tmdb.org/t/p/w1280{backdrop_path}" if backdrop_path else None,
+            "description": item.get("overview") or "",
+            "releaseInfo": year,
+            "imdbRating": rating_str,
+            "_tmdb_id": item.get("id"),
+            "_backdrop_path": backdrop_path,
+            "_poster_path": poster_path,
+            "_release_date": date_str,
+        }
+        _FIND_MAP[imdb_id] = meta
+        await asyncio.to_thread(_save_find_map)
+        return meta
+    except Exception as e:
+        logger.warning(f"Error finding meta for {imdb_id}: {e}")
+        return None
+
