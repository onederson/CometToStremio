+                            if en_logos:
+                                en_logos.sort(key=lambda x: float(x.get("vote_average") or 0.0), reverse=True)
+                                chosen_logo = en_logos[0].get("file_path")
+
+                if not chosen_backdrop and fallback_backdrop:
+                    chosen_backdrop = fallback_backdrop
+
+                res = {
+                    "backdrop": chosen_backdrop.lstrip("/") if chosen_backdrop else None,
+                    "logo": chosen_logo.lstrip("/") if chosen_logo else None,
+                }
+                _LANDSCAPE_MAP[cache_key] = res
+                landscape_cache_updated = True
+                return res
+
+        async def resolve_new_ep(tid: int) -> bool:
+            now = time.time()
