+    "🇧🇷",
+)
+
+
+class _DNSDatagramProtocol(asyncio.DatagramProtocol):
+    def __init__(self, query_data: bytes):
+        self.query_data = query_data
+        self.transport = None
+        self.response_future = asyncio.get_running_loop().create_future()
+
+    def connection_made(self, transport):
+        self.transport = transport
+        self.transport.sendto(self.query_data)
+
+    def datagram_received(self, data, addr):
+        if not self.response_future.done():
+            self.response_future.set_result(data)
+
+    def error_received(self, exc):
+        if not self.response_future.done():
+            self.response_future.set_exception(exc)
+
+    def connection_lost(self, exc):
+        if not self.response_future.done():
+            self.response_future.set_exception(exc or asyncio.CancelledError())
+
+
+def _parse_dns_response(data: bytes) -> list[str]:
+    if len(data) < 12:
+        return []
+    tid, flags, qdcount, ancount, nscount, arcount = struct.unpack(">HHHHHH", data[:12])
+    rcode = flags & 0x000F
+    if rcode != 0:
+        return []
+    idx = 12
+    for _ in range(qdcount):
+        while idx < len(data):
+            length = data[idx]
+            if length == 0:
+                idx += 1
+                break
+            elif (length & 0xC0) == 0xC0:
+                idx += 2
+                break
+            else:
+                idx += 1 + length
+        idx += 4
+
+    ips = []
+    for _ in range(ancount):
+        if idx >= len(data):
+            break
+        while idx < len(data):
+            length = data[idx]
+            if length == 0:
+                idx += 1
+                break
+            elif (length & 0xC0) == 0xC0:
+                idx += 2
+                break
+            else:
+                idx += 1 + length
+        if idx + 10 > len(data):
+            break
+        atype, aclass, ttl, rdlength = struct.unpack(">HHIH", data[idx:idx + 10])
+        idx += 10
+        if atype == 1 and rdlength == 4 and idx + 4 <= len(data):
+            ip = f"{data[idx]}.{data[idx + 1]}.{data[idx + 2]}.{data[idx + 3]}"
+            ips.append(ip)
+        idx += rdlength
+    return ips
+
+
+async def _query_house_dns_pure(host: str, dns_ip: str) -> list[str] | None:
+    tid = random.randint(0, 65535)
+    header = struct.pack(">HHHHHH", tid, 0x0100, 1, 0, 0, 0)
+    qname = b"".join(bytes([len(p)]) + p.encode("ascii") for p in host.split(".") if p) + b"\x00"
+    query = header + qname + struct.pack(">HH", 1, 1)
+
+    loop = asyncio.get_running_loop()
+    transport, protocol = await loop.create_datagram_endpoint(
+        lambda: _DNSDatagramProtocol(query),
+        remote_addr=(dns_ip, 53)
+    )
+    try:
+        data = await asyncio.wait_for(protocol.response_future, timeout=1.0)
+        return _parse_dns_response(data)
+    except Exception:
+        return None
+    finally:
+        transport.close()
+
+
+async def _is_host_blocked_by_house_dns(host: str, addon_name: str) -> bool:
+    house_dns = getattr(settings, "HOUSE_DNS", "192.168.3.44")
+    if not house_dns or not host:
+        return False
+    # If host is an IP literal, skip DNS query
+    if all(c.isdigit() or c == "." for c in host) or ":" in host:
+        return False
+
+    now = time.time()
+    if host in _HOUSE_DNS_CACHE:
+        ts, is_blocked = _HOUSE_DNS_CACHE[host]
+        if now - ts < _HOUSE_DNS_CACHE_TTL:
+            return is_blocked
+
+    try:
+        ips = await _query_house_dns_pure(host, house_dns)
+    except Exception:
+        ips = None
+    if ips is None:
+        # DNS da casa nao respondeu: nao da para saber, mantem o link e nao guarda cache
+        return False
+
+    is_blocked = (not ips) or ("0.0.0.0" in ips)
+    _HOUSE_DNS_CACHE[host] = (now, is_blocked)
+
+    if is_blocked:
+        last_logged = _HOUSE_DNS_LOGGED.get(host, 0)
+        if now - last_logged > 21600:  # 6 hours
+            logger.info(f"🚫 DNS da casa bloqueia {host} (link direto {addon_name})")
+            _HOUSE_DNS_LOGGED[host] = now
+
+    return is_blocked
+
+
+def _is_accepted_content_type(ct: str | None) -> bool:
+    if not ct:
+        return False
+    ct_clean = ct.split(";")[0].strip().lower()
+    if ct_clean.startswith("video/"):
+        return True
+    if ct_clean in (
+        "application/octet-stream",
+        "application/vnd.apple.mpegurl",
+        "application/x-mpegurl",
+    ):
+        return True
+    return False
+
+
+async def _validate_single_url(url: str, addon_name: str) -> bool:
+    now = time.time()
+    if url in _URL_VALID_CACHE:
+        ts, val = _URL_VALID_CACHE[url]
+        if now - ts < _URL_CACHE_TTL:
+            return val
+
+    headers = {
+        "User-Agent": "ExoPlayerLib/2.19.1",
+        "Range": "bytes=0-1023",
+    }
+    curr_url = url
+    transport = httpx.AsyncHTTPTransport(retries=0, verify=False)
+    is_valid = False
+    try:
+        async with httpx.AsyncClient(transport=transport) as client:
+            for hop in range(7):  # up to 6 redirects
+                parsed = urlparse(curr_url)
+                host = parsed.hostname
+                if not host:
+                    is_valid = False
+                    break
+
+                if await _is_host_blocked_by_house_dns(host, addon_name):
+                    is_valid = False
+                    break
+
+                try:
+                    async with client.stream(
+                        "GET",
+                        curr_url,
+                        headers=headers,
+                        follow_redirects=False,
+                        timeout=5.0
+                    ) as resp:
+                        if resp.status_code in (301, 302, 303, 307, 308):
+                            if hop >= 6:
+                                is_valid = False
+                                break
+                            loc = resp.headers.get("location")
+                            if not loc:
+                                is_valid = False
+                                break
+                            curr_url = urljoin(curr_url, loc)
+                            continue
+                        elif resp.status_code in (200, 206):
+                            ct = resp.headers.get("content-type")
+                            if not _is_accepted_content_type(ct):
+                                is_valid = False
+                                break
+                            body = bytearray()
+                            async for chunk in resp.aiter_bytes():
+                                body.extend(chunk)
+                                if len(body) >= 1024:
+                                    break
+                            is_valid = True
+                            break
+                        else:
+                            is_valid = False
+                            break
+                except Exception:
+                    is_valid = False
+                    break
+    except Exception:
+        is_valid = False
+
+    _URL_VALID_CACHE[url] = (now, is_valid)
+    return is_valid
+
+
+def _get_short_name(base_url: str) -> str:
+    parsed = urlparse(base_url)
+    host = (parsed.hostname or "").lower()
+    if "fenixflix" in host:
+        return "FenixFlix"
+    if "froststream" in host:
+        return "FrostStream"
+    first_label = host.split(".")[0] if host else "Direct"
+    return first_label.capitalize()
+
+
+def _extract_res(texto: str) -> str:
+    m = re.search(r"(?i)\b(2160p|4k|1080p|720p|480p)\b", texto)
+    if not m:
+        return ""
+    val = m.group(1).lower()
+    if val in ("2160p", "4k"):
+        return "4K"
+    elif val == "1080p":
+        return "1080p"
+    elif val == "720p":
+        return "720p"
+    elif val == "480p":
+        return "480p"
+    return ""
+
+
+async def _fetch_addon(
+    session: AsyncSession, base_url: str, media_type: str, media_id: str
+) -> list[dict]:
+    url = f"{base_url}/stream/{media_type}/{media_id}.json"
+    name = _get_short_name(base_url)
+    if breaker.is_open(name):
+        logger.debug(f"Fonte {name} pausada pelo breaker, pulando busca")
+        return []
+    try:
+        resp = await session.get(url, timeout=settings.DIRECT_ADDONS_TIMEOUT)
+        if resp.status_code == 200:
+            data = resp.json()
+            streams = data.get("streams", [])
+            if isinstance(streams, list):
+                record_source_success(name)
+                return streams
+            record_source_error(name, "Resposta sem streams")
+            return []
+        else:
+            logger.warning(
+                f"Direct addon {base_url} returned HTTP {resp.status_code}"
+            )
+            record_source_error(name, f"HTTP {resp.status_code}")
+    except Exception as e:
+        logger.warning(f"Direct addon {base_url} failed: {e}")
+        record_source_error(name, e)
+    return []
+
+
+async def fetch_direct_streams(media_type: str, media_id: str) -> list[dict]:
+    global _LAST_DIRECT_RATIO
+    try:
+        raw_urls = settings.DIRECT_ADDONS_URL
+        if isinstance(raw_urls, str):
+            urls = [raw_urls.rstrip("/")] if raw_urls else []
+        elif isinstance(raw_urls, list):
+            urls = [u.rstrip("/") for u in raw_urls if u]
+        else:
+            urls = []
+
+        if not urls:
+            return []
+
+        cache_key = (media_type, media_id, getattr(settings, "STREAM_LAYOUT", "clean"))
+        now = time.time()
+        if cache_key in _CACHE:
+            cached_time, cached_items = _CACHE[cache_key]
+            if now - cached_time < _CACHE_TTL:
+                return cached_items
+            else:
+                _CACHE.pop(cache_key, None)
+
+        try:
+            async with AsyncSession(impersonate="chrome") as session:
+                tasks = [
+                    _fetch_addon(session, base, media_type, media_id)
+                    for base in urls
+                ]
+                responses = await asyncio.gather(*tasks, return_exceptions=True)
+        except Exception as e:
+            logger.warning(f"Direct addons session error: {e}")
+            return []
+
+        raw_candidates = []
+        for base, res_streams in zip(urls, responses):
+            if not isinstance(res_streams, list):
+                continue
+            curto = _get_short_name(base)
+            for s in res_streams:
+                if not isinstance(s, dict):
+                    continue
+                orig_url = s.get("url")
+                if (
+                    not orig_url
+                    or not isinstance(orig_url, str)
+                    or not orig_url.startswith("http")
+                ):
+                    continue
+                raw_candidates.append((s, curto, orig_url))
+
+        total_count = len(raw_candidates)
+        if total_count == 0:
+            _LAST_DIRECT_RATIO = "0/0"
+            logger.info("🌐 diretos: 0/0")
+            return []
+
+        # Validate URLs in parallel (max 8 concurrent, total batch timeout 7.0s)
+        sem = asyncio.Semaphore(8)
+
+        async def _validate_wrapper(cand):
+            s_dict, addon_name, u_str = cand
+            async with sem:
+                valid = await _validate_single_url(u_str, addon_name)
+                return cand, valid
+
+        val_tasks = [asyncio.create_task(_validate_wrapper(cand)) for cand in raw_candidates]
+        done, pending = await asyncio.wait(val_tasks, timeout=7.0)
+        for t in pending:
+            t.cancel()
+
+        validated_candidates = []
+        for t in done:
+            if not t.cancelled() and not t.exception():
+                cand, is_valid = t.result()
+                if is_valid:
+                    validated_candidates.append(cand)
+
+        _LAST_DIRECT_RATIO = f"{len(validated_candidates)}/{total_count}"
+        logger.info(f"🌐 diretos: {len(validated_candidates)}/{total_count}")
+
+        converted_items = []
+        order_idx = 0
+
+        for s, curto, orig_url in validated_candidates:
+            orig_name = str(s.get("name") or "")
+            orig_desc = str(s.get("title") or s.get("description") or "")
+            texto = f"{orig_name}\n{orig_desc}"
+
+            texto_lower = texto.lower()
+            is_pt = any(kw in texto_lower for kw in PT_KEYWORDS)
+
+            res = _extract_res(texto)
+            res_rank = RES_RANKS.get(res, 4)
+
+            if getattr(settings, "STREAM_LAYOUT", "clean") == "clean":
+                res_label = res or "HD"
+                lang_label = "🇧🇷 PT-BR" if is_pt else "🌐 Original"
+                new_name = f"🌐 {res_label}\n{lang_label}"
+            else:
+                new_name = (
+                    ("🇧🇷 PT-BR\n" if is_pt else "")
+                    + f"🌐 {curto}"
+                    + (f"\n{res}" if res else "")
+                )
+
+            desc_lines = orig_desc.strip().splitlines()[:6]
+            trimmed_desc = "\n".join(desc_lines)
+            if trimmed_desc:
+                new_desc = (
+                    f"{trimmed_desc}\n🌐 Link direto ({curto}): "
+                    "não usa o Real-Debrid"
+                )
+            else:
+                new_desc = (
+                    f"🌐 Link direto ({curto}): não usa o Real-Debrid"
+                )
+
+            orig_hints = s.get("behaviorHints")
+            behavior_hints = (
+                dict(orig_hints) if isinstance(orig_hints, dict) else {}
+            )
+            behavior_hints["bingeGroup"] = f"comet|direct|{curto}|{res}"
+            if not behavior_hints.get("filename"):
+                behavior_hints["filename"] = f"{curto}.direct.{'PTBR' if is_pt else 'XX'}"
+
+            clean_stream = {
+                "name": new_name,
+                "description": new_desc,
+                "url": orig_url,
+                "behaviorHints": behavior_hints,
+                "_is_pt": is_pt,
+                "_res": res or "HD",
+                "_is_direct": True,
+            }
+            converted_items.append((clean_stream, is_pt, res_rank, order_idx))
+            order_idx += 1
+
+        converted_items.sort(key=lambda x: (0 if x[1] else 1, x[2], x[3]))
+        results = [item[0] for item in converted_items]
+
+        if results:
+            while len(_CACHE) >= _CACHE_MAX_SIZE:
+                oldest_key = min(_CACHE.keys(), key=lambda k: _CACHE[k][0])
+                _CACHE.pop(oldest_key, None)
+            _CACHE[cache_key] = (now, results)
+
+        return results
+    except Exception as e:
+        logger.warning(f"fetch_direct_streams unexpected error: {e}")
+        return []
