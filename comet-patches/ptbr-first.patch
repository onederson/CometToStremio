+            y1 = H - margin
+            y0 = y1 - bh
+            x1 = x0 + bw
+        else:
+            x0 = margin
+            y0 = margin
+            x1 = x0 + bw
+            y1 = y0 + bh
+
+        draw.rounded_rectangle([x0 + 1, y0 + 1, x1 + 1, y1 + 1], radius=radius, fill=(0, 0, 0, 90))
+        draw.rounded_rectangle([x0, y0, x1, y1], radius=radius, fill=bg, outline=(0, 0, 0, 100), width=1)
+        tx = x0 + (bw - tw) / 2 - bb[0]
+        ty = y0 + (bh - th) / 2 - bb[1]
+        draw.text((tx, ty), text, font=font, fill="#FFFFFF")
+
+
+def _draw_provider_logo(canvas: Image.Image, logo_bytes: bytes, is_poster: bool = False):
+    try:
+        W, H = canvas.size
+        metrics = _badge_metrics(canvas, is_poster=is_poster)
+        S = metrics["provider_size"]
+        margin = metrics["margin"]
+        x1 = W - margin
+        x0 = x1 - S
+        y0 = margin
+        y1 = y0 + S
+        radius = max(4, round(S * 0.18))
+
+        logo = Image.open(io.BytesIO(logo_bytes)).convert("RGBA")
+        logo_resized = logo.resize((S, S), Image.Resampling.LANCZOS)
+
+        mask = Image.new("L", (S, S), 0)
+        mask_draw = ImageDraw.Draw(mask)
+        mask_draw.rounded_rectangle([0, 0, S, S], radius=radius, fill=255)
+
+        if "A" in logo_resized.getbands():
+            alpha = logo_resized.split()[3]
+            mask = ImageChops.multiply(mask, alpha)
+
+        draw = ImageDraw.Draw(canvas)
+        draw.rounded_rectangle([x0 + 1, y0 + 1, x1 + 1, y1 + 1], radius=radius, fill=(0, 0, 0, 90))
+        canvas.paste(logo_resized, (x0, y0), mask=mask)
+        draw.rounded_rectangle([x0, y0, x1, y1], radius=radius, outline=(0, 0, 0, 80), width=1)
+    except Exception as e:
+        logger.warning(f"Error drawing provider logo: {e}")
+
