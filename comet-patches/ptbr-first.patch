new file mode 100644
index 0000000..28b4be2
--- /dev/null
+++ b/comet/api/endpoints/catalog.py
@@ -0,0 +1,94 @@
+import urllib.parse
+from fastapi import APIRouter, Request
+from fastapi.responses import JSONResponse
+
+from comet.core.config_validation import config_check, is_kids_request
+from comet.core.logger import logger
+from comet.core.models import settings
+from comet.services.catalogs import get_catalog
+
+router = APIRouter()
+
+
+@router.get(
+    "/catalog/{type}/{id}.json",
+    tags=["Stremio"],
+    summary="Catalog Provider",
+    description="Returns catalog metadata for the specified media.",
+)
+@router.get(
+    "/catalog/{type}/{id}/{extra}.json",
+    tags=["Stremio"],
+    summary="Catalog Provider",
+    description="Returns catalog metadata with extra parameters.",
+)
+@router.get(
+    "/{b64config}/catalog/{type}/{id}.json",
+    tags=["Stremio"],
+    summary="Catalog Provider",
+    description="Returns catalog metadata with configuration.",
+)
+@router.get(
+    "/{b64config}/catalog/{type}/{id}/{extra}.json",
+    tags=["Stremio"],
+    summary="Catalog Provider",
+    description="Returns catalog metadata with configuration and extra parameters.",
+)
+async def get_catalog_endpoint(
+    request: Request,
+    type: str,
+    id: str,
+    extra: str | None = None,
+    b64config: str | None = None,
+):
+    if not settings.CATALOGS_ENABLED:
+        return JSONResponse(
+            content={"metas": []},
+            headers={"Cache-Control": "public, max-age=600"},
+        )
+
+    try:
+        if b64config:
+            config = config_check(b64config)
+            if not config:
+                return JSONResponse(
+                    content={"metas": []},
+                    headers={"Cache-Control": "public, max-age=600"},
+                )
+
+        extra_dict = {}
+        if extra:
+            parsed = urllib.parse.parse_qs(extra)
+            for k, v in parsed.items():
+                if v:
+                    extra_dict[k] = v[0]
+
+        for k, v in request.query_params.items():
+            if k not in extra_dict:
+                extra_dict[k] = v
+
+        base_url = (getattr(settings, "PUBLIC_BASE_URL", None) or f"{request.url.scheme}://{request.url.netloc}").rstrip("/")
+        kids = is_kids_request(b64config)
+        is_personal = bool(settings.PERSONAL_LINK_TOKEN and b64config == settings.PERSONAL_LINK_TOKEN)
+        if id in ("comet_livetv", "comet_livehome") and b64config is not None and not is_personal and not kids:
+            return JSONResponse(
+                content={"metas": []},
+                headers={"Cache-Control": "public, max-age=600"},
+            )
+        metas = await get_catalog(
+            media_type=type,
+            catalog_id=id,
+            extra=extra_dict,
+            base_url=base_url,
+            kids=kids,
+        )
+        return JSONResponse(
+            content={"metas": metas},
+            headers={"Cache-Control": "public, max-age=600"},
+        )
+    except Exception as e:
+        logger.warning(f"Error handling catalog request: {type(e).__name__}")
+        return JSONResponse(
+            content={"metas": []},
+            headers={"Cache-Control": "public, max-age=600"},
+        )
