+# EBML Parser Utilities
+def _read_vint(data: bytes, offset: int) -> tuple[int | None, int | None, int]:
+    """
+    Reads an EBML variable-length integer.
+    Returns (raw_value, data_value, new_offset).
+    raw_value includes the length bit (used for Element IDs).
+    data_value masks off the length bit (used for Element Sizes).
+    If size is unknown (all bits 1), data_value is -1.
+    """
+    if offset >= len(data):
+        return None, None, offset
+    b0 = data[offset]
+    if b0 == 0:
+        return None, None, offset
+    mask = 0x80
+    length = 1
+    while not (b0 & mask):
+        mask >>= 1
+        length += 1
+        if length > 8:
+            return None, None, offset
+
+    if offset + length > len(data):
+        return None, None, offset
+
+    raw = 0
+    for i in range(length):
+        raw = (raw << 8) | data[offset + i]
+
+    first_byte_val = b0 & (~mask)
+    data_val = first_byte_val
+    for i in range(1, length):
+        data_val = (data_val << 8) | data[offset + i]
+
+    max_val = (1 << (7 * length)) - 1
+    if data_val == max_val:
+        data_val = -1
+
+    return raw, data_val, offset + length
+
+
+def _parse_tracks_element(data: bytes, start_offset: int, end_offset: int) -> list[dict]:
+    audio_tracks = []
+    toff = start_offset
+    while toff < end_offset:
+        te_id, _, te_noff = _read_vint(data, toff)
+        if te_id is None:
+            break
+        _, te_sz, te_doff = _read_vint(data, te_noff)
+        if te_sz is None:
+            break
+        te_end = len(data) if te_sz == -1 else te_doff + te_sz
+        if te_id == 0xAE:  # TrackEntry
+            eoff = te_doff
+            trk_type = None
+            lang = None
+            bcp47 = None
+            name = None
+            codec = None
+            while eoff < te_end:
+                sub_id, _, sub_noff = _read_vint(data, eoff)
+                if sub_id is None:
+                    break
+                _, sub_sz, sub_doff = _read_vint(data, sub_noff)
+                if sub_sz is None:
+                    break
+                sub_end = len(data) if sub_sz == -1 else sub_doff + sub_sz
+                sub_bytes = data[sub_doff:sub_end]
+                if sub_id == 0x83:  # TrackType
+                    trk_type = int.from_bytes(sub_bytes, "big")
+                elif sub_id == 0x22B59C:  # Language
+                    lang = sub_bytes.decode("utf-8", errors="replace").rstrip("\x00")
+                elif sub_id == 0x22B59D:  # LanguageBCP47
+                    bcp47 = sub_bytes.decode("utf-8", errors="replace").rstrip("\x00")
+                elif sub_id == 0x536E:  # Name
+                    name = sub_bytes.decode("utf-8", errors="replace").rstrip("\x00")
+                elif sub_id == 0x86:  # CodecID
+                    codec = sub_bytes.decode("utf-8", errors="replace").rstrip("\x00")
+                eoff = sub_end
+
+            if trk_type == 2:  # Audio
+                l = lang or bcp47 or "eng"
+                audio_tracks.append({
+                    "lang": l,
+                    "name": name or "",
+                    "codec": codec or "",
+                    "bcp47": bcp47 or "",
+                })
+        toff = te_end
+    return audio_tracks
+
+
+def _parse_mkv_buffer(data: bytes) -> tuple[list[dict] | None, int | None, bool]:
+    """
+    Parses MKV EBML data.
+    Returns (audio_tracks, tracks_seek_pos, hit_cluster).
+    """
+    if len(data) < 4 or data[:4] != b"\x1a\x45\xdf\xa3":
+        return None, None, False
+
+    offset = 0
+    eid, esz, offset = _read_vint(data, offset)
+    if eid != 0x1A45DFA3:
+        return None, None, False
+    _, esz, offset = _read_vint(data, offset)
+    if esz is None or offset + esz > len(data):
+        return None, None, False
+    offset += esz  # skip EBML header
+
+    eid, _, offset = _read_vint(data, offset)
+    if eid != 0x18538067:  # Segment
+        return None, None, False
+    _, seg_size, seg_data_start = _read_vint(data, offset)
+    if seg_data_start is None:
+        return None, None, False
+
+    seg_end = len(data) if seg_size == -1 else min(len(data), seg_data_start + seg_size)
+    offset = seg_data_start
+    audio_tracks = None
+    tracks_seek_pos = None
+    hit_cluster = False
+
+    while offset < seg_end:
+        cid, _, noff = _read_vint(data, offset)
+        if cid is None:
+            break
+        _, csize, doff = _read_vint(data, noff)
+        if csize is None:
+            break
+        cend = len(data) if csize == -1 else doff + csize
+
+        if cid == 0x1F43B675:  # Cluster
+            hit_cluster = True
+            break
+
+        if cid == 0x1654AE6B:  # Tracks
+            audio_tracks = _parse_tracks_element(data, doff, cend)
+            break
+
+        if cid == 0x114D9B74:  # SeekHead
+            soff = doff
+            while soff < cend:
+                sid, _, snoff = _read_vint(data, soff)
+                if sid is None:
+                    break
+                _, ssz, sdoff = _read_vint(data, snoff)
+                if ssz is None:
+                    break
+                send = len(data) if ssz == -1 else sdoff + ssz
+                if sid == 0x4DBB:  # Seek
+                    koff = sdoff
+                    seek_id_val = None
+                    seek_pos_val = None
+                    while koff < send:
+                        kid, _, knoff = _read_vint(data, koff)
+                        if kid is None:
+                            break
+                        _, ksz, kdoff = _read_vint(data, knoff)
+                        if ksz is None:
+                            break
+                        kend = len(data) if ksz == -1 else kdoff + ksz
+                        kbytes = data[kdoff:kend]
+                        if kid == 0x53AB:  # SeekID
+                            seek_id_val = kbytes
+                        elif kid == 0x53AC:  # SeekPosition
+                            seek_pos_val = int.from_bytes(kbytes, "big")
+                        koff = kend
+                    if seek_id_val == b"\x16\x54\xae\x6b" and seek_pos_val is not None:
+                        tracks_seek_pos = seg_data_start + seek_pos_val
+                soff = send
+
+        offset = cend
+
+    return audio_tracks, tracks_seek_pos, hit_cluster
+
+
+# MP4 Parser Utilities
+def _iter_mp4_boxes(buf: bytes):
+    boff = 0
+    while boff + 8 <= len(buf):
+        bsz = int.from_bytes(buf[boff:boff+4], "big")
+        btyp = buf[boff+4:boff+8]
+        if bsz == 1:
+            if boff + 16 > len(buf):
+                break
+            bsz = int.from_bytes(buf[boff+8:boff+16], "big")
+            hsz = 16
+        else:
+            hsz = 8
+        if bsz == 0:
+            bsz = len(buf) - boff
+        if boff + bsz > len(buf):
+            # truncated box
+            payload = buf[boff+hsz:]
+            yield btyp, payload
+            break
+        payload = buf[boff+hsz:boff+bsz]
+        yield btyp, payload
+        boff += bsz
+
+
+def _parse_mp4_buffer(data: bytes) -> tuple[list[dict] | None, bool]:
+    """
+    Parses MP4 data.
+    Returns (audio_tracks, moov_found).
+    """
+    if len(data) < 8 or data[4:8] != b"ftyp":
+        return None, False
+
+    moov_data = None
+    offset = 0
+    while offset + 8 <= len(data):
+        bsz = int.from_bytes(data[offset:offset+4], "big")
+        btype = data[offset+4:offset+8]
+        if bsz == 1:
+            if offset + 16 > len(data):
+                break
+            bsz = int.from_bytes(data[offset+8:offset+16], "big")
+            hsz = 16
+        else:
+            hsz = 8
+        if bsz == 0:
+            bsz = len(data) - offset
+        if btype == b"moov":
+            moov_end = min(len(data), offset + bsz)
+            moov_data = data[offset+hsz:moov_end]
+            break
+        offset += bsz
+
+    if not moov_data:
+        return None, False
+
+    audio_tracks = []
+    for m_typ, m_data in _iter_mp4_boxes(moov_data):
+        if m_typ == b"trak":
+            is_sound = False
+            lang = None
+            codec = ""
+            name = ""
+            for t_typ, t_data in _iter_mp4_boxes(m_data):
+                if t_typ == b"mdia":
+                    for md_typ, md_data in _iter_mp4_boxes(t_data):
+                        if md_typ == b"hdlr":
+                            if len(md_data) >= 12 and md_data[8:12] == b"soun":
+                                is_sound = True
+                        elif md_typ == b"mdhd":
+                            if len(md_data) >= 4:
+                                ver = md_data[0]
+                                lang_off = 32 if ver == 1 else 20
+                                if len(md_data) >= lang_off + 2:
+                                    li = int.from_bytes(md_data[lang_off:lang_off+2], "big")
+                                    c1 = chr(((li >> 10) & 0x1F) + 0x60)
+                                    c2 = chr(((li >> 5) & 0x1F) + 0x60)
+                                    c3 = chr((li & 0x1F) + 0x60)
+                                    if all("a" <= c <= "z" for c in (c1, c2, c3)):
+                                        lang = f"{c1}{c2}{c3}"
+                        elif md_typ == b"minf":
+                            for mi_typ, mi_data in _iter_mp4_boxes(md_data):
+                                if mi_typ == b"stbl":
+                                    for s_typ, s_data in _iter_mp4_boxes(mi_data):
+                                        if s_typ == b"stsd":
+                                            if len(s_data) >= 16:
+                                                codec = s_data[12:16].decode("ascii", errors="ignore").strip()
+                elif t_typ == b"udta":
+                    for u_typ, u_data in _iter_mp4_boxes(t_data):
+                        if u_typ in (b"name", b"\xa9nam"):
+                            try:
+                                name = u_data.decode("utf-8", errors="ignore").strip()
+                            except Exception:
+                                pass
+            if is_sound:
+                audio_tracks.append({
+                    "lang": lang or "und",
+                    "name": name,
+                    "codec": codec,
+                })
+    return audio_tracks, True
+
+
+async def _fetch_range(url: str, start: int, end: int, session: aiohttp.ClientSession) -> bytes | None:
+    headers = {
+        "User-Agent": "ExoPlayerLib/2.19.1",
+        "Range": f"bytes={start}-{end}",
+    }
+    max_bytes = end - start + 1
+    try:
+        timeout = aiohttp.ClientTimeout(total=8.0)
+        async with session.get(url, headers=headers, timeout=timeout, allow_redirects=True) as resp:
+            if resp.status not in (200, 206):
+                return None
+            chunks = []
+            received = 0
+            async for chunk in resp.content.iter_chunked(65536):
+                chunks.append(chunk)
+                received += len(chunk)
+                if received >= max_bytes:
+                    break
+            return b"".join(chunks)[:max_bytes]
+    except Exception as exc:
+        logger.debug(f"audio_probe range fetch failed ({url[:30]}...): {exc}")
+        return None
+
+
+async def probe_audio(url: str) -> list[dict] | None:
+    """
+    Probes audio tracks from a media URL using pure Python.
+    Reads Range 0-1048575, parses MKV or MP4.
+    If needed, reads up to 4 MB or fetches SeekHead range.
+    Returns list of track dicts or None on failure/unsupported format.
+    """
+    if not url:
+        return None
+
+    close_session = False
+    session = None
+    try:
+        try:
+            session = await http_client_manager.get_session()
+        except Exception:
+            session = aiohttp.ClientSession()
+            close_session = True
+
+        # 1. Read first 1 MB (bytes 0-1048575)
+        data = await _fetch_range(url, 0, 1048575, session)
+        if not data or len(data) < 8:
+            return None
+
+        # Check format
+        is_mkv = data[:4] == b"\x1a\x45\xdf\xa3"
+        is_mp4 = data[4:8] == b"ftyp"
+
+        if not is_mkv and not is_mp4:
+            return None
+
+        if is_mkv:
+            tracks, seek_pos, hit_cluster = _parse_mkv_buffer(data)
+            if tracks is not None:
+                return tracks
+
+            # If tracks were not found before Cluster, but SeekHead gave position
+            if hit_cluster and seek_pos is not None:
+                chunk = await _fetch_range(url, seek_pos, seek_pos + 65535, session)
+                if chunk:
+                    # chunk may start with Tracks element ID (0x1654AE6B)
+                    eid, _, noff = _read_vint(chunk, 0)
+                    if eid == 0x1654AE6B:
+                        _, sz, doff = _read_vint(chunk, noff)
+                        end = len(chunk) if sz == -1 else doff + sz
+                        seek_tracks = _parse_tracks_element(chunk, doff, end)
+                        return seek_tracks
+
+            # If tracks not found, read up to 4 MB (fetch next 3 MB)
+            more = await _fetch_range(url, 1048576, 4194303, session)
+            if more:
+                data = data + more
+                tracks, seek_pos, hit_cluster = _parse_mkv_buffer(data)
+                if tracks is not None:
+                    return tracks
+                if seek_pos is not None:
+                    chunk = await _fetch_range(url, seek_pos, seek_pos + 65535, session)
+                    if chunk:
+                        eid, _, noff = _read_vint(chunk, 0)
+                        if eid == 0x1654AE6B:
+                            _, sz, doff = _read_vint(chunk, noff)
+                            end = len(chunk) if sz == -1 else doff + sz
+                            return _parse_tracks_element(chunk, doff, end)
+
+            return None
+
+        elif is_mp4:
+            tracks, moov_found = _parse_mp4_buffer(data)
+            if moov_found and tracks is not None:
+                return tracks
+
+            # If moov not found in 1 MB, try up to 4 MB
+            more = await _fetch_range(url, 1048576, 4194303, session)
+            if more:
+                data = data + more
+                tracks, moov_found = _parse_mp4_buffer(data)
+                if moov_found and tracks is not None:
+                    return tracks
+
+            # If moov is not at the start, return None
+            return None
+
+    except Exception as exc:
+        logger.debug(f"probe_audio exception: {exc}")
+        return None
+    finally:
+        if close_session and session and not session.closed:
+            await session.close()
+
