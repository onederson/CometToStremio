+async def render_animation(
+    media_type: str,
+    tmdb_id: str | int,
+    ext: str,
+    kind: str = "backdrop",
+) -> tuple[bytes, str]:
+    ext = ext.lower().strip()
+    if ext not in ("webp", "gif"):
+        raise ArtworkNotFound(f"Unsupported format: {ext}")
+    clean_type = "tv" if media_type in ("tv", "series") else "movie"
+    try:
+        clean_id = int(str(tmdb_id).strip())
+    except (ValueError, TypeError):
+        raise ArtworkNotFound(f"Invalid tmdb_id: {tmdb_id}")
+
+    is_poster = (kind == "poster")
+    if is_poster:
+        cache_filename = f"anim-poster-{clean_type}-{clean_id}.{ext}"
+    else:
+        cache_filename = f"anim-{clean_type}-{clean_id}.{ext}"
+    cache_path = os.path.join(CACHE_DIR, cache_filename)
+
+    if os.path.isfile(cache_path):
+        try:
+            with open(cache_path, "rb") as f:
+                return f.read(), f"image/{ext}"
+        except Exception:
+            pass
