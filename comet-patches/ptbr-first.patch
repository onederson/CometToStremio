+def _get_manifest_version() -> str:
+    try:
+        resources = [
+            {
+                "name": "stream",
+                "types": ["movie", "series", "tv"] if getattr(settings, "LIVE_TV", True) else ["movie", "series"],
+                "idPrefixes": ["tt", "kitsu", "cometlive:"] if getattr(settings, "LIVE_TV", True) else ["tt", "kitsu"],
+            }
+        ]
+        if settings.SUBTITLES_ENABLED:
+            resources.append(
+                {"name": "subtitles", "types": ["movie", "series"], "idPrefixes": ["tt"]}
+            )
+        catalogs = []
+        if settings.CATALOGS_ENABLED:
+            catalogs = build_manifest_catalogs(is_personal=True)
+            resources.append("catalog")
+            resources.append(
+                {
+                    "name": "meta",
+                    "types": ["movie", "series", "tv"] if getattr(settings, "LIVE_TV", True) else ["movie", "series"],
+                    "idPrefixes": ["tt", "cometlive:"] if getattr(settings, "LIVE_TV", True) else ["tt"],
+                }
+            )
+        payload = catalogs + resources
+        n = int(
+            hashlib.sha1(
+                json.dumps(payload, sort_keys=True, ensure_ascii=False).encode()
+            ).hexdigest()[:6],
+            16,
+        )
+        return f"2.1.{n}"
+    except Exception:
+        return "2.1.0"
+
+
+def _format_uptime(seconds: int) -> str:
+    days, rem = divmod(seconds, 86400)
+    hours, rem = divmod(rem, 3600)
+    minutes, secs = divmod(rem, 60)
+    parts = []
+    if days > 0:
+        parts.append(f"{days}d")
+    if hours > 0:
+        parts.append(f"{hours}h")
+    if minutes > 0 or not parts:
+        parts.append(f"{minutes}m")
+    parts.append(f"{secs}s")
+    return " ".join(parts)
+
+
+def _get_system_memory() -> tuple[str, str]:
+    mem_avail = "N/A"
+    swap_free = "N/A"
+    try:
+        with open("/proc/meminfo", "r", encoding="utf-8") as f:
+            for line in f:
+                if line.startswith("MemAvailable:"):
+                    parts = line.split()
+                    kb = int(parts[1])
+                    mem_avail = f"{kb // 1024} MB"
+                elif line.startswith("SwapFree:"):
+                    parts = line.split()
+                    kb = int(parts[1])
+                    swap_free = f"{kb // 1024} MB"
+    except Exception:
+        pass
+    return mem_avail, swap_free
+
+
+def _get_process_rss() -> str:
+    rss = "N/A"
+    try:
+        with open("/proc/self/status", "r", encoding="utf-8") as f:
+            for line in f:
+                if line.startswith("VmRSS:"):
+                    parts = line.split()
+                    kb = int(parts[1])
+                    rss = f"{kb // 1024} MB"
+                    break
+    except Exception:
+        pass
+    return rss
+
+
+def _get_smoke_last():
+    path = Path("/opt/comet/data/smoke_last.json")
+    if not path.is_file():
+        return None
+    try:
+        return json.loads(path.read_text(encoding="utf-8"))
+    except Exception:
+        return None
+
+
+
+def _get_nightly_last():
+    path = Path("/opt/comet/data/nightly_last.json")
+    if not path.is_file():
+        path = Path("data/nightly_last.json")
+    if not path.is_file():
+        return None
+    try:
+        return json.loads(path.read_text(encoding="utf-8"))
+    except Exception:
+        return None
+
+
+def _get_next_nightly_str() -> str:
+    try:
+        now = datetime.now().astimezone()
+        hour = getattr(settings, "NIGHTLY_WARM_HOUR", 4)
+        target = now.replace(hour=hour, minute=0, second=0, microsecond=0)
+        if target <= now:
+            target += timedelta(days=1)
+        return target.strftime("%Y-%m-%d %H:%M:%S")
+    except Exception:
+        return "N/A"
+
+def _get_regress_last():
+    path = Path("/opt/comet/data/regress_last.json")
+    if not path.is_file():
+        return None
+    try:
+        return json.loads(path.read_text(encoding="utf-8"))
+    except Exception:
+        return None
