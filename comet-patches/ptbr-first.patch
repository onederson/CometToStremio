+def parse_query(text: str) -> dict | None:
+    if not text or not text.strip():
+        return None
+
+    raw = text.strip()
+    norm = strip_accents(raw).lower()
+
+    signals = []
+    matched_genres_movie = []
+    matched_genres_tv = []
+    original_language = None
+    media_type_hint = None
+
+    # 1. Media type hint (filme / série)
+    has_media_hint = False
+    if re.search(r"\b(filmes?)\b", norm):
+        media_type_hint = "movie"
+        has_media_hint = True
+    elif re.search(r"\b(series?)\b", norm):
+        media_type_hint = "series"
+        has_media_hint = True
+
+    # 2. Quality / Language / Country
+    dublado = False
+    if re.search(r"\b(dublad[oa]s?)\b", norm):
+        dublado = True
+        signals.append("dublado")
+
+    origin_country = None
+    if re.search(r"\b(naciona(l|is)|brasileir[oa]s?|do\s+brasil)\b", norm):
+        origin_country = "BR"
+        signals.append("nacional")
+
+    vote_average_gte = None
+    vote_count_gte = None
+    if re.search(r"\b(mais\s+bem\s+avaliad[oa]s?|bem\s+avaliad[oa]s?|melhores|aclamad[oa]s?)\b", norm):
+        vote_average_gte = 7.5
+        vote_count_gte = 500
+        signals.append("bem avaliado")
+
+    runtime_lte = None
+    if re.search(r"\b(curt[oa]s?)\b", norm):
+        runtime_lte = 100
+        signals.append("curto")
+
+    # 3. Epoch
+    epoch = None
+    now_year = datetime.date.today().year
+
+    decade_match = re.search(r"\b(?:dos\s+|de\s+|na\s+|da\s+decada\s+de\s+|decada\s+de\s+)?anos\s+(\d{2,4})s?\b", norm)
+    if not decade_match:
+        decade_match = re.search(r"\b(\d{4})s\b", norm)
+
+    if decade_match:
+        dec_val = int(decade_match.group(1))
+        if dec_val < 100:
+            if dec_val >= 20:
+                dec_val = 1900 + dec_val
+            else:
+                dec_val = 2000 + dec_val
+        epoch = {
+            "type": "range",
+            "gte": f"{dec_val}-01-01",
+            "lte": f"{dec_val + 9}-12-31",
+            "label": f"anos {dec_val % 100 if dec_val < 2000 else dec_val}",
+        }
+        signals.append(f"anos {dec_val % 100 if dec_val < 2000 else dec_val}")
+    elif re.search(r"\b(antig[oa]s?|classic[oa]s?)\b", norm):
+        epoch = {
+            "type": "antigo",
+            "gte": None,
+            "lte": "1989-12-31",
+            "label": "antigo (< 1990)",
+        }
+        signals.append("antigo")
+    elif re.search(r"\b(recentes?|nov[oa]s?|lancamentos?)\b", norm):
+        two_years_ago = f"{now_year - 2}-01-01"
+        epoch = {
+            "type": "recente",
+            "gte": two_years_ago,
+            "lte": None,
+            "label": f"recente (>= {now_year - 2})",
+        }
+        signals.append("recente")
+    else:
+        year_match = re.search(r"\b(?:de|em|do\s+ano\s+de)\s+(\d{4})\b", norm)
+        if year_match:
+            y = int(year_match.group(1))
+            if 1900 <= y <= now_year + 2:
+                epoch = {
+                    "type": "year",
+                    "year": y,
+                    "gte": f"{y}-01-01",
+                    "lte": f"{y}-12-31",
+                    "label": str(y),
+                }
+                signals.append(f"ano {y}")
+
+    # 4. Genres
+    has_genre = False
+    for pattern, mg_ids, tg_ids, label, lang in GENRES_CONFIG:
+        if re.search(pattern, norm):
+            has_genre = True
+            for gid in mg_ids:
+                if gid not in matched_genres_movie:
+                    matched_genres_movie.append(gid)
+            for gid in tg_ids:
+                if gid not in matched_genres_tv:
+                    matched_genres_tv.append(gid)
+            if lang and not original_language:
+                original_language = lang
+            signals.append(label)
+
+    # 5. Person
+    # "Pessoa só quando: com <nome>; ou do/da/de/dos <nome> em que o search/person..."
+    person = None
+    person_candidate = None
+    com_match = re.search(r"\bcom\s+([A-Za-z0-9À-ÿ\s]+)", raw, re.IGNORECASE)
+    if com_match:
+        cand = com_match.group(1).strip()
+        cand = re.split(
+            r"\b(?:dos\s+anos|anos|de\s+\d{4}|dublad[oa]|naciona|brasileir|bem\s+avaliad|melhores|curt[oa]|de\b|sobre\b)",
+            cand,
+            flags=re.IGNORECASE,
+        )[0].strip()
+        cand_norm = strip_accents(cand).lower()
+        if cand and cand_norm not in THEME_KEYWORDS and cand_norm not in DOMAIN_SYNONYMS and not any(w in DOMAIN_SYNONYMS for w in cand_norm.split()):
+            person = cand
+            signals.append(f"pessoa '{person}'")
+
+    if not person:
+        dir_match = re.search(r"\b(?:do|da|dos|das|de)\s+([A-Za-z0-9À-ÿ\s]+)", raw, re.IGNORECASE)
+        if dir_match:
+            cand = dir_match.group(1).strip()
+            cand = re.split(
+                r"\b(?:dos\s+anos|anos|de\s+\d{4}|dublad[oa]|naciona|brasileir|bem\s+avaliad|melhores|curt[oa]|sobre\b)",
+                cand,
+                flags=re.IGNORECASE,
+            )[0].strip()
+            cand_norm = strip_accents(cand).lower()
+            if cand and cand_norm not in ("brasil", "ano", "mundo") and cand_norm not in THEME_KEYWORDS and cand_norm not in DOMAIN_SYNONYMS and not any(w in DOMAIN_SYNONYMS for w in cand_norm.split()):
+                person_candidate = cand
+
+    # 6. Themes & Keywords
+    theme = None
+    keyword = None
+    theme_query = None
+
+    matched_plot = None
+    for pattern, kw in COMMON_PLOTS:
+        if re.search(pattern, norm):
+            matched_plot = kw
+            keyword = kw
+            signals.append(f"enredo '{kw}'")
+            break
+
+    if not keyword:
+        sorted_themes = sorted(THEME_KEYWORDS.keys(), key=lambda x: len(x), reverse=True)
+        for t_key in sorted_themes:
+            if re.search(rf"\b{re.escape(t_key)}\b", norm):
+                if person and t_key in strip_accents(person).lower():
+                    continue
+                theme = t_key
+                keyword = THEME_KEYWORDS[t_key]
+                signals.append(f"tema '{keyword}'")
+                break
+
+    # Strip recognized signals and stopwords from norm to find remaining words for generic theme
+    clean_text = norm
+    for pattern, _ in COMMON_PLOTS:
+        clean_text = re.sub(pattern, " ", clean_text)
+    for pattern, _, _, _, _ in GENRES_CONFIG:
+        clean_text = re.sub(pattern, " ", clean_text)
+    clean_text = re.sub(r"\b(?:dos\s+|de\s+|na\s+|da\s+decada\s+de\s+|decada\s+de\s+)?anos\s+\d{2,4}s?\b", " ", clean_text)
+    clean_text = re.sub(r"\b\d{4}s\b", " ", clean_text)
+    clean_text = re.sub(r"\b(?:de|em|do\s+ano\s+de)\s+\d{4}\b", " ", clean_text)
+    clean_text = re.sub(r"\b(antig[oa]s?|classic[oa]s?|recentes?|nov[oa]s?|lancamentos?)\b", " ", clean_text)
+    clean_text = re.sub(r"\b(dublad[oa]s?|naciona(l|is)|brasileir[oa]s?|do\s+brasil|mais\s+bem\s+avaliad[oa]s?|bem\s+avaliad[oa]s?|melhores|aclamad[oa]s?|curt[oa]s?)\b", " ", clean_text)
+    if theme:
+        clean_text = re.sub(rf"\b{re.escape(theme)}\b", " ", clean_text)
+    if person:
+        for pw in strip_accents(person).lower().split():
+            clean_text = re.sub(rf"\b{re.escape(pw)}\b", " ", clean_text)
+
+    has_connector = bool(re.search(CONNECTORS_PATTERN, norm))
+    remaining_tokens = [w for w in re.findall(r"[a-z0-9]+", clean_text) if w not in STOPWORDS]
+
+    if remaining_tokens and (has_media_hint or has_connector or has_genre or epoch or dublado or origin_country or keyword):
+        theme_query = " ".join(remaining_tokens)
+        if not keyword:
+            signals.append(f"tema '{theme_query}'")
+
+    if not signals and not person_candidate:
+        return None
+
+    if not (has_genre or epoch or dublado or origin_country or vote_average_gte or person or person_candidate or keyword or theme_query):
+        return None
+
+    return {
+        "raw_query": raw,
+        "genres": {
+            "movie": matched_genres_movie,
+            "tv": matched_genres_tv,
+        } if (matched_genres_movie or matched_genres_tv) else {},
+        "original_language": original_language,
+        "epoch": epoch,
+        "person": person,
+        "person_candidate": person_candidate,
+        "theme": theme,
+        "keyword": keyword,
+        "theme_query": theme_query,
+        "dublado": dublado,
+        "origin_country": origin_country,
+        "vote_average_gte": vote_average_gte,
+        "vote_count_gte": vote_count_gte,
+        "runtime_lte": runtime_lte,
+        "media_type_hint": media_type_hint,
+        "signals": signals,
+        "summary": ", ".join(signals),
+    }
