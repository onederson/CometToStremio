@@ -0,0 +1,232 @@
+import asyncio
+import time
+from datetime import datetime, timezone
+
+import aiohttp
+
+from comet.core.database import database
+from comet.core.logger import logger
+from comet.core.models import settings
+
+_RECENT_PREFETCHES: dict[str, float] = {}
+_PREFETCH_SEMAPHORE = asyncio.Semaphore(2)
+_TASKS: set = set()  # guarda referencia: sem isso o asyncio pode descartar a tarefa
+_COOLDOWN_SECONDS = 20 * 60  # 20 minutes
+
+
+def _is_future_release(rel_str: str | None) -> bool:
+    if not rel_str or not isinstance(rel_str, str):
+        return True
+    try:
+        clean = rel_str.strip().replace("Z", "+00:00")
+        dt = datetime.fromisoformat(clean)
+        if dt.tzinfo is None:
+            dt = dt.replace(tzinfo=timezone.utc)
+        return dt > datetime.now(timezone.utc)
+    except Exception:
+        try:
+            d_part = rel_str.strip().split("T", 1)[0]
+            d = datetime.strptime(d_part, "%Y-%m-%d").date()
+            return d > datetime.now(timezone.utc).date()
+        except Exception:
+            return True
+
+
+def _find_next_episode(
+    videos: list[dict], current_s: int, current_e: int
+) -> tuple[int, int] | None:
+    all_episodes: dict[tuple[int, int], dict] = {}
+    for v in videos:
+        if not isinstance(v, dict):
+            continue
+        s = v.get("season")
+        e = v.get("episode", v.get("number"))
+        try:
+            all_episodes[(int(s), int(e))] = v
+        except (TypeError, ValueError):
+            continue
+
+    season_episodes = [ep for (s, ep) in all_episodes.keys() if s == current_s]
+    if not season_episodes:
+        return None
+
+    max_e = max(season_episodes)
+    if current_e < max_e:
+        target = (current_s, current_e + 1)
+    else:
+        target = (current_s + 1, 1)
+
+    target_video = all_episodes.get(target)
+    if not target_video:
+        return None
+
+    rel = target_video.get("released") or target_video.get("firstAired")
+    if _is_future_release(rel):
+        return None
+
+    return target
+
+
+async def _get_series_videos(
+    session: aiohttp.ClientSession, imdb_id: str
+) -> list[dict]:
+    # 1. Tenta meta_ptbr (usa cache em memoria)
+    try:
+        from comet.services.meta_ptbr import get_meta_ptbr
+
+        meta = await get_meta_ptbr("series", imdb_id)
+        if meta and isinstance(meta.get("videos"), list) and meta["videos"]:
+            return meta["videos"]
+    except Exception as e:
+        logger.warning(f"Erro ao obter meta_ptbr para {imdb_id}: {e}")
+
+    # 2. Fallback direto Cinemeta
+    try:
+        url = f"https://v3-cinemeta.strem.io/meta/series/{imdb_id}.json"
+        async with session.get(
+            url, timeout=aiohttp.ClientTimeout(total=10.0)
+        ) as resp:
+            if resp.status == 200:
+                data = await resp.json()
+                if isinstance(data, dict):
+                    meta = data.get("meta") or {}
+                    if isinstance(meta.get("videos"), list):
+                        return meta["videos"]
+    except Exception as e:
+        logger.warning(f"Erro ao obter Cinemeta para {imdb_id}: {e}")
+
+    return []
+
+
+async def _resolve_imdb_id(
+    media_id: str | None, info_hash: str | None
+) -> str | None:
+    if media_id:
+        if media_id.startswith("tt"):
+            return media_id.split(":")[0]
+        if media_id.startswith("kitsu:"):
+            try:
+                from comet.services.anime import anime_mapper
+
+                parts = media_id.split(":")
+                k_id = parts[1] if len(parts) > 1 else media_id
+                mapped = await anime_mapper.get_imdb_from_kitsu(k_id)
+                if mapped and mapped.startswith("tt"):
+                    return mapped
+            except Exception:
+                pass
+            return media_id.split(":")[0] if ":" in media_id else media_id
+
+    if info_hash:
+        try:
+            row = await database.fetch_one(
+                """
+                SELECT media_id
+                FROM torrents
+                WHERE info_hash = :hash
+                ORDER BY updated_at DESC
+                LIMIT 1
+                """,
+                {"hash": info_hash},
+            )
+            if row and row["media_id"]:
+                raw = str(row["media_id"]).strip()
+                if raw.startswith("tt"):
+                    return raw.split(":")[0]
+                return raw
+        except Exception:
+            pass
+
+    return media_id.split(":")[0] if media_id else None
+
+
+async def _prefetch_worker(
+    b64config: str,
+    media_id: str | None,
+    info_hash: str | None,
+    season: int,
+    episode: int,
+) -> None:
+    try:
+        imdb_id = await _resolve_imdb_id(media_id, info_hash)
+        if not imdb_id:
+            return
+
+        timeout_meta = aiohttp.ClientTimeout(total=15.0)
+        async with aiohttp.ClientSession(timeout=timeout_meta) as meta_session:
+            videos = await _get_series_videos(meta_session, imdb_id)
+
+        if not videos:
+            return
+
+        target = _find_next_episode(videos, season, episode)
+        if not target:
+            return
+
+        next_s, next_e = target
+        cache_key = f"{imdb_id}:{next_s}:{next_e}"
+
+        now = time.monotonic()
+        expired = [
+            k
+            for k, v in _RECENT_PREFETCHES.items()
+            if now - v >= _COOLDOWN_SECONDS
+        ]
+        for k in expired:
+            _RECENT_PREFETCHES.pop(k, None)
+
+        if now - _RECENT_PREFETCHES.get(cache_key, 0) < _COOLDOWN_SECONDS:
+            return
+
+        _RECENT_PREFETCHES[cache_key] = now
+
+        async with _PREFETCH_SEMAPHORE:
+            url = f"http://127.0.0.1:8000/{b64config}/stream/series/{imdb_id}:{next_s}:{next_e}.json"
+            t0 = time.monotonic()
+            timeout_get = aiohttp.ClientTimeout(total=60.0)
+            async with aiohttp.ClientSession(timeout=timeout_get) as client:
+                async with client.get(url) as resp:
+                    elapsed = time.monotonic() - t0
+                    if resp.status == 200:
+                        data = await resp.json()
+                        streams = (
+                            data.get("streams", [])
+                            if isinstance(data, dict)
+                            else []
+                        )
+                        n_streams = len(streams)
+                        logger.info(
+                            f"⏭️ pré-busca {imdb_id} S{next_s}E{next_e}: {n_streams} streams em {elapsed:.1f}s"
+                        )
+                    else:
+                        logger.warning(
+                            f"Pré-busca {imdb_id} S{next_s}E{next_e} falhou: HTTP {resp.status}"
+                        )
+    except Exception as e:
+        logger.warning(
+            f"Pré-busca {media_id or info_hash} S{season}E{episode} falhou: {e}"
+        )
+
+
+def trigger_prefetch_next_episode(
+    b64config: str,
+    media_id: str | None,
+    info_hash: str | None,
+    season: int | None,
+    episode: int | None,
+) -> None:
+    if not getattr(settings, "PREFETCH_NEXT_EPISODE", True):
+        return
+    if season is None or episode is None:
+        return
+    task = asyncio.create_task(
+        _prefetch_worker(
+            b64config=b64config,
+            media_id=media_id,
+            info_hash=info_hash,
+            season=season,
+            episode=episode,
+        )
+    )
+    _TASKS.add(task)
+    task.add_done_callback(_TASKS.discard)
