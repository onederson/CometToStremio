@@ -0,0 +1,179 @@
+import asyncio
+import time
+from collections import deque
+from urllib.parse import quote
+
+from comet.core.database import database
+from comet.core.logger import logger
+from comet.core.models import settings
+from comet.debrid.exceptions import DebridLinkGenerationError
+from comet.debrid.stremthru import (
+    StremThru,
+    _record_debrid_blocked_hash,
+    _record_debrid_verified_hash,
+)
+from comet.services.trackers import trackers as generic_trackers
+from comet.utils.http_client import http_client_manager
+
+_precheck_lock = asyncio.Lock()
+_check_timestamps: deque = deque()
+_cooldown_until: float = 0.0
+
+
+async def is_hash_known_or_verified(debrid_service: str, info_hash: str) -> bool:
+    try:
+        norm_hash = info_hash.lower()
+        blocked = await database.fetch_one(
+            """
+            SELECT 1 FROM debrid_blocked_hashes
+            WHERE debrid_service = :debrid_service AND info_hash = :info_hash
+            LIMIT 1
+            """,
+            {"debrid_service": debrid_service, "info_hash": norm_hash},
+        )
+        if blocked:
+            return True
+
+        now = int(time.time())
+        verified = await database.fetch_one(
+            """
+            SELECT 1 FROM debrid_verified_hashes
+            WHERE debrid_service = :debrid_service AND info_hash = :info_hash AND expires_at > :now
+            LIMIT 1
+            """,
+            {"debrid_service": debrid_service, "info_hash": norm_hash, "now": now},
+        )
+        return bool(verified)
+    except Exception as exc:
+        logger.warning(
+            f"Erro ao consultar cache de verificação de {debrid_service}:{info_hash}: {exc}"
+        )
+        return False
+
+
+async def run_debrid_precheck(
+    token: str,
+    client_ip: str,
+    candidates: list[dict],
+) -> None:
+    global _cooldown_until
+
+    if not settings.DEBRID_PRECHECK:
+        return
+
+    now = time.time()
+    if now < _cooldown_until:
+        return
+
+    if _precheck_lock.locked():
+        return
+
+    if not candidates or not token:
+        return
+
+    async with _precheck_lock:
+        session = await http_client_manager.get_session()
+        checked_count = 0
+        for candidate in candidates:
+            if checked_count >= 3:
+                break
+
+            info_hash = candidate.get("info_hash")
+            title = candidate.get("title", "")
+            if not info_hash:
+                continue
+
+            info_hash = info_hash.lower()
+
+            now = time.time()
+            if now < _cooldown_until:
+                break
+
+            # Hourly rate limit (sliding 1 hour window)
+            while _check_timestamps and now - _check_timestamps[0] > 3600:
+                _check_timestamps.popleft()
+
+            max_per_hour = settings.DEBRID_PRECHECK_MAX_PER_HOUR or 20
+            if len(_check_timestamps) >= max_per_hour:
+                logger.log(
+                    "DEBRID",
+                    f"RD precheck: limite horário de {max_per_hour}/h atingido.",
+                )
+                break
+
+            if await is_hash_known_or_verified("realdebrid", info_hash):
+                continue
+
+            _check_timestamps.append(now)
+            checked_count += 1
+
+            magnet_uri = f"magnet:?xt=urn:btih:{info_hash}&dn={quote(title)}"
+            sources = candidate.get("sources") or generic_trackers[:20]
+            for s in sources:
+                magnet_uri += f"&tr={quote(s, safe='')}"
+
+            st = StremThru(
+                session,
+                "",
+                "",
+                f"realdebrid:{token}",
+                client_ip,
+            )
+
+            try:
+                magnet = await st._post_store_json(
+                    f"/magnets?client_ip={client_ip}",
+                    {"magnet": magnet_uri},
+                    "precheck torrent",
+                )
+                magnet_data = magnet.get("data", {}) if isinstance(magnet, dict) else {}
+                magnet_id = magnet_data.get("id")
+
+                await _record_debrid_verified_hash(
+                    "realdebrid", info_hash, status="ok", ttl_seconds=7 * 86400
+                )
+                logger.log(
+                    "DEBRID",
+                    f"✅ RD precheck aceitou {info_hash} {title}",
+                )
+
+                if magnet_id:
+                    deleted = await st.delete_magnet(str(magnet_id))
+                    if deleted:
+                        logger.log(
+                            "DEBRID",
+                            f"🗑️ RD precheck removeu {magnet_id} da conta",
+                        )
+            except DebridLinkGenerationError as err:
+                status_code = err.payload.get("status_code") if isinstance(err.payload, dict) else None
+                if (
+                    status_code == 451
+                    or err.error_code == "UNAVAILABLE_FOR_LEGAL_REASONS"
+                    or err.upstream_error_code == "infringing_file"
+                ):
+                    await _record_debrid_blocked_hash(
+                        "realdebrid", info_hash, "infringing_file"
+                    )
+                    logger.log(
+                        "DEBRID",
+                        f"🚫 RD precheck detectou bloqueio (451) em {info_hash} {title}",
+                    )
+                elif (
+                    status_code == 429
+                    or err.error_code in ("TOO_MANY_REQUESTS", "RATE_LIMIT_EXCEEDED")
+                ):
+                    logger.warning(
+                        f"RD precheck rate limit (429), pausando verificações por 30 min: {err}"
+                    )
+                    _cooldown_until = time.time() + 1800
+                    break
+                else:
+                    logger.warning(
+                        f"RD precheck erro na verificação de {info_hash}: {err}"
+                    )
+            except Exception as exc:
+                logger.warning(
+                    f"RD precheck falha de rede/exceção ({exc}), pausando verificações por 30 min"
+                )
+                _cooldown_until = time.time() + 1800
+                break
