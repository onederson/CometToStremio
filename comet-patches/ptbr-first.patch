@@ -12,6 +13,70 @@ from comet.utils.languages import alias_language
 from comet.utils.parsing import ensure_multi_language
 
 _TITLE_MATCH_CACHE_MAX_ENTRIES = 65_536
+_PTBR_TRACKER_RE = re.compile(r"comando|bludv|micoleaodublado", re.IGNORECASE)
+_PTBR_TITLE_EXPLICIT_RE = re.compile(
+    r"dublado|(?<![a-z0-9])(?:dub[ ._-]?pt(?:[ ._-]?br)?|nacional|pt[ ._-]?br|portugu[eê]s)(?![a-z0-9])",
+    re.IGNORECASE,
+)
+_PTBR_POR_RE = re.compile(r"(?<![a-z0-9])por(?![a-z0-9])", re.IGNORECASE)
+_PTBR_DUAL_AUDIO_RE = re.compile(
+    r"(?<![a-z0-9])(?:dual|audio|áudio)(?![a-z0-9])", re.IGNORECASE
+)
+_PTBR_DUAL_RE = re.compile(r"(?<![a-z0-9])dual(?![a-z0-9])", re.IGNORECASE)
+_LAT_ES_RE = re.compile(
+    r"(?<![a-z0-9])(?:lat|latino|castellano|esp|spanish)(?![a-z0-9])",
+    re.IGNORECASE,
+)
+
+
+@lru_cache(maxsize=8)
+def _get_ptbr_groups_re(groups_csv: str) -> re.Pattern | None:
+    groups = [g.strip() for g in groups_csv.split(",") if g.strip()]
+    if not groups:
+        return None
+    pattern = "|".join(re.escape(g) for g in groups)
+    return re.compile(rf"(?<![a-z0-9])(?:{pattern})(?![a-z0-9])", re.IGNORECASE)
+
+
+def apply_ptbr_detection(
+    parsed, torrent_title: str, tracker: str | None = None
+) -> None:
+    if "pt" in parsed.languages:
+        return
+
+    por_text = torrent_title
+    if getattr(parsed, "parsed_title", None):
+        title_words = parsed.parsed_title.split()
+        if title_words:
+            por_text = re.sub(
+                r"\W+".join(re.escape(w) for w in title_words),
+                " ",
+                torrent_title,
+                count=1,
+                flags=re.IGNORECASE,
+            )
+
+    has_explicit_pt = bool(
+        _PTBR_TITLE_EXPLICIT_RE.search(torrent_title)
+        or (
+            _PTBR_POR_RE.search(por_text)
+            and _PTBR_DUAL_AUDIO_RE.search(torrent_title)
+        )
+    )
+    if not has_explicit_pt and _LAT_ES_RE.search(torrent_title):
+        return
+
+    is_pt = has_explicit_pt or bool(
+        tracker and _PTBR_TRACKER_RE.search(tracker)
+    )
+    if not is_pt and _PTBR_DUAL_RE.search(torrent_title):
+        groups_re = _get_ptbr_groups_re(settings.PTBR_RELEASE_GROUPS or "")
+        if groups_re is not None and groups_re.search(torrent_title):
+            is_pt = True
+
+    if is_pt:
+        _log_exclusion(f"🏷️ Added Language (PT-BR) | {torrent_title} | pt")
+        parsed.languages.append("pt")
 
 if settings.RTN_FILTER_DEBUG:
 
