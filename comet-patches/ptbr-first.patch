+                    if rel_d_str:
+                        try:
+                            rel_d = datetime.date.fromisoformat(rel_d_str)
+                            diff = (today_date - rel_d).days
+                            if -1 <= diff <= 30:
+                                badge = "new"
+                        except ValueError:
+                            pass
+                if not badge and catalog_id != "comet_ready" and imdb_id in ready_set:
+                    badge = "dub"
+
+            if is_landscape:
+                backdrop_file = None
+                logo_file = None
+                if landscape_data and landscape_data.get("backdrop"):
+                    backdrop_file = landscape_data["backdrop"]
+                    logo_file = landscape_data.get("logo")
+                elif backdrop_path:
+                    backdrop_file = backdrop_path
+
+                if backdrop_file:
+                    b_clean = backdrop_file.lstrip("/")
+                    l_clean = logo_file.lstrip("/") if logo_file else None
+                    b_param = f"?b={badge}" if badge else ""
+                    if l_clean:
+                        meta["poster"] = f"{base_url}/art/land/{b_clean}/{l_clean}{b_param}"
+                    else:
+                        meta["poster"] = f"{base_url}/art/land/{b_clean}{b_param}"
+                    meta["posterShape"] = "landscape"
+            elif catalog_id.startswith("comet_orig_"):
+                if badge and poster_path:
+                    p_clean = poster_path.lstrip("/")
+                    meta["poster"] = f"{base_url}/art/poster/{p_clean}?b={badge}"
+
+            metas.append(meta)
+
+        if catalog_id == "comet_top10":
+            metas = metas[:10]
+            _TOP10_IDS_CACHE[media_type] = (time.time(), {m["id"] for m in metas if m.get("id")})
+            for idx, item_meta in enumerate(metas, start=1):
+                item_meta["posterShape"] = "square"
+                p_file = item_meta.pop("_raw_poster_path", None)
+                if p_file:
+                    p_clean = p_file.lstrip("/")
+                    item_meta["poster"] = f"{base_url}/art/top10/{idx}/{p_clean}"
+
+        return metas
+
+
+_SEARCH_CACHE: dict[tuple, tuple[float, list[dict]]] = {}
+_SEARCH_CACHE_MAX = 300
+_SEARCH_CACHE_TTL = 3600.0  # 1 hour
+
+
+def _get_cached_search(key: tuple) -> list[dict] | None:
+    now = time.time()
+    if key in _SEARCH_CACHE:
+        ts, items = _SEARCH_CACHE[key]
+        ttl = 6 * 3600.0 if (len(key) > 1 and key[1] == "comet_person") else _SEARCH_CACHE_TTL
+        if now - ts < ttl:
+            return items
+        _SEARCH_CACHE.pop(key, None)
+    return None
+
+
+def _set_cached_search(key: tuple, items: list[dict]) -> None:
+    while len(_SEARCH_CACHE) >= _SEARCH_CACHE_MAX:
+        oldest_key = min(_SEARCH_CACHE.keys(), key=lambda k: _SEARCH_CACHE[k][0])
+        _SEARCH_CACHE.pop(oldest_key, None)
+    _SEARCH_CACHE[key] = (time.time(), items)
+
