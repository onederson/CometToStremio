+        tmdb = TMDBApi(session)
+        person_data = await tmdb._get_json(
+            f"search/person?query={q_encoded}&language=pt-BR",
+            f"search person {query}",
+        )
+        if not isinstance(person_data, dict) or not isinstance(person_data.get("results"), list):
+            return []
+
+        words = _strip_accents(query).split()
+        matches = [
+            p
+            for p in person_data["results"]
+            if isinstance(p, dict) and all(w in _strip_accents(p.get("name", "")) for w in words)
+        ]
+        if not matches:
+            return []
+
+        matches.sort(key=lambda x: x.get("popularity", 0), reverse=True)
+        best_person = matches[0]
+        person_id = best_person.get("id")
