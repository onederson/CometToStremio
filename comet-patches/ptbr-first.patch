+def _get_cached_catalog(key: tuple) -> list[dict] | None:
+    now = time.time()
+    if key in _CATALOG_CACHE:
+        ts, metas = _CATALOG_CACHE[key]
+        if now - ts < _CATALOG_CACHE_TTL:
+            return metas
+        del _CATALOG_CACHE[key]
+    return None
+
+
+def _set_cached_catalog(key: tuple, metas: list[dict]):
+    now = time.time()
+    if len(_CATALOG_CACHE) >= _CATALOG_CACHE_MAX:
+        sorted_keys = sorted(_CATALOG_CACHE.keys(), key=lambda k: _CATALOG_CACHE[k][0])
+        for k in sorted_keys[:50]:
+            _CATALOG_CACHE.pop(k, None)
+    _CATALOG_CACHE[key] = (now, metas)
+
+
+def _build_tmdb_path_and_params(
+    media_type: str, catalog_id: str, genre: str | None, page: int
+) -> tuple[str, dict] | None:
+    region = getattr(settings, "CATALOG_REGION", "BR")
+    language = getattr(settings, "CATALOG_LANGUAGE", "pt-BR")
+    tmdb_type = "movie" if media_type == "movie" else "tv"
+    today_str = datetime.date.today().isoformat()
+
+    if catalog_id == "comet_trending":
+        path = f"trending/{tmdb_type}/week"
+        params = {
+            "language": language,
+            "page": page,
+        }
+        return path, params
+
+    if catalog_id == "comet_anime":
+        path = "discover/tv"
+        params = {
+            "language": language,
+            "page": page,
+            "with_original_language": "ja",
+        }
+        if genre in ("Lançamentos", "Lancamentos"):
+            params["sort_by"] = "first_air_date.desc"
+            params["vote_count.gte"] = 10
+            params["first_air_date.lte"] = today_str
+            params["with_genres"] = 16
+        elif genre in ("Mais bem avaliados", "Mais Bem Avaliados"):
+            params["sort_by"] = "vote_average.desc"
+            params["vote_count.gte"] = 500
+            params["with_genres"] = 16
+        elif genre and genre in TV_GENRE_MAP:
+            gid = TV_GENRE_MAP[genre]
+            params["with_genres"] = f"16,{gid}" if gid != 16 else 16
+            params["sort_by"] = "popularity.desc"
+            params["vote_count.gte"] = 50
+        else:
+            params["with_genres"] = 16
+            params["sort_by"] = "popularity.desc"
+            params["vote_count.gte"] = 50
+        return path, params
+
+    if catalog_id.startswith("comet_"):
+        provider_key = catalog_id[len("comet_"):]
+        if provider_key not in PROVIDERS:
+            return None
+        _, provider_id = PROVIDERS[provider_key]
+        path = f"discover/{tmdb_type}"
+        params = {
+            "watch_region": region,
+            "with_watch_providers": provider_id,
+            "language": language,
+            "page": page,
+        }
+        if genre in ("Lançamentos", "Lancamentos"):
+            if media_type == "movie":
+                params["sort_by"] = "primary_release_date.desc"
+                params["vote_count.gte"] = 10
+                params["primary_release_date.lte"] = today_str
+            else:
+                params["sort_by"] = "first_air_date.desc"
+                params["vote_count.gte"] = 10
+                params["first_air_date.lte"] = today_str
+        elif genre in ("Mais bem avaliados", "Mais Bem Avaliados"):
+            params["sort_by"] = "vote_average.desc"
+            params["vote_count.gte"] = 500
+        elif genre and genre in (MOVIE_GENRE_MAP if media_type == "movie" else TV_GENRE_MAP):
+            gid = (MOVIE_GENRE_MAP if media_type == "movie" else TV_GENRE_MAP)[genre]
+            params["with_genres"] = gid
+            params["sort_by"] = "popularity.desc"
+            params["vote_count.gte"] = 50
+        else:
+            params["sort_by"] = "popularity.desc"
+            params["vote_count.gte"] = 50
+            if media_type == "movie":
+                params["primary_release_date.gte"] = (datetime.date.today() - datetime.timedelta(days=4 * 365)).isoformat()
+            else:
+                params["air_date.gte"] = (datetime.date.today() - datetime.timedelta(days=2 * 365)).isoformat()
+                params["vote_count.gte"] = 200
+                # sem jornal, reality, novela e talk show (luta livre, programas diarios)
+                params["without_genres"] = "10763,10764,10766,10767"
+        return path, params
+
+    return None
+
