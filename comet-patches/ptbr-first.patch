+def format_audio_langs(tracks: list[dict] | list[str] | None) -> str:
+    if not tracks:
+        return ""
+    codes: list[str] = []
+    for item in tracks:
+        if isinstance(item, dict):
+            lang = (item.get("lang") or "").lower().strip()
+            bcp47 = (item.get("bcp47") or "").lower().strip()
+            is_pt = is_portuguese_track(item)
+        else:
+            lang = str(item).lower().strip()
+            bcp47 = ""
+            is_pt = lang in ("por", "pt", "pob", "pt-br") or lang.startswith("pt")
+
+        if is_pt:
+            code = "PT"
+        elif lang in ISO_639_TO_2:
+            code = ISO_639_TO_2[lang]
+        elif bcp47 and bcp47[:2].upper() in ISO_639_TO_2.values():
+            code = bcp47[:2].upper()
+        elif len(lang) == 2:
+            code = lang.upper()
+        elif len(lang) == 3:
+            code = lang[:2].upper()
+        else:
+            code = "??"
+
+        if code and code not in codes:
+            codes.append(code)
+
+    return " · ".join(codes[:4])
