+                    "imdbRating": rating_str,
+                })
+            return metas
+
+        # Fileira 🎬 Sagas (sem filtro de gênero): cada item vira a saga
+        selected_sagas = SAGAS[skip : skip + 40]
+        results = await asyncio.gather(
+            *[_get_collection_data(tmdb, cid) for _, cid in selected_sagas],
+            return_exceptions=True,
+        )
+
+        metas = []
+        for (label, cid), res in zip(selected_sagas, results):
+            if not isinstance(res, tuple) or not res[0]:
+                continue
+            coll_data, released = res
+            if not released:
+                continue
+
+            clean_name = _clean_collection_name(coll_data.get("name") or label)
+
+            first_part = released[0]
+            last_part = released[-1]
+            y1 = (first_part.get("release_date") or "")[:4]
+            yN = (last_part.get("release_date") or "")[:4]
