+        or BARE_EPISODE_PREFIX_PATTERN.match(file_leaf)
+        or file_title.isdigit()
+    ):
+        torrent_title = (parse(torrent_line).parsed_title or "").strip()
+        if torrent_title and (
+            unrecognizable_file or not title_match(torrent_title, file_title)
+        ):
