+                if not w_ids:
+                    continue
+                if idx in used_indices or w in domain_covered:
+                    fallback_single.append(w_ids)
+                    continue
+                if w_ids not in concepts:
+                    concepts.append(w_ids)
+                    concept_words.append(w)
+
+            # Item 4: Votos mínimos
+            is_ptbr = (filters.get("origin_country") == "BR" or filters.get("original_language") == "pt")
+            if filters.get("vote_count_gte") is not None:
+                base_vote_count = filters["vote_count_gte"]
+            elif is_ptbr:
+                base_vote_count = 5
+            else:
+                base_vote_count = 50 if media_type == "movie" else 20
+
+            params = {
+                "language": "pt-BR",
+                "sort_by": "popularity.desc",
+            }
+            gids = filters.get("genres", {}).get(tmdb_type, [])
+            if gids:
+                params["with_genres"] = ",".join(str(g) for g in gids)
+            if filters.get("original_language"):
+                params["with_original_language"] = filters["original_language"]
+            if filters.get("origin_country"):
+                params["with_origin_country"] = filters["origin_country"]
+            if filters.get("vote_average_gte") is not None:
+                params["vote_average.gte"] = str(filters["vote_average_gte"])
+            if media_type == "movie" and filters.get("runtime_lte") is not None:
+                params["with_runtime.lte"] = str(filters["runtime_lte"])
+            if filters.get("epoch"):
+                ep = filters["epoch"]
+                if ep.get("year"):
+                    if media_type == "movie":
+                        params["primary_release_year"] = str(ep["year"])
+                    else:
+                        params["first_air_date_year"] = str(ep["year"])
+                else:
+                    if ep.get("gte"):
+                        if media_type == "movie":
+                            params["primary_release_date.gte"] = ep["gte"]
+                        else:
+                            params["first_air_date.gte"] = ep["gte"]
+                    if ep.get("lte"):
+                        if media_type == "movie":
+                            params["primary_release_date.lte"] = ep["lte"]
+                        else:
+                            params["first_air_date.lte"] = ep["lte"]
+            if with_people:
+                params["with_people"] = str(with_people)
+
+            async def run_query(kw_arg: str | None, vote_cnt: int) -> list[dict]:
+                q_params = dict(params)
+                q_params["vote_count.gte"] = str(vote_cnt)
+                if kw_arg:
+                    q_params["with_keywords"] = kw_arg
+                qs1 = urllib.parse.urlencode({**q_params, "page": 1})
+                d1 = await tmdb._get_json(
+                    f"discover/{tmdb_type}?{qs1}",
+                    f"discover {tmdb_type} {query} p1",
