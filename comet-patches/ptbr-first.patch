+
+                cache_key = f"{tmdb_type}:{it['id']}"
+                en_title = _EN_TITLE_CACHE.get(cache_key)
+                if en_title is None:
+                    data = await tmdb._get_json(
+                        f"{tmdb_type}/{it['id']}?language=en-US",
+                        f"en title {it['id']}",
+                    )
+                    if isinstance(data, dict):
