+                        c_tracks = await probe_audio(c_vurl)
+                        c_dur = time.monotonic() - t0
+                        if c_tracks is not None:
+                            c_is_pt = has_portuguese(c_tracks)
+                            c_has_pt = 1 if c_is_pt else 0
+                            c_langs = format_audio_langs(c_tracks)
+                            await save_probe_result(c_hash, c_key, c_tracks, claimed_pt=True)
+                            logger.info(f"🔊 áudio {c_hash[:8]}: {c_langs} (pt={c_has_pt}) em {c_dur:.1f}s")
+                        else:
+                            record_probe_failure()
+                except Exception as cand_err:
+                    logger.log("PLAYBACK", f"audio_probe candidato extra {c_hash[:8]} falhou: {str(cand_err)[:80]}")
+    except DebridLinkGenerationError as err:
+        if (
+            err.payload.get("status_code") == 451
+            or err.error_code == "UNAVAILABLE_FOR_LEGAL_REASONS"
+            or err.upstream_error_code == "infringing_file"
+        ):
+            await _record_debrid_blocked_hash(service, info_hash, "infringing_file")
+            logger.log("PLAYBACK", f"🚫 {service} bloqueou (451) no pré-resolve do Assistir: {info_hash}")
+        else:
+            logger.log("PLAYBACK", f"Pré-resolve do Assistir sem link ({service}): {str(err)[:160]} {str(getattr(err, 'payload', ''))[:200]}")
+    except Exception as e:
+        logger.warning(f"Pré-resolve do Assistir falhou: {e}")
+    finally:
+        _PRERESOLVE_IN_FLIGHT.discard(info_hash)
