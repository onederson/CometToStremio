+        return _pluto_v4_cache
+
+    async with _pluto_v4_lock:
+        now = time.time()
+        if not force_refresh and _pluto_v4_cache and now < _pluto_v4_cache_expiry:
+            return _pluto_v4_cache
+
+        client_id = _get_pluto_device_id()
+        params = {
