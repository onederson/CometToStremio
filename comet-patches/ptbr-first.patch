+                "name": name,
+                "poster": logo,
+                "posterShape": "square",
+                "background": background,
+                "description": desc,
+                "genres": [cat] if cat else [],
+                "releaseInfo": "Ao vivo",
+                "behaviorHints": {
+                    "defaultVideoId": cid,
+                    "hasScheduledVideos": False,
+                },
+            })
+
+    # 2. IPTV-org open channels
+    if not kids and getattr(settings, "LIVE_TV_IPTV_ORG", True):
+        if not genre or genre == "Canais abertos":
+            iptv_channels = get_iptv_channels()
+            sorted_iptv = sorted(iptv_channels, key=lambda c: str(c.get("name", "")).lower())
+            for ch in sorted_iptv:
+                name = ch.get("name") or "Canal"
+                if search_q and search_q not in name.lower():
+                    continue
+                logo = ch.get("logo") or ""
+                cid = ch["id"]
+                metas.append({
+                    "id": cid,
+                    "type": "tv",
+                    "name": name,
+                    "poster": logo,
+                    "posterShape": "square",
+                    "background": logo,
+                    "description": "▶ Transmissão ao vivo 24h",
+                    "genres": ["Canais abertos"],
+                    "releaseInfo": "Ao vivo",
+                    "behaviorHints": {
+                        "defaultVideoId": cid,
+                        "hasScheduledVideos": False,
+                    },
+                })
+
+    return metas
+
+
+async def get_live_tv_home_catalog(extra: dict | None = None, kids: bool = False) -> list[dict]:
+    extra = extra or {}
+    skip = 0
+    try:
+        if extra.get("skip"):
+            skip = int(extra["skip"])
+    except Exception:
+        skip = 0
+
+    now_utc = datetime.datetime.now(datetime.timezone.utc)
+    pluto_channels = await get_pluto_channels()
+
+    def _get_num(c):
+        n = c.get("number")
+        try:
+            return int(n)
+        except Exception:
+            return 999999
+
+    sorted_pluto = sorted(pluto_channels, key=_get_num)
+    if _pluto_alive_ids is not None:
+        sorted_pluto = [c for c in sorted_pluto if c.get("_id") in _pluto_alive_ids]
+
+    selected_channels = []
+    seen_ids = set()
+
+    if kids:
+        for ch in sorted_pluto:
+            cat = ch.get("category") or ""
+            if cat.lower() in KIDS_CATEGORIES:
+                cid = ch.get("_id")
+                if cid and cid not in seen_ids:
+                    seen_ids.add(cid)
+                    selected_channels.append(ch)
+                    if len(selected_channels) == 20:
+                        break
+    else:
+        category_quotas = [
+            ("Filmes", lambda cat: cat == "Filmes", 4),
+            ("Séries", lambda cat: cat == "Séries", 3),
+            ("Infantil", lambda cat: cat.lower() in KIDS_CATEGORIES, 3),
+            ("Notícias", lambda cat: cat == "Notícias", 2),
+            ("Esportes", lambda cat: cat == "Esportes", 2),
+            ("Anime & Geek", lambda cat: cat == "Anime & Geek", 2),
+            ("Novelas/TV Brasileira", lambda cat: cat in ("Novelas", "TV Brasileira"), 2),
+            ("Comédia", lambda cat: cat == "Comédia", 2),
+        ]
+        for name, match_fn, quota in category_quotas:
+            count = 0
+            for ch in sorted_pluto:
+                cat = ch.get("category") or ""
+                if match_fn(cat):
+                    cid = ch.get("_id")
+                    if cid and cid not in seen_ids:
+                        seen_ids.add(cid)
+                        selected_channels.append(ch)
+                        count += 1
+                        if count == quota:
+                            break
+
+        if len(selected_channels) < 20:
+            for ch in sorted_pluto:
+                cid = ch.get("_id")
+                if cid and cid not in seen_ids:
+                    seen_ids.add(cid)
+                    selected_channels.append(ch)
+                    if len(selected_channels) == 20:
+                        break
+
+    metas = []
+    for ch in selected_channels:
+        cat = ch.get("category") or ""
+        name = ch.get("name") or "Canal"
+        logo = (ch.get("colorLogoPNG") or {}).get("path") or (ch.get("logo") or {}).get("path") or ""
+        background = (ch.get("featuredImage") or {}).get("path") or logo
+        desc = _format_agora_depois(ch.get("timelines", []), now_utc)
+        cid = f"cometlive:pluto:{ch['_id']}"
+
+        metas.append({
+            "id": cid,
+            "type": "tv",
+            "name": name,
+            "poster": logo,
+            "posterShape": "square",
+            "background": background,
+            "description": desc,
+            "genres": [cat] if cat else [],
+            "releaseInfo": "Ao vivo",
+            "behaviorHints": {
+                "defaultVideoId": cid,
+                "hasScheduledVideos": False,
+            },
+        })
+
+    if skip:
+        return metas[skip:skip + 20]
+    return metas[:20]
+
+
+async def get_live_tv_meta(media_id: str) -> dict | None:
+    now_utc = datetime.datetime.now(datetime.timezone.utc)
+    iso_now = now_utc.strftime("%Y-%m-%dT%H:%M:%SZ")
+    if media_id.startswith("cometlive:pluto:"):
+        pluto_id = media_id.split(":", 2)[2]
+        ch = await get_pluto_channel_by_id(pluto_id)
+        if not ch:
+            return None
+        logo = (ch.get("colorLogoPNG") or {}).get("path") or (ch.get("logo") or {}).get("path") or ""
+        background = (ch.get("featuredImage") or {}).get("path") or logo
+        cat = ch.get("category") or ""
+        desc = _format_meta_programming(ch.get("timelines", []), now_utc, ch.get("summary", ""))
+        overview = _format_agora_depois(ch.get("timelines", []), now_utc)
+        return {
+            "id": media_id,
+            "type": "tv",
+            "name": ch.get("name") or "Canal",
+            "logo": logo,
+            "poster": logo,
+            "posterShape": "square",
+            "background": background,
+            "description": desc,
+            "genres": [cat] if cat else [],
+            "releaseInfo": "Ao vivo",
+            "behaviorHints": {
+                "defaultVideoId": media_id,
+                "hasScheduledVideos": False,
+            },
+            "videos": [
+                {
+                    "id": media_id,
+                    "title": "📺 Assistir ao vivo",
+                    "released": iso_now,
+                    "thumbnail": background,
+                    "overview": overview,
+                }
+            ],
+        }
+
+    if media_id.startswith("cometlive:iptv:"):
+        ch = get_iptv_channel_by_id(media_id)
+        if not ch:
+            return None
+        logo = ch.get("logo") or ""
+        return {
+            "id": media_id,
+            "type": "tv",
+            "name": ch.get("name") or "Canal",
+            "logo": logo,
+            "poster": logo,
+            "posterShape": "square",
+            "background": logo,
+            "description": "Transmissão ao vivo",
+            "genres": ["Canais abertos"],
+            "releaseInfo": "Ao vivo",
+            "behaviorHints": {
+                "defaultVideoId": media_id,
+                "hasScheduledVideos": False,
+            },
+            "videos": [
+                {
+                    "id": media_id,
+                    "title": "📺 Assistir ao vivo",
+                    "released": iso_now,
+                    "thumbnail": logo,
+                    "overview": "▶ Transmissão ao vivo 24h",
+                }
+            ],
+        }
+
+    return None
+
+
+async def get_live_tv_stream(media_id: str) -> list[dict]:
+    if media_id.startswith("cometlive:pluto:"):
+        pluto_id = media_id.split(":", 2)[2]
+        ch = await get_pluto_channel_by_id(pluto_id)
+        if not ch:
+            return []
+        channel_name = ch.get("name") or "Canal"
+        streams = []
+
+        # 1. Opção 1: v4
+        session = await get_pluto_v4_session()
+        if session:
+            stitcher = session["stitcher"].rstrip("/")
+            sp = session["stitcherParams"].lstrip("?&")
+            jwt = session["sessionToken"]
+            v4_url = f"{stitcher}/v2/stitch/hls/channel/{pluto_id}/master.m3u8?{sp}&jwt={jwt}&masterJWTPassthrough=true"
+            streams.append({
+                "name": "📺 Ao vivo",
+                "description": f"{channel_name} · Pluto TV\nSe não abrir, tente a próxima opção",
+                "url": v4_url,
+                "behaviorHints": {
+                    "notWebReady": False,
+                },
+            })
+
+        # 2. Opção 2: jmp2
+        jmp2_url = f"https://jmp2.uk/plu-{pluto_id}.m3u8"
+        streams.append({
+            "name": "📺 Ao vivo · opção 2",
+            "description": f"{channel_name} · Pluto TV\nSe não abrir, tente a próxima opção",
+            "url": jmp2_url,
+            "behaviorHints": {
+                "notWebReady": False,
+            },
+        })
+
+        return streams
+
+    if media_id.startswith("cometlive:iptv:"):
+        ch = get_iptv_channel_by_id(media_id)
+        if not ch or not ch.get("url"):
+            return []
+        channel_name = ch.get("name") or "Canal"
+        return [
+            {
+                "name": "📺 Ao vivo",
+                "description": f"{channel_name} · Canal aberto",
+                "url": ch["url"],
+                "behaviorHints": {
+                    "notWebReady": False,
+                },
+            }
+        ]
+
+    return []
