+_SOURCE_ERROR_COUNTS: dict[str, int] = {}
+_PLAYBACK_EVENTS: list[tuple[float, str]] = []  # (ts, event_type: "play" | "budget" | "swap_451")
+
+
+def get_comet_uptime_seconds() -> int:
+    return int(time.time() - _COMET_START_TIME)
+
+
+def _clean_status_events(now: float):
+    cutoff = now - 6 * 3600
+    # limpa no maximo a cada 5000 eventos novos (barato) e nunca passa de 5000
+    if len(_STATUS_EVENTS) > 5000 or (_STATUS_EVENTS and _STATUS_EVENTS[0][0] < cutoff and len(_STATUS_EVENTS) % 500 == 0):
+        kept = [e for e in _STATUS_EVENTS if e[0] >= cutoff]
+        _STATUS_EVENTS[:] = kept[-4000:]
+
+
+def _clean_playback_events(now: float):
+    cutoff = now - 6 * 3600
+    # limpa no maximo a cada 5000 eventos novos (barato) e nunca passa de 5000
+    if len(_PLAYBACK_EVENTS) > 5000 or (_PLAYBACK_EVENTS and _PLAYBACK_EVENTS[0][0] < cutoff and len(_PLAYBACK_EVENTS) % 500 == 0):
+        kept = [e for e in _PLAYBACK_EVENTS if e[0] >= cutoff]
+        _PLAYBACK_EVENTS[:] = kept[-4000:]
+
+
+def record_source_success(source: str):
+    now = time.time()
+    _clean_status_events(now)
+    clean = source.split(" #")[0].removesuffix("Scraper")
+    _STATUS_EVENTS.append((now, clean, True, ""))
+    try:
+        from comet.core import breaker
+        breaker.record(clean, True, now=now)
+    except Exception:
+        pass
+
+
+def record_source_error(source: str, error: Exception | str):
+    now = time.time()
+    _clean_status_events(now)
+    clean = source.split(" #")[0].removesuffix("Scraper")
+    _SOURCE_ERROR_COUNTS[clean] = _SOURCE_ERROR_COUNTS.get(clean, 0) + 1
+    msg = str(error)
+    # Strip URLs and sensitive patterns
+    msg = re.sub(r"https?://\S+", "", msg)
+    msg = re.sub(r"//\S+", "", msg)
+    msg = re.sub(r"\s+", " ", msg)
+    msg = msg.strip(": -")
+    if not msg:
+        msg = type(error).__name__ if isinstance(error, Exception) else "Erro"
+    if len(msg) > 60:
+        msg = msg[:57] + "..."
+    _STATUS_EVENTS.append((now, clean, False, msg))
+    try:
+        from comet.core import breaker
+        breaker.record(clean, False, now=now)
+    except Exception:
+        pass
+
+
+def get_source_error_count(source: str) -> int:
+    clean = source.split(" #")[0].removesuffix("Scraper")
+    return _SOURCE_ERROR_COUNTS.get(clean, 0)
+
+
+def record_playback_play():
+    now = time.time()
+    _clean_playback_events(now)
+    _PLAYBACK_EVENTS.append((now, "play"))
+
+
+def record_playback_budget_exhausted():
+    now = time.time()
+    _clean_playback_events(now)
+    _PLAYBACK_EVENTS.append((now, "budget"))
+
+
+def record_playback_451_swap():
+    now = time.time()
+    _clean_playback_events(now)
+    _PLAYBACK_EVENTS.append((now, "swap_451"))
+
+
+def get_sources_stats(cutoff_hours: float = 6.0) -> dict[str, dict]:
+    cutoff = time.time() - cutoff_hours * 3600
+    events = [e for e in _STATUS_EVENTS if e[0] >= cutoff]
+    preferred_order = [
+        "Torrentio",
+        "MediaFusion",
+        "Comet",
+        "Zilean",
+        "Prowlarr",
+        "BRSites",
+        "Addons",
+        "FenixFlix",
+        "FrostStream",
+        "OpenSubtitles",
+        "SubSource",
+        "SubDL",
+        "TMDB",
+    ]
+    seen_sources = set(preferred_order)
+    for e in events:
+        seen_sources.add(e[1])
+
+    result = {}
+    ordered_keys = [s for s in preferred_order if s in seen_sources] + [
+        s for s in sorted(seen_sources) if s not in preferred_order
+    ]
+    for s in ordered_keys:
+        s_events = [e for e in events if e[1] == s]
+        successes = sum(1 for e in s_events if e[2])
+        errors = sum(1 for e in s_events if not e[2])
+        last_error = "-"
+        for e in reversed(s_events):
+            if not e[2]:
+                last_error = e[3]
+                break
+        result[s] = {
+            "success": successes,
+            "error": errors,
+            "last_error": last_error,
+        }
+    return result
+
+
+def get_playback_stats(cutoff_hours: float = 6.0) -> dict[str, int]:
+    cutoff = time.time() - cutoff_hours * 3600
+    events = [e for e in _PLAYBACK_EVENTS if e[0] >= cutoff]
+    plays = sum(1 for e in events if e[1] == "play")
+    budget_exhausted = sum(1 for e in events if e[1] == "budget")
+    swaps_451 = sum(1 for e in events if e[1] == "swap_451")
+    return {
+        "plays": plays,
+        "budget_exhausted": budget_exhausted,
+        "swaps_451": swaps_451,
+    }
