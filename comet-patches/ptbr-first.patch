+_SEARCH_CACHE: dict[tuple, tuple[float, list[dict]]] = {}
+_SEARCH_CACHE_MAX = 300
+_SEARCH_CACHE_TTL = 3600.0  # 1 hour
+
+
+def _get_cached_search(key: tuple) -> list[dict] | None:
+    now = time.time()
+    if key in _SEARCH_CACHE:
+        ts, items = _SEARCH_CACHE[key]
+        ttl = 6 * 3600.0 if (len(key) > 1 and key[1] == "comet_person") else _SEARCH_CACHE_TTL
+        if now - ts < ttl:
+            return items
+        _SEARCH_CACHE.pop(key, None)
+    return None
+
+
+def _set_cached_search(key: tuple, items: list[dict]) -> None:
+    while len(_SEARCH_CACHE) >= _SEARCH_CACHE_MAX:
+        oldest_key = min(_SEARCH_CACHE.keys(), key=lambda k: _SEARCH_CACHE[k][0])
+        _SEARCH_CACHE.pop(oldest_key, None)
+    _SEARCH_CACHE[key] = (time.time(), items)
