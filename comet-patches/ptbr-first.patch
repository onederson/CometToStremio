+                        if ok is True
+                    ]
+                else:
+                    unique_raw = [
+                        it for it in unique_raw
+                        if any(g in (10762, 10751, 16) for g in (it.get("genre_ids") or []))
+                    ]
+
+            # Item 1 (Rodada 2): Relevância = nº de conceitos distintos cobertos; empate -> popularity desc.
+            # Frase de 1 conceito = ordem por popularidade pura.
+            if len(concepts) <= 1:
+                unique_raw.sort(
+                    key=lambda it: float(it.get("popularity", 0) or 0),
+                    reverse=True,
+                )
+            else:
+                concept_term_sets: list[set[str]] = []
+                SYNONYM_TERMS = {
+                    "christmas": {"natal", "christmas", "xmas"},
+                    "family": {"familia", "family"},
+                    "dog": {"dog", "dogs", "cachorro", "cachorros", "cao", "caes", "scooby"},
+                    "detective": {"detective", "detetive", "investigation", "investigacao", "misterio", "mystery", "scooby"},
+                    "space": {"space", "espaco", "espacial"},
+                    "astronaut": {"astronaut", "astronauta"},
+                    "lost": {"lost", "perdido", "perdida"},
+                    "hospital": {"hospital"},
+                    "abandoned": {"abandoned", "abandonado", "abandonada"},
+                    "horror": {"horror", "terror"},
+                    "ninja": {"ninja", "naruto"},
+                    "pirate": {"pirate", "pirata", "one piece", "luffy"},
+                    "cooking": {"cooking", "cozinha", "culinaria", "chef", "food"},
+                    "competition": {"competition", "competicao"},
+                    "car": {"car", "carro", "carros"},
+                    "race": {"race", "racing", "corrida"},
+                    "robot": {"robot", "robo"},
+                    "giant": {"giant", "gigante"},
+                    "shark": {"shark", "tubarao"},
+                    "killer": {"killer", "assassino", "assassina"},
+                }
+                for cw in concept_words:
+                    terms = set()
+                    for w in cw.lower().split():
+                        if len(w) > 2:
+                            terms.add(w)
+                            for syn_k, syn_vals in SYNONYM_TERMS.items():
+                                if syn_k in w or w in syn_k:
+                                    terms.update(syn_vals)
+                    if not terms:
+                        terms.add(cw.lower())
+                    concept_term_sets.append(terms)
+
+                for it in unique_raw:
+                    c_matches = it.get("_concept_matches", 1)
+                    if c_matches >= len(concepts):
+                        it["_covered_concepts"] = len(concepts)
+                    else:
+                        item_name = (
+                            it.get("title") or it.get("original_title") or ""
+                            if media_type == "movie"
+                            else it.get("name") or it.get("original_name") or ""
+                        )
+                        name_norm = strip_accents(item_name).lower()
+                        overview_norm = strip_accents(it.get("overview") or "").lower()
+                        text_norm = f"{name_norm} {overview_norm}"
+
+                        covered = 0
+                        for terms in concept_term_sets:
+                            if any(term in text_norm for term in terms):
+                                covered += 1
+                        it["_covered_concepts"] = max(c_matches, covered)
+
+                unique_raw.sort(
+                    key=lambda it: (it.get("_covered_concepts", 1), float(it.get("popularity", 0) or 0)),
+                    reverse=True,
+                )
+            unique_raw = unique_raw[:40]
+
+            sem = asyncio.Semaphore(10)
+            cache_updated = False
+
+            async def resolve_imdb(tmdb_id: int) -> str | None:
+                nonlocal cache_updated
